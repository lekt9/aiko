{
  "schema_version": 2,
  "id": "aiko-drop-in-receptor",
  "description": "Provider-neutral receptor for any human observe→decide→effect breakpoint. One ingress+events+effects spec that validates Hoysan preference ingest under poll vs webhook vs hook input-sources as a single harness alias — no provider branches.",
  "triggers": ["wire into this role", "take over this loop", "preference ingest", "pre-shift cascade"],
  "ingress": {
    "modes": ["poll", "local_listener", "provider_webhook"],
    "delivery": "at_least_once",
    "signature": "adapter_declared",
    "max_body_bytes": 1048576,
    "privacy": "redacted"
  },
  "cursor": {
    "identity_fields": ["worker_id", "date"],
    "change_token_fields": ["payload_digest"],
    "ttl_ms": 86400000
  },
  "events": [
    { "id": "preference-ingest", "kind": "object" },
    { "id": "roster-delta", "kind": "object" },
    { "id": "shift-tick", "kind": "object" }
  ],
  "effects": [
    { "id": "normalize", "effect": "local_reversible", "variants": ["poll", "webhook", "hook"], "requires_authority": false, "evidence": ["input_bytes_digest"] },
    { "id": "level-roster", "effect": "local_reversible", "variants": ["deterministic"], "requires_authority": false, "evidence": ["request_digest", "roster_digest"] },
    { "id": "notify-shift", "effect": "external_message", "variants": ["send"], "requires_authority": true, "evidence": ["outbox_commit", "delivery_receipt"] }
  ]
}

{
  "schema_version": 2,
  "id": "http-webhook-v2",
  "description": "Provider-neutral webhook with polling and tunnel fallback",
  "triggers": ["receive remote event"],
  "events": [{"id": "request.received", "kind": "external_event"}],
  "ingress": {
    "modes": ["poll", "ephemeral_tunnel", "durable_tunnel", "provider_webhook"],
    "delivery": "at_least_once",
    "signature": "required",
    "max_body_bytes": 262144,
    "privacy": "redacted"
  },
  "cursor": {
    "identity_fields": ["source_instance", "event_id"],
    "change_token_fields": ["version", "etag", "content_hash"],
    "ttl_ms": 2592000000
  },
  "effects": [
    {
      "id": "response.send",
      "effect": "external_message",
      "variants": ["json", "empty"],
      "requires_authority": true,
      "evidence": ["provider_ack"]
    }
  ]
}

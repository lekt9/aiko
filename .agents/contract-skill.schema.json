{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiko.local/schemas/contract-skill-v1.json",
  "title": "Aiko Contract-Native Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "triggers", "input_schema", "output_schema", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "platforms": { "type": "array", "items": { "enum": ["all", "unix", "linux", "macos", "windows"] } },
    "triggers": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string" } },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "plan", "worker", "depends_on", "can_parallel", "timeout_ms", "effect", "reversible", "read_only", "requires_authority", "evidence"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "plan": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "worker": { "enum": ["aiko", "script", "host", "tool"] },
          "script": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "can_parallel": { "type": "boolean" },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
          "effect": { "enum": ["read_only", "local_reversible", "local_write", "external_message", "purchase", "job_application", "credential_access", "delete", "publish", "permission_change", "account_mutation"] },
          "reversible": { "type": "boolean" },
          "read_only": { "type": "boolean" },
          "requires_authority": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "examples": { "type": "array", "items": { "type": "object" } }
  }
}

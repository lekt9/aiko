import datetime, json, os, sys
sys.path.insert(0, os.path.join(os.environ["PR_CLI_DIR"], "lib"))
try:
    from contract_core import current_agent, _append
except ImportError:
    current_agent = lambda: ""
    _append = lambda r: None
op = os.environ["PR_OP"]; req_id = os.environ["PR_REQ_ID"]
reason = os.environ.get("PR_REASON", "")
resolver = (current_agent() or "anonymous").strip()
try: from contract_core import inbox_root as _iroot_r
except ImportError: _iroot_r = lambda: __import__('pathlib').Path(os.path.expanduser("~/.contracts/inbox"))
req_root = str(_iroot_r() / "permission-request")
match = None
if os.path.isdir(req_root):
    for fname in os.listdir(req_root):
        try:
            for line in open(os.path.join(req_root, fname)):
                row = json.loads(line)
                if row.get("req_id") == req_id:
                    match = row; break
        except (OSError, json.JSONDecodeError): pass
        if match: break
if not match:
    print(f"  ERROR: no permission_request found with req_id={req_id}", file=sys.stderr)
    sys.exit(1)
target = match["target"]
ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
try: from contract_core import inbox_path as _ipath2
except ImportError: _ipath2 = lambda c, n: os.path.expanduser(f"~/.contracts/inbox/{c}/{n}.jsonl")
resolve_inbox = str(_ipath2("permission-resolve", target))
os.makedirs(os.path.dirname(resolve_inbox), exist_ok=True)
resolve_row = {
    "event": "permission_resolve", "req_id": req_id, "target": target,
    "action": match["action"], "verdict": op, "reason": reason,
    "resolver": resolver, "for_contract": match.get("for_contract", ""), "ts": ts,
}
with open(resolve_inbox, "a") as f:
    f.write(json.dumps(resolve_row) + "\n")
_append({**resolve_row, "id": f"permission-resolve-{req_id}"})
print(f"  req_id:    {req_id}")
print(f"  target:    {target}")
print(f"  action:    {match['action']}")
print(f"  verdict:   {op.upper()}")
print(f"  resolver:  {resolver}")
if reason: print(f"  reason:    {reason}")
if match.get("for_contract"):
    print(f"  Ω1 hint:   bot should re-iterate contract {match['for_contract']} now")
print(f"  result:    PASS ({op}ed)")

import datetime, json, os, sys
sys.path.insert(0, os.path.join(os.environ["IB_CLI_DIR"], "lib"))
from contract_core import inbox_path, inbox_root, current_agent, _append
channel = os.environ["IB_CHANNEL"]; name = os.environ["IB_NAME"]
scope = os.environ.get("IB_SCOPE") or None
limit = int(os.environ.get("IB_LIMIT", "10"))
# Cross-scope guard: --scope explicitly different from active root requires audit row
active_root = str(inbox_root())
try:
    requested_path = inbox_path(channel, name, scope=scope)
except ValueError as e:
    print(f"  ERROR: {e}", file=sys.stderr); sys.exit(2)
cross_scope = scope is not None and not str(requested_path).startswith(active_root)
if cross_scope:
    # Audit the cross-scope read so the ledger has it
    ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
    _append({
        "event": "inbox_cross_scope_read",
        "id": f"inbox-xread-{channel}-{name}",
        "channel": channel, "name": name,
        "active_root": active_root, "requested_path": str(requested_path),
        "scope_kind": scope, "agent": (current_agent() or "anonymous").strip(),
        "ts": ts,
    })
    print(f"  ⚠  CROSS-SCOPE READ — active={active_root}  requested={requested_path}")
    print(f"     audit row appended (event=inbox_cross_scope_read)")
if not requested_path.exists():
    print(f"  inbox empty (no file at {requested_path})")
    sys.exit(0)
rows = []
with open(requested_path) as f:
    for line in f:
        try: rows.append(json.loads(line))
        except json.JSONDecodeError: continue
if os.environ["IB_SUB"] == "tail":
    rows = rows[-limit:]
else:
    rows = rows[:limit]
print(f"  channel:  {channel}")
print(f"  name:     {name}")
print(f"  path:     {requested_path}")
print(f"  showing:  {len(rows)} of {sum(1 for _ in open(requested_path))} rows")
print()
for r in rows:
    ev = r.get("event") or "?"
    ts = r.get("ts", "")[:19]
    summary_parts = []
    for k in ("from", "to", "requester", "target", "step", "verdict", "brief", "action"):
        if k in r and r[k]:
            v = str(r[k])[:60]
            summary_parts.append(f"{k}={v}")
    print(f"  [{ts}]  {ev}  {'  '.join(summary_parts)}")
IB_READ_PY

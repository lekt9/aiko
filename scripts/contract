    ;;
  _mark)
    ID="${1:-}"; STATUS="${2:-}"
    [ -z "$ID" ] || [ -z "$STATUS" ] && { echo "usage: contract _mark <id> <status> [--proof <text> | --proof-skip <reason>]" >&2; exit 2; }
    shift 2 || true
    # Parse --proof / --proof-skip. Bare 'satisfied' mark is refused unless
    # one is provided — plan-fulfillment binding: every satisfied row carries
    # a recorded artifact, not just in-thread agent judgment. Origin: 173c8819.
    PROOF=""
    PROOF_SKIP=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --proof) PROOF="${2:-}"; shift 2 ;;
        --proof-skip) PROOF_SKIP="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    # HARD-BREAK on resolution cycle: if this contract participates in a
    # contract:<id> cycle, refuse to satisfy. A cycle means satisfaction
    # would propagate falsely (Y depends on X depends on Y). Substrate
    # forbids; agent must supersede or revise to break the cycle first.
    # Contract fb9698f7 (depth + hard-break on cycles).
    if [ "$STATUS" = "satisfied" ]; then
      DEPTH_OUT=$(python3 "$SELF/contract-depth.py" "$ID" --strict-cycles 2>&1)
      DEPTH_EC=$?
      if [ "$DEPTH_EC" -ne 0 ]; then
        echo "=== HARD BREAK ON RESOLUTION (cycle) ==="
        echo "$DEPTH_OUT" | grep -E "CYCLES|→" | head -20
        echo
        echo "  refuse to _mark $ID satisfied — closing this would propagate a false truth."
        echo "  break the cycle first (revise an action / supersede one side / declare a non-pointer leaf)."
        exit 1
      fi
      # INHIBITION REFUSAL: scan for any satisfied contract that declares
      # itself an inhibitor of this id. If present, refuse the mark — the
      # downstream cell cannot fire while its inhibitor is active. Biology:
      # negative regulation. Substrate-level, fires before proof-check so
      # even a well-proofed mark is refused while suppression is on.
      # Contract d830f26e.
      INH_LIST=$(MH_ID="$ID" _py_inline "
import os
from contract_core import active_inhibitors
ids = active_inhibitors(os.environ['MH_ID'])
print(','.join(ids))
" 2>/dev/null)
      if [ -n "$INH_LIST" ]; then
        echo "=== INHIBITION REFUSAL ==="
        echo "  contract_id:       $ID"
        echo "  inhibitor_ids:     $INH_LIST"
        # Collect plans for each inhibitor as a single comma-joined KV value
        # so the block parses cleanly through openai-render (one KV per line).
        IFS=',' read -ra INH_ARR <<< "$INH_LIST"
        INH_PLANS_JOINED=""
        for inh_id in "${INH_ARR[@]}"; do
          INH_PLAN=$(MH_ID="$inh_id" _py_inline "
import os; from contract_core import get
c=get(os.environ['MH_ID']); print((c['plan'][:60]) if c else '(unknown)')
" 2>/dev/null)
          if [ -n "$INH_PLANS_JOINED" ]; then
            INH_PLANS_JOINED="$INH_PLANS_JOINED || $inh_id: $INH_PLAN"
          else
            INH_PLANS_JOINED="$inh_id: $INH_PLAN"
          fi
        done
        echo "  inhibitor_plans:   $INH_PLANS_JOINED"
        echo "  release_hint:      supersede or revise each inhibitor"
        echo "  doctrine:          an inhibitory contract suppresses downstream firing while itself satisfied"
        exit 1
      fi
      # PROOF REQUIRED: bare mark refused. Surface the plan as the rule the
      # agent must self-judge against. Origin: 173c8819.
      if [ -z "$PROOF" ] && [ -z "$PROOF_SKIP" ]; then
        PLAN_TEXT=$(MH_ID="$ID" _py_inline "
import os
from contract_core import get
c = get(os.environ['MH_ID'])
print(c['plan'] if c else '(unknown)')
" 2>/dev/null)
        echo "=== PROOF REQUIRED (plan-fulfillment binding) ===" >&2
        echo "  contract: $ID" >&2
        echo "  plan:     $PLAN_TEXT" >&2
        echo "" >&2
        echo "  Bare _mark satisfied is refused. The plan IS the rule;" >&2
        echo "  satisfaction needs a recorded proof on the ledger row." >&2
        echo "" >&2
        echo "  Pick one:" >&2
        echo "    contract _mark $ID satisfied --proof \"<one-line evidence the plan held>\"" >&2
        echo "    contract _mark $ID satisfied --proof-skip \"<why the in-thread KEY 2 is sufficient here>\"" >&2
        exit 2
      fi
    fi
    MH_ID="$ID" MH_STATUS="$STATUS" MH_PROOF="$PROOF" MH_PROOF_SKIP="$PROOF_SKIP" _py_inline "
import os, sys
from contract_core import mark_satisfied, mark_status, get
id=os.environ['MH_ID']; st=os.environ['MH_STATUS']
proof = os.environ.get('MH_PROOF') or None
skip = os.environ.get('MH_PROOF_SKIP') or None
# Substrate principle: never silently fabricate a row for an unknown id.
# verb-gate _mark caught this — marking a nonexistent id silently appended
# a satisfied row, which violates default #11 (every verification result
# traces to a real live source). Reject unknown ids before writing.
if get(id) is None:
    print(f'ERROR: contract {id} not found in this ledger', file=sys.stderr)
    sys.exit(1)
if st=='satisfied':
    # Honest mark: write only the satisfied event. The agent's KEY-2 verdict
    # this explicit mark IS the verdict — proof / skip captured on the row.
    mark_satisfied(id, 0, proof=proof, proof_skip_reason=skip)
else:
    mark_status(id, st)
print(f'  {id} -> {st}')
" || exit 1
    _fire_contract_hooks "mark" "$ID" "0"
    # BREAK ON RESOLUTION (refractory period): every satisfied mark fires a
    # substrate-enforced reflection pause BEFORE propagation. Maps to a
    # neuron's absolute refractory period — the cell that just fired
    # cannot fire again until the soma re-polarises. KEY 3 is the agent's
    # re-judgment: did this mark invalidate downstream claims?
    if [ "$STATUS" = "satisfied" ]; then
      echo
      echo "=== BREAK ON RESOLUTION (refractory) ==="
      echo "  $ID just fired. KEY 3 (agent): pause and judge BEFORE propagating:"
      echo "    · is the mark still genuine in retrospect (no fake-green)?"
      echo "    · does this satisfaction invalidate any downstream claim?"
      echo "    · are any peer or parent contracts now stale or duplicated?"
      echo "  If any answer is yes — supersede / revise / iterate before continuing."
      # Soft warnings: when depth>=7 or dims>=4 (Miller's 7±2 working-memory cap)
      # KEY-2 judgment becomes pattern-matching rather than integration.
      # Substrate surfaces; agent decides whether to honor.
      python3 "$SELF/contract-depth.py" "$ID" --json 2>/dev/null | python3 -c "
import json, sys
try:
    r = json.load(sys.stdin)
except Exception:
    sys.exit(0)
warns = []
if r.get('depth_total', 0) >= 7:
    warns.append(f'depth_total={r[\"depth_total\"]} >= 7 (exceeds Miller working-memory cap)')
if r.get('dims', 0) >= 4:
    warns.append(f'dims={r[\"dims\"]} >= 4 (KEY-2 becomes pattern-matching above ~3 dims)')
if warns:
    print('  ⚠️  multi-dimensional gate warnings:')
    for w in warns:
        print(f'      {w}')
" || true
    fi
    # SIGNAL PROPAGATION: a contract becoming satisfied is an action
    # potential. Surface the wavefront — parent organ, contract:<id>
    # referrers, corroborated synapses — so the state change is not inert.
    # The substrate surfaces; the agent judges KEY 2 on each.
    if [ "$STATUS" = "satisfied" ]; then
      MH_ID="$ID" _py_inline "
import os, json, pathlib
from contract_core import wavefront, get, _resolve_ledger
wf = wavefront(os.environ['MH_ID'])
items = []
if wf['parent']:
    items.append(('parent organ      ', wf['parent']))
for r in wf['referrers']:
    items.append(('unblocked referrer', r))
for s in wf['synapses']:

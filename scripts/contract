print()
print('=== PROPAGATION (signal) ===')
if not items:
    print('  leaf signal — no downstream contracts')
else:
    print('  ' + os.environ['MH_ID'] + ' satisfied. wavefront — judge KEY 2 on each:')
    for label, cid in items:
        c = get(cid)
        plan = (c['plan'][:52] if c else '?')
        print('  ' + label + ' ' + cid + '  \"' + plan + '\"')
        print('    -> contract iterate ' + cid)

# Ω1 — unblock-rewake: scan judged-HOLD rows whose blocked_by includes this id.
# When the blocker satisfies, surface the dependent HOLD'd contract as
# 'now re-judgeable' so the agent doesn't have to remember to re-fire it.
ledger = _resolve_ledger()

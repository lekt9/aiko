    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 "$SELF/contract-habit-detect.py" \
      --context "$TASK"
    echo ""
    echo "--- SKILL MATCHES ---"
    python3 - "$TASK" <<'PYSKILL'
import os, sys
task = sys.argv[1].lower()
tokens = set(w.strip('.,;:!?()[]') for w in task.split() if len(w) > 3)
skills_dir = os.path.expanduser('~/.claude/skills')
matches = []
try:
    for skill in os.listdir(skills_dir):
        if skill.startswith('_') or '.' in skill:
            continue
        sl = skill.lower().replace('-', ' ')
        parts = sl.split()
        score = sum(1 for t in tokens if t in parts or t in sl)
        if score > 0:
            matches.append((score, skill))
    matches.sort(reverse=True)
    for score, skill in matches[:8]:
        print(f'  ({score}) {skill}')
    if not matches:
        print('  (no skill name matches)')
except Exception as e:
    print(f'  (skill scan error: {e})')
PYSKILL
    echo ""
    echo "--- BINARY PRIMITIVES ---"
    python3 - "$TASK" <<'PYBIN'
import subprocess, sys
task = sys.argv[1].lower()
candidates = [
    ('bun',      ['bun', 'javascript', 'typescript', 'test', 'build', 'run', 'install']),
    ('npm',      ['npm', 'node', 'javascript', 'package']),
    ('wrangler', ['cloudflare', 'worker', 'deploy', 'pages', 'wrangler']),
    ('gh',       ['github', 'pull request', 'issue', 'workflow', 'ci', 'pr']),
    ('python3',  ['python', 'script', 'verify', 'check']),
    ('cargo',    ['rust', 'cargo', 'crate']),
    ('docker',   ['docker', 'container', 'image', 'compose']),
    ('curl',     ['api', 'http', 'endpoint', 'url', 'request']),
    ('git',      ['commit', 'push', 'branch', 'merge', 'tag', 'deploy']),
    ('jq',       ['json', 'parse', 'query']),
]
found = []
for binary, keywords in candidates:
    if any(kw in task for kw in keywords):
        r = subprocess.run(['which', binary], capture_output=True, text=True)
        if r.returncode == 0:
            found.append(f'  {binary:<12} {r.stdout.strip()}')
for f in found:
    print(f)
if not found:
    print('  (no matching binaries detected)')
PYBIN
    echo ""
    echo "--- SHAPE RECOMMENDATION ---"
    python3 - "$TASK" <<'PYSHAPE'
import sys
task = sys.argv[1].lower()
if any(w in task for w in ('ship', 'deploy', 'build', 'test', 'verify', 'check', 'pass', 'run', 'lint', 'compile', 'install')):
    print('  cell  →  contract declare "<claim>" --action "<cmd that exits 0>"')
elif any(w in task for w in ('always', 'never', 'principle', 'rule', 'must', 'should', 'pattern', 'law', 'gate')):
    print('  judgment  →  contract declare "<claim>" --action "agent-judges"')
elif any(w in task for w in ('iterate', 'loop', 'until', 'keep', 'perpetual', 'while', 'drive', 'continuously', 'forever')):
    print('  loop  →  contract declare "<claim>" --action "loop"')
elif any(w in task for w in ('all', 'both', 'every', 'each', 'complete', 'entire', 'full', 'and')):
    print('  funnel  →  contract declare "<claim>" --action "funnel"')
elif any(w in task for w in ('any', 'either', 'or', 'first', 'whichever', 'one of')):
    print('  funnel-first  →  contract declare "<claim>" --action "funnel-first"')
else:
    print('  judgment (default)  →  contract declare "<claim>" --action "agent-judges"')
PYSHAPE
    echo ""

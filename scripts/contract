    ;;

  judge)
    # Λ1 — runtime-agnostic KEY 2. Reads a contract's most recent iterate
    # output from the ledger and asks a configured OpenAI-compatible LLM
    # endpoint for a structured verdict (PROMOTE / HOLD / REJECT + proof).
    # Closes the loop opened by Φ1: where Φ1 streams substrate output to an
    # OpenAI client, Λ1 calls an OpenAI endpoint to serve KEY 2 in-thread.
    # The substrate becomes truly runtime-agnostic — any LLM that speaks
    # /v1/chat/completions can be the judge (Venice, OpenAI, Anthropic,
    # local llama.cpp, anything).
    #
    # Config (first hit wins):
    #   env: CONTRACT_LLM_URL / CONTRACT_LLM_KEY / CONTRACT_LLM_MODEL
    #   file: ~/.config/contract/llm.json {"url":"...","key":"...","model":"..."}
    JUDGE_ID="${1:-}"
    if [ -z "$JUDGE_ID" ]; then
      cat >&2 <<'USAGE'
usage: contract judge <id>

Λ1 — ask a configured LLM for KEY 2. Reads the latest iterate output for
<id> and POSTs to <CONTRACT_LLM_URL>/chat/completions asking for a
structured PROMOTE / HOLD / REJECT verdict.

Config (env overrides file):
  CONTRACT_LLM_URL    e.g. https://api.venice.ai/api/v1
  CONTRACT_LLM_KEY    bearer token for the endpoint
  CONTRACT_LLM_MODEL  e.g. venice-uncensored / gpt-4o-mini / claude-haiku-4-5
  ~/.config/contract/llm.json  {"url":"...","key":"...","model":"..."}

Exit codes:
  0  — LLM returned PROMOTE
  1  — LLM returned HOLD or REJECT (with reason printed)
  2  — config missing OR LLM call failed (raw response shown)
USAGE
      exit 2
    fi
    MH_JID="$JUDGE_ID" _py_inline "
import os, json, urllib.request, urllib.error, pathlib, sys, shutil, subprocess, tempfile
from contract_core import get, _resolve_ledger

jid = os.environ['MH_JID']
row = get(jid)
if not row:
    print(f'judge: unknown id {jid}', file=sys.stderr); sys.exit(2)

# Get the most recent iterate row's action_result for this contract by
# reading the ledger directly — keeps the substrate's only-writer rule
# intact (contract_core writes; everyone else reads the file).
recent = ''
try:
    p = _resolve_ledger()
except Exception:
    p = pathlib.Path.home() / '.contracts' / 'contracts.jsonl'
if p.exists():
    for line in p.read_text().splitlines():
        if not line.strip(): continue
        try: r = json.loads(line)
        except: continue
        if r.get('event') == 'iterated' and r.get('id') == jid:
            recent = r.get('action_result') or recent
plan = row.get('plan', '')
action = row.get('action', '')

prompt = f'''You are KEY 2 — the agent-judgment layer of the /contract substrate. Given a contract's plan, action, and the most recent mechanical run output, return ONE of three verdicts as a single token on the first line:

  PROMOTE   — the result is genuinely satisfied; the plan held
  HOLD      — the result looks passing but you suspect fake-green; iterate again
  REJECT    — the action passed for the wrong reason; supersede or revise

After the verdict token, write one short line of justification.

CONTRACT
  plan:   {plan}
  action: {action}
  latest_result: {recent}

VERDICT:'''

# Route preference: codex CLI (subscription-billed, default) → HTTP fallback.
# Override with CONTRACT_LLM_VIA=http to force the OpenAI-compatible path.
via_pref = os.environ.get('CONTRACT_LLM_VIA', '').lower()
codex_bin = shutil.which('codex')
use_codex = (via_pref == 'codex') or (via_pref != 'http' and codex_bin and via_pref != 'http')
content = ''
source = ''

if use_codex and codex_bin:
    # codex exec --skip-git-repo-check -s read-only --output-last-message <tmp> -
    # reads the prompt from stdin and writes ONLY the final model message to <tmp>.
    with tempfile.NamedTemporaryFile(mode='r', delete=False, suffix='.txt') as tf:
        last_msg_path = tf.name
    try:
        cmd = [codex_bin, 'exec', '--skip-git-repo-check', '-s', 'read-only',
               '--output-last-message', last_msg_path, '-']
        # Optional model override
        cmd_model = os.environ.get('CONTRACT_LLM_MODEL')
        if cmd_model:
            cmd = [codex_bin, 'exec', '--skip-git-repo-check', '-s', 'read-only',
                   '-m', cmd_model, '--output-last-message', last_msg_path, '-']
        cp = subprocess.run(cmd, input=prompt, text=True, capture_output=True, timeout=180)
        content = open(last_msg_path).read().strip() if os.path.exists(last_msg_path) else ''
        source = f'codex exec (model={cmd_model or \"default\"})'
    except subprocess.TimeoutExpired:
        print('judge: codex exec timed out (180s)', file=sys.stderr); sys.exit(2)
    except FileNotFoundError:
        print('judge: codex binary disappeared mid-call', file=sys.stderr); sys.exit(2)
    finally:
        try: os.unlink(last_msg_path)
        except: pass
    if not content:
        print(f'judge: codex returned empty content', file=sys.stderr)
        if cp.stderr: print(f'  stderr: {cp.stderr[:300]}', file=sys.stderr)
        sys.exit(2)
else:
    # HTTP fallback: OpenAI-compatible /v1/chat/completions
    cfg = {}
    cfg_path = pathlib.Path.home() / '.config' / 'contract' / 'llm.json'
    if cfg_path.exists():
        try: cfg = json.loads(cfg_path.read_text())
        except: pass
    url   = os.environ.get('CONTRACT_LLM_URL')   or cfg.get('url')
    key   = os.environ.get('CONTRACT_LLM_KEY')   or cfg.get('key')
    model = os.environ.get('CONTRACT_LLM_MODEL') or cfg.get('model') or 'gpt-4o-mini'
    if not url or not key:
        print('judge: no judging surface available', file=sys.stderr)
        print('  codex CLI not on PATH AND no HTTP config set', file=sys.stderr)
        print('  options:', file=sys.stderr)
        print('    1. install codex CLI (bun add -g @openai/codex), sign in with ChatGPT subscription', file=sys.stderr)
        print('    2. set CONTRACT_LLM_URL + CONTRACT_LLM_KEY env, OR write ~/.config/contract/llm.json', file=sys.stderr)
        sys.exit(2)
    body = json.dumps({
        'model': model,
        'messages': [{'role':'user','content':prompt}],
        'temperature': 0,
        'max_tokens': 120,
    }).encode()
    chat_url = url.rstrip('/') + '/chat/completions'
    req = urllib.request.Request(chat_url, data=body, method='POST', headers={
        'Authorization': f'Bearer {key}',
        'Content-Type': 'application/json',
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            resp = json.loads(r.read())
    except urllib.error.HTTPError as e:
        print(f'judge: LLM HTTP {e.code} — {e.read().decode()[:300]}', file=sys.stderr)
        sys.exit(2)
    except Exception as e:
        print(f'judge: LLM call failed — {e}', file=sys.stderr)
        sys.exit(2)
    content = resp.get('choices',[{}])[0].get('message',{}).get('content','').strip()
    source = f'HTTP {chat_url} (model={model})'
    if not content:
        print(f'judge: LLM returned empty content. raw: {json.dumps(resp)[:300]}', file=sys.stderr)
        sys.exit(2)

first_line = content.splitlines()[0].strip().upper()
rest = '\n'.join(content.splitlines()[1:]).strip()

# Ω1 — parse blocker contract ids out of the verdict reason. Pattern:
# any 8-hex id that appears alongside 'block', 'blocked', 'depends on',
# 'gated on', 'waiting on'. Records a 'judged' ledger event with the
# typed blocked_by list so the satisfy-wavefront can re-surface this
# contract when the blocker satisfies. Tight regex so prose doesn't
# leak random ids into the dependency graph.
import re as _re
blockers = []
if first_line.startswith('HOLD') or first_line.startswith('REJECT'):
    # Find 8-hex ids near blocker keywords (within ~40 chars)
    for m in _re.finditer(r'(block|blocked|depends?|depending|gated|waiting|until|after|when).{0,60}?\b([a-f0-9]{8})\b', rest, _re.IGNORECASE):
        bid = m.group(2)
        if bid != jid and bid not in blockers:
            # Confirm it's a real contract id, not random hex
            from contract_core import get as _g
            if _g(bid):
                blockers.append(bid)

# Record the judgment as a typed event row (Ω1) — survives session boundaries
from contract_core import record_event as _re_event
_re_event('judged', jid,
          verdict=first_line.split()[0] if first_line else 'UNKNOWN',
          blocked_by=blockers,
          reason=rest[:500],
          source=source)

print(f'=== Λ1 LLM VERDICT ===')
print(f'  verdict: {first_line}')
if rest:
    print(f'  reason:  {rest[:300]}')
if blockers:
    print(f'  blocked_by: {\", \".join(blockers)}  (will re-surface when these satisfy)')
print(f'  via:     {source}')
print()
if 'PROMOTE' in first_line:
    print(f'  next: contract _mark {jid} satisfied --proof \"Λ1 LLM judge ({source}): {rest[:160]}\"')
    sys.exit(0)
elif 'HOLD' in first_line:
    print(f'  next: contract iterate {jid}  # judge says fake-green or unconvinced')
    sys.exit(1)
elif 'REJECT' in first_line:
    print(f'  next: contract supersede {jid} <winner>  OR  contract revise {jid} <new-action>')
    sys.exit(1)
else:
    print(f'  unrecognized verdict token (expected PROMOTE/HOLD/REJECT)', file=sys.stderr)
    sys.exit(2)
"
    ;;

  unblocked)
    # Ω1 — list every judged-HOLD contract whose every blocker_id is now satisfied.
    # The substrate surfaces; the agent re-judges. Filters: --json (machine-readable).
    UB_JSON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) UB_JSON="1"; shift ;;
        *) shift ;;
      esac

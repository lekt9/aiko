import os, sys, json, glob, subprocess, time
from datetime import datetime, timezone
W_DIR    = os.environ['W_DIR']
INBOX_DIR= os.environ['INBOX_DIR']
CLI_SELF = os.environ['CLI_SELF']
VERBOSE  = bool(os.environ.get('VERBOSE_TICK'))
now      = datetime.now(timezone.utc)
fired    = 0
polled   = 0
skipped  = 0
for fpath in sorted(glob.glob(W_DIR + '/*.json')):
    try:
        with open(fpath) as fh: w = json.load(fh)
    except Exception:
        continue
    cid = w['contract_id']
    interval = int(w.get('interval_s', 60))
    last_ts = w.get('last_run_ts')
    if last_ts:
        try:
            last_dt = datetime.fromisoformat(last_ts.replace('Z','+00:00'))
            elapsed = (now - last_dt).total_seconds()
        except Exception:
            elapsed = interval + 1
    else:
        elapsed = interval + 1
    if elapsed < interval:
        skipped += 1
        if VERBOSE: print(f\"  skip   {cid}  ({int(interval-elapsed)}s until next poll)\")
        continue
    polled += 1
    probe = w.get('probe')
    probe_exit = None
    if probe:
        try:
            r = subprocess.run(probe, shell=True, capture_output=True, timeout=30)
            probe_exit = r.returncode
        except Exception:
            probe_exit = 124
        if VERBOSE: print(f\"  probe  {cid}  -> exit {probe_exit}\")
    # Update state
    w['last_run_ts']     = now.strftime('%Y-%m-%dT%H:%M:%SZ')
    w['last_probe_exit'] = probe_exit
    w['attempts']        = int(w.get('attempts', 0)) + 1
    should_fire = (probe is None) or (probe_exit == 0)
    if not should_fire:
        # Persist updated state; keep watching
        with open(fpath, 'w') as fh: json.dump(w, fh, indent=2)
        continue
    # FIRE: emit inbox event + auto-iterate the contract + remove watcher
    inbox_path = INBOX_DIR + '/' + cid + '.jsonl'
    event = {
        'event': 'flipped',
        'contract_id': cid,
        'ts': w['last_run_ts'],
        'probe_exit': probe_exit,
        'attempts': w['attempts'],
    }
    with open(inbox_path, 'a') as fh:
        fh.write(json.dumps(event) + '\\n')
    # Mail-stdin doctrine (b2d15246): stage the event at
    # ~/.contracts/inbox-pending/<cid>.json so the iterate's _run_action
    # pipes it to the action's stdin AND exports CONTRACT_INBOX_EVENT.
    # _run_action removes the file after consumption (idempotent fire).
    pending_dir = os.path.expanduser('~/.contracts/inbox-pending')
    try:
        os.makedirs(pending_dir, exist_ok=True)
        with open(pending_dir + '/' + cid + '.json', 'w') as fh:
            json.dump(event, fh)
    except Exception:
        pass
    # Auto-iterate. This emits the standard two-key exit; KEY 2 still belongs
    # to the agent next session. The fire is mechanical, not a verdict.
    try:
        subprocess.run([CLI_SELF, 'iterate', cid], capture_output=True, timeout=60)
    except Exception:
        pass
    # One-shot — remove the watcher
    try: os.unlink(fpath)
    except Exception: pass
    fired += 1
    if VERBOSE: print(f\"  FIRED  {cid}  (auto-iterated, inbox event written, watcher removed)\")
print(f'=== Ψ4 WATCH TICK === polled={polled} fired={fired} skipped={skipped}')
"
        ;;

      stop)
        S_ID="${1:-}"
        [ -z "$S_ID" ] && { echo "usage: contract watch stop <id>" >&2; exit 2; }
        S_FILE="$WATCHERS_DIR/$S_ID.json"
        if [ ! -f "$S_FILE" ]; then
          echo "no watcher registered for $S_ID" >&2
          exit 1
        fi
        rm -f "$S_FILE"
        echo "watcher stopped: $S_ID"
        ;;

      help|*)
        cat <<'USAGE'
contract watch — async watcher (Ψ4)

  contract watch <id> [--probe "<cmd>"] [--interval <s>]   register a watcher
  contract watch register <id> ...                          same as above (explicit)
  contract watch list [--json]                              list registered watchers
  contract watch tick [--verbose]                           run one poll cycle
  contract watch stop <id>                                  remove a watcher

Behaviour: one-shot. When the probe PASSes (or directly if no probe),
the tick auto-iterates the contract, writes an inbox event, and removes
the watcher. The auto-iterate fires the Ω1 wavefront on any dependent.
The tick runs automatically on every iterate/_mark via internal hook.
USAGE
        ;;
    esac
    ;;

  list)
    SHOW_MERGED=""
    VIEWER=""
    SINCE=""
    STATUS_FILTER=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --show-merged) SHOW_MERGED="1"; shift ;;
        --for)         VIEWER="${2:-}"; shift 2 ;;
        --since)       SINCE="${2:-}"; shift 2 ;;
        --status)      STATUS_FILTER="${2:-}"; shift 2 ;;
        --pending)     STATUS_FILTER="pending,active,declared"; shift ;;
        *) shift ;;
      esac
    done
    MH_SHOW_MERGED="${SHOW_MERGED:-}" MH_VIEWER="${VIEWER:-}" MH_SINCE="${SINCE:-}" MH_STATUS="${STATUS_FILTER:-}" _py_inline "
import os, json, time, re, pathlib
from contract_core import list_all
show = bool(os.environ.get('MH_SHOW_MERGED'))
viewer = os.environ.get('MH_VIEWER') or None
since = os.environ.get('MH_SINCE') or ''
status_filter = os.environ.get('MH_STATUS') or ''
status_set = set(s.strip() for s in status_filter.split(',') if s.strip()) if status_filter else None

# Parse --since duration: '1d', '24h', '30m', '60s', or plain seconds
cutoff_ts = None
if since:
    m = re.match(r'^(\d+)([smhd]?)\$', since.strip())
    if not m:
        print(f'  ERROR: --since must be like 24h, 7d, 30m, 60s (got: {since!r})'); raise SystemExit(2)
    n = int(m.group(1)); unit = m.group(2) or 's'
    mult = {'s':1, 'm':60, 'h':3600, 'd':86400}[unit]
    cutoff_ts = time.time() - (n * mult)

# Build a last-ts map by walking the ledger once (covers iterate + mark + judged + cached etc — any event with this id)
last_ts_by_id = {}
if cutoff_ts is not None:
    ledger = pathlib.Path(os.environ.get('CONTRACTS_STORE') or os.path.expanduser('~/.contracts/contracts.jsonl'))
    if ledger.exists():
        for line in ledger.read_text().splitlines():
            if not line.strip(): continue
            try: row = json.loads(line)
            except Exception: continue
            cid = row.get('id'); ts = row.get('ts')
            if not cid or not ts: continue
            try:
                # ts is ISO 8601 (e.g. '2026-05-24T03:42:00Z') — parse via time.strptime fallback to fromisoformat
                from datetime import datetime
                ts_f = datetime.fromisoformat(ts.replace('Z','+00:00')).timestamp()
            except Exception:
                continue
            if cid not in last_ts_by_id or ts_f > last_ts_by_id[cid]:
                last_ts_by_id[cid] = ts_f

cs=list_all(show_merged=show, viewer=viewer)
shown = 0
for c in cs:
    if status_set is not None and c['status'] not in status_set: continue
    if cutoff_ts is not None:
        last_ts = last_ts_by_id.get(c['id'])
        if last_ts is None or last_ts < cutoff_ts: continue
    shape='funnel' if (c.get('children') or c['action'] in ('children-satisfy','funnel')) else 'funnel-first' if c['action']=='funnel-first' else 'judgment' if c['action']=='agent-judges' else 'loop' if (c['action'].startswith('loop-until:') or c['action']=='loop') else 'harness' if c['action'].startswith('harness:') else 'cell'
    merged_note = f\" -> {c['merged_into']}\" if c.get('merged_into') else ''
    revised_note = ' [revised]' if c.get('original_action') else ''
    aud_note = f\" audience={','.join(c['audience'])}\" if c.get('audience') else ''
    age_note = ''
    if cutoff_ts is not None and c['id'] in last_ts_by_id:
        age_s = time.time() - last_ts_by_id[c['id']]
        age_h = age_s / 3600
        age_note = f' ({age_h:.1f}h ago)' if age_h < 48 else f' ({age_s/86400:.1f}d ago)'
    print(f\"[{c['status']}] {c['id']} ({shape}) w={c['wave']}{merged_note}{revised_note}{aud_note}{age_note}\")
    print(f\"  {c['plan'][:80]}\")
    shown += 1
if shown == 0:
    filters = []
    if status_set: filters.append(f'status in {sorted(status_set)}')
    if cutoff_ts is not None: filters.append(f'last touched within --since {since}')
    if viewer: filters.append(f'visible to {viewer!r}')
    print(f'  (no contracts match: {\" + \".join(filters) if filters else \"<all>\"})')
"
    ;;

  habit|search)
    # Stash args so we can re-derive the --context for the BASE RATE summary.
    _SEARCH_ARGS=("$@")
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 "$SELF/contract-habit-detect.py" "${_SEARCH_ARGS[@]}"
    _RC=$?
    # Extract --context value (if any) and append the BASE RATE one-liner.
    _CTX=""
    _i=0
    while [ "$_i" -lt "${#_SEARCH_ARGS[@]}" ]; do
      if [ "${_SEARCH_ARGS[$_i]}" = "--context" ]; then
        _j=$((_i+1))
        [ "$_j" -lt "${#_SEARCH_ARGS[@]}" ] && _CTX="${_SEARCH_ARGS[$_j]}"
        break
      fi
      _i=$((_i+1))
    done
    if [ -n "$_CTX" ]; then
      MH_CTX="$_CTX" PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 -c "
import os, importlib.util
spec = importlib.util.spec_from_file_location('hd_mod', '$SELF/contract-habit-detect.py')
mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
ctx = os.environ['MH_CTX']
cands = mod.detect(ctx, mod.DEFAULT_THRESHOLD)
total = len(cands)
sat = sum(1 for c in cands if c.get('status') == 'satisfied')
rate = (100.0 * sat / total) if total else 0.0
print(f'BASE RATE for this class: {sat} / {total} satisfied = {rate:.1f}% (window: all-time, threshold: {mod.DEFAULT_THRESHOLD})')
"
    fi
    exit $_RC
    ;;

  import)
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 "$SELF/contract-import-extract.py" "$@"
    ;;

  defaults)
    cat <<'DEFAULTS'
=== CONTRACT DEFAULTS (11 universal principles) ===

-- Engineering principles (CLAUDE.md + CONTRACTS.md) --
 1. substrate-enables (judgment) "substrate enables, never prescribes — no forbidden surface in any script or agent"
 2. no-regression    (judgment)  "every commit introduces zero new failures vs baseline"
 3. pointer-payload  (judgment)  "client holds only opaque pointers; all logic lives server-side"
 4. C-G01            (judgment)  "harness collects, agent judges — no script emits a verdict"
 5. C-G06            (judgment)  "verify served surface not source — build pass is never sufficient"
 6. C-G08            (judgment)  "fix root cause, never band-aid — no downstream compensator stage"
 7. C-O04            (cell)      "no .db or state file un-gitignored in repo"
    action: ! find . -maxdepth 3 -name '*.db' -not -path '*/.git/*' 2>/dev/null | grep -q .
 8. deploy-e2e       (judgment)  "auth/deploy chain verified against live service; not build/timestamp"

-- Fruits of the spirit + commandments (mapped where genuinely distinct) --
 9. love             (judgment)  "serve the genuine need, not just the literal request"
10. no-adultery      (judgment)  "one contract, one truth claim — two checks = two contracts"
11. no-false-witness (judgment)  "every verification result traces to a real live source"
DEFAULTS
    ;;

  init)
    # Idempotent first-use bootstrap. Installs the 11 universal Default
    # Contracts into the active ledger (project or global), runs the
    # CLAUDE.md/AGENTS.md activation symlink check, runs the claudemd
    # migration check, and ensures ~/.contracts/contracts.d/ exists.
    # Re-running is a no-op once everything is in place. Contract 33c188dc.
    DRY=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dry-run|-n) DRY="1"; shift ;;
        *) shift ;;
      esac
    done
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" CONTRACT_INIT_DRY="$DRY" python3 - <<'PY'
import json, os, sys, subprocess
from pathlib import Path
from contract_core import (
    _resolve_ledger, contracts_d_root, contract_dir,
    declare, mark_satisfied, list_all,
)

DRY = bool(os.environ.get("CONTRACT_INIT_DRY"))
ledger = _resolve_ledger()
print(f"=== contract init ({'DRY-RUN' if DRY else 'apply'}) ===")
print(f"  ledger: {ledger}")

# 1. Ensure ledger dir + contracts.d/ exist
if not DRY:
    ledger.parent.mkdir(parents=True, exist_ok=True)
    contracts_d_root().mkdir(parents=True, exist_ok=True)
print(f"  contracts.d: {contracts_d_root()}")

# 2. Default contracts — install if not already present (by plan-prefix match).
# These are the 11 universal principles from SKILL.md. They live as eternal
# judgments in the ledger so the agent can reference them; idempotent.
DEFAULTS = [
    ("substrate",        "judgment", "substrate enables, never prescribes — no forbidden surface in any script or agent"),
    ("no-regression",    "judgment", "every commit introduces zero new failures — diff vs baseline is non-positive"),
    ("pointer-payload",  "judgment", "pointer-not-payload — client holds only opaque pointers; all logic lives server-side"),
    ("C-G01",            "judgment", "harness collects, agent judges — no script emits PROMOTE/PASS/FAIL on its own"),
    ("C-G06",            "judgment", "verify the served surface, not the source — a build pass is never sufficient"),
    ("C-G08",            "judgment", "fix root cause, never band-aid — no downstream fix_/clean_/patch_ compensator"),
    ("C-O04",            "judgment", "no mutable .db or state file un-gitignored inside a git-tracked directory"),
    ("deploy-e2e",       "judgment", "auth/deploy chain verified against the live running service; not build, not timestamp"),
    ("love",             "judgment", "serve the genuine need, not just the literal request — technically-passing but intent-missing is fake-green"),
    ("no-adultery",      "judgment", "one contract, one truth claim — if an action checks two unrelated things it belongs as two contracts"),
    ("no-false-witness", "judgment", "every verification result traces to a real live source — no synthesized, proxied, or stubbed result"),
]
existing = list_all()
def _already_present(plan):
    """Idempotency by semantic anchor: first 3 distinctive 4+letter words.
    Tolerates re-wordings ("substrate enables, never prescribes" vs
    "the substrate enables; it does not prescribe") which a fixed-prefix
    match would miss."""
    import re
    words = [w.lower() for w in re.findall(r"[a-zA-Z][a-zA-Z-]{3,}", plan)][:3]
    if not words: return None
    for r in existing:
        rp = r.get("plan", "").lower()
        if all(w in rp for w in words):
            return r["id"]
    return None
installed, skipped = [], []
for tag, shape, plan in DEFAULTS:
    prior = _already_present(plan)
    if prior:
        skipped.append((tag, prior))
        continue
        continue
    cid, _ = declare(plan, action="agent-judges", parent_id=None)
    # Defaults are eternal facts — pre-satisfied so they act as references,
    # not pending iterates. The agent invokes them via wavefront / search.
    mark_satisfied(cid, 0)
    installed.append((tag, cid))
print(f"  defaults installed: {len(installed)}  skipped (already present): {len(skipped)}")

# 3. Activation symlinks: ~/.codex/AGENTS.md and ~/AGENTS.md → CLAUDE.md
home = Path.home()
claudemd = home / ".claude" / "CLAUDE.md"
for target in (home / ".codex" / "AGENTS.md", home / "AGENTS.md"):
    if not claudemd.exists():
        print(f"  symlink/{target.name}: SKIP (no ~/.claude/CLAUDE.md)")
        continue
    if target.is_symlink():
        actual = target.resolve()
        ok = actual == claudemd.resolve()
        print(f"  symlink/{target.name}: {'OK' if ok else 'MISMATCH ('+str(actual)+')'}")
    elif target.exists():
        print(f"  symlink/{target.name}: EXISTS as file (not symlink) — leaving alone")
    else:
        if DRY:
            print(f"  symlink/{target.name}: would create -> {claudemd}")
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.symlink_to(claudemd)
            print(f"  symlink/{target.name}: CREATED -> {claudemd}")

# 4. CLAUDE.md migration check (the skill's own script)
mig = home / ".claude" / "skills" / "contract" / "scripts" / "claudemd-migration-check.sh"
if mig.exists():
    r = subprocess.run(["bash", str(mig)], capture_output=True, text=True, timeout=30)
    print(f"  claudemd-migration: {'OK' if r.returncode == 0 else 'NEEDS ATTENTION (see stderr)'}")
    if r.returncode != 0:
        sys.stderr.write(r.stderr[:400])

print(f"\n=== init {'DRY-RUN' if DRY else 'complete'} ===")
PY
    ;;

  skills)
    # Programmatic discovery of ~/.claude/skills/*/SKILL.md — the directory
    # IS the truth, no ledger duplication. Replaces ~50 "skill: X exists"
    # rows. Subcommands: 'sync' (default = list current state), '--json'.
    SUB="${1:-sync}"; shift || true

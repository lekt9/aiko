          cat >&2 <<'USAGE'
contract show <id> [--internals] [--context] [--json]

Render a contract's public face by default (WHAT + STATUS + PROOF + LAYER).

  --internals   Add HOW block — action, pointer_type, cwd, wave, agent,
                timestamps, pierced_layers (Ψ5 internal surface).
  --context     Add DAG block — parent + children + contract-refs in/out +
                synapses + inhibitors, each shown with id/layer/status.
                Surfaces how this contract sits inside the funnel it's part
                of (one hop in every direction — the relevant context).
  --json        Emit structured JSON instead of pretty text.
USAGE
          exit 0
          ;;
        *) [ -z "$ID" ] && ID="$1"; shift ;;
      esac
    done
    [ -z "$ID" ] && { echo "usage: contract show <id> [--internals] [--context] [--json]" >&2; exit 2; }
    MH_ID="$ID" MH_INT="$SHOW_INTERNALS" MH_JSON="$JSON_OUT" MH_CTX="$SHOW_CONTEXT" _py_inline "
import os, sys, json, textwrap
from contract_core import get, _rows, layer_name
cid = os.environ['MH_ID']
c = get(cid)
if not c:
    print(f'ERROR: contract {cid} not found', file=sys.stderr); sys.exit(3)

all_rows = list(_rows())
latest_sat, latest_it, declared_row, latest_judged = None, None, None, None
for r in all_rows:
    if r.get('id') != cid: continue
    ev = r.get('event')
    if ev == 'declared': declared_row = r
    elif ev == 'satisfied':
        if not latest_sat or r.get('ts','') > latest_sat.get('ts',''): latest_sat = r
    elif ev == 'iterated':
        if not latest_it or r.get('ts','') > latest_it.get('ts',''): latest_it = r
    elif ev == 'judged':
        if not latest_judged or r.get('ts','') > latest_judged.get('ts',''): latest_judged = r

proof = (latest_sat or {}).get('proof') or (latest_sat or {}).get('proof_skip_reason')
blocked_by = (latest_judged or {}).get('blocked_by') or []
latest_verdict = (latest_judged or {}).get('verdict')
public = {
    'id': cid, 'plan': c.get('plan',''), 'status': c.get('status','pending'),
    'layer': c.get('layer'), 'layer_name': c.get('layer_name'),
    'audience': c.get('audience'), 'parent': c.get('parent_id'),
    'children_count': len(c.get('children') or []), 'bind_to': c.get('bind_to'),
    'latest_proof': proof, 'latest_verdict': latest_verdict,
    'blocked_by': blocked_by, 'inhibits': c.get('inhibits'),
    'pierced_layers': c.get('pierced_layers'),
}

# === DAG context (the relevant funnel/sequence/graph neighborhood) ===
# Walk one hop in every direction so 'contract show <id> --context' surfaces
# how this row sits inside its substrate-graph neighborhood: parent organ,
# children, contract-refs in (who gates on us), refs out (who we gate on
# via contract:<id> action), synapses (corroborated peers), inhibitors.
context = None
if os.environ.get('MH_CTX'):
    def _node(ref_id):
        n = get(ref_id)
        if not n: return {'id': ref_id, 'plan': '(not in ledger)', 'status': '?', 'layer': None}
        return {'id': ref_id, 'plan': (n.get('plan') or '')[:60],
                'status': n.get('status','pending'),
                'layer': n.get('layer'), 'layer_name': n.get('layer_name')}
    # Refs OUT: who do WE point at? contract: action + parent
    refs_out = []
    if c.get('action','').startswith('contract:'):
        refs_out.append(_node(c['action'].split(':',1)[1]))
    # Refs IN: who points at us as contract:<our-id> in their action?
    refs_in = []
    for r in all_rows:
        if r.get('event') != 'declared': continue
        if r.get('id') == cid: continue
        act = r.get('action','') or ''
        if act == f'contract:{cid}':
            refs_in.append(_node(r['id']))
    # Synapses: corroborate events naming us
    synapses = []
    for r in all_rows:
        if r.get('event') != 'corroborate': continue
        if cid in (r.get('ids') or []):
            for other in (r.get('ids') or []):
                if other != cid: synapses.append(_node(other))
    # Inhibitors: contracts whose 'inhibits' list contains us AND are satisfied
    inhibitors_active = []
    for r in all_rows:
        if r.get('event') != 'declared': continue
        if cid in (r.get('inhibits') or []):
            inh_status = get(r['id']) or {}
            if inh_status.get('status') == 'satisfied':
                inhibitors_active.append(_node(r['id']))
    context = {
        'parent':   _node(c['parent_id']) if c.get('parent_id') else None,
        'children': [_node(ch) for ch in (c.get('children') or [])],
        'refs_out': refs_out,
        'refs_in':  refs_in,
        'synapses': synapses,
        'inhibitors_active': inhibitors_active,
    }

internals = None
if os.environ.get('MH_INT'):
    internals = {
        'action': c.get('action'), 'pointer_type': c.get('pointer_type'),
        'cwd': c.get('cwd'), 'budget': c.get('budget'),
        'declared_ts': (declared_row or {}).get('ts'), 'agent': c.get('agent'),
        'wave': c.get('wave', 0),
        'last_iterated_ts': (latest_it or {}).get('ts'),
        'last_exit': (latest_it or {}).get('action_exit'),
        'last_result': (latest_it or {}).get('action_result'),
        'satisfied_ts': (latest_sat or {}).get('ts'),
        'merged_into': c.get('merged_into'),
    }

if os.environ.get('MH_JSON'):
    out = {'public': public}
    if internals is not None: out['internals'] = internals
    if context is not None: out['context'] = context
    print(json.dumps(out, indent=2, default=str)); sys.exit(0)

status = public['status']
glyph = {'satisfied':'✓','active':'○','pending':'·','merged':'×','rejected':'✗'}.get(status, '?')
print(f\"=== {cid}  {glyph} {status}  L{public['layer']} {public['layer_name']} ===\")
print('  WHAT must hold:')
for line in textwrap.wrap(public['plan'], width=72) or ['(no plan)']:
    print(f'    {line}')
if public['audience']:        print(f\"  AUDIENCE:        {', '.join(public['audience'])}\")
if public['parent']:          print(f\"  PARENT:          {public['parent']}\")
if public['children_count']:  print(f\"  CHILDREN:        {public['children_count']}\")
if public['bind_to']:         print(f\"  BIND_TO:         {public['bind_to']}\")
if public['blocked_by']:      print(f\"  BLOCKED_BY:      {', '.join(public['blocked_by'])}\")
if public['inhibits']:        print(f\"  INHIBITS:        {', '.join(public['inhibits'])}\")
if public['pierced_layers']:  print(f\"  PIERCED_LAYERS:  {public['pierced_layers']}\")
if public['latest_verdict']:  print(f\"  LATEST VERDICT:  {public['latest_verdict']}\")
if public['latest_proof']:
    proof_short = public['latest_proof'][:300] + ('...' if len(public['latest_proof'])>300 else '')
    print('  LATEST PROOF:')
    for line in textwrap.wrap(proof_short, width=72):
        print(f'    {line}')
if internals is not None:
    print()
    print('  --- HOW (Ψ5 internals — implementation surface) ---')
    if internals['action']:
        a = internals['action']; print(f'  action:          {a[:64]}' + ('...' if len(a)>64 else ''))
    if internals['pointer_type']:    print(f\"  pointer_type:    {internals['pointer_type']}\")
    if internals['cwd']:             print(f\"  cwd:             {internals['cwd']}\")
    if internals['budget']:          print(f\"  budget:          {internals['budget']}\")
    if internals['declared_ts']:     print(f\"  declared_ts:     {internals['declared_ts']}\")
    if internals['agent']:           print(f\"  agent:           {internals['agent']}\")
    print(f\"  wave:            {internals['wave']}\")
    if internals['last_iterated_ts']: print(f\"  last_iterated:   {internals['last_iterated_ts']}\")
    if internals['last_exit'] is not None:
        print(f\"  last_exit:       {internals['last_exit']} ({internals.get('last_result') or ''})\")
    if internals['satisfied_ts']:    print(f\"  satisfied_ts:    {internals['satisfied_ts']}\")
    if internals['merged_into']:     print(f\"  merged_into:     {internals['merged_into']}\")
else:
    print()
    print('  (use --internals to surface the HOW block: action, cwd, wave, agent, timestamps)')

# === DAG context block (--context) — the relevant funnel/graph neighborhood ===
if context is not None:
    def _fmt(n):
        if not n: return ''
        glyph = {'satisfied':'✓','active':'○','pending':'·','merged':'×','rejected':'✗'}.get(n.get('status','?'),'?')
        layer = f\"L{n['layer']}\" if n.get('layer') is not None else 'L?'
        return f\"{glyph} {n['id']}  {layer}  \\\"{n['plan']}\\\"\"
    print()
    print('  --- DAG CONTEXT (one hop in every direction) ---')
    if context['parent']:
        print(f\"  parent:      {_fmt(context['parent'])}\")
    if context['children']:
        print(f\"  children:    {len(context['children'])}\")
        for ch in context['children'][:10]:
            print(f\"    └─ {_fmt(ch)}\")
        if len(context['children']) > 10:
            print(f\"    ... ({len(context['children']) - 10} more)\")
    if context['refs_out']:
        print(f\"  refs out (this gates on):\")
        for n in context['refs_out']:
            print(f\"    →  {_fmt(n)}\")
    if context['refs_in']:
        print(f\"  refs in (these gate on us — {len(context['refs_in'])}):\")
        for n in context['refs_in'][:10]:
            print(f\"    ←  {_fmt(n)}\")
        if len(context['refs_in']) > 10:
            print(f\"    ... ({len(context['refs_in']) - 10} more)\")
    if context['synapses']:
        print(f\"  synapses (corroborated):\")
        for n in context['synapses'][:10]:
            print(f\"    ↔  {_fmt(n)}\")
    if context['inhibitors_active']:
        print(f\"  ACTIVE INHIBITORS (suppressing _mark):\")
        for n in context['inhibitors_active']:
            print(f\"    ⊘  {_fmt(n)}\")
    if not any([context['parent'], context['children'], context['refs_out'],
                context['refs_in'], context['synapses'], context['inhibitors_active']]):
        print('  (isolated — no parent, children, refs, synapses, or inhibitors)')
else:
    print('  (use --context to surface the DAG neighborhood — parent, children, refs in/out, synapses, inhibitors)')
"
    ;;

  sync)
    # contract sync [<dir>] [--message "<msg>"] [--no-push] — git add . + commit
    # + push to gitea for the target dir (defaults to $PWD). Delegates first-time
    # gitea-repo creation + remote-add to ~/.claude/skills/gitea-mirror/bin/mirror.sh
    # (the canonical gitea engine — token from keychain, Tailscale-only URL).
    #
    # Composes with ffdf4eac (commit-on-touch doctrine): every /contract turn that
    # touches code on disk can close with `contract sync` and the working tree
    # lands on gitea programmatically. The substrate enables the action; the agent
    # judges WHEN to call it (no auto-fire — that would violate C-O01).
    DIR="$PWD"
    MSG=""
    DO_PUSH=1
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir)        DIR="${2:-$PWD}"; shift 2 ;;
        --message|-m) MSG="${2:-}"; shift 2 ;;
        --no-push)    DO_PUSH=0; shift ;;
        --help|-h)
          cat >&2 <<'USAGE'
contract sync [<dir>] [--message "<msg>"] [--no-push]

git add . + commit + push to gitea for the target directory.

  <dir>          Repo to sync. Default: $PWD.
  --message      Commit message. Default: auto.
  --no-push      Stage + commit only; skip the push.

First-time gitea-remote setup is delegated to gitea-mirror/bin/mirror.sh.
Token loaded from macOS keychain (service=GITEA_TOKEN account=lekt8) or
GITEA_TOKEN env.
USAGE
          exit 0
          ;;
        --*) shift ;;
        *) DIR="$1"; shift ;;
      esac
    done
    [ -d "$DIR" ] || { echo "ERROR: directory $DIR not found" >&2; exit 2; }
    if [ ! -d "$DIR/.git" ]; then
      echo "  $DIR is not a git repo — initializing..." >&2
      git -C "$DIR" init -q >&2 || { echo "ERROR: git init failed" >&2; exit 2; }
    fi
    # Auto-load GITEA_TOKEN from keychain (macOS) if not in env
    if [ -z "${GITEA_TOKEN:-}" ] && command -v security >/dev/null 2>&1; then
      _kc=$(security find-generic-password -a lekt8 -s GITEA_TOKEN -w 2>/dev/null || true)
      [ -n "$_kc" ] && export GITEA_TOKEN="$_kc"
    fi
    # Stage + commit (idempotent — nothing-to-commit is fine)
    git -C "$DIR" add -A
    if git -C "$DIR" diff --cached --quiet 2>/dev/null; then
      echo "  (no staged changes — working tree clean)"
    else
      TS=$(date -u +%FT%TZ)
      DIRNAME=$(basename "$DIR")
      [ -z "$MSG" ] && MSG="contract: sync $DIRNAME $TS"
      git -C "$DIR" commit -q -m "$MSG" >&2 || { echo "ERROR: commit failed" >&2; exit 1; }
      echo "  committed: $(git -C "$DIR" log -1 --oneline 2>/dev/null)"
    fi
    [ "$DO_PUSH" = "0" ] && exit 0
    # Push to gitea — ensure remote exists; delegate first-time setup to mirror.sh
    if ! git -C "$DIR" remote get-url gitea >/dev/null 2>&1; then
      [ -z "${GITEA_TOKEN:-}" ] && { echo "ERROR: no gitea remote, no GITEA_TOKEN. Set it or pre-stage with gitea-mirror." >&2; exit 2; }
      echo "  no gitea remote — setting up via gitea-mirror/bin/mirror.sh..."
      bash ~/.claude/skills/gitea-mirror/bin/mirror.sh "$DIR" 2>&1 | tail -5
    else
      BRANCH=$(git -C "$DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
      if git -C "$DIR" push gitea "$BRANCH" 2>&1 | tail -3; then
        echo "  pushed: $BRANCH → gitea"
      else
        echo "  PUSH FAILED" >&2
        exit 1
      fi
    fi
    ;;

  tail)
    # contract tail <id> [--since-start] — follow ~/.contracts/streams/<id>/stdout.log
    # in real time. The substrate exposes the path convention; the action's job is
    # to write to it. See SKILL.md "Streams (the output side of receptors)".
    ID=""
    SINCE_START=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --since-start) SINCE_START="1"; shift ;;
        --help|-h)
          cat >&2 <<'USAGE'
contract tail <id> [--since-start]

Follow the contract's mid-flight stdout — ~/.contracts/streams/<id>/stdout.log
in real time. The stream convention is the OUTPUT dual of receptors (inbox).

Options:
  --since-start   Dump existing content first, then follow new lines.
                  Default: only follow new lines (tail -f).
USAGE
          exit 0
          ;;
        *) [ -z "$ID" ] && ID="$1"; shift ;;
      esac
    done
    if [ -z "$ID" ]; then
      echo "Usage: contract tail <id> [--since-start]" >&2
      exit 2
    fi
    STREAM_DIR="$HOME/.contracts/streams/$ID"
    LOG="$STREAM_DIR/stdout.log"
    if [ ! -f "$LOG" ]; then
      echo "no stream file yet at: $LOG" >&2
      echo "the contract's action writes here when it opts into the streams convention." >&2
      echo "see: contract tail --help" >&2
      exit 1
    fi
    if [ -n "$SINCE_START" ]; then
      exec tail -n +1 -f "$LOG"
    else
      exec tail -f "$LOG"
    fi
    ;;

  mail)
    # contract mail <canonical> [--last N] [--since <ISO>] [--related <text>]
    #
    # Σ7 — per-user append-only context queue reader. Reads
    # ~/.contracts/inbox/mail/<canonical>.jsonl (auto-populated by
    # ~/.contracts/hooks/mail-write.py on every iterate/_mark event with an
    # agent field). Designed for stateless bootstrap: pass the block to any new
    # /contract invocation so the new instance reconstructs the user's chain.
    CANONICAL="${1:-}"; shift || true
    LAST_N=""
    SINCE_ISO=""
    RELATED=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --last)    LAST_N="${2:-}"; shift 2 ;;
        --since)   SINCE_ISO="${2:-}"; shift 2 ;;
        --related) RELATED="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$CANONICAL" ] && { echo "usage: contract mail <canonical> [--last N] [--since <ISO>] [--related <text>]" >&2; exit 2; }
    MH_CANON="$CANONICAL" MH_LAST="$LAST_N" MH_SINCE="$SINCE_ISO" MH_RELATED="$RELATED" _py_inline "
import os, re, json
from pathlib import Path
try:
    from contract_core import resolve_identity
except Exception:
    resolve_identity = lambda s: s

canon = os.environ['MH_CANON']
resolved = resolve_identity(canon) or canon
safe = re.sub(r'[^A-Za-z0-9_.@-]', '_', resolved)
mail_file = Path.home() / '.contracts' / 'inbox' / 'mail' / f'{safe}.jsonl'

if not mail_file.exists():
    print(f'=====MAIL CONTEXT===== ({resolved})')
    print(f'  no mail for this identity yet (canonical-resolved from {canon!r})')
    print(f'  (mail populates as ledger events with agent={resolved!r} fire; verify Sigma1 attribution is set)')
    raise SystemExit(0)

rows = []
for line in mail_file.read_text().splitlines():
    if not line.strip(): continue
    try: rows.append(json.loads(line))
    except: continue

since = os.environ.get('MH_SINCE') or ''
if since:
    rows = [r for r in rows if (r.get('ts') or '') >= since]
related = os.environ.get('MH_RELATED') or ''
if related:
    rel_low = related.lower()
    rows = [r for r in rows if rel_low in (r.get('plan') or '').lower()]

last_n_str = os.environ.get('MH_LAST') or ''
if last_n_str:
    try:
        n = int(last_n_str)
        rows = rows[-n:]
    except ValueError:
        pass

print(f'=====MAIL CONTEXT===== ({resolved})')
print(f'  source: {mail_file}')
filters_note = (f'  (since {since})' if since else '') + (f'  (related to: {related!r})' if related else '')
print(f'  events: {len(rows)}{filters_note}')
print()
if not rows:
    print('  (no events match the filters)')
    raise SystemExit(0)

for r in rows:
    kind = r.get('kind', '?')
    ts = r.get('ts', '')
    cid = r.get('contract_id', '????????')
    status = r.get('status') or '-'
    plan = (r.get('plan') or '')[:140]
    print(f'  [{ts}] {kind:6} {cid[:8]} [{status:9}] {plan}')
    if r.get('proof'):
        print(f'    proof: {r[\"proof\"][:200]}')
    elif r.get('proof_skip_reason'):
        print(f'    proof-skip: {r[\"proof_skip_reason\"][:200]}')
print()
print(f'  bootstrap hint: any new /contract invocation by {resolved} can read this with')
print(f'    contract mail {resolved} --last 20    # full chain context')
"
    ;;

  listen)
    # contract listen <plan> --inbox <channel> [--filter <regex>] [--field <f> --equals <v>] [--timeout <s>] [--parent <id>]
    #
    # Pi5 — the conversation primitive. Declare a receptor contract whose
    # plan is prefixed `LISTEN[<channel>:<filter>]:` so the rearm-receptor
    # hook auto-spawns a successor on satisfy. Input -> output -> next-ear.
    #
    # The substrate handles the channel-continuation mechanically: agent
    # iterates -> wait-for-event matches a row -> agent reads + does work
    # + marks satisfied -> hook declares a FRESH receptor with --since-id
    # advanced past the inbox's current max -> next event auto-iterates
    # the new receptor, and so on. Telethon DMs, group messages, webhooks,
    # stripe events all use this single primitive.
    LP_INBOX=""
    LP_FIELD=""
    LP_EQUALS=""
    LP_FILTER=""
    LP_TIMEOUT="604800"
    LP_PARENT=""
    LP_PLAN=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --inbox)   LP_INBOX="${2:-}"; shift 2 ;;
        --field)   LP_FIELD="${2:-}"; shift 2 ;;
        --equals)  LP_EQUALS="${2:-}"; shift 2 ;;
        --filter)  LP_FILTER="${2:-}"; shift 2 ;;
        --timeout) LP_TIMEOUT="${2:-604800}"; shift 2 ;;
        --parent)  LP_PARENT="${2:-}"; shift 2 ;;
        --help|-h)
          cat >&2 <<'USAGE'
contract listen <plan> --inbox <channel> [--filter <regex>] [--field <f> --equals <v>] [--timeout <s>] [--parent <id>]

Declare a self-replicating receptor on a channel. On satisfy, an internal
hook (rearm-receptor) auto-spawns the next receptor with --since-id
advanced past the inbox's current max id. The conversation continues
forever without manual re-declaration.

Examples:
  contract listen "respond to Cayden" --inbox telegram --field chat_id --equals 1313681228
  contract listen "watch for redirect in group" --inbox telegram --filter redirect
  contract listen "first paid customer" --inbox stripe --field type --equals checkout.session.completed
USAGE
          exit 0 ;;
        *)
          if [ -z "$LP_PLAN" ]; then LP_PLAN="$1"; else LP_PLAN="$LP_PLAN $1"; fi
          shift ;;
      esac
    done
    if [ -z "$LP_PLAN" ] || [ -z "$LP_INBOX" ]; then
      echo "Usage: contract listen <plan> --inbox <channel> [...]" >&2
      exit 2
    fi
    # Resolve current max id in the inbox so the first receptor blocks on the NEXT event
    LP_MAX=$(LP_INBOX="$LP_INBOX" python3 -c '
import os, json, glob
from pathlib import Path
d = Path.home() / ".contracts" / "inbox" / os.environ["LP_INBOX"]
m = 0
if d.exists():
    for f in d.glob("*.jsonl"):
        try:
            with f.open() as fh:
                for ln in fh:
                    if not ln.strip(): continue
                    try: r = json.loads(ln)
                    except: continue
                    rid = r.get("id") or r.get("message_id")
                    if isinstance(rid,(int,float)) and int(rid) > m: m = int(rid)
        except: pass
print(m)
')
    # Build action
    LP_ACTION="python3 $HOME/.claude/skills/contract/scripts/wait-for-event.py --inbox $LP_INBOX --since-id $LP_MAX --timeout $LP_TIMEOUT"
    [ -n "$LP_FIELD" ]  && LP_ACTION="$LP_ACTION --field $LP_FIELD"
    [ -n "$LP_EQUALS" ] && LP_ACTION="$LP_ACTION --equals $(printf %q "$LP_EQUALS")"
    [ -n "$LP_FILTER" ] && LP_ACTION="$LP_ACTION --filter $(printf %q "$LP_FILTER")"
    LP_TAG="$LP_FILTER"
    [ -z "$LP_TAG" ] && LP_TAG="${LP_FIELD:-}=${LP_EQUALS:-}"
    [ "$LP_TAG" = "=" ] && LP_TAG="-"
    LP_FULL_PLAN="LISTEN[${LP_INBOX}:${LP_TAG}]: ${LP_PLAN}"
    # Delegate to declare
    DECLARE_CMD=("$0" declare "$LP_FULL_PLAN" --action "$LP_ACTION" --no-drive)
    [ -n "$LP_PARENT" ] && DECLARE_CMD+=("--parent" "$LP_PARENT")
    cat <<EOF
=== CONTRACT LISTEN (channel-continuation receptor) ===
  channel: $LP_INBOX
  filter:  $LP_TAG
  since:   $LP_MAX (next event > $LP_MAX wakes this contract)
  timeout: ${LP_TIMEOUT}s
  plan:    $LP_PLAN

On satisfy, rearm-receptor auto-spawns the next ear in this channel.
EOF
    bash "${DECLARE_CMD[@]}"
    ;;

  bg)
    # contract bg <id> [--lock <path>] [--restart] -- <cmd...>
    #
    # Launch <cmd> as a detached background process that writes stdout+stderr
    # to ~/.contracts/streams/<id>/stdout.log (the substrate streams convention).
    # Returns immediately with the PID and a `contract tail <id>` hint.
    #
    # Long-running actions (pollers, watchers, trainers, observers) MUST use
    # `contract bg` instead of blocking the foreground iterate. The agent's
    # turn never waits on long-lived work; the work writes to streams; the
    # observer (agent, user, another contract) tails the log when curious.
    #
    # State files (under ~/.contracts/streams/<id>/):
    #   stdout.log   — append-only stdout+stderr from <cmd>
    #   pid          — pid + start_ts + command line of the background job
    #   lock         — optional file-lock guard (see --lock)
    #
    # --lock <path>  Refuse to start if <path> exists and names a live pid;
    #                emit a structured "=== INSTANCE ALREADY RUNNING ==="
    #                block with the holder's pid + log path + start_ts.
    #                On clean start, write <pid> to <path>; on graceful exit
    #                the action removes <path> via a substrate trap.
    # --restart      Kill any existing instance (matched by --lock or by
    #                streams/<id>/pid) before starting the new one.
    #
    # Origin: 2026-05-24 — Lewis "/contract so that we dont do shit that is
    # long running like that that could be blocking — /contract so that its
    # always converted to stdio into bg or something." The convention IS the
    # streams output port (`ff6e8908`); `bg` is the canonical launcher into it.

    BG_ID=""
    BG_LOCK=""
    BG_RESTART=""
    declare -a BG_CMD=()
    SEEN_DASHDASH=""
    while [ $# -gt 0 ]; do
      if [ -z "$SEEN_DASHDASH" ]; then
        case "$1" in
          --) SEEN_DASHDASH="1"; shift ;;
          --lock)    BG_LOCK="${2:-}"; shift 2 ;;
          --restart) BG_RESTART="1"; shift ;;
          --help|-h)
            cat >&2 <<'USAGE'
contract bg <id> [--lock <path>] [--restart] -- <cmd...>

Launch <cmd> in the background, redirect stdout+stderr to the contract's
stream file, return immediately with PID and tail-hint. Never blocks.

Options:
  --lock <path>   Refuse to start if <path> holds a live pid; emit
                  INSTANCE ALREADY RUNNING block with holder info.
  --restart       Kill any existing instance before starting fresh.

Files written (under ~/.contracts/streams/<id>/):
  stdout.log   stdout+stderr of <cmd>
  pid          pid + start_ts + command line

Observe live:  contract tail <id>
USAGE
            exit 0 ;;
          *) [ -z "$BG_ID" ] && BG_ID="$1" && shift && continue ;
             # legacy: rest-of-args is the command without explicit --
             SEEN_DASHDASH="1"; BG_CMD+=("$1"); shift ;;
        esac
      else
        BG_CMD+=("$1"); shift
      fi
    done

    if [ -z "$BG_ID" ] || [ ${#BG_CMD[@]} -eq 0 ]; then
      echo "Usage: contract bg <id> [--lock <path>] [--restart] -- <cmd...>" >&2
      exit 2
    fi

    STREAM_DIR="$HOME/.contracts/streams/$BG_ID"
    mkdir -p "$STREAM_DIR"
    LOG="$STREAM_DIR/stdout.log"
    PIDFILE="$STREAM_DIR/pid"

    # Check existing instance — by --lock and/or streams/<id>/pid
    EXISTING_PID=""
    EXISTING_VIA=""
    if [ -n "$BG_LOCK" ] && [ -f "$BG_LOCK" ]; then
      _p=$(head -1 "$BG_LOCK" 2>/dev/null | awk '{print $1}')
      if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null; then
        EXISTING_PID="$_p"; EXISTING_VIA="lock"
      fi
    fi
    if [ -z "$EXISTING_PID" ] && [ -f "$PIDFILE" ]; then
      _p=$(head -1 "$PIDFILE" 2>/dev/null | awk '{print $1}')
      if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null; then
        EXISTING_PID="$_p"; EXISTING_VIA="pidfile"
      fi
    fi

    if [ -n "$EXISTING_PID" ]; then
      if [ -n "$BG_RESTART" ]; then
        echo "  killing existing pid $EXISTING_PID (via $EXISTING_VIA) before restart" >&2
        kill "$EXISTING_PID" 2>/dev/null && sleep 1
        kill -0 "$EXISTING_PID" 2>/dev/null && kill -9 "$EXISTING_PID" 2>/dev/null
        rm -f "$BG_LOCK" 2>/dev/null
      else
        cat <<EOF
=== INSTANCE ALREADY RUNNING ===
  contract: $BG_ID
  holder pid: $EXISTING_PID
  detected via: $EXISTING_VIA
  log: $LOG
$(test -f "$PIDFILE" && echo "  start info: $(cat "$PIDFILE")")
$(test -n "$BG_LOCK" && test -f "$BG_LOCK" && echo "  lock: $BG_LOCK")

  follow live:  bash $0 tail $BG_ID
  restart:      bash $0 bg $BG_ID${BG_LOCK:+ --lock $BG_LOCK} --restart -- ${BG_CMD[*]}
  kill it:      kill $EXISTING_PID
EOF
        exit 1
      fi
    fi

    # Launch — fully detached, stdout+stderr → log, command line baked into pidfile.
    # The `_` placeholder is the script-name ($0); BG_CMD lands at $1+ so
    # `exec "$@"` runs the user's command, not the first arg as bash.
    TS=$(date -u +%FT%TZ)
    if command -v setsid >/dev/null 2>&1; then
      setsid bash -c 'exec "$@" >> "'"$LOG"'" 2>&1' _ "${BG_CMD[@]}" </dev/null &
    else
      nohup bash -c 'exec "$@" >> "'"$LOG"'" 2>&1' _ "${BG_CMD[@]}" </dev/null >/dev/null 2>&1 &
    fi
    NEW_PID=$!
    disown 2>/dev/null || true
    printf '%s %s %s\n' "$NEW_PID" "$TS" "${BG_CMD[*]}" > "$PIDFILE"
    [ -n "$BG_LOCK" ] && printf '%s\n' "$NEW_PID" > "$BG_LOCK"

    cat <<EOF
=== CONTRACT BG ===
  contract: $BG_ID
  pid: $NEW_PID
  started: $TS
  cmd: ${BG_CMD[*]}
  log: $LOG
  pidfile: $PIDFILE
$(test -n "$BG_LOCK" && echo "  lock: $BG_LOCK")

  follow live:  bash $0 tail $BG_ID
  stop:         kill $NEW_PID
EOF
    ;;

  honest)
    # contract honest — metacognition report.
    # Runs every self/* check, every audit verify.sh, the digest chain,
    # standing-gate-id resolution, and CLI verb count. Returns one
    # structured report at L3 (truth-claim level) with claim / live / delta
    # for every dimension. Substrate emits; agent judges KEY 2.
    case "${1:-}" in
      --help|-h)
        cat >&2 <<'USAGE'
contract honest

Metacognition report — claim vs live vs delta across five dimensions:
  (a) every self/* check (skill-self-test)
  (b) every audits/*/verify.sh
  (c) digest chain — README.md SKILL.md digest vs live SKILL.md
  (d) standing-gate id resolution (27125bd7, 4a055cf7, f669f09c)
  (e) verbs count — CLI surface vs docs claim

Exit 0 iff every dimension is green; exit 1 otherwise. Use this before
marking any top-level organ satisfied, and as a periodic substrate-health
check.

The verb does not invent verdicts. Each dimension reports green/red with
the load-bearing evidence; KEY 2 still belongs to the agent.
USAGE
        exit 0
        ;;
    esac
    _py_inline "
import hashlib, json, os, re, subprocess, sys
from pathlib import Path

HOME = Path.home()
SKILL = HOME / '.claude/skills/contract'
LEDGER = HOME / '.contracts/contracts.jsonl'

failures = []

def green(msg): print(f'  ✓ {msg}')
def red(dim, msg):
    print(f'  ✗ {msg}')
    failures.append(dim)

print('=== /CONTRACT HONEST (metacognition) ===')
print()

# (a) self/* checks — run skill-self-test, parse PASS/FAIL self/ lines
print('(a) self/* checks')
res = subprocess.run(['bash', str(SKILL/'scripts/skill-self-test.sh')],
                     capture_output=True, text=True)
self_lines = [l for l in res.stdout.splitlines() if l.startswith(('PASS  self/','FAIL  self/'))]
self_pass = sum(1 for l in self_lines if l.startswith('PASS'))
self_fail = sum(1 for l in self_lines if l.startswith('FAIL'))
for l in self_lines:
    name = l.split(None,1)[1]
    if l.startswith('PASS'):
        green(name)
    else:
        red('self', name)
print(f'  ── {self_pass}/{self_pass+self_fail} self-checks green')
print()

# (b) audits/*/verify.sh
print('(b) audits/*/verify.sh')
audits_dir = SKILL/'audits'
audit_count = 0
audit_fail = 0
if audits_dir.exists():
    for v in sorted(audits_dir.glob('*/verify.sh')):
        rule = v.parent.name
        audit_count += 1
        r = subprocess.run(['bash', str(v)], capture_output=True, text=True)
        if r.returncode == 0:
            green(f'audits/{rule}')
        else:
            red('audits', f'audits/{rule} (exit {r.returncode})')
            audit_fail += 1
print(f'  ── {audit_count-audit_fail}/{audit_count} audits green')
print()

# (c) digest chain
print('(c) digest chain — README ↔ SKILL.md')
skill_text = (SKILL/'SKILL.md').read_text()
live_digest = hashlib.sha256(skill_text.encode()).hexdigest()
readme = (SKILL/'README.md')
if not readme.exists():
    red('digest', 'README.md missing')
else:
    m = re.search(r'SKILL\.md digest: ([a-f0-9]+)', readme.read_text())
    embedded = m.group(1) if m else None
    if not embedded:
        red('digest', 'README.md has no embedded SKILL.md digest')
    elif embedded != live_digest:
        red('digest', f'digest drift — embedded {embedded[:12]}… live {live_digest[:12]}…')
    else:
        green(f'README.md digest matches live SKILL.md ({live_digest[:12]}…)')
print()

# (d) standing-gate id resolution
print('(d) standing-gate ids')
standing = {
    '27125bd7': 'served-surface',
    '4a055cf7': 'empathy',
    'f669f09c': 'observe-original',
}
ledger_text = LEDGER.read_text() if LEDGER.exists() else ''
ledger_lines = ledger_text.splitlines()
for sid, name in standing.items():
    declared = any(f'\"id\": \"{sid}' in l and '\"event\": \"declared\"' in l for l in ledger_lines)
    if declared:
        green(f'standing-gate {sid} ({name}) resolves')
    else:
        red('standing-gate', f'standing-gate {sid} ({name}) NOT in ledger')
print()

# (e) verbs count
print('(e) CLI verbs')
self_res = subprocess.run(['bash', str(SKILL/'scripts/contract'), 'self', '--json'],
                          capture_output=True, text=True)
try:
    data = json.loads(self_res.stdout)
    live_verbs = len(data.get('verbs', []))
    green(f'live verbs: {live_verbs} (introspected from CLI)')
except Exception as e:
    red('verbs', f'contract self --json failed: {e}')
print()

# Render verdict
print('=== VERDICT ===')
if not failures:
    print('  ✓ HONEST: every dimension green')
    print('  KEY 2 (agent): is this GENUINELY satisfied, or fake-green?')
    sys.exit(0)
else:
    print(f'  ✗ DELTA: {len(failures)} dimension(s) red — {\", \".join(sorted(set(failures)))}')
    print('  KEY 2 (agent): fix each red dimension before any top-level mark satisfied.')
    sys.exit(1)
"
    ;;

  readme)
    # contract readme — regenerate README.md from SKILL.md.
    # The README is a DERIVED VIEW, never hand-edited. It extracts the
    # load-bearing sections (front-door table, 9-shape catalog, two-key
    # exit, standing-gate IDs) and embeds a SHA-256 of SKILL.md in the
    # header. self/readme-fresh fails when the embedded digest no longer
    # matches the live SKILL.md.
    case "${1:-}" in
      --help|-h)
        cat >&2 <<'USAGE'
contract readme

Regenerate ~/.claude/skills/contract/README.md from SKILL.md. The README
is a derived view (substrate enables, never prescribes) — pulls the
load-bearing sections and embeds a SKILL.md digest so drift is detectable.

Run after any edit to SKILL.md. The self/readme-fresh check fails when
the embedded digest no longer matches the live SKILL.md.
USAGE
        exit 0
        ;;
    esac
    _py_inline "
import hashlib, re, sys
from pathlib import Path

skill_path = Path.home() / '.claude/skills/contract/SKILL.md'
readme_path = Path.home() / '.claude/skills/contract/README.md'
text = skill_path.read_text()
digest = hashlib.sha256(text.encode('utf-8')).hexdigest()

def section(name):
    # extract '## <name>' (and its prose) up to the next H2 — non-greedy
    m = re.search(rf'(^## {re.escape(name)}[^\n]*\n[\s\S]*?)(?=\n## )', text, re.MULTILINE)
    return m.group(1).rstrip() if m else ''

front_door = section('When to invoke')
architecture = section('Architecture (L0-L2)')
shapes = section('The nine shapes (one data model)')
two_key = section('The two-key exit (load-bearing invariant)')

# pull the standing-gate IDs table out of Multi-dimensional gates
m = re.search(r'### Standing gate IDs[\s\S]*?\|---\|---\|---\|\n((?:\|[^\n]*\n)+)', text)
standing = m.group(0) if m else ''

readme = f'''<!-- AUTOGENERATED FROM SKILL.md — DO NOT EDIT BY HAND -->
<!-- Regenerate with: bash ~/.claude/skills/contract/scripts/contract readme -->
<!-- SKILL.md digest: {digest} -->

# /contract

\`/contract\` is the truth-claim primitive for agent-driven work. Declare what must hold,
iterate until genuinely satisfied, spawn children when sub-work emerges. One ledger row
per event; the ledger is the only memory. **SKILL.md is the canonical reference** — this
file is a derived view.

## Install

The skill lives at \`~/.claude/skills/contract/\`. First-use setup:

\`\`\`bash
# verify the CLI is on the right path and the substrate is sane
bash ~/.claude/skills/contract/scripts/contract self
bash ~/.claude/skills/contract/scripts/skill-self-test.sh
\`\`\`

If both exit 0, the substrate is live. The ledger writes to
\`~/.contracts/contracts.jsonl\` (set \`CONTRACTS_STORE\` to scope per-project).

{front_door}

{architecture}

{shapes}

{two_key}

## Standing gate IDs

Canonical pointers to standing gates other organs reference via \`--action contract:<id>\`:

{standing}

## Further reading

- **\`SKILL.md\`** — the canonical reference. Every doctrine, every default, every pattern.
- **\`scripts/skill-self-test.sh\`** — run this to verify the substrate against its own
  documentation; passes only when SKILL.md and the code agree on every claim.
- **\`contract self\`** — live introspection (no hand-written prose, no drift).
- **\`contract self --json\`** — programmatic view of the same.

## Substrate principle

Substrate enables; it does not prescribe. Scripts emit evidence only. The agent
renders every verdict in-thread. A contract that auto-satisfies is a tautology.

This README is itself derived — its truth depends on the SKILL.md digest above
matching the live SKILL.md. If they diverge, \`self/readme-fresh\` fails and the
agent regenerates this file.
'''

readme_path.write_text(readme)
print(f'wrote README.md ({len(readme)} bytes) with SKILL.md digest {digest[:12]}…')
"
    ;;

  graph)
    # contract graph <id> [--depth N] — render the gate graph centered on <id>.
    # depth=1 (default): parents one up, node, children one down with edge-type
    #   annotation, contract-ref pointers traced one hop, merged_into lineage.
    # depth>=2: also walks each child's children, each contract-ref's referent,
    #   showing the transitive DAG. Bounded at 10 for L2 readability; cycle
    #   detection via visited-set so a contract-ref loop never spins forever.
    ID=""
    DEPTH=1
    while [ $# -gt 0 ]; do
      case "$1" in
        --depth) DEPTH="${2:-1}"; shift 2 ;;
        --depth=*) DEPTH="${1#--depth=}"; shift ;;
        *) [ -z "$ID" ] && ID="$1"; shift ;;
      esac
    done
    if [ -z "$ID" ]; then
      echo "Usage: contract graph <id> [--depth N]" >&2
      exit 2
    fi
    MH_ID="$ID" MH_DEPTH="$DEPTH" _py_inline "
import os, json, re
from contract_core import get, list_all
target = os.environ['MH_ID']
try:
    depth = int(os.environ.get('MH_DEPTH', '1'))
except ValueError:
    depth = 1
depth = max(1, min(depth, 10))  # clamped 1..10
node = get(target)
if not node:
    print('  contract not found')
    raise SystemExit(0)
all_rows = list_all(show_merged=True)
by_id = {r['id']: r for r in all_rows}

def short_plan(r, n=56):
    p = (r.get('plan') or '')[:n]
    return p + ('…' if len(r.get('plan','')) > n else '')

def status_of(r):
    return r.get('status', '?')

def kid_action_kind(a):
    a = a or ''
    if a.startswith('contract:'):
        return 'contract-ref'
    if a in ('funnel', 'children-satisfy'): return 'funnel'
    if a == 'funnel-first': return 'funnel-first'
    if a == 'sequence': return 'sequence'
    if a.startswith('quorum:'): return 'quorum'
    if a == 'agent-judges': return 'judgment'
    if a.startswith('loop-until:') or a == 'loop': return 'loop'
    if a.startswith('harness:'): return 'harness'
    if a.startswith('tool-guard:'): return 'tool-guard'
    return 'cell'

# parents (still one hop — upward chain isn't load-bearing for gate visibility)
parent_id = node.get('parent_id')
print('[parents]')
if parent_id and parent_id in by_id:
    p = by_id[parent_id]
    print(f'  ← {p[\"id\"][:8]}  \"{short_plan(p)}\"  [{status_of(p)}]')
else:
    print('  (none — root)')

# node itself
print('[node]')
print(f'  ● {node[\"id\"][:8]}  \"{short_plan(node)}\"  [{status_of(node)}]')
action = (node.get('action') or '')
print(f'    action: {action[:80]}')

# children — transitive walk to MH_DEPTH
print(f'[children · depth={depth}]')
visited = {target}

def walk(node_id, level, prefix):
    if level > depth:
        return
    children = [r for r in all_rows if r.get('parent_id') == node_id]
    a_node = (by_id.get(node_id) or {}).get('action') or ''
    m = re.match(r'^contract:([a-f0-9]+)', a_node)
    ref_target = m.group(1) if m else None

    # Render children of this node
    for c in children:
        a = (c.get('action') or '')
        kind = kid_action_kind(a)
        sid = c['id'][:8]
        mref = re.match(r'^contract:([a-f0-9]+)', a)
        ref_id = mref.group(1) if mref else None
        ref_tag = f' → {ref_id[:8]}' if ref_id else ''
        marker = '├' if level == 1 else '│ ' * (level - 1) + '├'
        print(f'{prefix}{marker} [{kind}{ref_tag}] {sid}  \"{short_plan(c, 40)}\"  [{status_of(c)}]')
        if c['id'] in visited:
            print(f'{prefix}{\"│ \" * level}└ (already visited; cycle short-circuit)')
            continue
        visited.add(c['id'])
        # Recurse into THIS child's children
        if level < depth:
            walk(c['id'], level + 1, prefix)
        # Also follow contract-ref edges from this child
        if ref_id and ref_id not in visited and level < depth:
            ref_row = by_id.get(ref_id)
            if ref_row:
                print(f'{prefix}{\"│ \" * level}└─→ ref-target [{kid_action_kind(ref_row.get(\"action\"))}] {ref_id[:8]}  \"{short_plan(ref_row, 40)}\"  [{status_of(ref_row)}]')
                visited.add(ref_id)
                if level + 1 <= depth:
                    walk(ref_id, level + 2, prefix)

if depth >= 1:
    direct_children = [r for r in all_rows if r.get('parent_id') == target]
    if not direct_children:
        print('  (no children)')
    else:
        walk(target, 1, '  ')

# inbound pointer-refs (kept at one hop — these are the parents-by-reference)
refs_to_us = [r for r in all_rows if (r.get('action') or '').startswith(f'contract:{target}')]
if refs_to_us:
    print('[inbound pointer-refs]')
    for r in refs_to_us:
        print(f'  → {r[\"id\"][:8]}  \"{short_plan(r)}\"  [{status_of(r)}]  (referrer)')

# merged_into lineage (one hop)
merged_into = node.get('merged_into')
if merged_into:
    winner = by_id.get(merged_into)
    print('[lineage]')
    if winner:
        print(f'  ⇒ merged_into {merged_into[:8]}  \"{short_plan(winner)}\"  [{status_of(winner)}]')
    else:
        print(f'  ⇒ merged_into {merged_into}  (winner not in ledger)')
"
    ;;


  store)
    _py_inline "
import os, sys
sys.path.insert(0, os.environ['CONTRACT_LIB'])
from contract_core import _resolve_ledger
p = _resolve_ledger()
src = 'env(\$CONTRACTS_STORE)' if os.environ.get('CONTRACTS_STORE') else ('project (.claude/)' if (p.parent.name == '.claude') else 'global (~/.contracts/)')

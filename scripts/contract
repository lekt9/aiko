        ;;
      setup)
        # contract aiko setup [<cwd>]
        # Programmatically binds the aiko substrate to a cwd's native surfaces.
        # Detects: native binary (graff | ~/.cargo/bin/contract | forge_contract),
        # native app (AikoNotch / Aiko.app), spawn endpoint, chat endpoint.
        # Writes one aiko_cwd_bound ledger row per cwd; re-run is idempotent
        # (existing row found → reports, no duplicate write).
        # Substrate enables: surfaces what was detected; never auto-decides
        # whether the binding is "ready". KEY 2 lives with the agent.
        AK_TARGET_CWD="${1:-$PWD}"
        if [ ! -d "$AK_TARGET_CWD" ]; then
          echo "ERROR: cwd '$AK_TARGET_CWD' does not exist" >&2; exit 2
        fi
        AK_TARGET_CWD="$(cd "$AK_TARGET_CWD" && pwd)"

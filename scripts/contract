import json, os, sys
sys.path.insert(0, os.path.join(os.environ["PR_CLI_DIR"], "lib"))
try:
    from contract_core import resolve_identity, inbox_root as _iroot
except ImportError:
    resolve_identity = lambda x: x
    _iroot = lambda: __import__('pathlib').Path(os.path.expanduser("~/.contracts/inbox"))
raw = os.environ.get("PR_TARGET", "")
req_root = str(_iroot() / "permission-request")
resolved_root = str(_iroot() / "permission-resolve")
resolved_ids = set()
if os.path.isdir(resolved_root):
    for fname in os.listdir(resolved_root):
        try:
            for line in open(os.path.join(resolved_root, fname)):
                row = json.loads(line)
                resolved_ids.add(row.get("req_id"))
        except (OSError, json.JSONDecodeError): pass
pending = []
if os.path.isdir(req_root):
    files = [os.path.join(req_root, f) for f in os.listdir(req_root)]
    if raw:
        target = resolve_identity(raw) or raw
        files = [f for f in files if os.path.basename(f) == f"{target}.jsonl"]
    for path in files:
        try:
            for line in open(path):
                row = json.loads(line)
                if row.get("req_id") not in resolved_ids:
                    pending.append(row)
        except (OSError, json.JSONDecodeError): pass
print(f"  pending permission requests: {len(pending)}")
for p in pending:
    print(f"    {p['req_id']}  target={p['target']}  action={p['action']}  requester={p.get('requester','?')}  ts={p.get('ts','?')}")
    if p.get("context"): print(f"       context: {p['context'][:120]}")

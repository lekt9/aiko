#!/usr/bin/env bash
# contract — fractal contract primitive CLI
# Meta-harness shaped; the primitive is a contract not a scaffold.
# Every contract is a funnel + feedback loop + harness.
set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CONTRACT_LIB="$SELF/lib"

# All python calls use env vars to avoid quoting hell
_py() {
  PYTHONPATH="$CONTRACT_LIB:$PYTHONPATH" python3 "$@"
}

_py_inline() {
  PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 -c "$1"
# --verbose: Ψ1 layer-purity binding

# --verbose: Ψ1 layer-purity binding — when set, L0 mechanical noise (raw exit codes,
# pointer-type internals, hashes) is shown alongside L2/L3. Default OFF so L0 is hidden.
# Origin: contract f4468b06 (gap-debt session 2026-05-23).
CONTRACT_VERBOSE=0
for _arg in "$@"; do
  case "$_arg" in
    --verbose) CONTRACT_VERBOSE=1 ;;
    --no-verbose) CONTRACT_VERBOSE=0 ;;
  esac
done
export CONTRACT_VERBOSE

}

# Internal hook system — agent-agnostic, fires from within the CLI itself.
# Hooks live at ~/.contracts/hooks/ and are plain shell scripts.
# They receive: event, contract_id, exit_code (as $1 $2 $3).
# Runs in background so they never block the primary action.
_fire_contract_hooks() {
  local event="$1" id="$2" rc="${3:-0}"
  local hook_dir="$HOME/.contracts/hooks"
  [ -d "$hook_dir" ] || return 0
  for hook in "$hook_dir"/*.sh; do
    [ -x "$hook" ] && bash "$hook" "$event" "$id" "$rc" 2>>"$hook_dir/errors.log" &
  done
  for hook in "$hook_dir"/*.py; do
    [ -x "$hook" ] && python3 "$hook" "$event" "$id" "$rc" 2>>"$hook_dir/errors.log" &
  done
}

cmd="${1:-help}"; shift || true

_run_action() {
  local action="$1" id="$2" cwd="${3:-}"
  # Bind the action to its declare-time cwd: a relative-path action declared
  # in dir A must still run in A when iterated from dir B. An empty/missing
  # cwd (rows predating the cwd field) falls back to the current directory.
  local _rundir="."
  [ -n "$cwd" ] && [ -d "$cwd" ] && _rundir="$cwd"
  local ptype
  if [ "$action" = "agent-judges" ]; then
    ptype="agent-judges"
  elif [ "$action" = "children-satisfy" ] || [ "$action" = "funnel" ]; then
    ptype="funnel"
  elif [ "$action" = "funnel-first" ]; then
    ptype="funnel-first"
  elif [[ "$action" == loop-until:* ]] || [ "$action" = "loop" ]; then
    ptype="loop"
  elif [[ "$action" == harness:* ]]; then
    ptype="harness"
  elif [[ "$action" == tool-guard:* ]]; then
    ptype="tool-guard"
  elif [ "$action" = "sequence" ]; then
    ptype="sequence"
  elif [[ "$action" == quorum:* ]]; then
    ptype="quorum"
  elif [[ "$action" == contract:* ]]; then
    ptype="contract-ref"
  elif [[ "$action" == curl\ * || "$action" == http://* || "$action" == https://* || "$action" == wget\ * ]]; then
    ptype="api"
  else
    ptype="cli"
  fi

  if [ "$action" = "agent-judges" ]; then
    echo "  pointer(agent-judges): agent-judges"
    echo "  result: AGENT-JUDGES"
    return 0
  fi

  # funnel (AND-gate): all children must satisfy
  if [ "$action" = "children-satisfy" ] || [ "$action" = "funnel" ]; then
    local ok
    ok=$(MH_CONTRACT_ID="$id" _py_inline "
import os; from contract_core import children_satisfy
print('PASS' if children_satisfy(os.environ['MH_CONTRACT_ID']) else 'FAIL')
")
    echo "  pointer(funnel): all-children-satisfy"
    echo "  result: $ok"
    [ "$ok" = "PASS" ] && return 0 || return 1
  fi

  # funnel-first (OR-gate): any child satisfies
  if [ "$action" = "funnel-first" ]; then
    local ok
    ok=$(MH_CONTRACT_ID="$id" _py_inline "
import os; from contract_core import first_child_satisfies
print('PASS' if first_child_satisfies(os.environ['MH_CONTRACT_ID']) else 'FAIL')
")
    echo "  pointer(funnel-first): any-child-satisfies"
    echo "  result: $ok"
    [ "$ok" = "PASS" ] && return 0 || return 1
  fi

  # quorum:K — the integrate-and-fire neuron: satisfied when at least K
  # children are satisfied. funnel is the K=N extreme; funnel-first is K=1.
  if [[ "$action" == quorum:* ]]; then
    local qinfo
    qinfo=$(MH_ID="$id" MH_K="${action#quorum:}" _py_inline "
import os; from contract_core import get
c = get(os.environ['MH_ID'])
kids = c['children'] if c else []
sat = sum(1 for cid in kids if (get(cid) or {}).get('status') == 'satisfied')
print(str(sat) + ' ' + str(len(kids)) + ' ' + os.environ['MH_K'])
")
    set -- $qinfo
    local qsat="$1" qn="$2" qk="$3"
    echo "  pointer(quorum): >= $qk of $qn children satisfied"
    if [ "$qsat" -ge "$qk" ]; then
      echo "  result: PASS — $qsat/$qn satisfied (threshold $qk)"
      return 0
    fi
    echo "  result: FAIL — $qsat/$qn satisfied (threshold $qk)"
    return 1
  fi

  # loop (bare): perpetual while-loop — runs until agent judges BREAK (mark satisfied)
  # Each iterate = one iteration of the loop body (agent-driven or child-driven)
  # Reference other contracts inside via: contract iterate <child-id>
  if [ "$action" = "loop" ]; then
    local wave
    wave=$(MH_ID="$id" _py_inline "
import os; from contract_core import get
c=get(os.environ['MH_ID']); print(c['wave'] if c else 0)
")
    echo "  pointer(loop): perpetual"
    echo "  wave: $wave"
    echo "  result: LOOP-RUNNING — agent judges BREAK (mark satisfied) or CONTINUE (re-iterate)"
    return 0
  fi

  # loop-until:<body-action>: command-body loop; break condition is body exiting 0
  if [[ "$action" == loop-until:* ]]; then
    local body="${action#loop-until:}"
    echo "  pointer(loop-until): $body"
    if ( cd "$_rundir" && eval "$body" ) >/tmp/contract-action-out 2>&1; then
      echo "  result: PASS — body exited 0 (agent judges BREAK or CONTINUE)"
      return 0
    else
      local rc=$?
      echo "  result: LOOP-RUNNING (exit $rc) — body not passing; re-iterate to continue"
      echo "  stderr: $(tail -3 /tmp/contract-action-out)"
      return 1
    fi
  fi


  # harness:<path>: delegate to external harness verify.sh
  if [[ "$action" == harness:* ]]; then
    local harness_dir="${action#harness:}"
    if [[ "$harness_dir" != /* ]]; then
      echo "  result: ERROR — harness path must be absolute (relative paths break under sub-agent CWD changes)"
      return 1
    fi
    local verify="$harness_dir/verify.sh"
    echo "  pointer(harness): $harness_dir"
    if [ -x "$verify" ]; then
      if bash "$verify" >/tmp/contract-action-out 2>&1; then
        echo "  result: PASS"
        return 0
      else
        echo "  result: FAIL"
        echo "  stderr: $(tail -3 /tmp/contract-action-out)"
        return 1
      fi
    else
      echo "  result: ERROR — no executable verify.sh found at $harness_dir"
      return 1
    fi
  fi

  if [[ "$action" == contract:* ]]; then
    local ref_id="${action#contract:}"
    local ref_status
    ref_status=$(MH_REF_ID="$ref_id" _py_inline "
import os; from contract_core import get
c=get(os.environ['MH_REF_ID'])
print(c['status'] if c else 'not-found')
")
    echo "  pointer(contract-ref): $action"
    echo "  referenced: $ref_id => $ref_status"
    if [ "$ref_status" = "satisfied" ]; then
      echo "  result: PASS (referenced contract satisfied)"
      return 0
    else
      echo "  result: FAIL (referenced contract status: $ref_status)"
      return 1
    fi
  fi

  # sequence: an ORDERED funnel. Satisfied when every child is satisfied
  # (same AND-gate as funnel), but iterate names the first unsatisfied child
  # in declared order as the current stage — the Genesis-days arc. Ordering
  # is surfaced, not force-blocked: the substrate points at the next stage;
  # the agent follows it.
  if [ "$action" = "sequence" ]; then
    local seqinfo
    seqinfo=$(MH_ID="$id" _py_inline "
import os; from contract_core import get
c = get(os.environ['MH_ID'])
kids = c['children'] if c else []
pending = None
allsat = bool(kids)
# A 'merged' child is a fossil whose truth claim was carried by its
# winner — equivalent to 'satisfied' for sequence-walk purposes (mirrors
# children_satisfy's {satisfied, merged} acceptance set). Without this,
# a supersession mid-sequence pins the walker on the fossil and the
# organ deadlocks at the next stage. Fixed via contract 565691ba.
RESOLVED = ('satisfied', 'merged')
for k in kids:
    kc = get(k)
    st = kc['status'] if kc else 'missing'
    if st not in RESOLVED:
        allsat = False
        if pending is None:
            pending = (k, st)
if not kids:
    print('EMPTY')
elif allsat:
    print('ALL-SATISFIED')
else:
    print('STAGE ' + pending[0] + ' ' + pending[1])
")
    echo "  pointer(sequence): ordered funnel"
    case "$seqinfo" in
      ALL-SATISFIED)
        echo "  result: PASS — every stage satisfied, in order"
        return 0 ;;
      EMPTY)
        echo "  result: FAIL — sequence has no stages yet (spawn ordered children)"
        return 1 ;;
      STAGE\ *)
        set -- $seqinfo
        echo "  result: FAIL — current stage: $2 ($3)"
        echo "  do this stage next: contract iterate $2"
        return 1 ;;
    esac
  fi

  # tool-guard:<pattern>: a standing PreToolUse guard. NOT exec'd as a shell
  # command. The contract-tool-guard.py hook enforces it on every tool call:
  # while this contract is unsatisfied, any tool matching <pattern> is blocked
  # with this contract's plan text as the reason. Mark satisfied to lift.
  if [[ "$action" == tool-guard:* ]]; then
    local guarded="${action#tool-guard:}"
    echo "  pointer(tool-guard): $guarded"
    echo "  result: GUARD-ACTIVE — PreToolUse hook blocks tools matching '$guarded' while this contract is unsatisfied"
    echo "  (lift the guard by judging KEY 2 done, then: contract _mark $id satisfied)"
    return 0
  fi
  echo "  pointer($ptype): $action"
  if ( cd "$_rundir" && eval "$action" ) >/tmp/contract-action-out 2>&1; then
    echo "  result: PASS (exit 0)"
    return 0
  else
    echo "  result: FAIL (exit $?)"
    echo "  stderr: $(tail -3 /tmp/contract-action-out)"
    return 1
  fi
}

_two_key_exit() {
  local id="$1" action_rc="$2" action="${3:-}"
  local humanlike_signals=""
  humanlike_signals=$(MH_ID="$id" _py_inline "
import os; from contract_core import humanlike_iterate_warnings
print('\\n'.join(humanlike_iterate_warnings(os.environ['MH_ID'])))
")
  if [ -n "$humanlike_signals" ]; then
    echo
    echo "=== HUMANLIKE SIGNALS ==="
    echo "$humanlike_signals" | sed 's/^/  /'
  fi
  echo
  echo "=== TWO-KEY EXIT ==="
  [ "$action_rc" -eq 0 ] && echo "  KEY 1 (machine): PASS" || echo "  KEY 1 (machine): FAIL"
  # Loop-aware wording
  if [ "$action" = "loop" ] || [[ "$action" == loop-until:* ]]; then
    echo "  KEY 2 (agent):   BREAK or CONTINUE?"
    echo
    echo "  BREAK (truth established) → run: contract _mark $id satisfied"
    echo "  CONTINUE (loop still running) → contract iterate $id"
  else
    echo "  KEY 2 (agent):   JUDGE — is this GENUINELY satisfied, or fake-green?"
    echo
    if [ "$action_rc" -eq 0 ]; then
      echo "  If genuine → run: contract _mark $id satisfied"
    else
      echo "  Fix the target, then: contract iterate $id"
    fi
  fi
  # Drive mode — when armed, the agent self-drives the whole tree in-thread.
  if [ -f "$HOME/.contracts/.drive_active" ]; then
    local organ_id
    organ_id=$(cat "$HOME/.contracts/.drive_active")
    echo
    echo "  === DRIVE ACTIVE · DO NOT YIELD THE TURN (organ: $organ_id) ==="
    if [ "$action_rc" -eq 0 ]; then
      echo "  Judge KEY 2 in-thread NOW — no user prompt. If genuine:"
      echo "    contract _mark $id satisfied   → loop auto-advances to the next leaf"
      echo "  Fake-green? fix the root cause, then: contract iterate $id"
    else
      echo "  Diagnose the failure above, fix the ROOT CAUSE in-thread, then NOW:"
      echo "    contract iterate $id"
    fi
    echo "  Keep iterating until the organ is satisfied. End the turn ONLY if blocked by:"
    echo "  missing credential · irreversible action"
    echo "  (then: contract disarm and name the blocker)."
  fi
}

case "$cmd" in
  declare)
    PLAN="${1:-}"; shift || true
    ACTION="" PARENT="" POINTERS="" NO_DRIVE="" LEARNING="" BIND_TO="" INHIBITS=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action)      ACTION="${2:-}";   shift 2 ;;
        --parent)      PARENT="${2:-}";   shift 2 ;;
        --pointer-to)  POINTERS="${POINTERS:+$POINTERS,}${2:-}"; shift 2 ;;
        --target)      shift 2 ;;
        --drive)       shift ;;
        --no-drive)    NO_DRIVE="1"; shift ;;
        --learning)    LEARNING="${2:-}"; shift 2 ;;
        --budget)      BUDGET="${2:-}"; shift 2 ;;
        --bind-to)     BIND_TO="${2:-}"; shift 2 ;;
        --inhibits)    INHIBITS="${INHIBITS:+$INHIBITS,}${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$PLAN" ]   && { echo "usage: contract declare \"<plan>\" --action \"<cmd>\" [--parent <id>] [--pointer-to <tag>] [--learning \"<why>\"]..." >&2; exit 2; }
    [ -z "$ACTION" ] && { echo "ERROR: --action is required. A contract without a check is a wish." >&2; exit 2; }
    PLAN_WARN=$(MH_PLAN="$PLAN" _py_inline "
import os; from contract_core import plan_quality_warning
print(plan_quality_warning(os.environ['MH_PLAN']))
")
    if [ -n "$PLAN_WARN" ]; then
      echo "  Α1 plan-quality: $PLAN_WARN"
    fi
    ID=$(MH_PLAN="$PLAN" MH_ACTION="$ACTION" MH_PARENT="$PARENT" MH_POINTERS="$POINTERS" MH_LEARNING="$LEARNING" MH_BUDGET="${BUDGET:-}" MH_BIND_TO="$BIND_TO" MH_INHIBITS="$INHIBITS" _py_inline "
import os; from contract_core import declare
p = os.environ.get('MH_PARENT') or None
raw = os.environ.get('MH_POINTERS', '')
pts = [t.strip() for t in raw.split(',') if t.strip()] if raw else []
lrn = os.environ.get('MH_LEARNING') or None
bdg = int(os.environ['MH_BUDGET']) if os.environ.get('MH_BUDGET') else None
bnd = os.environ.get('MH_BIND_TO') or None
raw_inh = os.environ.get('MH_INHIBITS', '')
inh = [t.strip() for t in raw_inh.split(',') if t.strip()] if raw_inh else None
print(declare(os.environ['MH_PLAN'], os.environ['MH_ACTION'], p, pts, lrn, bdg, bnd, inhibits=inh))
")
    echo "declared: $ID"
    echo "  plan:        $PLAN"
    echo "  action:      $ACTION"
    [ -n "$BIND_TO" ] && echo "  bind_to:     $BIND_TO"
    [ -n "$INHIBITS" ] && echo "  inhibits:    $INHIBITS  (this contract suppresses _mark satisfied on each, while itself satisfied)"
    PTYPE=$(MH_ACTION="$ACTION" _py_inline "
import os; from contract_core import _infer_pointer_type
print(_infer_pointer_type(os.environ['MH_ACTION']))
")
    echo "  pointer_type: $PTYPE"
    [ -n "$PARENT" ]   && echo "  parent:      $PARENT"
    [ -n "$POINTERS" ] && echo "  pointers:    $POINTERS"
    [ -n "$LEARNING" ] && echo "  learning:    $LEARNING"
    echo "  next:        contract iterate $ID"

    # ── lifecycle / natural-selection check ──
    # Surface past contracts this new one may CONTRADICT or duplicate. The
    # substrate surfaces; the agent judges the contradiction in-thread. On a
    # genuine conflict, supersede the less-fit contract — it becomes a fossil.
    _LIFECYCLE=$(PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" \
      python3 "$SELF/contract-habit-detect.py" --context "$PLAN" --exclude "$ID" 2>/dev/null)
    if [ -n "$_LIFECYCLE" ] && [[ "$_LIFECYCLE" != *"no RELATED CONTRACTS"* ]]; then
      echo
      echo "  ── lifecycle check (natural selection) ──"
      echo "  related past contracts exist. JUDGE in-thread: does this new"
      echo "  contract CONTRADICT, duplicate, or refine any of them?"
      echo "$_LIFECYCLE" | sed 's/^/  /'
      echo "  on a genuine contradiction, supersede the less-fit contract:"
      echo "    contract supersede <loser-id> $ID --reason \"<why this one wins>\""
      echo "  the superseded contract becomes a fossil — kept in the append-only"
      echo "  ledger, dropped from active list/related-contract surfacing. Never delete a row."
    fi
    # self-drive default: arm the drive loop on the top-level contract so
    # /contract converges the whole tree without a human pause. Child
    # contracts (--parent set) never arm — the organ owns the drive.
    if [ -z "$NO_DRIVE" ] && [ -z "$PARENT" ] && [ ! -f "$HOME/.contracts/.drive_active" ]; then
      bash "$0" drive "$ID"
    fi
    ;;

  iterate)
    ID="${1:-}"
    [ -z "$ID" ] && { echo "usage: contract iterate <id>" >&2; exit 2; }
    DATA=$(MH_ID="$ID" _py_inline "
import os, json; from contract_core import get
c=get(os.environ['MH_ID'])
print(json.dumps(c) if c else 'null')
")
    [ "$DATA" = "null" ] && { echo "ERROR: contract $ID not found" >&2; exit 3; }
    ACTION=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['action'])" "$DATA")
    CWD=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('cwd') or '')" "$DATA")
    WAVE=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['wave']+1)" "$DATA")
    PLAN_TEXT=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['plan'][:80])" "$DATA")
    echo "=== CONTRACT ITERATE — wave $WAVE ==="
    echo "  id:     $ID"
    echo "  plan:   $PLAN_TEXT"
    BUDGET_N=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('budget') or '')" "$DATA")
    if [ -n "$BUDGET_N" ]; then
      if [ "$WAVE" -gt "$BUDGET_N" ]; then
        echo "  budget: wave $WAVE of $BUDGET_N — OVER BUDGET (evidence; you judge: escalate, simplify, or HOLD)"
      else
        echo "  budget: wave $WAVE of $BUDGET_N"
      fi
    fi
    echo
    _run_action "$ACTION" "$ID" "$CWD"
    ACTION_RC=$?
    MH_ID="$ID" MH_WAVE="$WAVE" MH_RC="$ACTION_RC" _py_inline "
import os; from contract_core import record_iteration
record_iteration(os.environ['MH_ID'], int(os.environ['MH_WAVE']),
  int(os.environ['MH_RC']),
  'pass' if os.environ['MH_RC']=='0' else 'fail', None, [])
"
    _fire_contract_hooks "iterate" "$ID" "$ACTION_RC"
    _two_key_exit "$ID" "$ACTION_RC" "$ACTION"
    # Synaptic firing: surface corroborated contracts so related truths are re-checked
    MH_ID="$ID" _py_inline "
import os; from contract_core import get_corroborations, get
corrs = get_corroborations(os.environ['MH_ID'])
active = [c for cid in corrs for c in [get(cid)] if c and c.get('status') not in ('merged','satisfied')]
if active:
    print()
    print('--- CORROBORATED TRUTHS (synapse fired — re-check) ---')
    for c in active:
        shape = 'funnel' if (c.get('children') or c['action'] in ('children-satisfy','funnel')) else 'funnel-first' if c['action']=='funnel-first' else 'judgment' if c['action']=='agent-judges' else 'loop' if (c['action'].startswith('loop-until:') or c['action']=='loop') else 'harness' if c['action'].startswith('harness:') else 'cell'
        print(f\"  {c['id']} [{c['status']}] ({shape})  \\\"{c['plan'][:60]}\\\"\")
        print(f\"    contract iterate {c['id']}\")
"
    ;;

  spawn)
    PARENT="${1:-}"; shift || true
    PLAN="${1:-}"; shift || true
    ACTION=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action) ACTION="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$PARENT" ] || [ -z "$PLAN" ] && { echo "usage: contract spawn <parent-id> \"<plan>\" [--action \"<cmd>\"]" >&2; exit 2; }
    ACTION_DISPLAY="${ACTION:-agent-judges}"
    cat <<SPAWN

=== SPAWN REQUIRED ===
  parent:  $PARENT
  plan:    $PLAN
  action:  $ACTION_DISPLAY

The agent MUST route this sub-contract via a sub-agent or directly.
  If this is one of N independent children for the same organ,
  use: contract fan-out $PARENT to launch all N in one parallel message.

  Option A — sub-agent (recommended for isolation):
    contract solve "$PLAN" --action "$ACTION_DISPLAY" --parent $PARENT

  Option B — inline:
    contract declare "$PLAN" --action "$ACTION_DISPLAY" --parent $PARENT
    contract iterate <child-id>    (until two-key exit satisfied)

When child satisfies, parent re-verifies:
    contract iterate $PARENT

SPAWN
    ;;

  build)
    PLAN="${1:-}"; shift || true
    ACTION="" NO_DRIVE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action)   ACTION="${2:-}"; shift 2 ;;
        --drive)    shift ;;
        --no-drive) NO_DRIVE="1"; shift ;;
        *) shift ;;
      esac
    done
    [ -z "$PLAN" ] && { echo "usage: contract build \"<plan>\" [--action \"<cmd>\"] [--no-drive]" >&2; exit 2; }
    ACTION="${ACTION:-agent-judges}"
    echo "=== CONTRACT BUILD ==="
    echo "  plan:   $PLAN"
    echo "  action: $ACTION"
    echo
    echo "--- search: similar contracts (reuse before build) ---"
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 "$SELF/contract-habit-detect.py" --context "$PLAN"
    echo
    echo "--- declare + first wave ---"
    MH_PLAN="$PLAN" MH_ACTION="$ACTION" bash "$0" solve "$PLAN" --action "$ACTION" ${NO_DRIVE:+--no-drive}
    ;;

  solve)
    if [ "${1:-}" = "--continue" ]; then
      ID="${2:-}"
      [ -z "$ID" ] && { echo "usage: contract solve --continue <id>" >&2; exit 2; }
      bash "$0" iterate "$ID"
    else
      PLAN="${1:-}"; shift || true
      ACTION="" PARENT="" NO_DRIVE=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --action)   ACTION="${2:-}"; shift 2 ;;
          --parent)   PARENT="${2:-}"; shift 2 ;;
          --drive)    shift ;;
          --no-drive) NO_DRIVE="1"; shift ;;
          *) shift ;;
        esac
      done
      [ -z "$PLAN" ]   && { echo "usage: contract solve \"<plan>\" --action \"<cmd>\" [--no-drive]" >&2; exit 2; }
      [ -z "$ACTION" ] && { echo "ERROR: --action required" >&2; exit 2; }
      echo "=== SOLVE [1/2] declare ==="
      DECLARE_OUT=$(bash "$0" declare "$PLAN" --action "$ACTION" ${PARENT:+--parent "$PARENT"} ${NO_DRIVE:+--no-drive})
      echo "$DECLARE_OUT"
      # Parse ID from declare output — race-safe vs list_all()[-1] which races under parallel fan-out
      ID=$(python3 -c "
import sys
for line in sys.stdin:
    line = line.strip()
    if line.startswith('declared:'):
        print(line.split(':', 1)[1].strip())
        break
" <<< "$DECLARE_OUT")
      echo
      echo "=== SOLVE [2/2] first wave ==="
      bash "$0" iterate "$ID"
      # self-drive armed by declare; solve's tail is intentionally empty.
    fi
    ;;

  status)
    ID="${1:-}"
    if [ -z "$ID" ]; then
      bash "$0" list
    else
      MH_ID="$ID" _py_inline "
import os, json; from contract_core import get_tree
def pr(node, depth=0):
    pad='  '*depth
    shape='funnel' if (node.get('children') or node['action'] in ('children-satisfy','funnel')) else 'funnel-first' if node['action']=='funnel-first' else 'judgment' if node['action']=='agent-judges' else 'loop' if (node['action'].startswith('loop-until:') or node['action']=='loop') else 'harness' if node['action'].startswith('harness:') else 'cell'
    print(f\"{pad}[{node['status']}] {node['id']} ({shape})\")
    print(f\"{pad}  plan:   {node['plan'][:72]}\")
    print(f\"{pad}  action: {node['action'][:60]}\")
    for c in node.get('child_nodes') or []: pr(c, depth+1)
t=get_tree(os.environ['MH_ID'])
pr(t) if t else print('  contract not found')
"
    fi
    ;;

  tail)
    # contract tail <id> [--since-start] — follow ~/.contracts/streams/<id>/stdout.log
    # in real time. The substrate exposes the path convention; the action's job is
    # to write to it. See SKILL.md "Streams (the output side of receptors)".
    ID=""
    SINCE_START=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --since-start) SINCE_START="1"; shift ;;
        --help|-h)
          cat >&2 <<'USAGE'
contract tail <id> [--since-start]

Follow the contract's mid-flight stdout — ~/.contracts/streams/<id>/stdout.log
in real time. The stream convention is the OUTPUT dual of receptors (inbox).

Options:
  --since-start   Dump existing content first, then follow new lines.
                  Default: only follow new lines (tail -f).
USAGE
          exit 0
          ;;
        *) [ -z "$ID" ] && ID="$1"; shift ;;
      esac
    done
    if [ -z "$ID" ]; then
      echo "Usage: contract tail <id> [--since-start]" >&2
      exit 2
    fi
    STREAM_DIR="$HOME/.contracts/streams/$ID"
    LOG="$STREAM_DIR/stdout.log"
    if [ ! -f "$LOG" ]; then
      echo "no stream file yet at: $LOG" >&2
      echo "the contract's action writes here when it opts into the streams convention." >&2
      echo "see: contract tail --help" >&2
      exit 1
    fi
    if [ -n "$SINCE_START" ]; then
      exec tail -n +1 -f "$LOG"
    else
      exec tail -f "$LOG"
    fi
    ;;


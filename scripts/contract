            print('  [%sd] %s  %s' % (r['age_days'], r['id'], r['plan'][:60]))
            print('         last satisfied: %s' % r['satisfied_ts'])
            print('         -> contract iterate %s     # re-prove the claim still holds' % r['id'])
            print('         -> contract supersede %s <winner>  # if the claim is obsolete' % r['id'])
        print()
        print('  staleness is a documented convention, not a typed field.')
        print('  the substrate surfaces; the agent decides whether to re-iterate or supersede.')

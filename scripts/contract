    ;;

  merge|supersede)
    SRC="${1:-}"; TGT="${2:-}"; shift 2 || true
    REASON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --reason) REASON="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$SRC" ] || [ -z "$TGT" ] && { echo "usage: contract supersede <loser-id> <winner-id> [--reason \"<why>\"]   (alias: merge)" >&2; exit 2; }
    MH_SRC="$SRC" MH_TGT="$TGT" MH_REASON="$REASON" _py_inline "
import os; from contract_core import merge_into, get
src, tgt = os.environ['MH_SRC'], os.environ['MH_TGT']
reason = os.environ.get('MH_REASON', '')
cs, ct = get(src), get(tgt)
if not cs: print(f'ERROR: contract {src} not found'); exit(1)
if not ct: print(f'ERROR: contract {tgt} not found'); exit(1)
merge_into(src, tgt, reason)
print('=== CONTRACT MERGE (cell fusion) ===')
print(f'  {src}  SUPERSEDED  \"{cs[\"plan\"][:55]}\"')
print(f'  {tgt}  CANONICAL   \"{ct[\"plan\"][:55]}\"')
if reason: print(f'  reason: {reason}')
print()
print(f'  {src} is now merged. contract list hides it by default.')
print(f'  next: contract iterate {tgt}   (re-verify the canonical truth)')
"
    ;;

  promote)
    # Promote a contract from the current ledger to the GLOBAL ledger
    # (~/.contracts/contracts.jsonl) so other projects can reference it via
    # `contract:<id>`. The promoted contract carries its plan/action/status
    # forward verbatim — same id, same state. Idempotent: re-running on an
    # already-promoted contract is a no-op (still appends a 'promoted' marker
    # locally so the lineage is preserved).
    #
    # Skill-modification origin: 2026-05-23. Substrate-level contracts
    # (telegram poller, webhook receiver, reactor) declared inside a project
    # ledger were not visible to other projects' organs — `contract:<id>`
    # resolution requires the row to exist in the lookup-time ledger.
    # Promotion is the missing primitive.
    TARGET="${1:-}"; shift || true
    REASON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --reason) REASON="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$TARGET" ] && { echo "usage: contract promote <id> [--reason \"<why this belongs globally>\"]" >&2; exit 2; }
    MH_TARGET="$TARGET" MH_REASON="$REASON" _py_inline "
import json, os, pathlib, time, uuid
from contract_core import _resolve_ledger, get, _append
target = os.environ['MH_TARGET']
reason = os.environ.get('MH_REASON', '')

src_path = pathlib.Path(_resolve_ledger())
global_path = pathlib.Path.home() / '.contracts' / 'contracts.jsonl'
global_path.parent.mkdir(parents=True, exist_ok=True)
global_path.touch(exist_ok=True)

if src_path.resolve() == global_path.resolve():
    print(f'  {target} is already in the global ledger ({global_path}); promotion is a no-op')
    raise SystemExit(0)

c = get(target)
if not c:
    print(f'ERROR: contract {target} not found in current ledger ({src_path})')
    raise SystemExit(1)

# Collect every row for target id from the source ledger
src_rows = []
with src_path.open() as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        if r.get('id') == target or r.get('parent_id') == target:
            src_rows.append(r)

# Idempotency check — is the target already in global?
already = False
if global_path.stat().st_size:
    with global_path.open() as f:
        for line in f:
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            if r.get('id') == target and r.get('event') == 'declared':
                already = True
                break

if already:
    # still append the local 'promoted' marker for lineage
    _append({'event': 'promoted', 'id': target, 'promoted_to': 'global', 'reason': reason or 'idempotent re-promotion', 'ts': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())})
    print(f'  {target} already in global ledger; appended idempotent promoted marker locally')
    raise SystemExit(0)

# Append target rows verbatim to global
n_target_rows = sum(1 for r in src_rows if r.get('id') == target)
n_child_decl = sum(1 for r in src_rows if r.get('parent_id') == target and r.get('event') == 'declared')
with global_path.open('a') as f:
    for r in src_rows:
        if r.get('id') == target:
            f.write(json.dumps(r, ensure_ascii=False) + '\n')

# Append the promoted marker in source ledger
_append({'event': 'promoted', 'id': target, 'promoted_to': 'global', 'rows_copied': n_target_rows, 'reason': reason, 'ts': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())})

print('=== CONTRACT PROMOTE (scope-promotion) ===')
print(f'  {target}  \"{c[\"plan\"][:70]}\"')
print(f'  source: {src_path}')
print(f'  global: {global_path}')
print(f'  rows copied: {n_target_rows}  (children NOT auto-promoted; promote them separately if needed: {n_child_decl} candidate children)')
if reason:
    print(f'  reason: {reason}')
print()
print(f'  Other projects can now reference this via:  contract:{target}')
print(f'  next: contract status {target}     # verify state preserved')
"
    ;;

  depth)
    # Walk the multi-dimensional resolution graph centered on <id>.
    # Surfaces {depth, breadth_max, dims, cycles, paths}. Pretty by default;
    # --json for machines; --strict-cycles exits 1 if any contract:<id> cycle
    # exists (this is what _mark satisfied uses to HARD-BREAK on cycles).
    # No new shape (per 310f425f) — depth is a query verb over the existing
    # parent_id + contract-ref graph. Origin: contract fb9698f7, 2026-05-23.
    TARGET="${1:-}"; shift || true
    EXTRA=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --json|--strict-cycles) EXTRA+=("$1"); shift ;;
        *) shift ;;
      esac
    done
    [ -z "$TARGET" ] && { echo "usage: contract depth <id> [--json] [--strict-cycles]" >&2; exit 2; }
    python3 "$SELF/contract-depth.py" "$TARGET" "${EXTRA[@]+"${EXTRA[@]}"}"
    ;;

  context-of)
    # On-demand library/topic context with pluggable non-binding sources
    # (eb663e04, 2026-05-24). Forward every arg to the orchestrator —
    # the python script handles --source / --from-stdin / --cache-only /
    # --refresh / --order and exits 0 on success, 1 on context-needed,
    # 2 on usage error.
    python3 "$SELF/contract-context-of.py" "$@"
    ;;

  next-of)
    # Post-iterate "next layer" proposer with pluggable non-binding sources
    # (c1bdb2b0, 2026-05-24). Symmetric to context-of but for the question
    # "what contract should fire NEXT if <id> can't resolve yet?"
    # Sources: judge-says / child-gap / failure-pattern / search-bm25 / stdin.
    # Flags: --source <name>, --order a,b,c, --from-stdin, --auto-declare,
    # --json. --auto-declare programmatically declares the top proposal as
    # a child contract under <id>.
    python3 "$SELF/contract-next-of.py" "$@"
    ;;

  render)
    # Universal renderer dispatch (d26df94c, 2026-05-24). Pluggable
    # surfaces: stdout (default), aiko-notch, merjs, video-message,
    # tg-video, plus any new scripts/renderers/<name>.{sh,py}. Optional
    # --humanize pipes through scripts/humanize.py (Aiko-voice strip).
    # Φ1 openai-render is one specific renderer; this verb generalizes
    # the family so the same substrate stdio fans out to any surface.
    python3 "$SELF/contract-render.py" "$@"
    ;;

  context)
    # Mail-stdin doctrine companion (b2d15246, 2026-05-24): emit a JSON
    # envelope describing this contract's originating context so a chained
    # action can load it programmatically. Output is JSON to stdout — every
    # action that consumes the inbox event via stdin/CONTRACT_INBOX_EVENT
    # calls `contract context $CONTRACT_ID` to load the upstream chain.
    #
    # Envelope: {id, plan, status, action, cwd, parent_chain, origin_chain,
    # last_iterations}. parent_chain walks parent_id upward; origin_chain
    # walks `corroborate` synapses (contracts that fired in the same wave
    # — co-iteration neighbours). last_iterations returns the most-recent
    # --max-iterations rows (default 5).
    TARGET="${1:-}"; shift || true
    MAX_ITERS="5"
    LIMIT=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --max-iterations) MAX_ITERS="${2:-5}"; shift 2 ;;
        --limit) LIMIT="${2:-}"; shift 2 ;;
        --json) shift ;;
        *) shift ;;
      esac
    done
    [ -z "$TARGET" ] && { echo "usage: contract context <id|channel-id> [--max-iterations N] [--limit N]" >&2; exit 2; }
    # R8 channel-context mode (gap 91d78419): if the target resolves to a
    # channel ledger at ~/.contracts/channels/<id>/contracts.jsonl, walk that
    # ledger and return the rolling stream as JSON. Detection rule:
    #   - channel dir exists, OR
    #   - target is NOT a known contract id (get() returns None) AND looks
    #     like a channel slug (contains '-' or non-hex chars).
    # The empty case (no rows yet) is a genuine "no events yet" envelope,
    # NOT a stub (Γ1). Substrate-enables: returns rows, never decides which
    # to consume (parent's LLM judges). Locality 79c2d656: channel ledgers
    # stay scoped; explicit `contract promote` is the only path up.
    CHANNEL_DIR="$HOME/.contracts/channels/$TARGET"
    IS_CHANNEL=0
    if [ -d "$CHANNEL_DIR" ]; then
      IS_CHANNEL=1
    elif ! printf '%s' "$TARGET" | grep -qE '^[a-f0-9]{6,12}$'; then
      # Not a hex contract id — treat as channel id (create-on-miss).
      IS_CHANNEL=1
    fi
    if [ "$IS_CHANNEL" = "1" ]; then
      EFFECTIVE_LIMIT="${LIMIT:-$MAX_ITERS}"
      MH_CHANNEL="$TARGET" MH_LIMIT="$EFFECTIVE_LIMIT" MH_CHDIR="$CHANNEL_DIR" python3 -c "
import os, json, pathlib
channel = os.environ['MH_CHANNEL']
chdir = pathlib.Path(os.environ['MH_CHDIR'])
ledger = chdir / 'contracts.jsonl'
try:
    limit = int(os.environ['MH_LIMIT'])
except (ValueError, TypeError):
    limit = 5
events = []
if ledger.exists():
    for line in ledger.read_text(encoding='utf-8').splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            continue
# Chronological order is file order (append-only). Tail to last N.
tail = events[-limit:] if limit > 0 else events
out = {
    'channel': channel,
    'limit': limit,
    'events': tail,
    'count': len(tail),
}
print(json.dumps(out, indent=2))
"
      exit $?
    fi
    MH_TARGET="$TARGET" MH_MAX="$MAX_ITERS" _py_inline "
import os, json
from contract_core import get, _rows
cid = os.environ['MH_TARGET']
c = get(cid)
if not c:
    print(json.dumps({'error': 'not-found', 'id': cid})); raise SystemExit(2)
# parent_chain
chain = []
cur = c
while cur and cur.get('parent_id'):
    p = get(cur['parent_id'])
    if not p: break
    chain.append({'id': p['id'], 'plan': (p.get('plan') or '')[:120], 'status': p.get('status')})
    cur = p
# origin_chain: corroborated peers
rows = _rows()
synapses = []
for r in rows:
    if r.get('event') == 'corroborated' and cid in (r.get('ids') or []):
        for other in (r.get('ids') or []):
            if other != cid:
                o = get(other)
                if o:
                    synapses.append({'id': other, 'plan': (o.get('plan') or '')[:120], 'status': o.get('status')})
# last_iterations
iters = [r for r in rows if r.get('event') == 'iterated' and r.get('id') == cid]
max_n = int(os.environ['MH_MAX'])
last_iters = []
for r in iters[-max_n:]:
    last_iters.append({
        'wave': r.get('wave'),
        'action_exit': r.get('action_exit'),
        'action_result': r.get('action_result'),
        'ts': r.get('ts'),
    })
envelope = {
    'id': c['id'],
    'plan': c.get('plan'),
    'status': c.get('status'),
    'action': c.get('action'),
    'cwd': c.get('cwd'),
    'parent_chain': chain,
    'origin_chain': synapses,
    'last_iterations': last_iters,
}
print(json.dumps(envelope, indent=2))
"
    ;;

  retire)
    # Retire a contract without an external winner. Declares a self-anchored
    # retirement marker (pre-satisfied), then supersedes <id> with it via the
    # same `merge_into` path. The fossil row carries the reason; <id> is

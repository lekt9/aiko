ttl_until_str = resolved.get("ttl_until")
fresh = False
if ttl_until_str and not os.environ.get("ID_REFRESH"):
    try:
        ttl_until = datetime.datetime.fromisoformat(ttl_until_str.replace("Z", "+00:00"))
        if now < ttl_until:
            fresh = True
    except ValueError:
        pass
def _kind_of(h):
    if "@" in h and "." in h.split("@", 1)[1]:
        return "email"
    if h.startswith("@") or h.lower().endswith(".eth") or h.startswith("0x") or h.startswith("did:"):
        if h.startswith("@"): return "handle"
        if h.lower().endswith(".eth"): return "ens"
        if h.startswith("0x"): return "wallet"
        if h.startswith("did:"): return "did"
    return "opaque"
if fresh and not os.environ.get("ID_STUB"):
    print(f"  identity:  {canonical}")
    print(f"  resolved:  cache HIT (ttl_until={resolved.get('ttl_until')})")
    print(f"  kind:      {resolved.get('kind', '?')}")
    if resolved.get("avatar_url"):
        print(f"  avatar:    {resolved['avatar_url']}")
    if resolved.get("profile_url"):
        print(f"  profile:   {resolved['profile_url']}")
    print(f"  result:    PASS (cached, no network)")
    sys.exit(0)
# Enrich
sources = []
kind = _kind_of(canonical)
avatar_url = profile_url = None
if os.environ.get("ID_STUB"):
    try:
        stub = json.loads(open(os.environ["ID_STUB"]).read())
        kind = stub.get("kind", kind)
        avatar_url = stub.get("avatar_url")
        profile_url = stub.get("profile_url")
        sources = stub.get("sources", ["stub"])
    except (OSError, json.JSONDecodeError) as e:
        sys.stderr.write(f"identify: stub parse failed: {e}\n")
else:
    if kind == "email":
        md5 = hashlib.md5(canonical.strip().lower().encode()).hexdigest()
        avatar_url = f"https://www.gravatar.com/avatar/{md5}?d=mp"
        sources.append("gravatar")
    elif kind == "handle":
        handle = canonical.lstrip("@")
        gh_url = f"https://api.github.com/users/{handle}"
        try:
            with urllib.request.urlopen(gh_url, timeout=4) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode())
                    avatar_url = data.get("avatar_url")
                    profile_url = data.get("html_url")
                    sources.append("github")
        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError):
            pass  # silent — best-effort
new_resolved = {
    "kind": kind,
    "sources": sources,
    "ts_resolved": now_iso,
    "ttl_until": (now + datetime.timedelta(seconds=DEFAULT_TTL_SECONDS)).isoformat().replace("+00:00", "Z"),
}
if avatar_url:  new_resolved["avatar_url"] = avatar_url
if profile_url: new_resolved["profile_url"] = profile_url
existing["identity"] = canonical
existing["resolved"] = new_resolved
existing["updated_at"] = now_iso
with open(path, "w") as f:
    json.dump(existing, f, indent=2)
_append({
    "event": "identity_resolved", "id": canonical, "ts": now_iso,
    "kind": kind, "sources": sources, "from_stub": bool(os.environ.get("ID_STUB")),
})
print(f"  identity:  {canonical}" + (f"  (alias of {raw})" if raw != canonical else ""))
print(f"  resolved:  {'STUB' if os.environ.get('ID_STUB') else 'NETWORK'}")
print(f"  kind:      {kind}")
print(f"  sources:   {', '.join(sources) if sources else '(none — no resolver matched)'}")
if avatar_url:  print(f"  avatar:    {avatar_url}")
if profile_url: print(f"  profile:   {profile_url}")
print(f"  ttl_until: {new_resolved['ttl_until']}")
print(f"  result:    PASS (resolved, cached locally + audit row appended)")

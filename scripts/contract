    ;;
  permission)
    # contract permission {request|grant|deny|show}
    #
    # The "Eugene-got-stuck" fix: when a chat hits an action requiring a
    # higher role, the bot doesn't dead-end. It writes a permission_request
    # row to target's inbox + returns PERMISSION REQUESTED block; target
    # runs grant/deny which writes to permission-resolve inbox; Ψ4 watcher
    # in the bot wakes Eugene's parent contract.
    PR_SUB="${1:-}"; shift || true
    PR_CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    case "$PR_SUB" in
      request)
        PR_TARGET="${1:-}"; PR_ACTION="${2:-}"; shift 2 || true
        PR_CONTEXT=""; PR_FOR_ID=""; PR_REQUESTER=""
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --context) shift; PR_CONTEXT="${1:-}"; shift ;;
            --for-id) shift; PR_FOR_ID="${1:-}"; shift ;;
            --requester) shift; PR_REQUESTER="${1:-}"; shift ;;
            *) echo "ERROR: unknown arg '$1'" >&2; exit 2 ;;
          esac
        done
        [ -z "$PR_TARGET" ] || [ -z "$PR_ACTION" ] && { echo "usage: contract permission request <target> <action> [--context T] [--for-id C] [--requester R]" >&2; exit 2; }
        PR_TARGET="$PR_TARGET" PR_ACTION="$PR_ACTION" PR_CONTEXT="$PR_CONTEXT" \
        PR_FOR_ID="$PR_FOR_ID" PR_REQUESTER="$PR_REQUESTER" PR_CLI_DIR="$PR_CLI_DIR" \
        python3 <<'PR_REQ_PY'
import datetime, json, os, secrets, sys
sys.path.insert(0, os.path.join(os.environ["PR_CLI_DIR"], "lib"))
try:
    from contract_core import resolve_identity, current_agent, _append
except ImportError:
    resolve_identity = lambda x: x
    current_agent = lambda: ""
    _append = lambda r: None
raw_target = os.environ["PR_TARGET"]
target = resolve_identity(raw_target) or raw_target
action = os.environ["PR_ACTION"]
requester = (os.environ.get("PR_REQUESTER") or current_agent() or "anonymous").strip()
req_id = secrets.token_hex(4)
ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
try: from contract_core import inbox_path as _ipath
except ImportError: _ipath = lambda c, n: os.path.expanduser(f"~/.contracts/inbox/{c}/{n}.jsonl")
inbox = str(_ipath("permission-request", target))
os.makedirs(os.path.dirname(inbox), exist_ok=True)
row = {
    "event": "permission_request", "req_id": req_id, "target": target,
    "action": action, "context": os.environ.get("PR_CONTEXT", ""),
    "requester": requester, "for_contract": os.environ.get("PR_FOR_ID", ""), "ts": ts,
}
with open(inbox, "a") as f:
    f.write(json.dumps(row) + "\n")
_append({**row, "id": f"permission-request-{req_id}"})
print(f"")
print(f"  === PERMISSION REQUESTED ===")
print(f"  kind:        permission_request")
print(f"  target:      {target}")
print(f"  action:      {action}")
print(f"  req_id:      {req_id}")
print(f"  requester:   {requester}")
if os.environ.get("PR_CONTEXT"):
    print(f"  context:     {os.environ['PR_CONTEXT'][:200]}")
if os.environ.get("PR_FOR_ID"):
    print(f"  for_contract: {os.environ['PR_FOR_ID']}")
print(f"  inbox:       {inbox}")
print(f"  resolve:     contract permission grant {req_id}   (or: deny)")
print(f"  wait_cmd:    python3 ~/.claude/skills/contract/scripts/wait-for-event.py --inbox permission-resolve --field req_id --equals {req_id} --timeout 0")
print(f"")
print(f"  Agent (Aiko voice for Eugene): 'I asked {target} to approve {action}. I'll finish when they say yes.'")
print(f"  result: FAIL (awaiting permission grant)")
sys.exit(1)
PR_REQ_PY
        ;;
      grant|deny)

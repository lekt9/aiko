    seen = set(); verbs2 = []
    for v in verbs:
        if v not in seen and v.islower() and len(v) <= 30:
            seen.add(v); verbs2.append(v)
    manifest["verbs"] = verbs2
except Exception as e:
    manifest["verbs_error"] = str(e)
print(json.dumps(manifest, indent=2))

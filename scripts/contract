    ID="${1:-}"; shift || true
    NEW_ACTION="" REASON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action) NEW_ACTION="${2:-}"; shift 2 ;;
        --reason) REASON="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$ID" ] || [ -z "$NEW_ACTION" ] && { echo "usage: contract revise <id> --action \"<new cmd>\" [--reason \"<why>\"]" >&2; exit 2; }
    MH_ID="$ID" MH_NEW_ACTION="$NEW_ACTION" MH_REASON="$REASON" _py_inline "
import os; from contract_core import revise, get
id = os.environ['MH_ID']
new_action = os.environ['MH_NEW_ACTION']
reason = os.environ.get('MH_REASON', '')
c = get(id)

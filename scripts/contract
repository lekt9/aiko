    r = subprocess.run(["bash", str(mig)], capture_output=True, text=True, timeout=30)
    print(f"  claudemd-migration: {'OK' if r.returncode == 0 else 'NEEDS ATTENTION (see stderr)'}")
    if r.returncode != 0:
        sys.stderr.write(r.stderr[:400])

print(f"\n=== init {'DRY-RUN' if DRY else 'complete'} ===")

import os, sys, json, glob, subprocess, time
from datetime import datetime, timezone
W_DIR    = os.environ['W_DIR']
INBOX_DIR= os.environ['INBOX_DIR']
CLI_SELF = os.environ['CLI_SELF']
VERBOSE  = bool(os.environ.get('VERBOSE_TICK'))
now      = datetime.now(timezone.utc)
fired    = 0
polled   = 0
skipped  = 0
for fpath in sorted(glob.glob(W_DIR + '/*.json')):
    try:
        with open(fpath) as fh: w = json.load(fh)
    except Exception:
        continue
    cid = w['contract_id']
    interval = int(w.get('interval_s', 60))
    last_ts = w.get('last_run_ts')
    if last_ts:
        try:
            last_dt = datetime.fromisoformat(last_ts.replace('Z','+00:00'))
            elapsed = (now - last_dt).total_seconds()
        except Exception:
            elapsed = interval + 1
    else:
        elapsed = interval + 1
    if elapsed < interval:
        skipped += 1
        if VERBOSE: print(f\"  skip   {cid}  ({int(interval-elapsed)}s until next poll)\")
        continue
    polled += 1
    probe = w.get('probe')
    probe_exit = None
    if probe:
        try:
            r = subprocess.run(probe, shell=True, capture_output=True, timeout=30)
            probe_exit = r.returncode
        except Exception:
            probe_exit = 124
        if VERBOSE: print(f\"  probe  {cid}  -> exit {probe_exit}\")
    # Update state
    w['last_run_ts']     = now.strftime('%Y-%m-%dT%H:%M:%SZ')
    w['last_probe_exit'] = probe_exit
    w['attempts']        = int(w.get('attempts', 0)) + 1
    should_fire = (probe is None) or (probe_exit == 0)
    if not should_fire:
        # Persist updated state; keep watching
        with open(fpath, 'w') as fh: json.dump(w, fh, indent=2)
        continue
    # FIRE: emit inbox event + auto-iterate the contract + remove watcher
    inbox_path = INBOX_DIR + '/' + cid + '.jsonl'
    event = {
        'event': 'flipped',
        'contract_id': cid,
        'ts': w['last_run_ts'],
        'probe_exit': probe_exit,
        'attempts': w['attempts'],
    }
    with open(inbox_path, 'a') as fh:
        fh.write(json.dumps(event) + '\\n')
    # Mail-stdin doctrine (b2d15246): stage the event at
    # ~/.contracts/inbox-pending/<cid>.json so the iterate's _run_action
    # pipes it to the action's stdin AND exports CONTRACT_INBOX_EVENT.
    # _run_action removes the file after consumption (idempotent fire).
    pending_dir = os.path.expanduser('~/.contracts/inbox-pending')
    try:
        os.makedirs(pending_dir, exist_ok=True)
        with open(pending_dir + '/' + cid + '.json', 'w') as fh:
            json.dump(event, fh)
    except Exception:
        pass
    # Auto-iterate. This emits the standard two-key exit; KEY 2 still belongs
    # to the agent next session. The fire is mechanical, not a verdict.
    try:
        subprocess.run([CLI_SELF, 'iterate', cid], capture_output=True, timeout=60)
    except Exception:
        pass
    # One-shot — remove the watcher
    try: os.unlink(fpath)
    except Exception: pass
    fired += 1
    if VERBOSE: print(f\"  FIRED  {cid}  (auto-iterated, inbox event written, watcher removed)\")
print(f'=== Ψ4 WATCH TICK === polled={polled} fired={fired} skipped={skipped}')
"
        ;;

      stop)
        S_ID="${1:-}"
        [ -z "$S_ID" ] && { echo "usage: contract watch stop <id>" >&2; exit 2; }
        S_FILE="$WATCHERS_DIR/$S_ID.json"
        if [ ! -f "$S_FILE" ]; then
          echo "no watcher registered for $S_ID" >&2
          exit 1
        fi
        rm -f "$S_FILE"
        echo "watcher stopped: $S_ID"
        ;;

      help|*)
        cat <<'USAGE'
contract watch — async watcher (Ψ4)

  contract watch <id> [--probe "<cmd>"] [--interval <s>]   register a watcher
  contract watch register <id> ...                          same as above (explicit)
  contract watch list [--json]                              list registered watchers
  contract watch tick [--verbose]                           run one poll cycle
  contract watch stop <id>                                  remove a watcher

Behaviour: one-shot. When the probe PASSes (or directly if no probe),
the tick auto-iterates the contract, writes an inbox event, and removes
the watcher. The auto-iterate fires the Ω1 wavefront on any dependent.
The tick runs automatically on every iterate/_mark via internal hook.
USAGE
        ;;
    esac
    ;;

  list)

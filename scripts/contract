  synapse)
    # Hebbian (biology): \"cells that fire together wire together.\" The
    # synapse verb walks the ledger for contract pairs whose `iterated`
    # events fall within the same wave-window N times — co-firing is
    # behavioral evidence the two truths are related, distinct from the
    # text-similarity \`search\` surfaces. Surfaces candidates as
    # `corroborate` suggestions; never auto-declares (substrate principle).
    # No new shape — synapse is a query verb. Origin: contract 5fc64e98.
    WINDOW="300"   # seconds — default 5min wave window
    THRESHOLD="2"  # default: 2 co-iterations -> surface
    JSON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --window)    WINDOW="${2:-300}"; shift 2 ;;
        --threshold) THRESHOLD="${2:-2}"; shift 2 ;;
        --json)      JSON="1"; shift ;;

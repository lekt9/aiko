import os, sys
sys.path.insert(0, os.path.join(os.path.dirname('$SELF/contract-habit-detect.py')))
sys.path.insert(0, '$SELF')
from importlib import import_module
hd = import_module('contract-habit-detect') if False else None
# load detect() out of contract-habit-detect.py by file path
import importlib.util
spec = importlib.util.spec_from_file_location('hd_mod', '$SELF/contract-habit-detect.py')

import sys
task = sys.argv[1].lower()
if any(w in task for w in ('ship', 'deploy', 'build', 'test', 'verify', 'check', 'pass', 'run', 'lint', 'compile', 'install')):
    print('  cell  →  contract declare "<claim>" --action "<cmd that exits 0>"')
elif any(w in task for w in ('always', 'never', 'principle', 'rule', 'must', 'should', 'pattern', 'law', 'gate')):
    print('  judgment  →  contract declare "<claim>" --action "agent-judges"')
elif any(w in task for w in ('iterate', 'loop', 'until', 'keep', 'perpetual', 'while', 'drive', 'continuously', 'forever')):
    print('  loop  →  contract declare "<claim>" --action "loop"')
elif any(w in task for w in ('all', 'both', 'every', 'each', 'complete', 'entire', 'full', 'and')):
    print('  funnel  →  contract declare "<claim>" --action "funnel"')
elif any(w in task for w in ('any', 'either', 'or', 'first', 'whichever', 'one of')):
    print('  funnel-first  →  contract declare "<claim>" --action "funnel-first"')
else:
    print('  judgment (default)  →  contract declare "<claim>" --action "agent-judges"')
PYSHAPE

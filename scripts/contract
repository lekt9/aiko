#!/usr/bin/env bash
# contract — fractal contract primitive CLI
# Meta-harness shaped; the primitive is a contract not a scaffold.
# Every contract is a funnel + feedback loop + harness.
set -uo pipefail

# 2026-05-25 (contract 396f5327 root-cause fix): resolve symlinks so SELF
# points to the real skill dir, not the symlink dir. Prevents CONTRACT_LIB
# from resolving to /usr/local/bin/lib when CLI invoked via symlink.
SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
export CONTRACT_LIB="$SELF/lib"

# All python calls use env vars to avoid quoting hell
_py() {
  PYTHONPATH="$CONTRACT_LIB:$PYTHONPATH" python3 "$@"
}

_py_inline() {
  PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 -c "$1"
}

# Ψ1 — layer-purity helper. Echoes its args only when CONTRACT_VERBOSE=1.
# L0 lines (pointer-type internals, raw mechanical surface) are routed
# through this; L2/L3 lines (result:, KEY prompts, structured ===blocks===)
# stay always-on so the agent-UX surface is unchanged for non-verbose use.
_l0() {
  [ "${CONTRACT_VERBOSE:-0}" = "1" ] && echo "$@"
  return 0
}

# --verbose: Ψ1 layer-purity binding — when set, L0 mechanical noise (raw exit codes,
# pointer-type internals, hashes) is shown alongside L2/L3. Default OFF so L0 is hidden.
# Inherit from env if set; --verbose / --no-verbose on the command line wins.
# Origin: contract f4468b06 (gap-debt session 2026-05-23).
CONTRACT_VERBOSE="${CONTRACT_VERBOSE:-0}"
for _arg in "$@"; do
  case "$_arg" in
    --verbose) CONTRACT_VERBOSE=1 ;;
    --no-verbose) CONTRACT_VERBOSE=0 ;;
  esac
done
export CONTRACT_VERBOSE

# ── Σ21 call-lineage-as-attention (doctrine ac4bb115) ────────────────────────
# Every /contract invocation records the caller chain on iterated/satisfied
# rows so KEY 2 has attention context for "why this contract is being touched
# in this turn". Propagation:
#   CONTRACT_CALLER_CHAIN — comma-separated 8hex ids, root-toward-tail. The
#                            current invocation's id is PREPENDED (chain grows
#                            toward root: [caller, caller's-caller, ...]).
#   CONTRACT_MAX_CHAIN_DEPTH — bound, default 32.
# Cycle: if the id being acted on already appears in the chain → refuse with
# === CALL CYCLE DETECTED === block + exit 2. Surfaced via `contract status
# <id>` (walks the most recent iterated/satisfied row's caller_chain).
CONTRACT_MAX_CHAIN_DEPTH="${CONTRACT_MAX_CHAIN_DEPTH:-32}"
export CONTRACT_MAX_CHAIN_DEPTH

# _caller_chain_get — emit the current chain (comma-joined 8hex), or empty.
_caller_chain_get() {
  printf '%s' "${CONTRACT_CALLER_CHAIN:-}"
}

# _caller_chain_contains <id> — exit 0 iff id is already in the chain.
_caller_chain_contains() {
  local needle="$1"
  local chain="${CONTRACT_CALLER_CHAIN:-}"
  [ -z "$chain" ] && return 1
  case ",$chain," in
    *",$needle,"*) return 0 ;;
    *)             return 1 ;;
  esac
}

# _caller_chain_prepend <id> — echo the chain that should be exported to a
# child invocation: <id>,<existing-chain>. Respects MAX depth (trims tail).
_caller_chain_prepend() {
  local newid="$1"
  local existing="${CONTRACT_CALLER_CHAIN:-}"
  local combined
  if [ -z "$existing" ]; then
    combined="$newid"
  else
    combined="$newid,$existing"
  fi
  # Trim to CONTRACT_MAX_CHAIN_DEPTH entries.
  printf '%s' "$combined" | awk -v max="$CONTRACT_MAX_CHAIN_DEPTH" -F, '{
    out=""
    for (i=1; i<=NF && i<=max; i++) {
      out = out (i>1 ? "," : "") $i
    }
    printf "%s", out
  }'
}

# _caller_chain_emit_cycle <id> — print the structured cycle-detected block
# to stderr and return. Caller decides exit code (typically 2).
_caller_chain_emit_cycle() {
  local cyc_id="$1"
  echo "=== CALL CYCLE DETECTED ===" >&2
  echo "  contract_id:  $cyc_id" >&2
  echo "  chain:        ${CONTRACT_CALLER_CHAIN:-}" >&2
  echo "  reason:       $cyc_id already in CONTRACT_CALLER_CHAIN — would re-recurse" >&2
  echo "  remediation:  break the cycle (revise an action / supersede / spawn a non-recursive leaf)" >&2
}

# _caller_chain_check_cycle <id> — if cyc, emit block + return 1; else 0.
_caller_chain_check_cycle() {
  if _caller_chain_contains "$1"; then
    _caller_chain_emit_cycle "$1"
    return 1
  fi
  return 0
}

# Internal hook system — agent-agnostic, fires from within the CLI itself.
# Hooks live at ~/.contracts/hooks/ and are plain shell scripts.
# They receive: event, contract_id, exit_code (as $1 $2 $3).
# Runs in background so they never block the primary action.
_fire_contract_hooks() {
  local event="$1" id="$2" rc="${3:-0}"
  local hook_dir="$HOME/.contracts/hooks"
  [ -d "$hook_dir" ] || return 0
  for hook in "$hook_dir"/*.sh; do
    [ -x "$hook" ] && bash "$hook" "$event" "$id" "$rc" 2>>"$hook_dir/errors.log" &
  done
  for hook in "$hook_dir"/*.py; do
    [ -x "$hook" ] && python3 "$hook" "$event" "$id" "$rc" 2>>"$hook_dir/errors.log" &
  done
}

cmd="${1:-help}"; shift || true

_run_action() {
  local action="$1" id="$2" cwd="${3:-}"
  # Bind the action to its declare-time cwd: a relative-path action declared
  # in dir A must still run in A when iterated from dir B. An empty/missing
  # cwd (rows predating the cwd field) falls back to the current directory.
  local _rundir="."
  [ -n "$cwd" ] && [ -d "$cwd" ] && _rundir="$cwd"
  local ptype
  if [ "$action" = "agent-judges" ]; then
    ptype="agent-judges"
  elif [ "$action" = "children-satisfy" ] || [ "$action" = "funnel" ]; then
    ptype="funnel"
  elif [ "$action" = "funnel-first" ]; then
    ptype="funnel-first"
  elif [[ "$action" == loop-until:* ]] || [ "$action" = "loop" ]; then
    ptype="loop"
  elif [[ "$action" == harness:* ]]; then
    ptype="harness"
  elif [[ "$action" == tool-guard:* ]]; then
    ptype="tool-guard"
  elif [ "$action" = "sequence" ]; then
    ptype="sequence"
  elif [[ "$action" == quorum:* ]]; then
    ptype="quorum"
  elif [[ "$action" == contract:* ]]; then
    ptype="contract-ref"
  elif [[ "$action" == x402:* ]]; then
    ptype="x402"
  elif [[ "$action" == bridge:* ]]; then
    ptype="bridge"
  elif [[ "$action" == agent:* ]]; then
    ptype="agent"
  elif [[ "$action" == curl\ * || "$action" == http://* || "$action" == https://* || "$action" == wget\ * ]]; then
    ptype="api"
  else
    ptype="cli"
  fi

  # ── Π11 env-guard (doctrine 8edd53ef) ─────────────────────────────────────
  # Classify required environment from ptype:
  #   LOCAL-required → user's actual host (cli, machine, tool-guard, contract-ref reads local ledger)
  #   REMOTE-capable → needs UNBROWSE_BASE reachable (x402, api, agent, bridge)
  #   AGNOSTIC → pure-composition or in-thread judgment (agent-judges, funnel, funnel-first, sequence, quorum, loop, harness)
  # Detect current env: UNBROWSE_BASE present + reachable counts as remote-capable.
  # Soft mode by default (warn-only); CONTRACT_STRICT_ENV_GUARD=1 refuses with exit 2.
  # Bypass per-call: NO_ENV_GUARD=1 env or --no-env-guard flag (set by caller).
  if [ -z "${NO_ENV_GUARD:-}" ] && [ "${CONTRACT_ENV_GUARD:-1}" != "0" ]; then
    local _req_env _cur_env
    case "$ptype" in
      cli|machine|tool-guard|contract-ref) _req_env="LOCAL" ;;
      x402|api|agent|bridge) _req_env="REMOTE" ;;
      *) _req_env="AGNOSTIC" ;;
    esac
    if [ -n "${UNBROWSE_BASE:-}" ]; then _cur_env="REMOTE-CAPABLE"; else _cur_env="LOCAL-ONLY"; fi
    local _mismatch=""
    if [ "$_req_env" = "REMOTE" ] && [ "$_cur_env" = "LOCAL-ONLY" ]; then
      _mismatch="remote-required action in local-only env (UNBROWSE_BASE unset)"
    fi
    if [ -n "$_mismatch" ]; then
      echo "=== WRONG ENVIRONMENT ===" >&2
      echo "  contract: $id" >&2
      echo "  action:   $action" >&2
      echo "  ptype:    $ptype" >&2
      echo "  required: $_req_env" >&2
      echo "  current:  $_cur_env" >&2
      echo "  reason:   $_mismatch" >&2
      echo "  hint:     export UNBROWSE_BASE=https://beta-api.unbrowse.ai  (or run on a host where it's reachable)" >&2
      echo "  bypass:   NO_ENV_GUARD=1 contract iterate $id  (or set CONTRACT_ENV_GUARD=0)" >&2
      if [ "${CONTRACT_STRICT_ENV_GUARD:-0}" = "1" ]; then
        echo "  (strict mode: refusing to run; exit 2)" >&2
        return 2
      fi
      echo "  (soft mode: continuing — wrong-env warning logged for audit)" >&2
    fi
  fi
  # ── /Π11 env-guard ─────────────────────────────────────────────────────────

  if [ "$action" = "agent-judges" ]; then
    _l0 "  pointer(agent-judges): agent-judges"
    echo "  result: AGENT-JUDGES"
    return 0
  fi

  # funnel (AND-gate): all children must satisfy
  if [ "$action" = "children-satisfy" ] || [ "$action" = "funnel" ]; then
    local ok
    ok=$(MH_CONTRACT_ID="$id" _py_inline "
import os; from contract_core import children_satisfy
print('PASS' if children_satisfy(os.environ['MH_CONTRACT_ID']) else 'FAIL')
")
    _l0 "  pointer(funnel): all-children-satisfy"
    echo "  result: $ok"
    [ "$ok" = "PASS" ] && return 0 || return 1
  fi

  # funnel-first (OR-gate): any child satisfies
  if [ "$action" = "funnel-first" ]; then
    local ok
    ok=$(MH_CONTRACT_ID="$id" _py_inline "
import os; from contract_core import first_child_satisfies
print('PASS' if first_child_satisfies(os.environ['MH_CONTRACT_ID']) else 'FAIL')
")
    _l0 "  pointer(funnel-first): any-child-satisfies"
    echo "  result: $ok"
    [ "$ok" = "PASS" ] && return 0 || return 1
  fi

  # quorum:K — the integrate-and-fire neuron: satisfied when at least K
  # children are satisfied. funnel is the K=N extreme; funnel-first is K=1.
  if [[ "$action" == quorum:* ]]; then
    local qinfo
    qinfo=$(MH_ID="$id" MH_K="${action#quorum:}" _py_inline "
import os; from contract_core import get
c = get(os.environ['MH_ID'])
kids = c['children'] if c else []
sat = sum(1 for cid in kids if (get(cid) or {}).get('status') == 'satisfied')
print(str(sat) + ' ' + str(len(kids)) + ' ' + os.environ['MH_K'])
")
    set -- $qinfo
    local qsat="$1" qn="$2" qk="$3"
    _l0 "  pointer(quorum): >= $qk of $qn children satisfied"
    if [ "$qsat" -ge "$qk" ]; then
      echo "  result: PASS — $qsat/$qn satisfied (threshold $qk)"
      return 0
    fi
    echo "  result: FAIL — $qsat/$qn satisfied (threshold $qk)"
    return 1
  fi

  # loop (bare): perpetual while-loop — runs until agent judges BREAK (mark satisfied)
  # Each iterate = one iteration of the loop body (agent-driven or child-driven)
  # Reference other contracts inside via: contract iterate <child-id>
  if [ "$action" = "loop" ]; then
    local wave
    wave=$(MH_ID="$id" _py_inline "
import os; from contract_core import get
c=get(os.environ['MH_ID']); print(c['wave'] if c else 0)
")
    _l0 "  pointer(loop): perpetual"
    echo "  wave: $wave"
    echo "  result: LOOP-RUNNING — agent judges BREAK (mark satisfied) or CONTINUE (re-iterate)"
    return 0
  fi

  # loop-until:<body-action>: command-body loop; break condition is body exiting 0
  if [[ "$action" == loop-until:* ]]; then
    local body="${action#loop-until:}"
    _l0 "  pointer(loop-until): $body"
    if ( cd "$_rundir" && eval "$body" ) >/tmp/contract-action-out 2>&1; then
      echo "  result: PASS — body exited 0 (agent judges BREAK or CONTINUE)"
      return 0
    else
      local rc=$?
      echo "  result: LOOP-RUNNING (exit $rc) — body not passing; re-iterate to continue"
      echo "  stderr: $(tail -3 /tmp/contract-action-out)"
      return 1
    fi
  fi


  # harness:<path>: delegate to external harness verify.sh
  if [[ "$action" == harness:* ]]; then
    local harness_dir="${action#harness:}"
    if [[ "$harness_dir" != /* ]]; then
      echo "  result: ERROR — harness path must be absolute (relative paths break under sub-agent CWD changes)"
      return 1
    fi
    local verify="$harness_dir/verify.sh"
    _l0 "  pointer(harness): $harness_dir"
    if [ -x "$verify" ]; then
      if bash "$verify" >/tmp/contract-action-out 2>&1; then
        echo "  result: PASS"
        return 0
      else
        echo "  result: FAIL"
        echo "  stderr: $(tail -3 /tmp/contract-action-out)"
        return 1
      fi
    else
      echo "  result: ERROR — no executable verify.sh found at $harness_dir"
      return 1
    fi
  fi

  if [[ "$action" == contract:* ]]; then
    local ref_id="${action#contract:}"
    local ref_status
    ref_status=$(MH_REF_ID="$ref_id" _py_inline "
import os; from contract_core import get
c=get(os.environ['MH_REF_ID'])
print(c['status'] if c else 'not-found')
")
    _l0 "  pointer(contract-ref): $action"
    echo "  referenced: $ref_id => $ref_status"
    if [ "$ref_status" = "satisfied" ]; then
      echo "  result: PASS (referenced contract satisfied)"
      return 0
    else
      echo "  result: FAIL (referenced contract status: $ref_status)"
      return 1
    fi
  fi

  # Π10 — bridge pointer: action is `bridge:contract:<foreign-id>@<owner-canonical>?cost=<usdc>`.
  # Resolves a foreign contract row across owner silos. At iterate:
  #   (1) Σ17 RBAC check on the foreign contract (owner must have allowed bridging)
  #   (2) On RBAC pass: settle x402 against UNBROWSE_API_KEY for declared cost
  #   (3) On 402: emit === PAYMENT REQUIRED === (per Π1 shape)
  #   (4) On 200: read foreign contract's status + lineage as evidence
  # NEVER copies the foreign row — only references it.
  #
  # CURRENT REALITY (2026-05-25): Σ17 RBAC field is DOCTRINE-NAMED but NOT
  # YET IMPLEMENTED (gap 2b98f80f). Foreign-row lookup across owner silos is
  # also not implemented (gap 036073d8 — unbrowse-broker per Π8). Until both
  # land, every bridge: iterate is REFUSED honestly with === BRIDGE REFUSED ===
  # naming the missing dependency. Γ1 no-stubs: no fake success path.
  if [[ "$action" == bridge:* ]]; then
    # Strict parse per Π10 spec: bridge:contract:<8-hex>@<owner>?cost=<usdc>
    # Three fields are crystallized on the declared row at declare-time
    # (bridge_foreign_id / bridge_owner_canonical / bridge_cost_usdc) but
    # we re-derive here for the runtime block — the regex is the gate.
    local bridge_parts
    bridge_parts=$(MH_ACTION="$action" python3 -c "
import os, re
m = re.match(r'^bridge:contract:([0-9a-f]{8})@([^?]+)\?cost=([0-9]+(?:\.[0-9]+)?)$', os.environ['MH_ACTION'])
if not m:
    print('MALFORMED')
else:
    print(m.group(1) + '\t' + m.group(2) + '\t' + m.group(3))
")
    if [ "$bridge_parts" = "MALFORMED" ]; then
      echo "  result: ERROR — bridge: action malformed (expected bridge:contract:<8hex>@<owner>?cost=<n>, got: $action)" >&2
      return 1
    fi
    local bridge_foreign_id bridge_owner bridge_cost
    bridge_foreign_id=$(printf '%s' "$bridge_parts" | cut -f1)
    bridge_owner=$(printf '%s' "$bridge_parts" | cut -f2)
    bridge_cost=$(printf '%s' "$bridge_parts" | cut -f3)
    _l0 "  pointer(bridge): contract:$bridge_foreign_id@$bridge_owner cost=\$$bridge_cost"
    {
      echo ""
      echo "  === BRIDGE REFUSED ==="
      echo "    kind: bridge"
      echo "    foreign_id: $bridge_foreign_id"
      echo "    owner_canonical: $bridge_owner"
      echo "    cost_usdc: $bridge_cost"
      echo "    reason: Σ17 RBAC not yet implemented (depends on gap 2b98f80f); foreign-fetch depends on Π8 broker (gap 036073d8)"
      echo ""
      echo "  Substrate enables, never auto-installs. This bridge will iterate"
      echo "  successfully once both dependencies land. Until then every bridge:"
      echo "  iterate refuses honestly (Γ1 no-stubs)."
      echo ""
      echo "  result: FAIL (bridge refused — missing substrate dependencies)"
    } >&2
    # Stash structured action_meta for record_iteration to crystallize on the
    # iterated row. The wrapper in the main iterate loop reads this file when
    # writing the ledger event so consumers don't have to grep stderr.
    cat >/tmp/contract-action-meta <<EOF
{"block_kind":"bridge-refused","bridge_foreign_id":"$bridge_foreign_id","bridge_owner_canonical":"$bridge_owner","bridge_cost_usdc":"$bridge_cost","missing_deps":["2b98f80f","036073d8"]}
EOF
    return 1
  fi

  # Π1 — x402 payment-gate pointer: action is `x402:<unbrowse-endpoint>`.
  # The substrate POSTs (or GETs for *balance* URLs) to the endpoint with
  # a Bearer token resolved from UNBROWSE_API_KEY env or ~/.config/unbrowse/api-key.
  #
  # Response semantics:
  #   200 → PASS (free quota or paid balance covered the call)
  #   402 → FAIL with === PAYMENT REQUIRED === block surfacing the payment
  #         payload from the response body. Transport adapters MUST render
  #         this block: Telegram → sendInvoice (Stars / Stripe-via-tg),
  #         Web → x402 wallet (Flex facilitator), Panel → checkout button,
  #         Terminal → print pay_url + amount.
  #   401 → FAIL with sign-in hint (UNBROWSE_API_KEY missing or invalid).
  #   other → FAIL with raw status + body excerpt.
  #
  # The substrate NEVER does payment logic itself — all settlement happens
  # at unbrowse (project CLAUDE.md, unbrowse-payments-canonical rule).
  # /contract is the referrer; unbrowse is the cashier.
  if [[ "$action" == x402:* ]]; then
    local x402_url="${action#x402:}"
    local x402_token=""
    if [ -n "${UNBROWSE_API_KEY:-}" ]; then
      x402_token="$UNBROWSE_API_KEY"
    elif [ -f "$HOME/.config/unbrowse/api-key" ]; then
      x402_token=$(cat "$HOME/.config/unbrowse/api-key" 2>/dev/null | tr -d '[:space:]')
    fi
    _l0 "  pointer(payment): $x402_url"
    # /balance is GET; everything else (/debit, /grant, …) is POST.
    local x402_method="POST"
    [[ "$x402_url" == *balance* ]] && x402_method="GET"
    local x402_curl_args=( -sS -X "$x402_method" -w "\n__X402_HTTP_CODE__%{http_code}" )
    [ -n "$x402_token" ] && x402_curl_args+=( -H "Authorization: Bearer $x402_token" )
    x402_curl_args+=( -H "Content-Type: application/json" "$x402_url" )
    local x402_resp x402_code x402_body
    x402_resp=$(curl "${x402_curl_args[@]}" 2>&1)
    x402_code=$(printf '%s' "$x402_resp" | awk -F'__X402_HTTP_CODE__' '{print $2}' | tail -1)
    x402_body=$(printf '%s' "$x402_resp" | sed 's/__X402_HTTP_CODE__[0-9]*$//')
    case "$x402_code" in
      200)
        echo "  result: PASS (HTTP 200 — paid or free-tier covered)"
        echo "  body:   $(printf '%s' "$x402_body" | head -c 200)"
        return 0
        ;;
      402)
        # Π2 — autopay (chill mode). If the user opted in (CONTRACT_AUTOPAY=1
        # env or autopay config file), attempt a server-side settle at unbrowse
        # using the same API key, then retry the original call. Keys live at
        # unbrowse, not in the substrate — the substrate only orchestrates.
        local ap_enabled="0" ap_cap_usd="10" ap_reason="" ap_status="" ap_body=""
        if [ "${CONTRACT_AUTOPAY:-0}" = "1" ]; then ap_enabled="1"; fi
        if [ -f "$HOME/.config/unbrowse/autopay.json" ]; then
          ap_enabled="1"
          ap_cap_usd=$(python3 -c "import json;print(json.load(open('$HOME/.config/unbrowse/autopay.json')).get('cap_usd',10))" 2>/dev/null || echo "10")
        fi
        [ -n "${CONTRACT_AUTOPAY_CAP_USD:-}" ] && ap_cap_usd="$CONTRACT_AUTOPAY_CAP_USD"
        if [ "$ap_enabled" = "1" ] && [ -n "$x402_token" ]; then
          # Derive the unbrowse base from the original URL (preserve host)
          local ap_base ap_url
          ap_base=$(printf '%s' "$x402_url" | python3 -c "import sys, urllib.parse as u; p=u.urlparse(sys.stdin.read().strip()); print(f'{p.scheme}://{p.netloc}')")
          ap_url="${ap_base}/v1/billing/autopay/charge"
          echo "  autopay: attempting silent settle (cap=\$${ap_cap_usd}, endpoint=${ap_url})"
          local ap_payload
          ap_payload=$(python3 -c "import json,sys; print(json.dumps({'intent_body': sys.argv[1], 'cap_usd': float(sys.argv[2]), 'source':'contract-substrate'}))" "$x402_body" "$ap_cap_usd")
          local ap_resp
          ap_resp=$(curl -sS -X POST -w "\n__AP_HTTP_CODE__%{http_code}" \
            -H "Authorization: Bearer $x402_token" \
            -H "Content-Type: application/json" \
            -d "$ap_payload" \
            "$ap_url" 2>&1)
          ap_status=$(printf '%s' "$ap_resp" | awk -F'__AP_HTTP_CODE__' '{print $2}' | tail -1)
          ap_body=$(printf '%s' "$ap_resp" | sed 's/__AP_HTTP_CODE__[0-9]*$//')
          if [ "$ap_status" = "200" ]; then
            # Settled — retry the original 402 call
            local retry_resp retry_code
            retry_resp=$(curl "${x402_curl_args[@]}" 2>&1)
            retry_code=$(printf '%s' "$retry_resp" | awk -F'__X402_HTTP_CODE__' '{print $2}' | tail -1)
            if [ "$retry_code" = "200" ]; then
              echo "  result: PASS (HTTP 200 — autopay settled \$${ap_cap_usd} cap, retry succeeded)"
              echo "  autopay_body: $(printf '%s' "$ap_body" | head -c 200)"
              return 0
            else
              ap_reason="autopay charge 200 but retry returned HTTP $retry_code — falling through"
            fi
          else
            case "$ap_status" in
              404) ap_reason="autopay endpoint not yet shipped at unbrowse (HTTP 404) — falling through to manual" ;;
              403) ap_reason="autopay forbidden (HTTP 403 — likely no payment method on file) — falling through" ;;
              402) ap_reason="autopay itself returned 402 (cap exceeded or insufficient method) — falling through" ;;
              *)   ap_reason="autopay HTTP $ap_status — falling through" ;;
            esac
          fi
        fi
        echo ""
        echo "  === PAYMENT REQUIRED ==="
        echo "  upstream: $x402_url"
        echo "  status:   402"
        echo "  body:     $x402_body"
        # Plank 11 of 386497eb: surface chain_id + required_chain when the 402 body
        # names a target chain (x402 spec field 'chain' or 'network'). Lets transports
        # render a chain-switch prompt when the user's bound wallet is on a different
        # chain (e.g. wallet on Solana, payment requires Base). Best-effort jq parse;
        # silently skipped when body isn't JSON / fields absent.
        x402_chain=""
        x402_req_chain=""
        if command -v jq >/dev/null 2>&1; then
          x402_chain=$(printf '%s' "$x402_body" | jq -r '.chain // .network // .chain_id // empty' 2>/dev/null)
          x402_req_chain=$(printf '%s' "$x402_body" | jq -r '.required_chain // .target_chain // empty' 2>/dev/null)
        fi
        if [ -n "$x402_chain" ]; then
          echo "  chain_id: $x402_chain"
        fi
        if [ -n "$x402_req_chain" ] && [ "$x402_req_chain" != "$x402_chain" ]; then
          echo "  required_chain: $x402_req_chain"
          echo "  wallet_action:  user's bound wallet may be on wrong chain — transport should prompt for chain-switch before pay"
        fi
        if [ -n "$ap_reason" ]; then
          echo "  autopay_attempted: $ap_reason"
          echo "  autopay_body:      $(printf '%s' "$ap_body" | head -c 200)"
        elif [ "$ap_enabled" != "1" ]; then
          echo "  autopay_available: opt in with CONTRACT_AUTOPAY=1 or ~/.config/unbrowse/autopay.json {\"cap_usd\": N}"
        fi
        echo ""
        echo "  Render this block per transport:"
        echo "    Telegram → sendInvoice (XTR Stars or Stripe-via-Telegram) using body.pay_url + amount"
        echo "                IF chain_id+required_chain mismatch → inline keyboard 'Switch to <required_chain>' first"
        echo "    Web      → wallet payment prompt (Flex facilitator → USDC tx)"
        echo "                IF chain mismatch → wallet.switchChain(required_chain) before tx"
        echo "    Panel    → embed checkout button (unbrowse Stripe hosted page)"
        echo "    Terminal → user opens pay_url in browser, retries iterate after settle"
        echo "  result: FAIL (402 — payment required; user pays via transport, then re-iterate)"
        return 1
        ;;
      401)
        echo ""
        echo "  === SIGN-IN REQUIRED ==="
        echo "  upstream: $x402_url"
        echo "  status:   401"
        echo "  body:     $x402_body"
        echo ""
        echo "  Render this block per transport (same shape as PAYMENT REQUIRED):"
        echo "    Telegram → inline keyboard with a 'Sign in' button → magic-link URL"
        echo "    Web      → OAuth/magic-link prompt rendered in-page"
        echo "    Panel    → embedded sign-in card with Privy magic-link button"
        echo "    Terminal → user opens sign-in URL, retries iterate after auth"
        echo "  result: FAIL (HTTP 401 — sign-in needed; set UNBROWSE_API_KEY after auth, then re-iterate)"
        return 1
        ;;
      "")
        echo "  result: ERROR — no HTTP response (network? curl=$? on $x402_url)"
        echo "  raw:    $(printf '%s' "$x402_resp" | head -c 200)"
        return 1
        ;;
      *)
        echo "  result: FAIL (HTTP $x402_code)"
        echo "  body:   $(printf '%s' "$x402_body" | head -c 300)"
        return 1
        ;;
    esac
  fi

  # Σ4 — agent routing pointer: action is `agent:<identity>`.
  # The substrate compares the CURRENT iterating agent (CONTRACT_AGENT or
  # git user.email, both Σ3-canonicalized) to the routed identity. If they
  # match, the action behaves like `agent-judges` — the current agent does
  # the work and judges KEY 2 in-thread. If they don't match, the iterate
  # is REFUSED and a row is appended to ~/.contracts/inbox/agent/<identity>.jsonl
  # so the routed agent picks it up via wait-for-event.py on next poll.
  #
  # Σ4 is the dual of Σ2 (audience gates LIST visibility) — Σ4 gates ITERATE
  # routing. Composable: declare `--action agent:lewis@getfoundry.app
  # --audience private` and you get both "only lewis can iterate" + "only
  # lewis sees it in list". Σ3 aliases mean any of lewis's identities
  # (lekt8, lewistham9x@gmail) resolves to the canonical and iterates fine.
  if [[ "$action" == agent:* ]]; then
    local agent_target="${action#agent:}"
    local agent_target_canon agent_current_canon
    agent_target_canon=$(MH_T="$agent_target" _py_inline "
import os; from contract_core import resolve_identity
print(resolve_identity(os.environ['MH_T']))
")
    agent_current_canon=$(_py_inline "
from contract_core import current_agent, resolve_identity
print(resolve_identity(current_agent()))
")
    _l0 "  pointer(agent): routed to $agent_target"
    if [ -n "$agent_target_canon" ] && [ "$agent_target_canon" = "$agent_current_canon" ]; then
      echo "  current_agent matches (canonical: $agent_current_canon) — JUDGE in-thread"
      echo "  result: AGENT-JUDGES"
      return 0
    fi
    # Mismatched agent: write an inbox row so the routed agent picks it up,
    # then refuse the iterate. The substrate enables the handoff; the
    # routed agent (when they next iterate from their own CONTRACT_AGENT
    # session) is the one that actually does the work.
    mkdir -p "$HOME/.contracts/inbox/agent" 2>/dev/null
    local _inbox="$HOME/.contracts/inbox/agent/${agent_target_canon:-$agent_target}.jsonl"
    local _ts
    _ts=$(date -u +%FT%TZ)
    printf '{"event":"agent-routed","contract_id":"%s","target":"%s","target_canonical":"%s","routed_by":"%s","ts":"%s"}\n' \
      "$id" "$agent_target" "$agent_target_canon" "$agent_current_canon" "$_ts" >> "$_inbox"
    echo "  current_agent ($agent_current_canon) ≠ routed agent ($agent_target_canon)"
    echo "  inbox row appended: $_inbox"
    echo "  result: FAIL (ROUTED — wait for $agent_target_canon to iterate from their own session)"
    # Structured ROUTED block — KV-shape so openai-render.py can lift it to a
    # tool_call (`agent_routed`) for transports. The plain "result: FAIL" line
    # above stays as the L2 agent-UX line; this block carries the L3 truth-claim.
    echo "=== ROUTED ==="
    echo "  contract_id:        $id"
    echo "  target_canonical:   ${agent_target_canon:-$agent_target}"
    echo "  target_raw:         $agent_target"
    echo "  routed_by:          $agent_current_canon"
    echo "  inbox_path:         $_inbox"
    echo "  wait_cmd:           python3 ~/.claude/skills/contract/scripts/wait-for-event.py --inbox agent --field target_canonical --equals '${agent_target_canon:-$agent_target}'"
    return 1
  fi

  # Π3 — machine: pointer (machine-local binary resolution).
  # --action "machine:<name> [args...]" makes the contract portable across hosts:
  # the substrate looks up the binary at iterate time per-machine, so the same
  # row works on mac (graff at /opt/homebrew/bin/graff) and tencent
  # (graff at /home/ubuntu/.local/bin/graff) without baking an absolute path.
  #
  # Resolution order (first hit wins):
  #   1. ~/.config/contract/machine-binaries.json — explicit map
  #        {"graff": "/opt/homebrew/bin/graff", "unbrowse": "/usr/local/bin/unbrowse"}
  #   2. command -v <name> — fall back to PATH lookup
  #   3. emit === MACHINE BINARY MISSING === block with the name + checked locations
  if [[ "$action" == machine:* ]]; then
    local machine_spec="${action#machine:}"
    local machine_name machine_args
    machine_name=$(printf '%s' "$machine_spec" | awk '{print $1}')
    machine_args=$(printf '%s' "$machine_spec" | sed -E 's/^[^ ]+ ?//')
    if [ -z "$machine_name" ]; then
      echo "  result: ERROR — machine: action missing binary name (got: $action)"
      return 1
    fi
    local machine_resolved=""
    local machine_map="$HOME/.config/contract/machine-binaries.json"
    if [ -f "$machine_map" ]; then
      machine_resolved=$(MH_NAME="$machine_name" MH_MAP="$machine_map" python3 -c "
import os, json
try:
  m = json.load(open(os.environ['MH_MAP']))
  v = m.get(os.environ['MH_NAME'])
  if v and os.path.isfile(v) and os.access(v, os.X_OK):
    print(v)
except Exception:
  pass
" 2>/dev/null)
    fi
    if [ -z "$machine_resolved" ]; then
      machine_resolved=$(command -v "$machine_name" 2>/dev/null || true)
    fi
    if [ -z "$machine_resolved" ]; then
      echo ""
      echo "  === MACHINE BINARY MISSING ==="
      echo "  name:     $machine_name"
      echo "  checked:  $machine_map (map), PATH=\$PATH"
      echo "  hostname: $(hostname 2>/dev/null || echo unknown)"
      echo ""
      echo "  Fix: install $machine_name on this machine, OR add it to the map:"
      echo "    mkdir -p ~/.config/contract && echo '{\"$machine_name\":\"/path/to/$machine_name\"}' > $machine_map"
      echo "  Then re-iterate. Cross-host contracts stay portable — pin the binary path here, not in the action."
      echo "  result: FAIL (machine: binary '$machine_name' not found on $(hostname 2>/dev/null || echo this-host))"
      return 1
    fi
    _l0 "  pointer(machine): $machine_resolved $machine_args"
    if [ -n "$machine_args" ]; then
      # shellcheck disable=SC2086
      eval "$machine_resolved $machine_args"
    else
      "$machine_resolved"
    fi
    local machine_exit=$?
    if [ $machine_exit -eq 0 ]; then
      echo "  result: PASS (exit 0, host=$(hostname 2>/dev/null || echo unknown), bin=$machine_resolved)"
    else
      echo "  result: FAIL (exit $machine_exit, host=$(hostname 2>/dev/null || echo unknown), bin=$machine_resolved)"
    fi
    return $machine_exit
  fi

  # Χ6 — sandbox: pointer (turbobox remote container execution).
  # --action "sandbox:<image>:<intent>" runs the intent inside a fresh
  # turbobox container (image ∈ {alpine,python,node,dev,debian}), then
  # destroys the box. This is the load-bearing surface for Λ1 codegen
  # ("code generated on the fly, never stored") and Π3's portability claim
  # taken to its limit — the binary doesn't exist locally OR on this host;
  # it exists inside the named image.
  #
  # Today the intent is the literal exec command (no codegen).
  # Tomorrow (Χ6+Λ1 wave): the intent is a natural-language goal and Λ1
  # writes the bash that runs against the image's binaries.
  #
  # Config (env): TURBOBOX_URL (default https://sandbox.trilok.ai),
  # TURBOBOX_API_KEY (required), TURBOBOX_CPU, TURBOBOX_MEMORY.
  # On missing auth OR upstream unreachable: emits === SANDBOX UNAVAILABLE ===
  # with how-to-fix, returns FAIL — never silent-fallback-locally (would
  # break Locality 79c2d656 by smuggling host execution into a sandboxed claim).
  if [[ "$action" == sandbox:* ]]; then
    local sandbox_spec="${action#sandbox:}"
    local sandbox_image="${sandbox_spec%%:*}"
    local sandbox_intent="${sandbox_spec#*:}"
    if [ -z "$sandbox_image" ] || [ "$sandbox_image" = "$sandbox_spec" ] || [ -z "$sandbox_intent" ]; then
      echo "  result: ERROR — sandbox: action must be 'sandbox:<image>:<intent>' (got: $action)"
      return 1
    fi
    # Resolve script-relative path so the dispatch works when HOME is sandboxed
    # (verb-gates redirect HOME — must not depend on it for skill-internal scripts).
    local _cli_dir
    _cli_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    python3 "$_cli_dir/lib/sandbox_layer.py" "$sandbox_image" "$sandbox_intent"
    local sandbox_exit=$?
    return $sandbox_exit
  fi

  # bun: pointer-type — plank 7 of 386497eb (TS-native execution at L1).
  if [[ "$action" == bun:* ]]; then
    local bun_spec="${action#bun:}"
    if [ -z "$bun_spec" ]; then
      echo "  result: ERROR — bun: action needs spec (e.g. bun:run script.ts, bun:-e 'console.log(1)')"
      return 1
    fi
    local _cli_dir_bun
    _cli_dir_bun="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    python3 "$_cli_dir_bun/lib/bun_layer.py" "$bun_spec"
    return $?
  fi

  # macos-sandbox: pointer-type — OS-native isolation tier.
  if [[ "$action" == macos-sandbox:* ]]; then
    local macsb_spec="${action#macos-sandbox:}"
    local macsb_profile="${macsb_spec%%:*}"
    local macsb_cmd="${macsb_spec#*:}"
    if [ -z "$macsb_profile" ] || [ "$macsb_profile" = "$macsb_spec" ] || [ -z "$macsb_cmd" ]; then
      echo "  result: ERROR — macos-sandbox: action must be 'macos-sandbox:<profile>:<cmd>' (profiles: no-network, read-only, pure-compute, custom)"
      return 1
    fi
    local _cli_dir_msb
    _cli_dir_msb="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    python3 "$_cli_dir_msb/lib/macos_sandbox_layer.py" "$macsb_profile" "$macsb_cmd"
    return $?
  fi

  # deepwiki: + findskills: pointer-types — plank 8/9, requirement-block emitters.
  # Substrate names the requirement + payload; agent calls the MCP tool / Skill tool
  # in the next turn. Returns FAIL until the agent satisfies via mcp__deepwiki__ask_question
  # / Skill tool, then re-iterates with the result captured in a satisfied row.
  if [[ "$action" == deepwiki:* ]]; then
    local dw_spec="${action#deepwiki:}"
    local dw_repo="${dw_spec%%:*}"
    local dw_q="${dw_spec#*:}"
    if [ -z "$dw_repo" ] || [ "$dw_repo" = "$dw_spec" ] || [ -z "$dw_q" ]; then
      echo "  result: ERROR — deepwiki: action must be 'deepwiki:<owner/repo>:<question>'"
      return 1
    fi
    echo ""
    echo "  === DEEPWIKI REQUIRED ==="
    echo "  kind:        deepwiki_query"
    echo "  repo:        $dw_repo"
    echo "  question:    $dw_q"
    echo "  tool:        mcp__deepwiki__ask_question"
    echo "  args:        {repoName: \"$dw_repo\", question: \"$dw_q\"}"
    echo ""
    echo "  Agent: call mcp__deepwiki__ask_question, summarise the answer as the iterate proof, then _mark satisfied with --proof citing the answer."
    echo "  result: FAIL (awaiting deepwiki agent-side resolution)"
    return 1
  fi
  if [[ "$action" == findskills:* ]]; then
    local fs_context="${action#findskills:}"
    if [ -z "$fs_context" ]; then
      echo "  result: ERROR — findskills: action needs context (e.g. findskills:landing-page-audit)"
      return 1
    fi
    echo ""
    echo "  === FIND-SKILLS REQUIRED ==="
    echo "  kind:        skill_lookup"
    echo "  context:     $fs_context"
    echo "  tool:        Skill (or /find-skills if available)"
    echo "  hint:        invoke the Skill tool with the most-specialised skill name matching the context;"
    echo "               if none clearly fits, fall back to general-purpose Agent + named context"
    echo ""
    echo "  Agent: pick the right skill, invoke it, then _mark satisfied with --proof naming the skill used."
    echo "  result: FAIL (awaiting find-skills agent-side resolution)"
    return 1
  fi

  # runpod: pointer (alternative-backend serverless execution).
  # Plank 1 of DEFERRED-MEGA-VISION 386497eb. Same lifecycle shape as sandbox:
  # (auth → POST → result → return code), different upstream — RunPod serverless
  # /v2/<endpoint_id>/runsync. The endpoint is preconfigured by the user at
  # runpod.io/console/serverless; this pointer dispatches an intent to it.
  if [[ "$action" == runpod:* ]]; then
    local runpod_spec="${action#runpod:}"
    local runpod_endpoint="${runpod_spec%%:*}"
    local runpod_intent="${runpod_spec#*:}"
    if [ -z "$runpod_endpoint" ] || [ "$runpod_endpoint" = "$runpod_spec" ] || [ -z "$runpod_intent" ]; then
      echo "  result: ERROR — runpod: action must be 'runpod:<endpoint_id>:<intent>' (got: $action)"
      return 1
    fi
    local _cli_dir_rp
    _cli_dir_rp="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    python3 "$_cli_dir_rp/lib/runpod_layer.py" "$runpod_endpoint" "$runpod_intent"
    local runpod_exit=$?
    return $runpod_exit
  fi

  # sequence: an ORDERED funnel. Satisfied when every child is satisfied
  # (same AND-gate as funnel), but iterate names the first unsatisfied child
  # in declared order as the current stage — the Genesis-days arc. Ordering
  # is surfaced, not force-blocked: the substrate points at the next stage;
  # the agent follows it.
  if [ "$action" = "sequence" ]; then
    local seqinfo
    seqinfo=$(MH_ID="$id" _py_inline "
import os; from contract_core import get
c = get(os.environ['MH_ID'])
kids = c['children'] if c else []
pending = None
allsat = bool(kids)
# A 'merged' child is a fossil whose truth claim was carried by its
# winner — equivalent to 'satisfied' for sequence-walk purposes (mirrors
# children_satisfy's {satisfied, merged} acceptance set). Without this,
# a supersession mid-sequence pins the walker on the fossil and the
# organ deadlocks at the next stage. Fixed via contract 565691ba.
RESOLVED = ('satisfied', 'merged')
for k in kids:
    kc = get(k)
    st = kc['status'] if kc else 'missing'
    if st not in RESOLVED:
        allsat = False
        if pending is None:
            pending = (k, st)
if not kids:
    print('EMPTY')
elif allsat:
    print('ALL-SATISFIED')
else:
    print('STAGE ' + pending[0] + ' ' + pending[1])
")
    _l0 "  pointer(sequence): ordered funnel"
    case "$seqinfo" in
      ALL-SATISFIED)
        echo "  result: PASS — every stage satisfied, in order"
        return 0 ;;
      EMPTY)
        echo "  result: FAIL — sequence has no stages yet (spawn ordered children)"
        return 1 ;;
      STAGE\ *)
        set -- $seqinfo
        echo "  result: FAIL — current stage: $2 ($3)"
        echo "  do this stage next: contract iterate $2"
        return 1 ;;
    esac
  fi

  # tool-guard:<pattern>: a standing PreToolUse guard. NOT exec'd as a shell
  # command. The contract-tool-guard.py hook enforces it on every tool call:
  # while this contract is unsatisfied, any tool matching <pattern> is blocked
  # with this contract's plan text as the reason. Mark satisfied to lift.
  if [[ "$action" == tool-guard:* ]]; then
    local guarded="${action#tool-guard:}"
    _l0 "  pointer(tool-guard): $guarded"
    echo "  result: GUARD-ACTIVE — PreToolUse hook blocks tools matching '$guarded' while this contract is unsatisfied"
    echo "  (lift the guard by judging KEY 2 done, then: contract _mark $id satisfied)"
    return 0
  fi
  _l0 "  pointer($ptype): $action"
  # Inbox-event delivery (mail-stdin doctrine, contract b2d15246, 2026-05-24):
  # when an external trigger (watch-tick, receptor injector) has staged an
  # event for this contract at ~/.contracts/inbox-pending/<id>.json, pipe the
  # event JSON to the action's stdin AND export it as CONTRACT_INBOX_EVENT.
  # The action chains programmatically by reading either surface; chained
  # actions resolve the originating context via `contract context <id>`.
  # Also expose CONTRACT_ID so the action can call `contract context $CONTRACT_ID`.
  local _inbox_pending="$HOME/.contracts/inbox-pending/$id.json"
  local _rc
  # Σ21 — propagate caller chain to any sub-`contract` invocation the action
  # spawns. The child sees CONTRACT_CALLER_CHAIN=<this-id>,<prior-chain>.
  local _prior_chain="${CONTRACT_CALLER_CHAIN:-}"
  local _next_chain
  _next_chain=$(_caller_chain_prepend "$id")
  export CONTRACT_CALLER_CHAIN="$_next_chain"
  if [ -f "$_inbox_pending" ]; then
    export CONTRACT_INBOX_EVENT
    CONTRACT_INBOX_EVENT=$(cat "$_inbox_pending")
    export CONTRACT_ID="$id"
    ( cd "$_rundir" && eval "$action" ) </"$_inbox_pending" >/tmp/contract-action-out 2>&1
    _rc=$?
    rm -f "$_inbox_pending"
    unset CONTRACT_INBOX_EVENT CONTRACT_ID
  else
    export CONTRACT_ID="$id"
    ( cd "$_rundir" && eval "$action" ) >/tmp/contract-action-out 2>&1
    _rc=$?
    unset CONTRACT_ID
  fi
  # Restore (don't leak prepended chain into outer-scope verbs).
  if [ -z "$_prior_chain" ]; then
    unset CONTRACT_CALLER_CHAIN
  else
    export CONTRACT_CALLER_CHAIN="$_prior_chain"
  fi
  if [ "$_rc" -eq 0 ]; then
    echo "  result: PASS (exit 0)"
    return 0
  else
    echo "  result: FAIL (exit $_rc)"
    echo "  stderr: $(tail -3 /tmp/contract-action-out)"
    return 1
  fi
}

_two_key_exit() {
  local id="$1" action_rc="$2" action="${3:-}"
  local humanlike_signals=""
  humanlike_signals=$(MH_ID="$id" _py_inline "
import os; from contract_core import humanlike_iterate_warnings
print('\\n'.join(humanlike_iterate_warnings(os.environ['MH_ID'])))
")
  if [ -n "$humanlike_signals" ]; then
    echo
    echo "=== HUMANLIKE SIGNALS ==="
    echo "$humanlike_signals" | sed 's/^/  /'
  fi
  echo
  echo "=== TWO-KEY EXIT ==="
  [ "$action_rc" -eq 0 ] && echo "  KEY 1 (machine): PASS" || echo "  KEY 1 (machine): FAIL"
  # Loop-aware wording
  if [ "$action" = "loop" ] || [[ "$action" == loop-until:* ]]; then
    echo "  KEY 2 (agent):   BREAK or CONTINUE?"
    echo
    echo "  BREAK (truth established) → run: contract _mark $id satisfied"
    echo "  CONTINUE (loop still running) → contract iterate $id"
  else
    echo "  KEY 2 (agent):   JUDGE — is this GENUINELY satisfied, or fake-green?"
    echo
    if [ "$action_rc" -eq 0 ]; then
      echo "  If genuine → run: contract _mark $id satisfied"
    else
      echo "  Fix the target, then: contract iterate $id"
    fi
  fi
  # Drive mode — when armed, the agent self-drives the whole tree in-thread.
  if [ -f "$HOME/.contracts/.drive_active" ]; then
    local organ_id
    organ_id=$(cat "$HOME/.contracts/.drive_active")
    echo
    echo "  === DRIVE ACTIVE · DO NOT YIELD THE TURN (organ: $organ_id) ==="
    if [ "$action_rc" -eq 0 ]; then
      echo "  Judge KEY 2 in-thread NOW — no user prompt. If genuine:"
      echo "    contract _mark $id satisfied   → loop auto-advances to the next leaf"
      echo "  Fake-green? fix the root cause, then: contract iterate $id"
    else
      echo "  Diagnose the failure above, fix the ROOT CAUSE in-thread, then NOW:"
      echo "    contract iterate $id"
    fi
    echo "  Keep iterating until the organ is satisfied. End the turn ONLY if blocked by:"
    echo "  missing credential · irreversible action"
    echo "  (then: contract disarm and name the blocker)."
  fi
}

case "$cmd" in
  declare)
    PLAN="${1:-}"; shift || true
    ACTION="" PARENT="" POINTERS="" NO_DRIVE="" LEARNING="" BIND_TO="" INHIBITS="" AUDIENCE="" LAYER="" PIERCE="" INTENT="" INTENT_SKIP=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action)      ACTION="${2:-}";   shift 2 ;;
        --parent)      PARENT="${2:-}";   shift 2 ;;
        --pointer-to)  POINTERS="${POINTERS:+$POINTERS,}${2:-}"; shift 2 ;;
        --target)      shift 2 ;;
        --drive)       shift ;;
        --no-drive)    NO_DRIVE="1"; shift ;;
        --learning)    LEARNING="${2:-}"; shift 2 ;;
        --budget)      BUDGET="${2:-}"; shift 2 ;;
        --bind-to)     BIND_TO="${2:-}"; shift 2 ;;
        --inhibits)    INHIBITS="${INHIBITS:+$INHIBITS,}${2:-}"; shift 2 ;;
        --audience)    AUDIENCE="${AUDIENCE:+$AUDIENCE,}${2:-}"; shift 2 ;;
        --layer)       LAYER="${2:-}"; shift 2 ;;
        --pierce)      PIERCE="${PIERCE:+$PIERCE,}${2:-}"; shift 2 ;;
        --intent)      INTENT="${2:-}"; shift 2 ;;
        --intent-skip) INTENT_SKIP="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$PLAN" ]   && { echo "usage: contract declare \"<plan>\" --action \"<cmd>\" [--parent <id>] [--pointer-to <tag>] [--learning \"<why>\"]..." >&2; exit 2; }
    [ -z "$ACTION" ] && { echo "ERROR: --action is required. A contract without a check is a wish." >&2; exit 2; }

    # ε5 EMPATHY-DEFAULT-AUDIENCE (doctrine 74996ac4): when --audience is
    # omitted, apply CONTRACT_AGENT's preferences.default_audience as the
    # implicit tag. Explicit --audience always wins. AUDIENCE_FROM_PREF flag
    # lets the declared block surface "from preferences" so the agent sees
    # which tier got applied and why.
    AUDIENCE_FROM_PREF=""
    if [ -z "$AUDIENCE" ]; then
      AUDIENCE_FROM_PREF=$(_py_inline "
import os
from contract_core import get_default_audience
agent = os.environ.get('CONTRACT_AGENT') or ''
val = get_default_audience(agent) if agent else None
print(val or '')
")
      if [ -n "$AUDIENCE_FROM_PREF" ]; then
        AUDIENCE="$AUDIENCE_FROM_PREF"
      fi
    fi

    PLAN_WARN=$(MH_PLAN="$PLAN" _py_inline "
import os; from contract_core import plan_quality_warning
print(plan_quality_warning(os.environ['MH_PLAN']))
")
    if [ -n "$PLAN_WARN" ]; then
      echo "  Α1 plan-quality: $PLAN_WARN"
    fi
    # Π5 — cross-layer reach check. When --action is contract:<other> OR
    # --parent <other>, compare the layer delta vs the new contract's
    # inferred/explicit layer. Soft-warning by default; refusal under
    # CONTRACT_LAYER_STRICT=1 unless --pierce <target-layer> authorizes it.
    PI5_VIOLATION=$(MH_ACT="$ACTION" MH_LAYER="$LAYER" MH_PARENT="$PARENT" MH_PIERCE="$PIERCE" _py_inline "
import os
from contract_core import _infer_layer, get, layer_name
act = os.environ['MH_ACT']
my_layer = int(os.environ['MH_LAYER']) if os.environ.get('MH_LAYER') else _infer_layer(act)
pierce_raw = os.environ.get('MH_PIERCE','')
pierced = set(int(x) for x in pierce_raw.split(',') if x.strip())
violations = []
# Resolve every contract: reference in the action, plus the parent
refs = []
if act.startswith('contract:'): refs.append(act.split(':',1)[1])
parent = os.environ.get('MH_PARENT')
if parent: refs.append(parent)
for ref in refs:
    target = get(ref)
    if not target: continue
    tl = int(target.get('layer', 3))
    # Rule: a contract at layer N may reach layers N or N+1 freely
    # (cells call binaries: 2→1 OK; graph composes cells: 3→2 OK; etc.)
    delta = my_layer - tl
    if delta < -1 or delta > 1:
        if tl in pierced: continue
        violations.append(f'L{my_layer}({layer_name(my_layer)}) → L{tl}({layer_name(tl)}) via {ref}')
if violations:
    print('|'.join(violations))
")
    if [ -n "$PI5_VIOLATION" ]; then
      echo "  ⚠ Π5 cross-layer reach (soft warning by default; CONTRACT_LAYER_STRICT=1 refuses):"
      IFS='|' read -ra V_ARR <<< "$PI5_VIOLATION"
      for v in "${V_ARR[@]}"; do echo "      $v"; done
      echo "      (authorize with --pierce <target-layer>; passes silently and writes pierced_layers on the row)"
      if [ "${CONTRACT_LAYER_STRICT:-0}" = "1" ]; then
        echo "" >&2
        echo "=== LAYER VIOLATION (Π5 strict) ===" >&2
        echo "  refused: declared layer reaches across more than +/-1 without --pierce authorization" >&2
        for v in "${V_ARR[@]}"; do echo "    $v" >&2; done
        exit 2
      fi
    fi
    ID=$(MH_PLAN="$PLAN" MH_ACTION="$ACTION" MH_PARENT="$PARENT" MH_POINTERS="$POINTERS" MH_LEARNING="$LEARNING" MH_BUDGET="${BUDGET:-}" MH_BIND_TO="$BIND_TO" MH_INHIBITS="$INHIBITS" MH_AUDIENCE="$AUDIENCE" MH_LAYER="$LAYER" MH_PIERCE="$PIERCE" MH_INTENT="$INTENT" MH_INTENT_SKIP="$INTENT_SKIP" _py_inline "
import os; from contract_core import declare
p = os.environ.get('MH_PARENT') or None
raw = os.environ.get('MH_POINTERS', '')
pts = [t.strip() for t in raw.split(',') if t.strip()] if raw else []
lrn = os.environ.get('MH_LEARNING') or None
bdg = int(os.environ['MH_BUDGET']) if os.environ.get('MH_BUDGET') else None
bnd = os.environ.get('MH_BIND_TO') or None
raw_inh = os.environ.get('MH_INHIBITS', '')
inh = [t.strip() for t in raw_inh.split(',') if t.strip()] if raw_inh else None
raw_aud = os.environ.get('MH_AUDIENCE', '')
aud = [t.strip() for t in raw_aud.split(',') if t.strip()] if raw_aud else None
lay = int(os.environ['MH_LAYER']) if os.environ.get('MH_LAYER') else None
raw_pierce = os.environ.get('MH_PIERCE', '')
pierce = [int(t.strip()) for t in raw_pierce.split(',') if t.strip()] if raw_pierce else None
itn = os.environ.get('MH_INTENT') or None
itn_skip = os.environ.get('MH_INTENT_SKIP') or None
print(declare(os.environ['MH_PLAN'], os.environ['MH_ACTION'], p, pts, lrn, bdg, bnd, inhibits=inh, audience=aud, layer=lay, pierced_layers=pierce, intent=itn, intent_skip_reason=itn_skip))
")
    echo "declared: $ID"
    _fire_contract_hooks "declare" "$ID" "0"
    # Φ9 entrypoint-hints: run foreground (not via _fire_contract_hooks bus,
    # which sinks hook stderr to errors.log) so the hints reach the agent.
    # Fail-open: any non-zero exit is swallowed.
    _PHI9_HOOK="$HOME/.contracts/hooks/phi9-entrypoint-hints.sh"
    if [ -x "$_PHI9_HOOK" ]; then
      bash "$_PHI9_HOOK" "declare" "$ID" "0" || true
    fi
    echo "  plan:        $PLAN"
    echo "  action:      $ACTION"
    [ -n "$BIND_TO" ] && echo "  bind_to:     $BIND_TO"
    [ -n "$INHIBITS" ] && echo "  inhibits:    $INHIBITS  (this contract suppresses _mark satisfied on each, while itself satisfied)"
    if [ -n "$AUDIENCE" ]; then
      if [ -n "$AUDIENCE_FROM_PREF" ]; then
        echo "  audience:    $AUDIENCE  (Σ2 from preferences.default_audience — pass --audience to override)"
      else
        echo "  audience:    $AUDIENCE  (Σ2: only visible via 'contract list --for <one of these identities>' or 'public')"
      fi
    fi
    PTYPE=$(MH_ACTION="$ACTION" _py_inline "
import os; from contract_core import _infer_pointer_type
print(_infer_pointer_type(os.environ['MH_ACTION']))
")
    echo "  pointer_type: $PTYPE"
    [ -n "$PARENT" ]   && echo "  parent:      $PARENT"
    [ -n "$POINTERS" ] && echo "  pointers:    $POINTERS"
    [ -n "$LEARNING" ] && echo "  learning:    $LEARNING"
    [ -n "$INTENT" ]   && echo "  intent:      $INTENT"
    [ -n "$INTENT_SKIP" ] && echo "  intent_skip: $INTENT_SKIP"
    echo "  next:        contract iterate $ID"

    # ── META-INTENT (advisory) ──
    # Doctrine 9328a165: every contract's plan says WHAT must hold; --intent
    # says WHY (the meta-principle above the literal request). When neither
    # --intent nor --intent-skip is provided, surface a non-blocking advisory
    # so the agent has a structured prompt to name the meta-principle (or
    # explicitly skip with a reason). Mirrors the proof-binding pattern:
    # in-thread judgment crystallized to a ledger field.
    if [ -z "$INTENT" ] && [ -z "$INTENT_SKIP" ]; then
      echo ""
      echo "=== META-INTENT (advisory) ==="
      echo "  Plan text says WHAT must hold. The meta-principle above the literal"
      echo "  request is unnamed. Re-declare or amend with one of:"
      echo ""
      echo "    contract declare \"<plan>\" --action \"<cmd>\" --intent \"<one-line meta-principle the user was actually pointing at>\""
      echo "    contract declare \"<plan>\" --action \"<cmd>\" --intent-skip \"<why naming the meta-principle adds nothing here>\""
      echo ""
      echo "  Why this matters: the ledger row crystallizes intent so future search,"
      echo "  lifecycle check, and audit can see the meta-principle, not just the"
      echo "  literal text. Composes with default contract #9 (serve genuine need)."
    fi

    # ── CONTEXT ORIENTATION (advisory; doctrine 91e64e17) ──
    # Substrate detects environment + surfaces canonical context channels so the
    # agent orients BEFORE iterating. Channels are CANONICAL (always listed; no
    # plan-matching per 0e707b01). Quiet under CONTRACT_QUIET_CONTEXT=1 for
    # noisy automation paths.
    if [ "${CONTRACT_QUIET_CONTEXT:-0}" != "1" ]; then
      MH_PLAN_CO="$PLAN" _py_inline "
import os
from contract_core import emit_context_orientation
emit_context_orientation(os.environ.get('MH_PLAN_CO',''))
" 2>&1 1>&2 || true
    fi

    # ── lifecycle / natural-selection check ──
    # Surface past contracts this new one may CONTRADICT or duplicate. The
    # substrate surfaces; the agent judges the contradiction in-thread. On a
    # genuine conflict, supersede the less-fit contract — it becomes a fossil.
    _LIFECYCLE=$(PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" \
      python3 "$SELF/contract-habit-detect.py" --context "$PLAN" --exclude "$ID" 2>/dev/null)
    if [ -n "$_LIFECYCLE" ] && [[ "$_LIFECYCLE" != *"no RELATED CONTRACTS"* ]]; then
      echo
      echo "  ── lifecycle check (natural selection) ──"
      echo "  related past contracts exist. JUDGE in-thread: does this new"
      echo "  contract CONTRADICT, duplicate, or refine any of them?"
      echo "$_LIFECYCLE" | sed 's/^/  /'
      echo "  on a genuine contradiction, supersede the less-fit contract:"
      echo "    contract supersede <loser-id> $ID --reason \"<why this one wins>\""
      echo "  the superseded contract becomes a fossil — kept in the append-only"
      echo "  ledger, dropped from active list/related-contract surfacing. Never delete a row."
    fi
    # self-drive default: arm the drive loop on the top-level contract so
    # /contract converges the whole tree without a human pause. Child
    # contracts (--parent set) never arm — the organ owns the drive.
    if [ -z "$NO_DRIVE" ] && [ -z "$PARENT" ] && [ ! -f "$HOME/.contracts/.drive_active" ]; then
      bash "$0" drive "$ID"
    fi
    # 2026-05-25 (contract d3241099): /contract should always execute itself
    # upon creation. Top-level declare (no --parent) auto-iterates the first
    # wave INLINE — realizes 'declare-then-drill' (fdb8899c) at substrate
    # level instead of relying on agent KEY 2 to reach for drill. Drive arm
    # above + Stop-hook re-fire still handles subsequent waves; this just
    # guarantees wave-1 happens in the same call, not deferred. Opt out via
    # CONTRACT_DECLARE_NO_AUTO_ITERATE=1 for mass-import / dry-run scripts.
    # Children (--parent set) skip — parent iterate already evaluates them.
    if [ -z "$PARENT" ] && [ -z "${CONTRACT_DECLARE_NO_AUTO_ITERATE:-}" ]; then
      echo ""
      echo "=== DECLARE→ITERATE (auto, doctrine d3241099) ==="
      bash "$0" iterate "$ID"
    fi
    ;;

  iterate)
    ID="${1:-}"; shift || true
    USE_STDIN=""
    NO_CACHE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --stdin)     USE_STDIN=1; shift ;;
        --no-cache)  NO_CACHE=1; shift ;;
        *) shift ;;
      esac
    done
    [ -z "$ID" ] && { echo "usage: contract iterate <id> [--stdin] [--no-cache]" >&2; exit 2; }
    # Σ21 — refuse re-recursion if this id already appears in the caller chain.
    if ! _caller_chain_check_cycle "$ID"; then
      exit 2
    fi
    STDIN_DATA=""
    if [ -n "$USE_STDIN" ] || [ ! -t 0 ]; then
      STDIN_DATA=$(cat)
    fi
    DATA=$(MH_ID="$ID" _py_inline "
import os, json; from contract_core import get
c=get(os.environ['MH_ID'])
print(json.dumps(c) if c else 'null')
")
    [ "$DATA" = "null" ] && { echo "ERROR: contract $ID not found" >&2; exit 3; }
    ACTION=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['action'])" "$DATA")
    CWD=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('cwd') or '')" "$DATA")
    WAVE=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['wave']+1)" "$DATA")
    PLAN_TEXT=$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['plan'][:80])" "$DATA")
    PTYPE=$(MH_ACTION="$ACTION" _py_inline "
import os; from contract_core import _infer_pointer_type
print(_infer_pointer_type(os.environ['MH_ACTION']))
")
    echo "=== CONTRACT ITERATE — wave $WAVE ==="
    echo "  id:     $ID"
    echo "  plan:   $PLAN_TEXT"
    BUDGET_N=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('budget') or '')" "$DATA")
    if [ -n "$BUDGET_N" ]; then
      if [ "$WAVE" -gt "$BUDGET_N" ]; then
        echo "  budget: wave $WAVE of $BUDGET_N — OVER BUDGET (evidence; you judge: escalate, simplify, or HOLD)"
      else
        echo "  budget: wave $WAVE of $BUDGET_N"
      fi
    fi
    echo
    # ── 10s sliding-window cache lookup (per-user, stdio-shaped pointers only) ──
    # See lib/cache_layer.py for the design. Bypass forced via --no-cache.
    CLOOKUP_OUT=$(mktemp)
    CACHE_HEADER="BYPASS"
    if [ -z "$NO_CACHE" ]; then
      printf '%s' "$STDIN_DATA" | PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" \
        python3 "$CONTRACT_LIB/cache_layer.py" lookup "$ID" "$ACTION" "$PTYPE" >"$CLOOKUP_OUT" 2>/dev/null || true
      CACHE_HEADER=$(head -1 "$CLOOKUP_OUT")
    fi
    if [[ "$CACHE_HEADER" == HIT* ]]; then
      set -- $CACHE_HEADER
      ACTION_RC="$2"; AGE_S="$3"; SRC_WAVE="$4"; CKEY="$5"; CUSER="$6"
      echo "  cache_hit_from: wave $SRC_WAVE (${AGE_S}s ago, user=$CUSER, key=${CKEY:0:12})"
      echo
      tail -n +2 "$CLOOKUP_OUT"
      rm -f "$CLOOKUP_OUT"
      _two_key_exit "$ID" "$ACTION_RC" "$ACTION"
    else
      rm -f "$CLOOKUP_OUT" /tmp/contract-action-meta
      CONTRACT_STDIN="$STDIN_DATA" _run_action "$ACTION" "$ID" "$CWD"
      ACTION_RC=$?
      # Read action_meta stash written by pointer-type handlers (e.g. bridge:
      # refusal, x402: payment-required) so the iterated row carries structured
      # block metadata. Empty when the handler didn't emit one.
      ACTION_META_JSON=""
      [ -f /tmp/contract-action-meta ] && ACTION_META_JSON=$(cat /tmp/contract-action-meta 2>/dev/null || true)
      MH_ID="$ID" MH_WAVE="$WAVE" MH_RC="$ACTION_RC" MH_META="$ACTION_META_JSON" \
        MH_CHAIN="$(_caller_chain_get)" _py_inline "
import os, json; from contract_core import record_iteration
meta = None
raw = os.environ.get('MH_META','').strip()
if raw:
    try: meta = json.loads(raw)
    except Exception: meta = None
chain_raw = os.environ.get('MH_CHAIN','').strip()
caller_chain = [x for x in chain_raw.split(',') if x] if chain_raw else []
record_iteration(os.environ['MH_ID'], int(os.environ['MH_WAVE']),
  int(os.environ['MH_RC']),
  'pass' if os.environ['MH_RC']=='0' else 'fail', None, [], action_meta=meta,
  caller_chain=caller_chain)
"
      if [ -z "$NO_CACHE" ] && [[ "$CACHE_HEADER" == MISS* ]]; then
        ARESULT=""
        [ -f /tmp/contract-action-out ] && ARESULT=$(cat /tmp/contract-action-out 2>/dev/null || true)
        printf '%s\0%s' "$STDIN_DATA" "$ARESULT" | PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" \
          python3 "$CONTRACT_LIB/cache_layer.py" write "$ID" "$ACTION" "$PTYPE" "$ACTION_RC" "$WAVE" 2>/dev/null || true
      fi
      _fire_contract_hooks "iterate" "$ID" "$ACTION_RC"
      _two_key_exit "$ID" "$ACTION_RC" "$ACTION"
    fi
    # Γ1 — proactive goal-chain anchor (contract 6aaf78cb).
    # Walk parent_id ↑ from this leaf to the root organ and surface the END GOAL so
    # KEY 2 is judged against whether the iterate advances the root truth claim,
    # not just whether the leaf's local action passed. Substrate surfaces; agent decides.
    MH_ID="$ID" _py_inline "
import os; from contract_core import get
cur = get(os.environ['MH_ID'])
if cur and cur.get('parent_id'):
    chain = [cur]
    seen = {cur['id']}
    while chain[-1].get('parent_id') and chain[-1]['parent_id'] not in seen:
        p = get(chain[-1]['parent_id'])
        if not p: break
        seen.add(p['id'])
        chain.append(p)
    if len(chain) > 1:
        root = chain[-1]
        print()
        print('=== GOAL CHAIN (proactive anchor) ===')
        print(f\"  END GOAL ({root['id']}, status={root['status']}): {root['plan'][:90]}\")
        if len(chain) > 2:
            mid_count = len(chain) - 2
            print(f\"  (...{mid_count} intermediate stage{'s' if mid_count!=1 else ''} up the chain...)\" )
        print(f\"  THIS LEAF ({cur['id']}): {cur['plan'][:90]}\")
        print(f\"  KEY 2 anchor: does this iterate ADVANCE the end goal, or just pass locally?\")
        print(f\"    if off-axis → spawn corrective child / supersede / revise before _mark satisfied\")
        print(f\"    -> contract status {root['id']}   # see the full organ tree\")
"
    # Synaptic firing: surface corroborated contracts so related truths are re-checked
    MH_ID="$ID" _py_inline "
import os; from contract_core import get_corroborations, get
corrs = get_corroborations(os.environ['MH_ID'])
active = [c for cid in corrs for c in [get(cid)] if c and c.get('status') not in ('merged','satisfied')]
if active:
    print()
    print('--- CORROBORATED TRUTHS (synapse fired — re-check) ---')
    for c in active:
        shape = 'funnel' if (c.get('children') or c['action'] in ('children-satisfy','funnel')) else 'funnel-first' if c['action']=='funnel-first' else 'judgment' if c['action']=='agent-judges' else 'loop' if (c['action'].startswith('loop-until:') or c['action']=='loop') else 'harness' if c['action'].startswith('harness:') else 'cell'
        print(f\"  {c['id']} [{c['status']}] ({shape})  \\\"{c['plan'][:60]}\\\"\")
        print(f\"    contract iterate {c['id']}\")
"
    ;;

  spawn)
    PARENT="${1:-}"; shift || true
    PLAN="${1:-}"; shift || true
    ACTION=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action) ACTION="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$PARENT" ] || [ -z "$PLAN" ] && { echo "usage: contract spawn <parent-id> \"<plan>\" [--action \"<cmd>\"]" >&2; exit 2; }
    ACTION_DISPLAY="${ACTION:-agent-judges}"
    cat <<SPAWN

=== SPAWN REQUIRED ===
  parent:  $PARENT
  plan:    $PLAN
  action:  $ACTION_DISPLAY

The agent MUST route this sub-contract via a sub-agent or directly.
  If this is one of N independent children for the same organ,
  use: contract fan-out $PARENT to launch all N in one parallel message.

  Option A — sub-agent (recommended for isolation):
    contract solve "$PLAN" --action "$ACTION_DISPLAY" --parent $PARENT

  Option B — inline:
    contract declare "$PLAN" --action "$ACTION_DISPLAY" --parent $PARENT
    contract iterate <child-id>    (until two-key exit satisfied)

When child satisfies, parent re-verifies:
    contract iterate $PARENT

SPAWN
    ;;

  build)
    PLAN="${1:-}"; shift || true
    ACTION="" NO_DRIVE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --action)   ACTION="${2:-}"; shift 2 ;;
        --drive)    shift ;;
        --no-drive) NO_DRIVE="1"; shift ;;
        *) shift ;;
      esac
    done
    [ -z "$PLAN" ] && { echo "usage: contract build \"<plan>\" [--action \"<cmd>\"] [--no-drive]" >&2; exit 2; }
    ACTION="${ACTION:-agent-judges}"
    echo "=== CONTRACT BUILD ==="
    echo "  plan:   $PLAN"
    echo "  action: $ACTION"
    echo
    echo "--- search: similar contracts (reuse before build) ---"
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 "$SELF/contract-habit-detect.py" --context "$PLAN"
    echo
    echo "--- declare + first wave ---"
    MH_PLAN="$PLAN" MH_ACTION="$ACTION" bash "$0" solve "$PLAN" --action "$ACTION" ${NO_DRIVE:+--no-drive}
    ;;

  solve)
    if [ "${1:-}" = "--continue" ]; then
      ID="${2:-}"
      [ -z "$ID" ] && { echo "usage: contract solve --continue <id>" >&2; exit 2; }
      bash "$0" iterate "$ID"
    else
      PLAN="${1:-}"; shift || true
      ACTION="" PARENT="" NO_DRIVE=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --action)   ACTION="${2:-}"; shift 2 ;;
          --parent)   PARENT="${2:-}"; shift 2 ;;
          --drive)    shift ;;
          --no-drive) NO_DRIVE="1"; shift ;;
          *) shift ;;
        esac
      done
      [ -z "$PLAN" ]   && { echo "usage: contract solve \"<plan>\" --action \"<cmd>\" [--no-drive]" >&2; exit 2; }
      [ -z "$ACTION" ] && { echo "ERROR: --action required" >&2; exit 2; }
      echo "=== SOLVE [1/2] declare ==="
      DECLARE_OUT=$(bash "$0" declare "$PLAN" --action "$ACTION" ${PARENT:+--parent "$PARENT"} ${NO_DRIVE:+--no-drive})
      echo "$DECLARE_OUT"
      # Parse ID from declare output — race-safe vs list_all()[-1] which races under parallel fan-out
      ID=$(python3 -c "
import sys
for line in sys.stdin:
    line = line.strip()
    if line.startswith('declared:'):
        print(line.split(':', 1)[1].strip())
        break
" <<< "$DECLARE_OUT")
      echo
      echo "=== SOLVE [2/2] first wave ==="
      bash "$0" iterate "$ID"
      # self-drive armed by declare; solve's tail is intentionally empty.
    fi
    ;;

  status)
    ID="${1:-}"
    if [ -z "$ID" ]; then
      bash "$0" list
    else
      MH_ID="$ID" _py_inline "
import os, json; from contract_core import get_tree
def pr(node, depth=0):
    pad='  '*depth
    shape='funnel' if (node.get('children') or node['action'] in ('children-satisfy','funnel')) else 'funnel-first' if node['action']=='funnel-first' else 'judgment' if node['action']=='agent-judges' else 'loop' if (node['action'].startswith('loop-until:') or node['action']=='loop') else 'harness' if node['action'].startswith('harness:') else 'cell'
    print(f\"{pad}[{node['status']}] {node['id']} ({shape})\")
    print(f\"{pad}  plan:   {node['plan'][:72]}\")
    print(f\"{pad}  action: {node['action'][:60]}\")
    for c in node.get('child_nodes') or []: pr(c, depth+1)
t=get_tree(os.environ['MH_ID'])
pr(t) if t else print('  contract not found')
"
      # ε9 VERB-COMPOSITION (doctrine fa801cd4): cite next-action verbs
      # the agent can run on this contract id without recall.
      echo ""
      echo "=== RELATED VERBS ==="
      echo "  → contract iterate $ID         # advance / re-verify"
      echo "  → contract cost --ref $ID      # tokens spent on this contract"
      echo "  → contract lineage $ID         # parent_id chain to root"
      echo "  → contract graph $ID           # parents + children + corroborate edges"
      echo "  → contract context $ID         # JSON envelope (upstream chain + last iterations)"
    fi
    ;;

  show)
    # Ψ5 + Π5 — public-internal row view + Π5 layer-tagged read.
    # Same row in the ledger, two views. Default: WHAT + STATUS + PROOF + LAYER
    # (the public face). `--internals` adds HOW + HISTORY (action, cwd, wave,
    # agent, timestamps, pierced_layers). Pointer-not-payload at the row layer.
    # Origin: contract d10b3dbb, 2026-05-24.
    ID=""
    SHOW_INTERNALS=""
    JSON_OUT=""
    SHOW_CONTEXT=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --internals|--how) SHOW_INTERNALS="1"; shift ;;
        --context|--dag)   SHOW_CONTEXT="1"; shift ;;
        --json) JSON_OUT="1"; shift ;;

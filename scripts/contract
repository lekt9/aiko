    # Honest mark: write only the satisfied event. The agent's KEY-2 verdict
    # this explicit mark IS the verdict — proof / skip captured on the row.
    mark_satisfied(id, 0, proof=proof, proof_skip_reason=skip)
else:
    mark_status(id, st)
print(f'  {id} -> {st}')
" || exit 1
    _fire_contract_hooks "mark" "$ID" "0"
    # BREAK ON RESOLUTION (refractory period): every satisfied mark fires a
    # substrate-enforced reflection pause BEFORE propagation. Maps to a
    # neuron's absolute refractory period — the cell that just fired
    # cannot fire again until the soma re-polarises. KEY 3 is the agent's

    _fire_contract_hooks "verb" "face" "0"
    ;;

  gap)
    # Β1 shorthand: declare one DEFERRED-* row with agent-judges + --no-drive
    # so the gap is captured on the ledger before the turn yields. Replaces the
    # antipattern of naming gaps in prose-summaries that don't survive sessions.
    SCOPE="${1:-DEFERRED}"; shift || true
    PLAN="${*:-}"
    [ -z "$PLAN" ] && { echo "usage: contract gap <scope> \"<plan>\"" >&2; exit 2; }
    bash "$0" declare "DEFERRED-${SCOPE}: ${PLAN}" --action agent-judges --no-drive
    _fire_contract_hooks "verb" "gap" "0"
    ;;

  gaps)
    # Β1 surface: list every DEFERRED-* row (pending/active) on the ledger.
    # Substrate enables; agent picks which to iterate/judge/supersede next.
    _py_inline "
import os, sys, json, pathlib
sys.path.insert(0, '$CONTRACT_LIB')
from contract_core import _rows, get
seen = {}
for r in _rows():
    if r.get('event') != 'declared': continue
    plan = r.get('plan') or ''
    if not plan.startswith('DEFERRED-'): continue
    cid = r.get('id')
    seen[cid] = r
# filter to non-satisfied
open_gaps = []
for cid, r in seen.items():
    c = get(cid)
    if c and c.get('status') not in ('satisfied', 'merged', 'rejected'):
        open_gaps.append((cid, r.get('plan', '')))
print()
print('=== Β1 OPEN GAPS ===')
if not open_gaps:
    print('  no open DEFERRED-* rows — every named gap has a satisfied/merged terminal row')
else:
    print(f'  {len(open_gaps)} open DEFERRED-* row(s):')
    for cid, plan in sorted(open_gaps, key=lambda x: x[1])[:50]:
        scope = plan.split(':', 1)[0].replace('DEFERRED-', '')
        rest = (plan.split(':', 1)[1].strip() if ':' in plan else '')[:90]
        print(f'  · {cid}  [{scope}]  {rest}')
    if len(open_gaps) > 50:
        print(f'  · ... {len(open_gaps) - 50} more')
    print()
    print('  iterate one: contract iterate <id>')
    print('  judge one:   contract judge <id>')
    print('  abandon one: contract supersede <id> <winner-id> --reason \"<why fitter>\"')
"
    _fire_contract_hooks "verb" "gaps" "0"
    ;;

  *)
    # plugin fallthrough — if ~/.contracts/lib/verbs/$cmd is executable, exec it.
    # This is the convention: substrate-level helpers ship as plugin verbs in the
    # global ~/.contracts/lib/verbs/ directory (distributed via Π5 upgrade channel).
    plugin="$HOME/.contracts/lib/verbs/$cmd"
    if [ -x "$plugin" ]; then
      # Σ10 universal verb-trigger: fire hook bus before plugin exec so substrate
      # goes deep into itself — every verb (not just iterate/_mark/declare) joins
      # the bus. Hooks self-guard against recursion via per-event env flags.
      _fire_contract_hooks "verb" "$cmd" "0"
      exec "$plugin" "$@"
    fi
    # Λ-verbless invocation: when $cmd is not a known verb / plugin AND looks like
    # plan text (length > 12 chars AND contains whitespace), treat the whole arg
    # as the plan and chain to `solve`, which declares + first-iterates with
    # self-drive auto-armed (Ω3/Ω4 perpetuate across sessions until satisfied).
    # /contract IS one primitive; the bare invocation triggers completion. CLI is
    # one transport; the same plan-text input works identically through MCP, the
    # OpenAI-front (Φ1), or any other Π6-bound environment.
    if [ ${#cmd} -gt 12 ] && [[ "$cmd" == *" "* ]]; then
      _fire_contract_hooks "verb" "verbless" "0"
      # Default --action agent-judges: the plan text IS the truth claim, the
      # agent (in-thread) IS the KEY 2 judge. Caller can still override by
      # passing --action explicitly after the bare-plan arg.
      has_action=""
      for a in "$@"; do [ "$a" = "--action" ] && has_action="1" && break; done
      if [ -z "$has_action" ]; then
        exec bash "$0" solve "$cmd" --action agent-judges "$@"
      else
        exec bash "$0" solve "$cmd" "$@"
      fi
    fi
    echo "unknown subcommand: $cmd" >&2
    bash "$0" help >&2
    exit 2
    ;;
esac

# Σ10 universal verb-trigger (post-dispatch): every CLI verb invocation fires
# the hook bus with event="verb" + verb name so the substrate goes deep into
# itself recursively. Already-fired events (iterate/mark/declare) carry their
# own typed event; this is the catch-all for the long-tail verbs (list, status,
# search, alias, audit, watch, channel, env-bind, etc.) so they too participate
# in the substrate's reactive nervous system.
_fire_contract_hooks "verb" "$cmd" "0"

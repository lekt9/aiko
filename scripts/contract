    # so any receptor contract can block on it via
    #   wait-for-event.py --inbox telegram --field chat_id --equals <id>
    #
    # Bound INTO the /contract CLI itself (not a separate scripts/*.py file)
    # so the documented schema and the producer ship together. Telethon-based
    # so it works for user-session accounts (DMs) and bot sessions equally.
    #
    # Usage:
    #   contract telegram-poll --chat-id <int>   [--session <path>] [--interval <s>] [--once] [--inbound-only]
    #   contract telegram-poll --username <name> [--session <path>] [--interval <s>] [--once] [--inbound-only]
    #   contract telegram-poll --resolve <name>  [--session <path>]      # one-shot identity lookup
    #
    # State:
    #   ~/.contracts/.telegram-poll/<chat-id>.hwm    (last-seen message id)
    #   ~/.contracts/inbox/telegram/<chat-id>.jsonl  (append-only event log)
    #
    # Creds: TG_API_ID / TG_API_HASH env, or files at
    #   ~/.config/telegram/api_id  and  ~/.config/telegram/api_hash
    TG_CHAT_ID=""
    TG_USERNAME=""
    TG_RESOLVE=""
    TG_SESSION="${HOME}/.config/telegram/contract-poll.session"
    TG_INTERVAL="30"
    TG_ONCE=""
    TG_INBOUND_ONLY=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --chat-id)       TG_CHAT_ID="${2:-}"; shift 2 ;;
        --username)      TG_USERNAME="${2:-}"; shift 2 ;;
        --resolve)       TG_RESOLVE="${2:-}"; shift 2 ;;
        --session)       TG_SESSION="${2:-}"; shift 2 ;;
        --interval)      TG_INTERVAL="${2:-30}"; shift 2 ;;
        --once)          TG_ONCE="1"; shift ;;
        --inbound-only)  TG_INBOUND_ONLY="1"; shift ;;
        -h|--help)
          cat <<'USAGE'
contract telegram-poll — Telethon-based injector for the `telegram` inbox channel

  contract telegram-poll --chat-id <int>   [--session <path>] [--interval <s>] [--once] [--inbound-only]
  contract telegram-poll --username <name> [--session <path>] [--interval <s>] [--once] [--inbound-only]
  contract telegram-poll --resolve <name>  [--session <path>]

Writes to ~/.contracts/inbox/telegram/<chat-id>.jsonl in the schema
documented in SKILL.md so receptors block via:
  wait-for-event.py --inbox telegram --field chat_id --equals <id>

Defaults: interval=30s, session=~/.config/telegram/contract-poll.session.
Creds: TG_API_ID/TG_API_HASH env or ~/.config/telegram/api_{id,hash}.
USAGE
          exit 0 ;;
        *) echo "telegram-poll: unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    if [ -z "$TG_RESOLVE" ] && [ -z "$TG_CHAT_ID" ] && [ -z "$TG_USERNAME" ]; then
      echo "usage: contract telegram-poll (--chat-id <int> | --username <name> | --resolve <name>) [opts]" >&2
      exit 2
    fi
    # Session-lock guard — Telethon's SQLite session can only be held by one
    # process at a time. If another process is holding it, refuse cleanly with
    # a structured block naming the holder (so the caller can decide to kill
    # or wait), instead of crashing with `database is locked`.
    if command -v lsof >/dev/null 2>&1 && [ -f "$TG_SESSION" ]; then
      HOLDER_PID=$(lsof -t "$TG_SESSION" 2>/dev/null | head -1)
      MY_PID=$$
      if [ -n "$HOLDER_PID" ] && [ "$HOLDER_PID" != "$MY_PID" ]; then
        HOLDER_CMD=$(ps -p "$HOLDER_PID" -o command= 2>/dev/null | head -c 140)
        cat >&2 <<EOF
=== TELETHON SESSION LOCKED ===
  session: $TG_SESSION
  holder pid: $HOLDER_PID
  holder cmd: $HOLDER_CMD

  another process is holding this session's SQLite db. Telethon allows
  only one client per session at a time. Either:
    1. stop the existing holder:  kill $HOLDER_PID
    2. use a different session:   contract telegram-poll --session <other-path> ...
    3. wait for the holder to exit, then retry.

  if you just want to send ONE message, use --once and pick a different
  session to avoid contention with a long-running poller.
EOF
        exit 4
      fi
    fi
    TG_CHAT_ID="$TG_CHAT_ID" TG_USERNAME="$TG_USERNAME" TG_RESOLVE="$TG_RESOLVE" \
    TG_SESSION="$TG_SESSION" TG_INTERVAL="$TG_INTERVAL" \
    TG_ONCE="$TG_ONCE" TG_INBOUND_ONLY="$TG_INBOUND_ONLY" \

import os, re
t = os.environ['MH_TXT']
tl = t.lower()
hits = {'L0': 0, 'L1': 0, 'L2': 0, 'L3': 0, 'L4': 0}
# L0 — mechanical (exit codes, hashes, paths)
if re.search(r'\\b(exit|errno|hash|sha|path|byte|stderr|stdout|pid|cwd)\\b', tl): hits['L0'] += 2
if re.search(r'/[a-z_-]+/[a-z_-]+|[0-9a-f]{8,}|\\\$[A-Z_]+', t): hits['L0'] += 1
# L1 — substrate (shape names, ledger events)
if re.search(r'\\b(cell|funnel|sequence|quorum|harness|iterate|mark|ledger|hook|verb)\\b', tl): hits['L1'] += 2
# L2 — agent-UX (next action, navigation)
if re.search(r'\\b(next|then|after|advance|drive|drill|wave)\\b', tl): hits['L2'] += 1
# L3 — truth-claim (must hold, PASS/FAIL)
if re.search(r'\\b(must|always|hold|pass|fail|true|verify|prove|claim)\\b', tl): hits['L3'] += 2
# L4 — user-intent (business goal, plain English)
if re.search(r'\\b(want|need|user|ship|launch|reflect|identity|personality|face|human|why)\\b', tl): hits['L4'] += 2
ladder_order = {'L4': 0, 'L3': 1, 'L2': 2, 'L1': 3, 'L0': 4}
order = sorted(hits.items(), key=lambda x: (-x[1], ladder_order[x[0]]))
top = order[0][0]
print('=== Ω5 LAYER IDENTIFY ===')
print(f'  request: {t[:80]}')
print(f'  scored:  ' + '  '.join(f'{k}={v}' for k, v in sorted(hits.items())))
print(f'  primary: {top}')
print()
print('  human-replicating resolution order (resolve FIRST at the highest non-zero layer above primary):')
ladder = ['L4', 'L3', 'L2', 'L1', 'L0']
start_idx = ladder.index(top)
for L in ladder[max(0,start_idx-2):]:
    score = hits[L]
    if score > 0 or L == top:
        print(f'    {L} ({score})  -> agent renders at this layer before descending')
print()
print('  Substrate surfaces; agent judges. Wrong layer is the most common defect (Ψ1 layer purity).')
"
    _fire_contract_hooks "verb" "layer" "0"
    ;;

  face)
    # Ω6 face: emit identity+personality manifest carried on every LLM call.
    # Composes Σ1 attribution (CONTRACT_AGENT/git email), Σ3 alias canonical,
    # Identity doctrine (1bed8068, Aiko voice), Humanlike Σ/Ε/Α dimensions.
    # JSON to stdout; substrate enables, transports/LLM-judge read.

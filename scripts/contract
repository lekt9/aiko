print(f'__BR__|{sat}|{total}|{rate:.4f}')
")
    # Split the summary (printed) from the machine row (parsed)
    HUMAN=$(echo "$BR_LINE" | grep -v '^__BR__')
    MACHINE=$(echo "$BR_LINE" | grep '^__BR__' | head -1)
    SAT=$(echo "$MACHINE" | awk -F'|' '{print $2}')
    TOTAL=$(echo "$MACHINE" | awk -F'|' '{print $3}')
    RATE=$(echo "$MACHINE" | awk -F'|' '{print $4}')
    echo "=== CONTRACT BASERATE ==="
    echo "  target: $TARGET — \"${TPLAN:0:72}\""
    echo
    echo "$HUMAN"
    MH_ID="$TARGET" MH_SAT="$SAT" MH_TOT="$TOTAL" MH_RATE="$RATE" _py_inline "
import os; from contract_core import record_event
record_event('baserate', os.environ['MH_ID'],
             satisfied=int(os.environ['MH_SAT']),
             total=int(os.environ['MH_TOT']),
             rate=float(os.environ['MH_RATE']))
"
    echo
    echo "  KEY 1 (machine): base rate computed against related-contract corpus."
    echo "  KEY 2 (agent):   if base rate is LOW, treat this plan as ambitious —"
    echo "                   demand more evidence per wave; do not auto-promote."
    ;;

  invert)
    # Inversion (declare the negation as a sibling). If the inverted form
    # satisfies more readily than the original, the original was wrong-polarity.
    # The agent iterates the sibling and judges KEY 2 carefully.
    TARGET="${1:-}"; shift || true
    [ -z "$TARGET" ] && { echo "usage: contract invert <id>" >&2; exit 2; }
    TPLAN=$(MH_ID="$TARGET" _py_inline "
import os; from contract_core import get
c=get(os.environ['MH_ID']); print(c['plan'] if c else 'NOT-FOUND')")
    [ "$TPLAN" = "NOT-FOUND" ] && { echo "ERROR: contract $TARGET not found" >&2; exit 1; }
    INV_PLAN="INVERSION OF $TARGET: NOT ($TPLAN)"
    NEW_ID=$(MH_PLAN="$INV_PLAN" MH_PARENT="$TARGET" _py_inline "
import os; from contract_core import declare
print(declare(os.environ['MH_PLAN'], 'agent-judges',
              parent_id=None,
              inverted_from=os.environ['MH_PARENT']))")
    echo "=== INVERSION DECLARED ==="
    echo "  original: $TARGET — \"${TPLAN:0:72}\""
    echo "  sibling:  $NEW_ID"
    echo "  plan:     ${INV_PLAN:0:100}"
    echo
    echo "  next: contract iterate $NEW_ID"
    echo
    echo "  If the inverted contract satisfies more readily than the original,"
    echo "  the original was wrong-polarity. Iterate it and judge KEY 2 carefully."
    ;;

  stale)
    # Apoptosis (biology): a satisfied row is not eternal truth — it was
    # true when the action last fired. The `stale` verb scans the ledger
    # for satisfied rows older than --since and surfaces them with their
    # plan + age, so the agent can re-iterate or supersede. No new shape
    # (per 310f425f) — `stale` is a query verb; staleness is a documented
    # convention on existing loop-until / cell satisfactions, not a typed
    # field. Origin: contract 20402720 (biology gaps wave).
    SINCE="7d"
    JSON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --since) SINCE="${2:-7d}"; shift 2 ;;
        --json)  JSON="1"; shift ;;
        *) shift ;;
      esac
    done
    MH_SINCE="$SINCE" MH_JSON="$JSON" _py_inline "
import os, re, json, sys
from datetime import datetime, timezone, timedelta
from contract_core import _rows, get

def parse_since(s):
    m = re.fullmatch(r'(\d+)([smhdw])', s.strip())
    if not m:
        print(f'ERROR: --since must look like 7d, 24h, 30m, 60s, 2w; got {s!r}', file=sys.stderr); sys.exit(2)
    n = int(m.group(1)); unit = m.group(2)
    mult = {'s':1,'m':60,'h':3600,'d':86400,'w':604800}[unit]
    return timedelta(seconds=n*mult)

cutoff = datetime.now(timezone.utc) - parse_since(os.environ['MH_SINCE'])
# latest satisfied row per id
latest = {}
for r in _rows():
    if r.get('event') == 'satisfied':
        prev = latest.get(r['id'])
        if not prev or r.get('ts','') > prev.get('ts',''):
            latest[r['id']] = r

stale = []
for cid, sat in latest.items():
    try:
        ts = datetime.fromisoformat(sat['ts'].replace('Z','+00:00'))
    except Exception:
        continue
    if ts < cutoff:
        c = get(cid) or {}
        if c.get('status') != 'satisfied':
            continue  # superseded since, no longer satisfied
        stale.append({'id': cid, 'plan': c.get('plan',''), 'satisfied_ts': sat['ts'], 'age_days': round((datetime.now(timezone.utc)-ts).total_seconds()/86400, 1)})
stale.sort(key=lambda r: r['satisfied_ts'])

since_label = os.environ['MH_SINCE']
if os.environ.get('MH_JSON'):
    print(json.dumps({'since': since_label, 'count': len(stale), 'stale': stale}, indent=2))
else:
    print('=== CONTRACT STALE (--since %s) ===' % since_label)
    if not stale:
        print('  no satisfied contracts older than the cutoff.')
    else:
        print('  %d satisfied contract(s) older than %s:' % (len(stale), since_label))
        for r in stale:
            print('  [%sd] %s  %s' % (r['age_days'], r['id'], r['plan'][:60]))
            print('         last satisfied: %s' % r['satisfied_ts'])
            print('         -> contract iterate %s     # re-prove the claim still holds' % r['id'])
            print('         -> contract supersede %s <winner>  # if the claim is obsolete' % r['id'])
        print()
        print('  staleness is a documented convention, not a typed field.')
        print('  the substrate surfaces; the agent decides whether to re-iterate or supersede.')
"
    ;;

  synapse)
    # Hebbian (biology): \"cells that fire together wire together.\" The
    # synapse verb walks the ledger for contract pairs whose `iterated`
    # events fall within the same wave-window N times — co-firing is
    # behavioral evidence the two truths are related, distinct from the
    # text-similarity \`search\` surfaces. Surfaces candidates as
    # `corroborate` suggestions; never auto-declares (substrate principle).
    # No new shape — synapse is a query verb. Origin: contract 5fc64e98.
    WINDOW="300"   # seconds — default 5min wave window
    THRESHOLD="2"  # default: 2 co-iterations -> surface
    JSON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --window)    WINDOW="${2:-300}"; shift 2 ;;
        --threshold) THRESHOLD="${2:-2}"; shift 2 ;;
        --json)      JSON="1"; shift ;;
        *) shift ;;
      esac
    done
    MH_WINDOW="$WINDOW" MH_THRESHOLD="$THRESHOLD" MH_JSON="$JSON" _py_inline "
import os, json, sys
from datetime import datetime
from collections import defaultdict
from contract_core import _rows, get_corroborations, get

window = int(os.environ['MH_WINDOW'])
thresh = int(os.environ['MH_THRESHOLD'])

# Collect all iterated events with their ts (epoch seconds)
events = []
for r in _rows():
    if r.get('event') == 'iterated' and r.get('id') and r.get('ts'):
        try:
            ts = datetime.fromisoformat(r['ts'].replace('Z','+00:00')).timestamp()
            events.append((ts, r['id']))
        except Exception:
            continue
events.sort()

# Count co-iteration pairs within window. Sliding window over sorted events.
pair_count = defaultdict(int)
n = len(events)
for i, (ts_i, id_i) in enumerate(events):
    for j in range(i+1, n):
        ts_j, id_j = events[j]
        if ts_j - ts_i > window:
            break
        if id_i == id_j:
            continue
        key = tuple(sorted([id_i, id_j]))
        pair_count[key] += 1

# Filter: above threshold AND not already corroborated
candidates = []
for (a, b), n_co in sorted(pair_count.items(), key=lambda kv: -kv[1]):
    if n_co < thresh:
        continue
    existing = set(get_corroborations(a))
    if b in existing:
        continue
    ca = get(a); cb = get(b)
    if not ca or not cb:
        continue
    candidates.append({
        'a': a, 'b': b, 'co_iterations': n_co,
        'plan_a': ca.get('plan',''), 'plan_b': cb.get('plan',''),
        'status_a': ca.get('status'), 'status_b': cb.get('status'),
    })

if os.environ.get('MH_JSON'):
    print(json.dumps({'window_seconds': window, 'threshold': thresh,
                      'count': len(candidates), 'candidates': candidates}, indent=2))
else:
    print('=== CONTRACT SYNAPSE (Hebbian co-iteration scan) ===')
    print('  window: %ds    threshold: %d co-iterations' % (window, thresh))
    if not candidates:
        print('  no co-iteration pairs above threshold (no existing-corroboration overlap).')
        print()
        print('  Hebbian principle: cells that fire together wire together.')
        print('  raise --window or lower --threshold to surface weaker correlations.')
    else:
        print('  %d candidate synapse(s) — pairs co-iterated together but not yet corroborated:' % len(candidates))
        for c in candidates:
            aid = c['a']; bid = c['b']
            a_plan = c['plan_a'][:60]; b_plan = c['plan_b'][:60]
            a_st = c['status_a']; b_st = c['status_b']
            n_co = c['co_iterations']
            print('  [%dx]  %s <-> %s' % (n_co, aid, bid))
            print('         %s: %s   [%s]' % (aid, a_plan, a_st))
            print('         %s: %s   [%s]' % (bid, b_plan, b_st))
            print('         -> contract corroborate %s %s  # if behaviorally related' % (aid, bid))
        print()
        print('  substrate surfaces; agent decides. corroborate is the synapse — never auto-fired.')
"
    ;;

  telegram-poll)
    # Telegram DM/chat injector — the documented receptor producer for the
    # `telegram` inbox channel (SKILL.md "Receptors" section). Writes one
    # JSON row per inbound message to ~/.contracts/inbox/telegram/<chat-id>.jsonl
    # so any receptor contract can block on it via
    #   wait-for-event.py --inbox telegram --field chat_id --equals <id>
    #
    # Bound INTO the /contract CLI itself (not a separate scripts/*.py file)
    # so the documented schema and the producer ship together. Telethon-based
    # so it works for user-session accounts (DMs) and bot sessions equally.
    #
    # Usage:
    #   contract telegram-poll --chat-id <int>   [--session <path>] [--interval <s>] [--once] [--inbound-only]
    #   contract telegram-poll --username <name> [--session <path>] [--interval <s>] [--once] [--inbound-only]
    #   contract telegram-poll --resolve <name>  [--session <path>]      # one-shot identity lookup
    #
    # State:
    #   ~/.contracts/.telegram-poll/<chat-id>.hwm    (last-seen message id)
    #   ~/.contracts/inbox/telegram/<chat-id>.jsonl  (append-only event log)
    #
    # Creds: TG_API_ID / TG_API_HASH env, or files at
    #   ~/.config/telegram/api_id  and  ~/.config/telegram/api_hash
    TG_CHAT_ID=""
    TG_USERNAME=""
    TG_RESOLVE=""
    TG_SESSION="${HOME}/.config/telegram/contract-poll.session"
    TG_INTERVAL="30"
    TG_ONCE=""
    TG_INBOUND_ONLY=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --chat-id)       TG_CHAT_ID="${2:-}"; shift 2 ;;
        --username)      TG_USERNAME="${2:-}"; shift 2 ;;
        --resolve)       TG_RESOLVE="${2:-}"; shift 2 ;;
        --session)       TG_SESSION="${2:-}"; shift 2 ;;
        --interval)      TG_INTERVAL="${2:-30}"; shift 2 ;;
        --once)          TG_ONCE="1"; shift ;;
        --inbound-only)  TG_INBOUND_ONLY="1"; shift ;;
        -h|--help)
          cat <<'USAGE'
contract telegram-poll — Telethon-based injector for the `telegram` inbox channel

  contract telegram-poll --chat-id <int>   [--session <path>] [--interval <s>] [--once] [--inbound-only]
  contract telegram-poll --username <name> [--session <path>] [--interval <s>] [--once] [--inbound-only]
  contract telegram-poll --resolve <name>  [--session <path>]

Writes to ~/.contracts/inbox/telegram/<chat-id>.jsonl in the schema
documented in SKILL.md so receptors block via:
  wait-for-event.py --inbox telegram --field chat_id --equals <id>

Defaults: interval=30s, session=~/.config/telegram/contract-poll.session.
Creds: TG_API_ID/TG_API_HASH env or ~/.config/telegram/api_{id,hash}.
USAGE
          exit 0 ;;
        *) echo "telegram-poll: unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    if [ -z "$TG_RESOLVE" ] && [ -z "$TG_CHAT_ID" ] && [ -z "$TG_USERNAME" ]; then
      echo "usage: contract telegram-poll (--chat-id <int> | --username <name> | --resolve <name>) [opts]" >&2
      exit 2
    fi
    # Session-lock guard — Telethon's SQLite session can only be held by one
    # process at a time. If another process is holding it, refuse cleanly with
    # a structured block naming the holder (so the caller can decide to kill
    # or wait), instead of crashing with `database is locked`.
    if command -v lsof >/dev/null 2>&1 && [ -f "$TG_SESSION" ]; then
      HOLDER_PID=$(lsof -t "$TG_SESSION" 2>/dev/null | head -1)
      MY_PID=$$
      if [ -n "$HOLDER_PID" ] && [ "$HOLDER_PID" != "$MY_PID" ]; then
        HOLDER_CMD=$(ps -p "$HOLDER_PID" -o command= 2>/dev/null | head -c 140)
        cat >&2 <<EOF
=== TELETHON SESSION LOCKED ===
  session: $TG_SESSION
  holder pid: $HOLDER_PID
  holder cmd: $HOLDER_CMD

  another process is holding this session's SQLite db. Telethon allows
  only one client per session at a time. Either:
    1. stop the existing holder:  kill $HOLDER_PID
    2. use a different session:   contract telegram-poll --session <other-path> ...
    3. wait for the holder to exit, then retry.

  if you just want to send ONE message, use --once and pick a different
  session to avoid contention with a long-running poller.
EOF
        exit 4
      fi
    fi
    TG_CHAT_ID="$TG_CHAT_ID" TG_USERNAME="$TG_USERNAME" TG_RESOLVE="$TG_RESOLVE" \
    TG_SESSION="$TG_SESSION" TG_INTERVAL="$TG_INTERVAL" \
    TG_ONCE="$TG_ONCE" TG_INBOUND_ONLY="$TG_INBOUND_ONLY" \
    python3 - <<'PY'
import os, sys, json, asyncio, pathlib, time
try:
    from telethon import TelegramClient
except ImportError:
    print("telegram-poll: telethon not installed (pip install telethon)", file=sys.stderr)
    sys.exit(3)

def _load_cred(env_key, fname):
    v = os.environ.get(env_key)
    if v: return v.strip()
    p = pathlib.Path.home() / ".config" / "telegram" / fname
    if p.exists(): return p.read_text().strip()
    return None

api_id_raw = _load_cred("TG_API_ID", "api_id")
api_hash   = _load_cred("TG_API_HASH", "api_hash")
if not api_id_raw or not api_hash:
    print("telegram-poll: missing TG_API_ID / TG_API_HASH (or ~/.config/telegram/api_{id,hash})",
          file=sys.stderr)
    sys.exit(3)
api_id = int(api_id_raw)

session  = os.environ["TG_SESSION"]
resolve  = os.environ.get("TG_RESOLVE") or ""
username = os.environ.get("TG_USERNAME") or ""
chat_id  = os.environ.get("TG_CHAT_ID") or ""
interval = int(os.environ.get("TG_INTERVAL") or "30")
once     = bool(os.environ.get("TG_ONCE"))
inbound_only = bool(os.environ.get("TG_INBOUND_ONLY"))

HOME = pathlib.Path.home()
HWM_DIR = HOME / ".contracts" / ".telegram-poll"
INBOX_DIR = HOME / ".contracts" / "inbox" / "telegram"
HWM_DIR.mkdir(parents=True, exist_ok=True)
INBOX_DIR.mkdir(parents=True, exist_ok=True)

async def main():
    async with TelegramClient(session, api_id, api_hash) as client:
        me = await client.get_me()

        # Resolution-only mode
        if resolve:
            ent = await client.get_entity(resolve)
            uname = getattr(ent, "username", None)
            print(json.dumps({
                "resolved":  resolve,
                "id":        ent.id,
                "username":  uname,
                "first_name": getattr(ent, "first_name", None),
                "last_name":  getattr(ent, "last_name", None),
            }, indent=2))
            return 0

        # Target resolution
        target_id = None
        target_username = None
        if chat_id:
            target_id = int(chat_id)
            try:
                ent = await client.get_entity(target_id)
                target_username = getattr(ent, "username", None)
            except Exception:
                ent = None
        else:
            ent = await client.get_entity(username)
            target_id = ent.id
            target_username = getattr(ent, "username", None) or username

        hwm_file = HWM_DIR / f"{target_id}.hwm"
        inbox    = INBOX_DIR / f"{target_id}.jsonl"

        def read_hwm():
            try: return int(hwm_file.read_text().strip())
            except FileNotFoundError: return 0

        def write_hwm(v): hwm_file.write_text(str(v))

        def append(row):
            with inbox.open("a") as f:
                f.write(json.dumps(row, ensure_ascii=False) + "\n")

        print(f"telegram-poll live as @{me.username} (id={me.id})"
              f" -> chat_id={target_id} (@{target_username}) -> {inbox}",
              flush=True)

        async def one_poll():
            hwm = read_hwm()
            collected = []
            async for m in client.iter_messages(ent or target_id, limit=20):
                if m.id <= hwm: break
                if inbound_only and m.out: continue
                collected.append(m)
            collected.reverse()
            if not collected: return 0
            for m in collected:
                row = {
                    "id": m.id,
                    "chat_id": target_id,
                    "from_username": target_username,
                    "out": bool(m.out),
                    "text": m.text or "",
                    "date": m.date.isoformat() if m.date else None,
                    "reply_to": m.reply_to_msg_id,
                }
                append(row)
                tag = "->" if m.out else "<-"
                print(f"  [{row['date']}] {tag} {(m.text or '')[:180]}", flush=True)
            write_hwm(max(m.id for m in collected))
            return len(collected)

        while True:
            try:
                n = await one_poll()
                if n: print(f"  +{n} event(s) appended", flush=True)
            except Exception as e:
                print(f"  poll err: {e}", file=sys.stderr, flush=True)
            if once: break
            await asyncio.sleep(interval)
        return 0

sys.exit(asyncio.run(main()) or 0)
PY
    ;;

  toggle)
    # contract toggle <feature> on|off|status — substrate-as-config primitive.
    #
    # Replaces env-var hook opt-ins (CONTRACT_GIT_SYNC, CONTRACT_OUTLINE_SYNC,
    # etc.) with standing-gate contracts whose status==satisfied IS the on-flag.
    # The hook reads ~/.contracts/feature-toggles/<feature>.txt → contract id →
    # status to decide whether to fire.
    #
    # On: declare a fresh toggle contract (if no file or current is superseded),
    #     mark it satisfied. Write the id to the toggle file.
    # Off: supersede the current toggle into a fresh OFF fossil; delete the file.
    # Status: print on/off/absent and the contract id (if any).
    FEATURE="${1:-}"
    ACTION="${2:-status}"
    if [ -z "$FEATURE" ]; then
      cat >&2 <<'USAGE'
contract toggle <feature> [on|off|status]

Substrate-as-config: replace env-var opt-ins with standing-gate contracts
whose status==satisfied IS the on-flag. Toggle state lives at
~/.contracts/feature-toggles/<feature>.txt -> contract id -> ledger status.

Examples:
  contract toggle git-sync on            # enable commit auto-sync on satisfy
  contract toggle git-sync-push on       # enable push (separate toggle)
  contract toggle outline-sync on        # enable doc upsert
  contract toggle outline-sync-force on  # bypass audience filter on doc sync
  contract toggle git-sync off           # disable; supersedes the toggle contract
  contract toggle git-sync status        # report on/off/absent + contract id
USAGE
      exit 2
    fi
    TOG_DIR="$HOME/.contracts/feature-toggles"
    mkdir -p "$TOG_DIR"
    TOG_FILE="$TOG_DIR/${FEATURE}.txt"
    GLOBAL_STORE="$HOME/.contracts/contracts.jsonl"

    case "$ACTION" in
      on)
        EXISTING_ID=""
        [ -f "$TOG_FILE" ] && EXISTING_ID="$(cat "$TOG_FILE" 2>/dev/null | tr -d ' \n')"
        if [ -n "$EXISTING_ID" ]; then
          STATUS=$(CONTRACTS_STORE="$GLOBAL_STORE" python3 -c "
import sys, os
sys.path.insert(0, os.path.expanduser('~/.claude/skills/contract/scripts/lib'))
from contract_core import get
s = get('$EXISTING_ID') or {}
print(s.get('status', ''))
" 2>/dev/null)
          if [ "$STATUS" = "satisfied" ]; then
            echo "  $FEATURE is already on (contract $EXISTING_ID satisfied)"
            exit 0
          fi
        fi
        PLAN="FEATURE-TOGGLE $FEATURE — on. The satisfied status of this contract IS the on-flag for the $FEATURE hook. Toggle off via 'contract toggle $FEATURE off'."
        NEW_ID=$(CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
          bash "$0" declare "$PLAN" --action "agent-judges" --no-drive --audience team 2>&1 | \
          grep -oE "^declared: [0-9a-f]{8}" | head -1 | awk "{print \$2}")
        if [ -z "$NEW_ID" ]; then
          echo "ERROR: failed to declare toggle contract for $FEATURE" >&2
          exit 1
        fi
        CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
          bash "$0" _mark "$NEW_ID" satisfied --proof "feature toggle $FEATURE ON via 'contract toggle' verb at $(date -u +%FT%TZ); state file: $TOG_FILE" >/dev/null 2>&1
        echo "$NEW_ID" > "$TOG_FILE"
        echo "  $FEATURE turned ON (contract $NEW_ID satisfied, recorded at $TOG_FILE)"
        ;;

      off)
        if [ ! -f "$TOG_FILE" ]; then
          echo "  $FEATURE is already off (no toggle file at $TOG_FILE)"
          exit 0
        fi
        EXISTING_ID="$(cat "$TOG_FILE" 2>/dev/null | tr -d ' \n')"
        if [ -z "$EXISTING_ID" ]; then
          rm -f "$TOG_FILE"
          echo "  $FEATURE turned off (toggle file was empty, removed)"
          exit 0
        fi
        STATUS=$(CONTRACTS_STORE="$GLOBAL_STORE" python3 -c "
import sys, os
sys.path.insert(0, os.path.expanduser('~/.claude/skills/contract/scripts/lib'))
from contract_core import get
s = get('$EXISTING_ID') or {}
print(s.get('status', ''))
" 2>/dev/null)
        if [ "$STATUS" = "satisfied" ]; then
          OFF_PLAN="FEATURE-TOGGLE $FEATURE — off (supersedes $EXISTING_ID). The hook is now disabled. Re-enable via 'contract toggle $FEATURE on' (declares a fresh toggle contract)."
          OFF_ID=$(CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
            bash "$0" declare "$OFF_PLAN" --action "agent-judges" --no-drive --audience team 2>&1 | \
            grep -oE "^declared: [0-9a-f]{8}" | head -1 | awk "{print \$2}")
          if [ -n "$OFF_ID" ]; then
            CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
              bash "$0" supersede "$EXISTING_ID" "$OFF_ID" --reason "feature toggle $FEATURE OFF via 'contract toggle' verb at $(date -u +%FT%TZ)" >/dev/null 2>&1 || true
          fi
        fi
        rm -f "$TOG_FILE"
        echo "  $FEATURE turned OFF (removed $TOG_FILE; previous toggle $EXISTING_ID was status=$STATUS)"
        ;;

      status|"")
        if [ ! -f "$TOG_FILE" ]; then
          echo "  $FEATURE: absent (no toggle file at $TOG_FILE)"
          exit 0
        fi
        EXISTING_ID="$(cat "$TOG_FILE" 2>/dev/null | tr -d ' \n')"
        if [ -z "$EXISTING_ID" ]; then
          echo "  $FEATURE: off (toggle file empty)"
          exit 0
        fi
        STATUS=$(CONTRACTS_STORE="$GLOBAL_STORE" python3 -c "
import sys, os

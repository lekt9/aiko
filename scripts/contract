    while [ "$#" -gt 0 ]; do
      case "$1" in
        --try)
          shift
          [ -z "${1:-}" ] && { echo "ERROR: --try needs a spec" >&2; exit 2; }
          ROUTE_TRIES+=("$1"); shift ;;
        --parent)
          shift; ROUTE_PARENT="${1:-}"; shift ;;
        *)
          echo "ERROR: unknown arg to route: '$1'" >&2; exit 2 ;;
      esac
    done
    if [ -z "$ROUTE_PLAN" ] || [ "${#ROUTE_TRIES[@]}" -eq 0 ]; then
      cat >&2 <<'ROUTEUSAGE'
usage: contract route "<plan>" --try <spec> [--try <spec> ...] [--parent <pid>]

Each <spec> is the action-text for a candidate backend. Examples:
  --try "machine:python3 -c 'print(1)'"
  --try "sandbox:python:python3 -c 'print(1)'"
  --try "runpod:abc123:python3 -c 'print(1)'"
  --try "true"                              # any cli action also works

Children iterate in declared order; first PASS wins. All FAIL → ROUTE FAILED.
ROUTEUSAGE
      exit 2
    fi
    # Self-locate the CLI so recursive calls survive cwd / PATH ambiguity.
    ROUTE_CLI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    # 1) Declare the funnel-first organ.
    declare -a ROUTE_DECL_ARGS
    ROUTE_DECL_ARGS=(declare "$ROUTE_PLAN" --action funnel-first --no-drive)
    [ -n "$ROUTE_PARENT" ] && ROUTE_DECL_ARGS+=(--parent "$ROUTE_PARENT")
    ROUTE_ORGAN_OUT=$("$ROUTE_CLI" "${ROUTE_DECL_ARGS[@]}" 2>&1)
    ROUTE_ORGAN_ID=$(printf '%s\n' "$ROUTE_ORGAN_OUT" | grep -oE 'declared: [a-f0-9]{8}' | awk '{print $2}' | head -1)
    if [ -z "$ROUTE_ORGAN_ID" ]; then
      echo "ERROR: failed to declare route organ" >&2
      printf '%s\n' "$ROUTE_ORGAN_OUT" >&2
      exit 1
    fi

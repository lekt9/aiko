  toggle)
    # contract toggle <feature> on|off|status — substrate-as-config primitive.
    #
    # Replaces env-var hook opt-ins (CONTRACT_GIT_SYNC, CONTRACT_OUTLINE_SYNC,
    # etc.) with standing-gate contracts whose status==satisfied IS the on-flag.
    # The hook reads ~/.contracts/feature-toggles/<feature>.txt → contract id →
    # status to decide whether to fire.
    #
    # On: declare a fresh toggle contract (if no file or current is superseded),
    #     mark it satisfied. Write the id to the toggle file.
    # Off: supersede the current toggle into a fresh OFF fossil; delete the file.
    # Status: print on/off/absent and the contract id (if any).
    FEATURE="${1:-}"
    ACTION="${2:-status}"
    if [ -z "$FEATURE" ]; then
      cat >&2 <<'USAGE'
contract toggle <feature> [on|off|status]

Substrate-as-config: replace env-var opt-ins with standing-gate contracts
whose status==satisfied IS the on-flag. Toggle state lives at
~/.contracts/feature-toggles/<feature>.txt -> contract id -> ledger status.

Examples:
  contract toggle git-sync on            # enable commit auto-sync on satisfy
  contract toggle git-sync-push on       # enable push (separate toggle)
  contract toggle outline-sync on        # enable doc upsert
  contract toggle outline-sync-force on  # bypass audience filter on doc sync
  contract toggle git-sync off           # disable; supersedes the toggle contract
  contract toggle git-sync status        # report on/off/absent + contract id
USAGE
      exit 2
    fi
    TOG_DIR="$HOME/.contracts/feature-toggles"
    mkdir -p "$TOG_DIR"
    TOG_FILE="$TOG_DIR/${FEATURE}.txt"
    GLOBAL_STORE="$HOME/.contracts/contracts.jsonl"

    case "$ACTION" in
      on)
        EXISTING_ID=""
        [ -f "$TOG_FILE" ] && EXISTING_ID="$(cat "$TOG_FILE" 2>/dev/null | tr -d ' \n')"
        if [ -n "$EXISTING_ID" ]; then
          STATUS=$(CONTRACTS_STORE="$GLOBAL_STORE" python3 -c "
import sys, os
sys.path.insert(0, os.path.expanduser('~/.claude/skills/contract/scripts/lib'))
from contract_core import get
s = get('$EXISTING_ID') or {}
print(s.get('status', ''))
" 2>/dev/null)
          if [ "$STATUS" = "satisfied" ]; then
            echo "  $FEATURE is already on (contract $EXISTING_ID satisfied)"
            exit 0
          fi
        fi
        PLAN="FEATURE-TOGGLE $FEATURE — on. The satisfied status of this contract IS the on-flag for the $FEATURE hook. Toggle off via 'contract toggle $FEATURE off'."
        NEW_ID=$(CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
          bash "$0" declare "$PLAN" --action "agent-judges" --no-drive --audience team 2>&1 | \
          grep -oE "^declared: [0-9a-f]{8}" | head -1 | awk "{print \$2}")
        if [ -z "$NEW_ID" ]; then
          echo "ERROR: failed to declare toggle contract for $FEATURE" >&2
          exit 1
        fi
        CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
          bash "$0" _mark "$NEW_ID" satisfied --proof "feature toggle $FEATURE ON via 'contract toggle' verb at $(date -u +%FT%TZ); state file: $TOG_FILE" >/dev/null 2>&1
        echo "$NEW_ID" > "$TOG_FILE"
        echo "  $FEATURE turned ON (contract $NEW_ID satisfied, recorded at $TOG_FILE)"
        ;;

      off)
        if [ ! -f "$TOG_FILE" ]; then
          echo "  $FEATURE is already off (no toggle file at $TOG_FILE)"
          exit 0
        fi
        EXISTING_ID="$(cat "$TOG_FILE" 2>/dev/null | tr -d ' \n')"
        if [ -z "$EXISTING_ID" ]; then
          rm -f "$TOG_FILE"
          echo "  $FEATURE turned off (toggle file was empty, removed)"
          exit 0
        fi
        STATUS=$(CONTRACTS_STORE="$GLOBAL_STORE" python3 -c "
import sys, os
sys.path.insert(0, os.path.expanduser('~/.claude/skills/contract/scripts/lib'))
from contract_core import get
s = get('$EXISTING_ID') or {}
print(s.get('status', ''))
" 2>/dev/null)
        if [ "$STATUS" = "satisfied" ]; then
          OFF_PLAN="FEATURE-TOGGLE $FEATURE — off (supersedes $EXISTING_ID). The hook is now disabled. Re-enable via 'contract toggle $FEATURE on' (declares a fresh toggle contract)."
          OFF_ID=$(CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
            bash "$0" declare "$OFF_PLAN" --action "agent-judges" --no-drive --audience team 2>&1 | \
            grep -oE "^declared: [0-9a-f]{8}" | head -1 | awk "{print \$2}")
          if [ -n "$OFF_ID" ]; then
            CONTRACTS_STORE="$GLOBAL_STORE" CONTRACT_AGENT="${CONTRACT_AGENT:-$(git config user.email 2>/dev/null || echo unknown)}" \
              bash "$0" supersede "$EXISTING_ID" "$OFF_ID" --reason "feature toggle $FEATURE OFF via 'contract toggle' verb at $(date -u +%FT%TZ)" >/dev/null 2>&1 || true
          fi
        fi
        rm -f "$TOG_FILE"
        echo "  $FEATURE turned OFF (removed $TOG_FILE; previous toggle $EXISTING_ID was status=$STATUS)"
        ;;

      status|"")
        if [ ! -f "$TOG_FILE" ]; then
          echo "  $FEATURE: absent (no toggle file at $TOG_FILE)"
          exit 0
        fi
        EXISTING_ID="$(cat "$TOG_FILE" 2>/dev/null | tr -d ' \n')"
        if [ -z "$EXISTING_ID" ]; then
          echo "  $FEATURE: off (toggle file empty)"
          exit 0
        fi
        STATUS=$(CONTRACTS_STORE="$GLOBAL_STORE" python3 -c "
import sys, os
sys.path.insert(0, os.path.expanduser('~/.claude/skills/contract/scripts/lib'))
from contract_core import get
s = get('$EXISTING_ID') or {}
print(s.get('status', 'unknown'))
" 2>/dev/null)
        if [ "$STATUS" = "satisfied" ]; then
          echo "  $FEATURE: ON  (contract $EXISTING_ID satisfied)"
        else
          echo "  $FEATURE: off (contract $EXISTING_ID status=$STATUS)"
        fi
        ;;

      *)
        echo "ERROR: unknown toggle action: $ACTION (expected on|off|status)" >&2
        exit 2
        ;;
    esac

import json, os, sys
sys.path.insert(0, os.path.join(os.environ["MA_CLI_DIR"], "lib"))
try: from contract_core import resolve_identity, _rows
except ImportError:
    resolve_identity = lambda x: x; _rows = lambda: []
target_filter = os.environ.get("MA_TO", "")
if target_filter:
    target_filter = resolve_identity(target_filter) or target_filter
# Reconstruct each mail's current state from event stream
rows = _rows()
mails = {}
for r in rows:
    mid = r.get("mail_id")
    if not mid: continue
    if r["event"] == "mail_sent":
        mails[mid] = dict(r)
    elif mid in mails and r["event"] in ("mail_step_complete", "mail_step_assigned"):
        m = mails[mid]
        if r["event"] == "mail_step_assigned":
            m["assigned_agent"] = r.get("agent")
            m["current_step"] = r.get("step", m.get("current_step", 0))
            m["state"] = "in_progress"
        elif r["event"] == "mail_step_complete":
            m["completed_steps"] = (m.get("completed_steps") or []) + [
                {"step": r.get("step"), "proof": r.get("proof", ""),
                 "by_agent": r.get("agent"), "ts": r.get("ts", "")}
            ]
            m["assigned_agent"] = None  # DETACH
            m["state"] = "awaiting_next" if r.get("step", 0) < m.get("total_steps", 0) else "completed"
shown = 0
for mid, m in sorted(mails.items(), key=lambda kv: kv[1].get("ts", ""), reverse=True):
    if target_filter and m.get("to") != target_filter: continue
    shown += 1
    print(f"  mail_id={mid}  to={m.get('to')}  state={m.get('state')}  step={len(m.get('completed_steps',[]))}/{m.get('total_steps')}  ts={m.get('ts','?')[:19]}")
    print(f"    brief: {(m.get('brief') or '')[:120]}")
    if m.get("assigned_agent"):
        print(f"    assigned: {m['assigned_agent']}")
print(f"  ({shown} mail(s))")

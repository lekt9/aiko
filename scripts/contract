print('      -> bash ' + str(skill) + '/scripts/skill-self-test.sh   # fires all 4 dimensions')
print('  Substrate surfaces dimensions; KEY 2 stays with the agent on the composed mark.')
"
      exit 0
    fi
    if [[ "$SCOPE" != "project" && "$SCOPE" != "global" && "$SCOPE" != "all" ]]; then

import os, json, time, pathlib, sys
inbox = pathlib.Path.home() / '.contracts' / 'inbox' / 'claims'
inbox.mkdir(parents=True, exist_ok=True)
p = inbox / f'{os.environ[\"MH_REQ\"].replace(\"/\",\"_\")}.jsonl'
existing = []
if p.exists():
  for line in p.read_text().splitlines():
    if not line.strip(): continue
    try: existing.append(json.loads(line))
    except: pass
prior_claim = next((r for r in existing if r.get('event') == 'claim'), None)
if prior_claim and prior_claim.get('client_id') != os.environ['MH_CID']:
  print(f'=== ALREADY CLAIMED ===')
  print(f'  requirement: {os.environ[\"MH_REQ\"]}')
  print(f'  claimed by:  {prior_claim[\"client_id\"]} at {prior_claim.get(\"ts_iso\",\"?\")}')
  print(f'  this client: {os.environ[\"MH_CID\"]} — show \"resolved on another device\" hint')
  sys.exit(1)
row = {
  'event': 'claim',
  'requirement_id': os.environ['MH_REQ'],
  'client_id': os.environ['MH_CID'],
  'ts': time.time(),
  'ts_iso': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
}

import os, re, json, sys
from datetime import datetime, timezone, timedelta
from contract_core import _rows, get

def parse_since(s):
    m = re.fullmatch(r'(\d+)([smhdw])', s.strip())
    if not m:
        print(f'ERROR: --since must look like 7d, 24h, 30m, 60s, 2w; got {s!r}', file=sys.stderr); sys.exit(2)
    n = int(m.group(1)); unit = m.group(2)
    mult = {'s':1,'m':60,'h':3600,'d':86400,'w':604800}[unit]
    return timedelta(seconds=n*mult)

cutoff = datetime.now(timezone.utc) - parse_since(os.environ['MH_SINCE'])
# latest satisfied row per id
latest = {}
for r in _rows():
    if r.get('event') == 'satisfied':
        prev = latest.get(r['id'])
        if not prev or r.get('ts','') > prev.get('ts',''):
            latest[r['id']] = r


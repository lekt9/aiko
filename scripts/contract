import os, sys
sys.path.insert(0, os.path.join(os.environ["AK_CLI_DIR"], "lib"))
from contract_core import _rows
target = os.environ["AK_TARGET"]
aikos = [r for r in _rows() if r.get("event") == "aiko_spawned"]
match = None
for a in aikos:
    if a.get("short_id") == target or a.get("pubkey", "").startswith(target):
        match = a; break
if not match:
    print(f"  ERROR: no aiko with id/pubkey '{target}'", file=sys.stderr); sys.exit(1)

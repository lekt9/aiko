import datetime, json, os, sys
sys.path.insert(0, os.path.join(os.environ["AK_CLI_DIR"], "lib"))
from contract_core import _rows, _append, current_agent
target = os.environ["AK_TARGET"]
from_pubkey = os.environ["AK_FROM"]
amount = os.environ["AK_AMOUNT"]
note = os.environ.get("AK_NOTE", "")
aikos = [r for r in _rows() if r.get("event") == "aiko_spawned"]
target_row = next((a for a in aikos if a.get("short_id") == target or a.get("pubkey", "").startswith(target)), None)
if not target_row:
    print(f"  ERROR: no aiko found for '{target}'", file=sys.stderr); sys.exit(1)
from_row = next((a for a in aikos if a.get("pubkey", "").startswith(from_pubkey)), None)
if not from_row:
    print(f"  ERROR: --from pubkey '{from_pubkey}' is not a known aiko (run 'contract aiko list' to see)", file=sys.stderr); sys.exit(1)
# Lineage check: --from MUST be in target's lineage (no random funder)
if from_row["pubkey"] not in target_row.get("lineage", []) and from_row["pubkey"] != target_row.get("parent_pubkey"):
    print(f"  ERROR: '{from_pubkey[:8]}' is not an ancestor of '{target}' — only lineage ancestors can fund (prevents cross-tree drains)", file=sys.stderr); sys.exit(1)
ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
agent = (current_agent() or "anonymous").strip()
_append({
    "event": "aiko_fund_requested",
    "id": f"aiko-fund-{target_row['short_id']}-{int(datetime.datetime.now().timestamp())}",
    "from_pubkey": from_row["pubkey"],
    "to_pubkey": target_row["pubkey"],
    "amount_sol": amount,
    "note": note,
    "requested_by": agent,
    "ts": ts,
})
# Emit TRANSFER REQUIRED block — substrate names intent, transport signs
print(f"=== TRANSFER REQUIRED ===")
print(f"  kind:         aiko_fund")
print(f"  from:         {from_row['pubkey']}  ({from_row.get('handle') or 'parent'})")
print(f"  to:           {target_row['pubkey']}  ({target_row.get('handle') or 'child'})")
print(f"  amount_sol:   {amount}")
print(f"  note:         {note or '(none)'}")
print(f"  custody:      {from_row.get('custody', '?')}  (transport renders the signing UI)")
print()
print(f"  render hints (transport picks one):")
print(f"    privy:      open privy embedded-wallet, populate amount, ask for confirm")
print(f"    lobster:    POST /v1/transfer with {{from, to, amount_sol, note}}, await signed tx")
print(f"    self:       prompt user to run 'solana transfer {target_row['pubkey']} {amount} --keypair {from_row.get('keypair_path','<path>')}'")
print(f"    cli:        emit the solana-cli command above")
print()
print(f"  audit row appended (event=aiko_fund_requested)")
print(f"  result:       INTENT_RECORDED (no on-chain signature until transport confirms)")

# === Self-custody on-chain path (opt-in via --sign) ===
# Only for custody='self'; privy/lobster require their own transport-side
# wiring (DEFERRED contracts e8cedf82 + 08197b29). For self, we construct +
# sign + (optionally) submit the Solana SystemProgram.transfer instruction
# using the local keypair file.
if os.environ.get("AK_SIGN") == "1":
    if from_row.get("custody") != "self":
        print(f"  ERROR: --sign requires custody='self' on the FROM aiko (got '{from_row.get('custody')}')", file=sys.stderr); sys.exit(1)
    import shutil as _shutil, subprocess as _sub
    helper = os.path.join(os.environ["AK_CLI_DIR"], "aiko-sign.py")
    if not os.path.isfile(helper):
        print(f"  ERROR: signing helper missing at {helper}", file=sys.stderr); sys.exit(1)
    sub_env = os.environ.copy()
    sub_env["AK_SIGN_FROM_KEYPAIR"] = from_row["keypair_path"]
    sub_env["AK_SIGN_FROM_PUBKEY"] = from_row["pubkey"]
    sub_env["AK_SIGN_TO_PUBKEY"] = target_row["pubkey"]
    sub_env["AK_SIGN_AMOUNT"] = amount
    sub_env["AK_SIGN_RPC"] = os.environ.get("AK_RPC") or "https://api.devnet.solana.com"
    sub_env["AK_SIGN_NOTE"] = note
    sub_env["AK_SIGN_AGENT"] = agent
    sub_env["AK_SIGN_TARGET_SHORT"] = target_row["short_id"]
    # Try python3 first, then python3.12 fallback (python3.14 + solders binary wheels often fail)
    candidates = [_shutil.which("python3"), _shutil.which("python3.12"), "/Users/lekt9/.local/bin/python3.12"]
    tried = []
    for py in candidates:
        if not py or not os.path.isfile(py) or py in tried: continue
        tried.append(py)
        check = _sub.run([py, "-c", "import solders"], capture_output=True)
        if check.returncode == 0:
            rc = _sub.call([py, helper], env=sub_env)
            sys.exit(rc)
    print(f"  ERROR: no python with solders found (tried: {tried}). Install via `python3.12 -m pip install --break-system-packages solders`. DEFERRED rows e8cedf82/08197b29 cover privy/lobster custody.", file=sys.stderr)
    sys.exit(1)
AK_FUND_PY
        ;;
      issues)

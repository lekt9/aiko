import os, json, subprocess, pathlib, re
skill = pathlib.Path(os.environ['MH_SKILL']).resolve()
self_out = subprocess.run([str(skill/'scripts/contract'), 'self', '--json'], capture_output=True, text=True, timeout=10)
try: meta = json.loads(self_out.stdout)
except Exception: meta = {}
verbs = meta.get('verbs', [])
shapes = meta.get('shapes', [])
gates_dir = skill / 'verb-gates'
gate_dirs = sorted([d.name for d in gates_dir.iterdir() if d.is_dir() and (d/'verify.sh').exists()]) if gates_dir.exists() else []
shape_gates = sorted([d for d in (skill).iterdir() if d.is_dir() and d.name.endswith('-gate') and (d/'verify.sh').exists()]) if skill.exists() else []
skill_md = (skill/'SKILL.md').read_text() if (skill/'SKILL.md').exists() else ''

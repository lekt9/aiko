    latest_judged = {}
    for line in ledger.read_text().splitlines():
        if not line.strip(): continue
        try: row = json.loads(line)
        except: continue
        if row.get('event') == 'judged':
            latest_judged[row.get('id')] = row
    me = os.environ['MH_ID']
    unblocked = []
    for cid, jr in latest_judged.items():
        if jr.get('verdict') in ('HOLD', 'REJECT') and me in (jr.get('blocked_by') or []):
            # confirm the contract is still pending (not yet satisfied via another path)
            c = get(cid)
            if c and c.get('status') != 'satisfied':
                unblocked.append((cid, c.get('plan', '?')))
    if unblocked:
        print()
        print('=== Ω1 UNBLOCK-REWAKE ===')
        print('  ' + me + ' satisfied — judge-HOLD dependents re-fireable:')
        for cid, plan in unblocked:
            print('  🔓 ' + cid + '  \"' + plan[:52] + '\"')
            print('    -> contract judge ' + cid + '  # re-fire Λ1 with this blocker cleared')
"
    fi
    # INLINE DRIVE ADVANCE: framework-agnostic self-drive — runs synchronously inside the
    # CLI process so any agent/runtime gets the next action without waiting for an external hook
    if [ "$STATUS" = "satisfied" ] && [ -f "$HOME/.contracts/.drive_active" ]; then
      DRIVE_HOOK="$HOME/.contracts/hooks/drive-advance.sh"
      [ -x "$DRIVE_HOOK" ] && bash "$DRIVE_HOOK" "mark" "$ID" "0" 2>>"$HOME/.contracts/hooks/errors.log"
      if [ -f "$HOME/.contracts/drive_next.txt" ]; then
        NEXT_STATE=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('state',''))" < "$HOME/.contracts/drive_next.txt" 2>/dev/null)
        NEXT_CMD=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('resume_cmd',''))" < "$HOME/.contracts/drive_next.txt" 2>/dev/null)
        NEXT_MSG=$(python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('msg',''))" < "$HOME/.contracts/drive_next.txt" 2>/dev/null)
        echo
        echo "=== INLINE DRIVE ADVANCE ==="
        if [ "$NEXT_STATE" = "complete" ]; then
          echo "  ALL CHILDREN SATISFIED — drive complete"
          echo "  Disarm with: contract disarm"
        else
          echo "  next leaf: $NEXT_CMD"
          echo "  $NEXT_MSG"
        fi
        echo
      fi
    fi
    if [ "$STATUS" = "satisfied" ] && [ -z "${CONTRACT_SELF_TEST:-}" ]; then
      bash "$HOME/.contracts/push-to-gitea.sh" &
      SELF_TEST_PREF=$(PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 -c "
from contract_core import _load_prefs
p = _load_prefs()
print('1' if p.get('self_test_on_complete') else '0')
")
      if [ "$SELF_TEST_PREF" = "1" ]; then
        echo
        bash "$0" self-test
      fi
    fi
    ;;

  learn)
    # Crystallize an explicit insight: write a memory file + an Outline doc,
    # and append a `learned` ledger row. The hook-like structure (the
    # crystallize-learning hook) does this automatically for a satisfied
    # learning-bearing contract; this verb is the on-demand entry point.
    TEXT="${1:-}"; shift || true
    SOURCE=""
    while [ $# -gt 0 ]; do

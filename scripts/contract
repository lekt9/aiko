    fi

    # Declare the summoned contract. Pass --parent to root it under the
    # spawning context; the resulting ledger row carries parent_id natively.
    DECLARE_ARGS=(--action "agent:$TO" --audience public --no-drive)
    [ -n "$PARENT" ] && DECLARE_ARGS+=(--parent "$PARENT")
    NEW_ID=$(CONTRACT_AGENT="$TO" bash "$0" declare "$PLAN" "${DECLARE_ARGS[@]}" 2>&1 | grep -oE "^declared: [0-9a-f]{8}" | head -1 | awk '{print $2}')

    if [ -z "$NEW_ID" ]; then
      echo "ERROR: failed to declare summon contract" >&2
      exit 1
    fi

    # Σ4 inbox write with lineage triple. Transports + unbrowse-mirror both
    # see (parent_contract, summoner_agent, origin_contract) so a leaf-Aiko
    # is always traceable back to the originating contract + identity.
    INBOX_DIR="$HOME/.contracts/inbox/agent"
    mkdir -p "$INBOX_DIR"
    INBOX_FILE="$INBOX_DIR/${TO}.jsonl"
    TS=$(date -u +%FT%TZ)
    PLAN="$PLAN" TO="$TO" NEW_ID="$NEW_ID" REASON="$REASON" TS="$TS" \
      PARENT="$PARENT" ORIGIN="$ORIGIN" SUMMONER="$SUMMONER" python3 <<'PY' >> "$INBOX_FILE"
import json, os
row = {
    "event": "summoned",
    "target_canonical": os.environ["TO"],
    "contract_id": os.environ["NEW_ID"],

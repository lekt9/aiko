    ;;
  rbac)
    # contract rbac check <identity> <action>
    # contract rbac grant <role> <action> [<action>...]
    # contract rbac revoke <role> <action> [<action>...]
    # contract rbac show [<role>]
    # contract rbac assign <identity> <role>
    #
    # Role-based access control via /contract. Role map at
    # ~/.contracts/rbac/roles.json; identity carries 'role' on its profile.
    # check exits 0 if allowed, 1 + RBAC DENIED block on deny.
    RB_SUB="${1:-}"; shift || true
    RB_CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    case "$RB_SUB" in
      check)
        RB_ID="${1:-}"; RB_ACT="${2:-}"
        [ -z "$RB_ID" ] || [ -z "$RB_ACT" ] && { echo "usage: contract rbac check <identity> <action>" >&2; exit 2; }
        RB_ID="$RB_ID" RB_ACT="$RB_ACT" RB_CLI_DIR="$RB_CLI_DIR" python3 <<'RB_CHECK_PY'
import json, os, sys
sys.path.insert(0, os.path.join(os.environ["RB_CLI_DIR"], "lib"))
try:
    from contract_core import resolve_identity
except ImportError:
    resolve_identity = lambda x: x
raw = os.environ["RB_ID"]
action = os.environ["RB_ACT"]
canonical = resolve_identity(raw) or raw
profile_path = os.path.expanduser(f"~/.contracts/identities/{canonical}.json")
roles_path = os.path.expanduser("~/.contracts/rbac/roles.json")
role = None
if os.path.isfile(profile_path):
    try:
        prof = json.loads(open(profile_path).read())
        role = prof.get("role")
    except (OSError, json.JSONDecodeError):
        pass
roles_map = {}
if os.path.isfile(roles_path):
    try: roles_map = json.loads(open(roles_path).read())
    except (OSError, json.JSONDecodeError): roles_map = {}
allowed_actions = roles_map.get(role or "", []) if role else []
if action in allowed_actions or "*" in allowed_actions:
    print(f"  identity:  {canonical}")
    print(f"  role:      {role}")
    print(f"  action:    {action}")
    print(f"  result:    PASS (allowed)")
    sys.exit(0)
sys.stdout.write("\n  === RBAC DENIED ===\n")
sys.stdout.write(f"  identity:  {canonical}\n")
sys.stdout.write(f"  role:      {role or '(no role assigned)'}\n")
sys.stdout.write(f"  action:    {action}\n")
sys.stdout.write(f"  granted:   {', '.join(allowed_actions) if allowed_actions else '(none)'}\n")
if not role:
    sys.stdout.write(f"  fix:       contract rbac assign {canonical} <role>\n")
elif role not in roles_map:
    sys.stdout.write(f"  fix:       contract rbac grant {role} {action}  (role has no grants yet)\n")
else:
    sys.stdout.write(f"  fix:       contract rbac grant {role} {action}  OR assign a role with this action\n")
sys.stdout.write(f"\n  result: FAIL (rbac denied)\n")
sys.exit(1)
RB_CHECK_PY
        ;;
      grant|revoke)
        RB_ROLE="${1:-}"; shift || true
        [ -z "$RB_ROLE" ] || [ "$#" -eq 0 ] && { echo "usage: contract rbac $RB_SUB <role> <action> [<action>...]" >&2; exit 2; }
        RB_OP="$RB_SUB" RB_ROLE="$RB_ROLE" \
        RB_ACTIONS_JOIN="$(IFS=$'\x1f'; echo "$*")" \

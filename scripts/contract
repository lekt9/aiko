for i, anc in enumerate(match.get("lineage", [])):
    anc_row = next((a for a in aikos if a["pubkey"] == anc), None)
    anc_handle = (anc_row.get("handle") if anc_row else None) or "(unnamed)"
    print(f"    {'  ' * i}↑ {anc[:8]}  {anc_handle}")
print(f"    {'  ' * len(match.get('lineage', []))}● {match['short_id']}  {match.get('handle') or '(unnamed)'}  ← THIS aiko")
descendants = [a for a in aikos if match["pubkey"] in a.get("lineage", [])]
print()
print(f"  descendants ({len(descendants)} spawned from this aiko):")
for d in sorted(descendants, key=lambda x: x.get("depth", 0)):
    rel_depth = d.get("depth", 0) - match.get("depth", 0)
    print(f"    {'  ' * rel_depth}↓ {d['short_id']}  {d.get('handle') or '(unnamed)'}  custody={d.get('custody','?')}")
if not descendants:
    print(f"    (none — this is a leaf aiko)")

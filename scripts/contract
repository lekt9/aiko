for cid, sat in latest.items():
    try:
        ts = datetime.fromisoformat(sat['ts'].replace('Z','+00:00'))
    except Exception:
        continue
    if ts < cutoff:
        c = get(cid) or {}
        if c.get('status') != 'satisfied':
            continue  # superseded since, no longer satisfied
        stale.append({'id': cid, 'plan': c.get('plan',''), 'satisfied_ts': sat['ts'], 'age_days': round((datetime.now(timezone.utc)-ts).total_seconds()/86400, 1)})
stale.sort(key=lambda r: r['satisfied_ts'])


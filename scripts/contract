print(f'  set {key} = {json.dumps(val)}  ({prefs_path})')
"
    else
      _py_inline "
import json, os
from pathlib import Path
from contract_core import _load_prefs
prefs = _load_prefs()
global_path  = Path.home() / '.contracts' / 'prefs.json'

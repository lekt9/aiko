    ;;

  drive)
    ID="${1:-}"
    [ -z "$ID" ] && { echo "usage: contract drive <contract-id>  arm the agent-judged drive loop" >&2; exit 2; }
    # Per-contract folder substrate. Every contract has its own ~/.contracts/contracts.d/<id>/
    # holding drive.json + cwd.txt + artifacts/. Multiple drives can be armed concurrently
    # because state is per-folder, not a global singleton. Contract a2290c19.
    ACTIVE_STORE=$(PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 -c "from contract_core import _resolve_ledger; print(_resolve_ledger())" 2>/dev/null || echo "$HOME/.contracts/contracts.jsonl")
    CONTRACT_FOLDER=$(PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 -c "from contract_core import contract_dir; print(contract_dir('$ID'))" 2>/dev/null)
    if [ -z "$CONTRACT_FOLDER" ]; then
      echo "contract: ERROR could not resolve folder for $ID" >&2
      exit 1
    fi
    ARMED_TS=$(python3 -c "from datetime import datetime, timezone; print(datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ'))")
    python3 -c "
import json, sys
json.dump({
    'organ':    '$ID',
    'cwd':      '$(pwd)',
    'store':    '$ACTIVE_STORE',
    'armed_ts': '$ARMED_TS',
    'state':    'armed',
}, open('$CONTRACT_FOLDER/drive.json', 'w'))
"
    echo "$(pwd)" > "$CONTRACT_FOLDER/cwd.txt"
    # Legacy compatibility: keep the old global sidecars in lockstep so any
    # in-flight tooling (drive-advance.sh older builds, external readers)
    # still works during the transition. They are now derivative of the
    # per-contract folder, never the source of truth.
    echo "$ID" > "$HOME/.contracts/.drive_active"
    echo "$ACTIVE_STORE" > "$HOME/.contracts/.drive_store"
    pwd > "$HOME/.contracts/.drive_cwd"
    # Seed the next-pending-leaf surface via the existing internal hook.
    DRIVE_HOOK="$HOME/.contracts/hooks/drive-advance.sh"
    [ -x "$DRIVE_HOOK" ] && bash "$DRIVE_HOOK" "drive" "$ID" "0" 2>>"$HOME/.contracts/hooks/errors.log"
    echo "=== CONTRACT DRIVE ARMED: $ID ==="
    echo "  Folder: $CONTRACT_FOLDER"
    echo "  Agent-judged turbo loop. 'contract disarm $ID' (or bare 'disarm' to clear all)."
    echo
    if [ -f "$HOME/.contracts/drive_next.txt" ]; then
      NEXT_MSG=$(python3 -c "import json,sys; print(json.load(sys.stdin).get('msg',''))" < "$HOME/.contracts/drive_next.txt" 2>/dev/null)
      NEXT_CMD=$(python3 -c "import json,sys; print(json.load(sys.stdin).get('resume_cmd',''))" < "$HOME/.contracts/drive_next.txt" 2>/dev/null)
      [ -n "$NEXT_MSG" ] && echo "  $NEXT_MSG"
      echo
      echo "  Run now: ${NEXT_CMD:-bash $0 iterate <next pending leaf>}"
      echo "  Then judge KEY 2 in-thread. If genuine: contract _mark <id> satisfied."
    else
      echo "  (no pending leaf surfaced  run: contract status $ID)"
    fi
    ;;

  verify)
    # Lock-and-key binding dispatcher. Fires every contract whose bind_to
    # matches the given surface (file path / glob / symbol / event tag).
    # Substrate becomes a dispatcher, not just a ledger: when a surface
    # changes, the contracts bound to it re-iterate. Contract ae1340a6.
    #   contract verify <surface>           # iterate matching contracts
    #   contract verify <surface> --list    # list matches without iterating
    #   contract verify <surface> --auto    # auto-mark cell PASSes (KEY-2 surrogate)
    SURFACE="${1:-}"; shift || true
    [ -z "$SURFACE" ] && { echo "usage: contract verify <surface> [--list] [--auto]" >&2; exit 2; }
    LIST_ONLY=""; AUTO=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --list) LIST_ONLY="1"; shift ;;
        --auto) AUTO="1"; shift ;;
        *) shift ;;
      esac
    done
    SELF="$0"
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" \
      CV_SURFACE="$SURFACE" CV_LIST="$LIST_ONLY" CV_AUTO="$AUTO" CV_SELF="$SELF" \
      python3 - <<'PY'
import fnmatch, os, subprocess, sys
from contract_core import list_all, get

surface = os.environ["CV_SURFACE"]
list_only = bool(os.environ.get("CV_LIST"))
auto = bool(os.environ.get("CV_AUTO"))
SELF = os.environ["CV_SELF"]

def _matches(bind_to: str, surf: str) -> bool:
    """Three-mode match: literal, glob, substring. The most specific wins,
    but every successful mode counts as a match."""
    if not bind_to: return False
    if bind_to == surf: return True
    # glob match (fnmatch handles *, ?, [seq])
    if any(c in bind_to for c in "*?["):
        if fnmatch.fnmatch(surf, bind_to): return True
        # also try matching surf as a path against the glob from any segment
        try:
            if fnmatch.fnmatch(os.path.abspath(surf), bind_to): return True
        except Exception: pass
        return False
    # substring fallback (e.g., bind_to="layout.tsx" matches surf=".../src/app/layout.tsx")
    return bind_to in surf

# Build active-contract list (full rows so we can read bind_to + status)
all_rows = list_all()
matches = []
for c in all_rows:
    bt = c.get("bind_to")
    if not bt: continue
    if c.get("status") in ("merged",): continue  # fossils don't fire
    if _matches(bt, surface):
        matches.append(c)

print(f"=== contract verify ({surface}) ===")
print(f"  matched {len(matches)} bound contract(s)")
if list_only:
    for c in matches:
        print(f"  - {c['id']} [{c.get('status','pending')}]  bind_to={c.get('bind_to')!r}  {c['plan'][:60]}")
    sys.exit(0)

if not matches:
    print(f"  no contracts bound to '{surface}'. Use --bind-to on declare to bind one.")
    sys.exit(0)

def _latest_action_exit(cid):
    """Latest 'iterated' row's action_exit. iterate(1) always exits 0
    (two-key exit defers verdict to agent); ledger row holds the truth."""
    import json, pathlib
    store = os.environ.get("CONTRACTS_STORE") or str(pathlib.Path.home() / ".contracts" / "contracts.jsonl")
    last = None
    try:
        for l in open(store):
            try: r = json.loads(l)
            except Exception: continue
            if r.get("id") == cid and r.get("event") == "iterated":
                last = r
    except FileNotFoundError:
        return None
    return last.get("action_exit") if last else None

fail = 0
for c in matches:
    print(f"\n  ── verifying {c['id']} (bind_to={c.get('bind_to')!r}) ──")
    r = subprocess.run(["bash", SELF, "iterate", c["id"]])
    if r.returncode != 0:
        fail += 1
        continue
    action = c.get("action") or ""
    is_judgment = action == "agent-judges" or action.startswith(
        ("funnel", "harness:", "loop", "sequence", "quorum", "tool-guard:"))
    if not is_judgment:
        exit_code = _latest_action_exit(c["id"])
        if exit_code is not None and exit_code != 0:
            fail += 1
            continue
        if auto:
            subprocess.run(["bash", SELF, "_mark", c["id"], "satisfied"])

print(f"\n  surface={surface}  matched={len(matches)}  failed={fail}")
sys.exit(0 if fail == 0 else 1)
PY
    ;;

  drive-watch)
    # Runtime-agnostic drive transport. Polls the ledger inline and re-fires
    # `contract iterate` against the next pending leaf until the organ is
    # satisfied OR a leaf reports AGENT-JUDGES (which requires in-thread
    # judgment). Replaces the Claude-Code Stop hook for any runtime that
    # doesn't have one. Contract 31a7612c. Usage:
    #   contract drive-watch <organ-id> [--interval N] [--max-waves N] [--auto-mark-cells]
    # By default ONLY runs cell actions (mechanical). Judgments halt the loop
    # so the agent can render KEY 2; the loop resumes when the agent re-runs
    # the verb. --auto-mark-cells marks a cell SATISFIED when its exit is 0
    # AND the agent has supplied CONTRACT_AUTOMARK=1 (still a KEY-2 surrogate
    # for trusted-mechanical actions; off by default to preserve two-key exit).
    ORGAN="${1:-}"; shift || true
    [ -z "$ORGAN" ] && { echo "usage: contract drive-watch <organ-id> [--interval N] [--max-waves N] [--auto-mark-cells]" >&2; exit 2; }
    INTERVAL="2"; MAX="200"; AUTOMARK=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --interval) INTERVAL="${2:-2}"; shift 2 ;;
        --max-waves) MAX="${2:-200}"; shift 2 ;;
        --auto-mark-cells) AUTOMARK="1"; shift ;;
        *) shift ;;
      esac
    done
    SELF="$0"
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" \
      CDW_ORGAN="$ORGAN" CDW_INTERVAL="$INTERVAL" CDW_MAX="$MAX" CDW_AUTOMARK="$AUTOMARK" \
      CDW_SELF="$SELF" python3 - <<'PY'
import json, os, subprocess, sys, time
from contract_core import get_tree, get

ORGAN    = os.environ["CDW_ORGAN"]
INTERVAL = max(1, int(os.environ.get("CDW_INTERVAL", "2")))
MAX      = max(1, int(os.environ.get("CDW_MAX", "200")))
AUTOMARK = bool(os.environ.get("CDW_AUTOMARK"))
SELF     = os.environ["CDW_SELF"]

def first_pending_leaf(node):
    if node.get("status") not in ("pending", "active"):
        return None
    kids = node.get("child_nodes") or []
    if not kids:
        return node
    for k in kids:
        leaf = first_pending_leaf(k)
        if leaf: return leaf
    return None

print(f"=== contract drive-watch ({ORGAN}) ===")
print(f"  interval={INTERVAL}s  max-waves={MAX}  auto-mark-cells={AUTOMARK}")
print("  Halts on judgment leaves so the agent can render KEY 2;")
print("  re-run drive-watch after marking to resume.")

waves = 0
while waves < MAX:
    tree = get_tree(ORGAN)
    if not tree:
        print(f"  organ {ORGAN} not found — exiting")
        sys.exit(0)
    if tree["status"] == "satisfied":
        print(f"  organ {ORGAN} SATISFIED — drive complete")
        sys.exit(0)
    leaf = first_pending_leaf(tree)
    if not leaf:
        # No pending leaf but organ not satisfied: parent iterate may close it
        print(f"  no pending leaves — iterating organ {ORGAN}")
        r = subprocess.run(["bash", SELF, "iterate", ORGAN])
        if r.returncode != 0:
            print(f"  organ iterate failed (exit {r.returncode}) — halting")
            sys.exit(r.returncode)
        time.sleep(INTERVAL)
        waves += 1
        continue

    waves += 1
    leaf_full = get(leaf["id"])
    action = (leaf_full or {}).get("action", "")
    print(f"\n  wave {waves}/{MAX} → leaf {leaf['id']} ({leaf['plan'][:60]}...)")
    print(f"    action: {action[:80]}")
    r = subprocess.run(["bash", SELF, "iterate", leaf["id"]])
    if r.returncode != 0:
        print(f"  iterate exited {r.returncode} — halting (fix and re-run drive-watch)")
        sys.exit(r.returncode)

    # If leaf is a mechanical cell AND --auto-mark-cells is set, mark it.
    # Otherwise the loop halts here for the agent's KEY-2 judgment.
    if action == "agent-judges" or action.startswith(("funnel", "harness:", "loop", "sequence", "quorum", "tool-guard:")):
        print(f"\n  HALT: leaf {leaf['id']} requires in-thread KEY-2 judgment.")
        print(f"    If genuinely satisfied: bash {SELF} _mark {leaf['id']} satisfied")
        print(f"    Then re-run: bash {SELF} drive-watch {ORGAN}")
        sys.exit(0)

    if AUTOMARK:
        print(f"  auto-marking cell leaf {leaf['id']} satisfied (KEY-2 surrogate via --auto-mark-cells)")
        subprocess.run(["bash", SELF, "_mark", leaf["id"], "satisfied",
                        "--proof-skip",
                        f"drive-watch --auto-mark-cells: mechanical cell exit 0 (wave {waves}/{MAX})"])
    else:
        print(f"\n  HALT: cell {leaf['id']} passed. Agent KEY-2: bash {SELF} _mark {leaf['id']} satisfied")
        print(f"    Then re-run: bash {SELF} drive-watch {ORGAN}  (or pass --auto-mark-cells to skip the pause)")
        sys.exit(0)

    time.sleep(INTERVAL)

print(f"  reached --max-waves {MAX} without satisfaction — halting")
sys.exit(0)
PY
    ;;

  drill)
    # Synchronous in-thread multi-id loop. Lewis 2026-05-24:
    # "programmatically /contract it in the skill to drill all things that you
    #  propose to me as a while loop until there's nothing left unless the
    #  /contract goal's already completed properly."
    #
    # Takes N target ids. For each, calls `drive-watch` (which already loops
    # one organ until it satisfies / halts on judgment / hits max-waves).
    # Already-satisfied / merged / rejected ids are no-ops (the "unless
    # completed properly" carve-out). When --auto-judge is set AND Λ1 is
    # available (codex CLI or CONTRACT_LLM_URL), drill calls `contract judge`
    # on halted leaves and `_mark satisfied` on PROMOTE — closing the
    # iterate→judge→mark loop in-thread with no per-step prompting.
    #
    # Halts cleanly when: all ids settled, or an outer round makes no
    # progress (genuine blocker needs human KEY-2 or external state).
    # Origin: contract declared this turn — see SKILL.md "Drill" section.
    MAX_WAVES="50"; AUTOMARK=""; AUTOJUDGE=""; OUTER_MAX="8"
    IDS=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --max-waves) MAX_WAVES="${2:-50}"; shift 2 ;;
        --max-waves=*) MAX_WAVES="${1#*=}"; shift ;;
        --outer-rounds) OUTER_MAX="${2:-8}"; shift 2 ;;
        --auto-mark-cells) AUTOMARK="--auto-mark-cells"; shift ;;
        --auto-judge) AUTOJUDGE="1"; shift ;;
        --) shift; while [ "$#" -gt 0 ]; do IDS+=("$1"); shift; done ;;
        -*) echo "contract drill: unknown flag $1" >&2; exit 2 ;;
        *) IDS+=("$1"); shift ;;
      esac
    done

    if [ "${#IDS[@]}" -eq 0 ]; then
      cat <<'USAGE' >&2
usage: contract drill <id> [<id>...] [--max-waves N] [--outer-rounds N] [--auto-mark-cells] [--auto-judge]

  Synchronous in-thread while-loop driver across N targets. For each id,
  delegates to drive-watch (one organ at a time). Skips already-satisfied
  ids. Exits 0 only when every target is settled (satisfied / merged /
  rejected); exits 1 if any remain pending after outer rounds exhausted.

  --auto-mark-cells   passthrough to drive-watch: cell exits 0 → _mark
  --auto-judge        on judgment halts, call Λ1 (contract judge); PROMOTE → _mark
USAGE
      exit 2
    fi

    # Validate ids exist
    BAD=""
    for id in "${IDS[@]}"; do
      EXISTS=$(_py_inline "from contract_core import get; r = get('$id'); print('Y' if r else 'N')")
      [ "$EXISTS" != "Y" ] && BAD="$BAD $id"
    done
    if [ -n "$BAD" ]; then
      echo "contract drill: ids not found in ledger:$BAD" >&2
      exit 2
    fi

    echo "=== CONTRACT DRILL (targets=${#IDS[@]} max_waves=$MAX_WAVES outer_max=$OUTER_MAX) ==="
    echo "  targets: ${IDS[*]}"
    [ -n "$AUTOMARK" ] && echo "  flag: --auto-mark-cells (cells auto-_mark on PASS)"
    [ "$AUTOJUDGE" = "1" ] && echo "  flag: --auto-judge (judgments → Λ1 → _mark on PROMOTE)"

    LLM_AVAILABLE=""
    if command -v codex >/dev/null 2>&1 || [ -n "${CONTRACT_LLM_URL:-}" ]; then
      LLM_AVAILABLE="1"
    fi

    OUTER=0
    while [ "$OUTER" -lt "$OUTER_MAX" ]; do
      OUTER=$((OUTER + 1))
      PROGRESS=0
      STILL_PENDING=()

      for id in "${IDS[@]}"; do
        STATUS=$(_py_inline "from contract_core import get; r = get('$id'); print(r['status'] if r else 'MISSING')")
        case "$STATUS" in
          satisfied|merged|rejected)
            continue ;;
        esac

        echo
        echo "  === outer round $OUTER · drilling $id (status=$STATUS) ==="
        bash "$0" drive-watch "$id" --max-waves "$MAX_WAVES" $AUTOMARK 2>&1

        AFTER=$(_py_inline "from contract_core import get; r = get('$id'); print(r['status'] if r else 'MISSING')")

        # Auto-judge on halt (judgments + cells without --auto-mark-cells)
        if [ "$AUTOJUDGE" = "1" ] && [ "$AFTER" != "satisfied" ] && [ "$AFTER" != "merged" ] && [ -n "$LLM_AVAILABLE" ]; then
          echo "  Λ1 judge on $id..."
          JUDGE_OUT=$(bash "$0" judge "$id" 2>&1) || true
          echo "$JUDGE_OUT" | sed 's/^/    /'
          if echo "$JUDGE_OUT" | grep -q "verdict: PROMOTE"; then
            bash "$0" _mark "$id" satisfied --proof "drilled via contract drill — Λ1 PROMOTE in outer round $OUTER" 2>&1 | sed 's/^/    /' || true
            AFTER=$(_py_inline "from contract_core import get; r = get('$id'); print(r['status'] if r else 'MISSING')")
          fi
        fi

        if [ "$AFTER" != "$STATUS" ]; then PROGRESS=1; fi
        case "$AFTER" in
          satisfied|merged|rejected) ;;
          *) STILL_PENDING+=("$id") ;;
        esac
      done

      if [ "${#STILL_PENDING[@]}" -eq 0 ]; then
        echo
        echo "  outer round $OUTER: every target settled."
        break
      fi

      if [ "$PROGRESS" -eq 0 ]; then
        echo
        echo "  outer round $OUTER: no progress — halting (remaining ${#STILL_PENDING[@]} target(s) need human KEY-2 or external state)"
        break
      fi
    done

    # Final report
    echo
    echo "=== DRILL REPORT ==="
    ANY_PENDING=0
    for id in "${IDS[@]}"; do
      STATUS=$(_py_inline "from contract_core import get; r = get('$id'); print(r['status'] if r else 'MISSING')")
      PLAN=$(_py_inline "from contract_core import get; r = get('$id'); print((r['plan'][:78] + '...') if r and len(r.get('plan','')) > 78 else (r.get('plan','') if r else 'MISSING'))")
      case "$STATUS" in
        satisfied|merged|rejected) MARK="o" ;;
        *) MARK="."; ANY_PENDING=1 ;;
      esac
      printf '  %s [%-9s] %s  %s\n' "$MARK" "$STATUS" "$id" "$PLAN"
    done
    echo

    [ "$ANY_PENDING" -eq 0 ] && exit 0 || exit 1
    ;;

  disarm)
    # Per-contract disarm: with an id, clears that one folder's drive.json.
    # Without an id, clears ALL drives whose cwd matches the current session
    # (or every drive if --all is passed). The global sidecars are also cleared
    # whenever no armed contracts remain.
    TARGET="${1:-}"
    ALL=""
    if [ "$TARGET" = "--all" ]; then ALL="1"; TARGET=""; fi
    PYTHONPATH="$CONTRACT_LIB:${PYTHONPATH:-}" python3 - "$TARGET" "$ALL" <<'PY'
import json, os, sys, shutil
from pathlib import Path
from contract_core import contracts_d_root
target, mode_all = sys.argv[1], sys.argv[2]
root = contracts_d_root()
cleared = []
here = os.path.realpath(os.getcwd())
if target:
    drive = root / target / "drive.json"
    if drive.exists():
        drive.unlink()
        cleared.append(target)
else:
    for d in (root.glob("*/drive.json") if root.exists() else []):
        try:
            j = json.loads(d.read_text())
        except Exception:
            continue
        if mode_all or os.path.realpath(j.get("cwd", "")) == here:
            d.unlink()
            cleared.append(d.parent.name)
# If no drives remain, clear the legacy global sidecars too.
remaining = list(root.glob("*/drive.json")) if root.exists() else []
if not remaining:
    for f in (".drive_active", "drive_next.txt", ".drive_store", ".drive_cwd"):
        try: (Path.home() / ".contracts" / f).unlink()
        except FileNotFoundError: pass
if cleared:
    print(f"Contract drive disarmed: {', '.join(cleared)}")
elif remaining:
    print(f"No matching drive to disarm (cwd={here}). "
          f"{len(remaining)} drive(s) still armed in other cwds; use --all to clear them.")
else:
    print("No drive active.")
PY
    ;;

  corroborate)
    ID1="${1:-}"; ID2="${2:-}"; shift 2 || true
    LABEL=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --label) LABEL="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$ID1" ] || [ -z "$ID2" ] && { echo "usage: contract corroborate <id1> <id2> [--label \"<why>\"]" >&2; exit 2; }
    MH_ID1="$ID1" MH_ID2="$ID2" MH_LABEL="$LABEL" _py_inline "
import os; from contract_core import corroborate, get
id1, id2 = os.environ['MH_ID1'], os.environ['MH_ID2']
label = os.environ.get('MH_LABEL', '')
c1, c2 = get(id1), get(id2)
if not c1: print(f'ERROR: contract {id1} not found'); exit(1)
if not c2: print(f'ERROR: contract {id2} not found'); exit(1)
corroborate(id1, id2, label)
print('=== CONTRACT CORROBORATE (synapse created) ===')
print(f'  {id1}  \"{c1[\"plan\"][:60]}\"')
print(f'  {id2}  \"{c2[\"plan\"][:60]}\"')
if label: print(f'  label: {label}')
print()
print('  When either is iterated, the other will be surfaced for re-check.')
print(f'  next: contract iterate {id1}')
"
    ;;

  merge|supersede)
    SRC="${1:-}"; TGT="${2:-}"; shift 2 || true
    REASON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --reason) REASON="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$SRC" ] || [ -z "$TGT" ] && { echo "usage: contract supersede <loser-id> <winner-id> [--reason \"<why>\"]   (alias: merge)" >&2; exit 2; }
    MH_SRC="$SRC" MH_TGT="$TGT" MH_REASON="$REASON" _py_inline "
import os; from contract_core import merge_into, get
src, tgt = os.environ['MH_SRC'], os.environ['MH_TGT']
reason = os.environ.get('MH_REASON', '')
cs, ct = get(src), get(tgt)
if not cs: print(f'ERROR: contract {src} not found'); exit(1)
if not ct: print(f'ERROR: contract {tgt} not found'); exit(1)
merge_into(src, tgt, reason)
print('=== CONTRACT MERGE (cell fusion) ===')
print(f'  {src}  SUPERSEDED  \"{cs[\"plan\"][:55]}\"')
print(f'  {tgt}  CANONICAL   \"{ct[\"plan\"][:55]}\"')
if reason: print(f'  reason: {reason}')
print()
print(f'  {src} is now merged. contract list hides it by default.')
print(f'  next: contract iterate {tgt}   (re-verify the canonical truth)')
"
    ;;

  promote)
    # Promote a contract from the current ledger to the GLOBAL ledger
    # (~/.contracts/contracts.jsonl) so other projects can reference it via
    # `contract:<id>`. The promoted contract carries its plan/action/status
    # forward verbatim — same id, same state. Idempotent: re-running on an
    # already-promoted contract is a no-op (still appends a 'promoted' marker
    # locally so the lineage is preserved).
    #
    # Skill-modification origin: 2026-05-23. Substrate-level contracts
    # (telegram poller, webhook receiver, reactor) declared inside a project
    # ledger were not visible to other projects' organs — `contract:<id>`
    # resolution requires the row to exist in the lookup-time ledger.
    # Promotion is the missing primitive.
    TARGET="${1:-}"; shift || true
    REASON=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --reason) REASON="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ -z "$TARGET" ] && { echo "usage: contract promote <id> [--reason \"<why this belongs globally>\"]" >&2; exit 2; }
    MH_TARGET="$TARGET" MH_REASON="$REASON" _py_inline "
import json, os, pathlib, time, uuid
from contract_core import _resolve_ledger, get, _append
target = os.environ['MH_TARGET']
reason = os.environ.get('MH_REASON', '')

src_path = pathlib.Path(_resolve_ledger())
global_path = pathlib.Path.home() / '.contracts' / 'contracts.jsonl'
global_path.parent.mkdir(parents=True, exist_ok=True)
global_path.touch(exist_ok=True)

if src_path.resolve() == global_path.resolve():
    print(f'  {target} is already in the global ledger ({global_path}); promotion is a no-op')
    raise SystemExit(0)

c = get(target)
if not c:
    print(f'ERROR: contract {target} not found in current ledger ({src_path})')
    raise SystemExit(1)

# Collect every row for target id from the source ledger
src_rows = []
with src_path.open() as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        if r.get('id') == target or r.get('parent_id') == target:
            src_rows.append(r)

# Idempotency check — is the target already in global?
already = False
if global_path.stat().st_size:
    with global_path.open() as f:
        for line in f:
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            if r.get('id') == target and r.get('event') == 'declared':
                already = True
                break

if already:
    # still append the local 'promoted' marker for lineage
    _append({'event': 'promoted', 'id': target, 'promoted_to': 'global', 'reason': reason or 'idempotent re-promotion', 'ts': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())})
    print(f'  {target} already in global ledger; appended idempotent promoted marker locally')
    raise SystemExit(0)

# Append target rows verbatim to global
n_target_rows = sum(1 for r in src_rows if r.get('id') == target)
n_child_decl = sum(1 for r in src_rows if r.get('parent_id') == target and r.get('event') == 'declared')
with global_path.open('a') as f:
    for r in src_rows:
        if r.get('id') == target:
            f.write(json.dumps(r, ensure_ascii=False) + '\n')

# Append the promoted marker in source ledger
_append({'event': 'promoted', 'id': target, 'promoted_to': 'global', 'rows_copied': n_target_rows, 'reason': reason, 'ts': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())})

print('=== CONTRACT PROMOTE (scope-promotion) ===')
print(f'  {target}  \"{c[\"plan\"][:70]}\"')
print(f'  source: {src_path}')
print(f'  global: {global_path}')
print(f'  rows copied: {n_target_rows}  (children NOT auto-promoted; promote them separately if needed: {n_child_decl} candidate children)')
if reason:
    print(f'  reason: {reason}')
print()
print(f'  Other projects can now reference this via:  contract:{target}')
print(f'  next: contract status {target}     # verify state preserved')
"
    ;;

  depth)
    # Walk the multi-dimensional resolution graph centered on <id>.
    # Surfaces {depth, breadth_max, dims, cycles, paths}. Pretty by default;
    # --json for machines; --strict-cycles exits 1 if any contract:<id> cycle
    # exists (this is what _mark satisfied uses to HARD-BREAK on cycles).
    # No new shape (per 310f425f) — depth is a query verb over the existing
    # parent_id + contract-ref graph. Origin: contract fb9698f7, 2026-05-23.
    TARGET="${1:-}"; shift || true
    EXTRA=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --json|--strict-cycles) EXTRA+=("$1"); shift ;;
        *) shift ;;
      esac
    done
    [ -z "$TARGET" ] && { echo "usage: contract depth <id> [--json] [--strict-cycles]" >&2; exit 2; }
    python3 "$SELF/contract-depth.py" "$TARGET" "${EXTRA[@]+"${EXTRA[@]}"}"
    ;;

  context-of)
    # On-demand library/topic context with pluggable non-binding sources
    # (eb663e04, 2026-05-24). Forward every arg to the orchestrator —
    # the python script handles --source / --from-stdin / --cache-only /
    # --refresh / --order and exits 0 on success, 1 on context-needed,
    # 2 on usage error.
    python3 "$SELF/contract-context-of.py" "$@"
    ;;

  next-of)
    # Post-iterate "next layer" proposer with pluggable non-binding sources
    # (c1bdb2b0, 2026-05-24). Symmetric to context-of but for the question
    # "what contract should fire NEXT if <id> can't resolve yet?"
    # Sources: judge-says / child-gap / failure-pattern / search-bm25 / stdin.
    # Flags: --source <name>, --order a,b,c, --from-stdin, --auto-declare,
    # --json. --auto-declare programmatically declares the top proposal as
    # a child contract under <id>.
    python3 "$SELF/contract-next-of.py" "$@"
    ;;

  render)
    # Universal renderer dispatch (d26df94c, 2026-05-24). Pluggable
    # surfaces: stdout (default), aiko-notch, merjs, video-message,
    # tg-video, plus any new scripts/renderers/<name>.{sh,py}. Optional
    # --humanize pipes through scripts/humanize.py (Aiko-voice strip).
    # Φ1 openai-render is one specific renderer; this verb generalizes
    # the family so the same substrate stdio fans out to any surface.
    python3 "$SELF/contract-render.py" "$@"
    ;;

  context)
    # Mail-stdin doctrine companion (b2d15246, 2026-05-24): emit a JSON
    # envelope describing this contract's originating context so a chained
    # action can load it programmatically. Output is JSON to stdout — every
    # action that consumes the inbox event via stdin/CONTRACT_INBOX_EVENT
    # calls `contract context $CONTRACT_ID` to load the upstream chain.
    #
    # Envelope: {id, plan, status, action, cwd, parent_chain, origin_chain,
    # last_iterations}. parent_chain walks parent_id upward; origin_chain
    # walks `corroborate` synapses (contracts that fired in the same wave
    # — co-iteration neighbours). last_iterations returns the most-recent
    # --max-iterations rows (default 5).
    TARGET="${1:-}"; shift || true
    MAX_ITERS="5"
    while [ $# -gt 0 ]; do
      case "$1" in
        --max-iterations) MAX_ITERS="${2:-5}"; shift 2 ;;
        --json) shift ;;
        *) shift ;;
      esac
    done
    [ -z "$TARGET" ] && { echo "usage: contract context <id> [--max-iterations N]" >&2; exit 2; }
    MH_TARGET="$TARGET" MH_MAX="$MAX_ITERS" _py_inline "
import os, json
from contract_core import get, _rows
cid = os.environ['MH_TARGET']
c = get(cid)
if not c:
    print(json.dumps({'error': 'not-found', 'id': cid})); raise SystemExit(2)
# parent_chain
chain = []
cur = c
while cur and cur.get('parent_id'):
    p = get(cur['parent_id'])
    if not p: break
    chain.append({'id': p['id'], 'plan': (p.get('plan') or '')[:120], 'status': p.get('status')})
    cur = p
# origin_chain: corroborated peers
rows = _rows()
synapses = []
for r in rows:
    if r.get('event') == 'corroborated' and cid in (r.get('ids') or []):
        for other in (r.get('ids') or []):
            if other != cid:
                o = get(other)
                if o:
                    synapses.append({'id': other, 'plan': (o.get('plan') or '')[:120], 'status': o.get('status')})
# last_iterations
iters = [r for r in rows if r.get('event') == 'iterated' and r.get('id') == cid]
max_n = int(os.environ['MH_MAX'])
last_iters = []
for r in iters[-max_n:]:
    last_iters.append({
        'wave': r.get('wave'),
        'action_exit': r.get('action_exit'),
        'action_result': r.get('action_result'),
        'ts': r.get('ts'),
    })
envelope = {
    'id': c['id'],
    'plan': c.get('plan'),
    'status': c.get('status'),
    'action': c.get('action'),
    'cwd': c.get('cwd'),
    'parent_chain': chain,
    'origin_chain': synapses,
    'last_iterations': last_iters,
}
print(json.dumps(envelope, indent=2))
"
    ;;

  retire)
    # Retire a contract without an external winner. Declares a self-anchored
    # retirement marker (pre-satisfied), then supersedes <id> with it via the
    # same `merge_into` path. The fossil row carries the reason; <id> is

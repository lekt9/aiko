    MH_JSON="${UB_JSON:-}" _py_inline "
import os, json, pathlib
from contract_core import _resolve_ledger, get
ledger = _resolve_ledger()
if not ledger.exists():
    print('=== Ω1 UNBLOCKED (no ledger yet) ===')
    raise SystemExit(0)
latest_judged = {}
for line in ledger.read_text().splitlines():
    if not line.strip(): continue
    try: row = json.loads(line)
    except: continue
    if row.get('event') == 'judged':
        latest_judged[row.get('id')] = row

import datetime, json, os, sys
sys.path.insert(0, os.path.join(os.environ["MA_CLI_DIR"], "lib"))
try: from contract_core import current_agent, _append, _rows
except ImportError:
    current_agent = lambda: ""; _append = lambda r: None; _rows = lambda: []
mid = os.environ["MA_ID"]
agent = (current_agent() or "anonymous").strip()
ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
sent = None; completed = 0; last_assign = None; last_complete_ts = ""
for r in _rows():
    if r.get("mail_id") != mid: continue
    if r["event"] == "mail_sent": sent = r
    elif r["event"] == "mail_step_complete":
        completed += 1
        last_complete_ts = r.get("ts", "")
    elif r["event"] == "mail_step_assigned":
        last_assign = r
if not sent:
    print(f"  ERROR: no mail with id {mid}", file=sys.stderr); sys.exit(1)
if completed >= sent.get("total_steps", 1):
    print(f"  ERROR: mail {mid} already at completion ({completed}/{sent.get('total_steps')})", file=sys.stderr); sys.exit(1)
if last_assign and last_assign.get("ts", "") > last_complete_ts:
    print(f"  ERROR: mail {mid} still assigned to {last_assign.get('agent')} (step {last_assign.get('step')} not complete) — finish detach via 'mailbox step-complete {mid} --proof' first", file=sys.stderr); sys.exit(1)
next_step = completed + 1
_append({
    "event": "mail_step_assigned", "id": f"mail-{mid}-assign-{next_step}",
    "mail_id": mid, "step": next_step, "agent": agent, "ts": ts,
})
print(f"  mail_id:      {mid}")
print(f"  step:         {next_step}/{sent.get('total_steps')}  ASSIGNED")
print(f"  assigned_to:  {agent}")
print(f"  brief (cold read):")
print(f"    {sent.get('brief','')}")
if completed:
    print(f"  history ({completed} prior steps — agent reads this BEFORE acting):")
    for r in _rows():
        if r.get("mail_id") == mid and r["event"] == "mail_step_complete":
            print(f"    step {r.get('step')}: {(r.get('proof') or '')[:100]}")
print(f"  next:         do step {next_step}, then 'contract mailbox step-complete {mid} --proof <evidence>'")
print(f"  result:       PASS (attached + cold-read brief surfaced)")
MA_NEXT_PY
        ;;
      ""|*)

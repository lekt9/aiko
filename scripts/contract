      sync|list|"")
        FMT="$FMT" python3 - <<'PY'
import json, os, sys, re
from pathlib import Path
fmt = os.environ.get("FMT", "text")
skills_dir = Path.home() / ".claude" / "skills"
rows = []
if skills_dir.is_dir():
    for d in sorted(skills_dir.iterdir()):
        if not d.is_dir(): continue
        sk = d / "SKILL.md"
        if not sk.exists(): continue
        size = sk.stat().st_size
        desc = ""
        try:
            text = sk.read_text(errors="replace")[:2048]
            m = re.search(r"^description:\s*(.+?)$", text, re.M)
            if m: desc = m.group(1).strip().strip('"').strip("'")[:120]
            elif text.lstrip().startswith("#"):
                desc = text.lstrip().split("\n", 2)[0].lstrip("#").strip()[:120]
        except Exception:
            pass
        rows.append({"name": d.name, "size": size, "desc": desc, "path": str(sk)})
if fmt == "json":
    json.dump({"count": len(rows), "skills": rows}, sys.stdout, indent=2)
    sys.stdout.write("\n")
else:
    print(f"=== contract skills ({len(rows)} found) ===")
    for r in rows:
        print(f"  {r['name']:<40} {r['size']:>7}b  {r['desc']}")
PY
        ;;

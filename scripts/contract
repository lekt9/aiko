print(f'  [3] verb-gates ({len(gate_dirs)}): binding regression checks')
for g in gate_dirs[:6]:
    print(f'      · {g}')
if len(gate_dirs) > 6:
    print(f'      · ... ({len(gate_dirs) - 6} more)')
print(f'      -> bash {skill}/scripts/skill-self-test.sh   # fire all gates')

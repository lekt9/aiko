def count_rows(inbox_path):
    if not os.path.isdir(inbox_path): return 0
    n = 0
    for f in os.listdir(inbox_path):
        if f.endswith(".jsonl"):
            try:
                with open(os.path.join(inbox_path, f)) as h:
                    n += sum(1 for _ in h)
            except: pass
    return n


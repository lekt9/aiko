import datetime, json, os, sys
sys.path.insert(0, os.path.join(os.environ["AK_CLI_DIR"], "lib"))
try:
    from contract_core import _append, current_agent
except ImportError:
    print("FATAL: contract_core not importable", file=sys.stderr); sys.exit(3)
try:
    from cryptography.hazmat.primitives.asymmetric import ed25519
    from cryptography.hazmat.primitives import serialization
except ImportError:
    print("ERROR: install cryptography (`pip3 install cryptography`)", file=sys.stderr); sys.exit(2)
try:
    import base58
except ImportError:
    print("ERROR: install base58 (`pip3 install base58`)", file=sys.stderr); sys.exit(2)

custody = os.environ["AK_CUSTODY"]
if custody not in ("self", "privy", "lobster"):
    print(f"ERROR: --custody must be self|privy|lobster (got '{custody}')", file=sys.stderr); sys.exit(2)
if custody in ("privy", "lobster"):
    # Honest-gap: name the choice on the row, but key material is generated locally
    # until the transport-side custody wiring lands. This matches Π4's deferred pattern.
    print(f"  ⚠  custody='{custody}' is recorded on the row but external custody is not yet wired", file=sys.stderr)
    print(f"      key material is generated locally; migrate later via 'contract aiko migrate-custody'", file=sys.stderr)

private_key = ed25519.Ed25519PrivateKey.generate()
priv_bytes = private_key.private_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PrivateFormat.Raw,
    encryption_algorithm=serialization.NoEncryption(),
)
pub_bytes = private_key.public_key().public_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PublicFormat.Raw,
)
# Solana keypair = 64 bytes (private || public), base58 = display
pubkey_b58 = base58.b58encode(pub_bytes).decode()
keypair_bytes = priv_bytes + pub_bytes
short_id = pubkey_b58[:8]  # use first 8 chars of base58 pubkey as terse id

parent_pubkey = os.environ.get("AK_PARENT", "").strip() or None
# Resolve parent's lineage to walk-and-extend
lineage = []
if parent_pubkey:
    # Walk ledger for parent's aiko_spawned row to read its lineage
    try:
        from contract_core import _rows
        for r in _rows():
            if r.get("event") == "aiko_spawned" and r.get("pubkey", "").startswith(parent_pubkey):
                lineage = list(r.get("lineage", [])) + [r.get("pubkey")]
                parent_pubkey = r.get("pubkey")  # canonicalize to full pubkey
                break
        else:
            print(f"  ⚠  parent '{parent_pubkey}' has no aiko_spawned row — lineage will be [parent_pubkey] only", file=sys.stderr)
            lineage = [parent_pubkey]
    except Exception as e:
        print(f"  ⚠  could not resolve parent lineage: {e}", file=sys.stderr)
        lineage = [parent_pubkey]

# Store keypair on disk. Path: ~/.contracts/aikos/<short-id>/keypair.json
# For Σ2-style segregation: if CONTRACTS_AIKO_ROOT env set use that root.
aikos_root = os.environ.get("CONTRACTS_AIKO_ROOT") or os.path.expanduser("~/.contracts/aikos")
aiko_dir = os.path.join(aikos_root, short_id)
os.makedirs(aiko_dir, exist_ok=True)
# Solana convention: byte array of len 64
keypair_path = os.path.join(aiko_dir, "keypair.json")
with open(keypair_path, "w") as f:
    json.dump(list(keypair_bytes), f)
os.chmod(keypair_path, 0o600)  # owner-read-only
# Public surface (safe to share): pubkey.txt
with open(os.path.join(aiko_dir, "pubkey.txt"), "w") as f:
    f.write(pubkey_b58 + "\n")

ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
agent = (current_agent() or "anonymous").strip()
handle = os.environ.get("AK_HANDLE", "").strip() or None
row = {
    "event": "aiko_spawned",
    "id": f"aiko-{short_id}",
    "pubkey": pubkey_b58,
    "short_id": short_id,
    "parent_pubkey": parent_pubkey,
    "lineage": lineage,  # ordered list of ancestor pubkeys
    "depth": len(lineage),
    "custody": custody,
    "keypair_path": keypair_path,
    "handle": handle,
    "spawned_by": agent,
    "ts": ts,
}
_append(row)
print(f"  aiko_id:        {short_id}")
print(f"  pubkey:         {pubkey_b58}")
print(f"  handle:         {handle or '(unnamed)'}")
print(f"  parent_pubkey:  {parent_pubkey or '(root)'}")
print(f"  lineage_depth:  {len(lineage)}")
if lineage:
    print(f"  lineage:        {' → '.join(p[:8] for p in lineage)} → {short_id}")
print(f"  custody:        {custody}")
print(f"  keypair_path:   {keypair_path}  (chmod 600)")
print(f"  spawned_by:     {agent}")
print(f"  result:         PASS (aiko_spawned row + keypair persisted)")
print()
print(f"  next steps:")
print(f"    contract aiko tree {short_id}")
print(f"    contract aiko spawn --parent {pubkey_b58}  (spawn a child aiko)")
print(f"    contract aiko fund {short_id} --from <parent-pubkey> --amount-sol 0.01")
AK_SPAWN_PY
        ;;
      list)

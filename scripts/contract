import os, sys
sys.path.insert(0, os.path.join(os.environ["AK_CLI_DIR"], "lib"))
from contract_core import _rows
rows = list(_rows())
aikos = [r for r in rows if r.get("event") == "aiko_spawned"]
print(f"=== AIKO MANAGEMENT VIEW ({len(aikos)} aikos) ===")
# Mailboxes in flight: mail_sent without final mail_step_complete on every step
mail_open = {}  # mail_id -> {sent, completed, total}
for r in rows:
    if r.get("event") == "mail_sent":
        mid = r.get("mail_id")
        if mid: mail_open[mid] = {"sent": r, "completed": 0, "total": r.get("total_steps", 1)}
    elif r.get("event") == "mail_step_complete":
        mid = r.get("mail_id")
        if mid in mail_open: mail_open[mid]["completed"] += 1
open_mail = {mid: m for mid, m in mail_open.items() if m["completed"] < m["total"]}
# Deferred contracts (Β1)
deferred = [r for r in rows if r.get("event") == "declared" and (r.get("plan") or "").startswith("DEFERRED")]
deferred_open = []
for d in deferred:
    cid = d.get("id")
    if not any(r.get("event") == "satisfied" and r.get("id") == cid for r in rows):
        deferred_open.append(d)
# Pending permission requests
perm_pending = {}
for r in rows:
    if r.get("event") == "permission_request": perm_pending[r.get("req_id")] = r
    elif r.get("event") == "permission_resolve":
        perm_pending.pop(r.get("req_id"), None)
print(f"\n  📬 OPEN MAILBOXES ({len(open_mail)}):")
if not open_mail: print("    (none — all mail completed)")
for mid, m in list(open_mail.items())[:10]:
    s = m["sent"]
    print(f"    {mid}  {s.get('from','?'):<25s} → {s.get('to','?'):<25s}  step {m['completed']}/{m['total']}  brief: {(s.get('brief') or '')[:50]}")
print(f"\n  🕒 DEFERRED CONTRACTS ({len(deferred_open)}):")
if not deferred_open: print("    (none open)")
for d in deferred_open[:10]:
    plan = (d.get("plan") or "")[:80]
    print(f"    {d.get('id')}  {plan}")
print(f"\n  🔐 PENDING PERMISSION REQUESTS ({len(perm_pending)}):")
if not perm_pending: print("    (none pending)")
for rid, r in list(perm_pending.items())[:10]:
    print(f"    {rid}  {r.get('requester','?'):<25s} asks {r.get('target','?'):<25s} for: {r.get('action','?')}")
# Aiko summary
roots = [a for a in aikos if not a.get("parent_pubkey")]
print(f"\n  🤖 AIKO ROSTER:")
print(f"    roots:        {len(roots)}")
print(f"    total aikos:  {len(aikos)}")
print(f"    max depth:    {max((a.get('depth', 0) for a in aikos), default=0)}")
custodies = {}
for a in aikos:
    c = a.get("custody", "?"); custodies[c] = custodies.get(c, 0) + 1
print(f"    by custody:   {', '.join(f'{c}={n}' for c, n in custodies.items())}")

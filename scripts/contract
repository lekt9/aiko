        echo "  Pick one:" >&2
        echo "    contract _mark $ID satisfied --proof \"<one-line evidence the plan held>\"" >&2
        echo "    contract _mark $ID satisfied --proof-skip \"<why the in-thread KEY 2 is sufficient here>\"" >&2
        exit 2
      fi
    fi
    MH_ID="$ID" MH_STATUS="$STATUS" MH_PROOF="$PROOF" MH_PROOF_SKIP="$PROOF_SKIP" _py_inline "
import os, sys
from contract_core import mark_satisfied, mark_status, get
id=os.environ['MH_ID']; st=os.environ['MH_STATUS']
proof = os.environ.get('MH_PROOF') or None
skip = os.environ.get('MH_PROOF_SKIP') or None
# Substrate principle: never silently fabricate a row for an unknown id.
# verb-gate _mark caught this — marking a nonexistent id silently appended
# a satisfied row, which violates default #11 (every verification result
# traces to a real live source). Reject unknown ids before writing.
if get(id) is None:
    print(f'ERROR: contract {id} not found in this ledger', file=sys.stderr)
    sys.exit(1)

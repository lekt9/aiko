    ;;
  organism)
    # contract organism "<plan>" [--action <a>] [--child "plan|action"]... [--parent <pid>]
    #
    # Reduce + inflate. The agent-facing default — one verb that mechanically
    # expands to the whole invocation organism (search → declare → spawn →
    # iterate-all → auto-mark → propagate) per the doctrine at 55e60ce8.
    #
    # No more typing drill/iterate/_mark/--auto-mark-cells/--auto-judge per
    # leaf — the organism verb wraps them. drill/iterate/_mark remain as L1
    # substrate verbs (this verb uses them internally) but stop being agent-
    # facing front door.
    #
    # Forms:
    #   organism "X must hold" --action "test -f foo"
    #       → single-claim cell, iterates, auto-marks on PASS
    #   organism "Y composes Z things" --child "z1|cmd1" --child "z2|cmd2"
    #       → funnel root with N child cells, iterates all in order,
    #         auto-marks leaves on PASS, auto-marks root when all-satisfied
    #   organism "judgment claim"
    #       → declares agent-judges, iterates (returns AGENT-JUDGES),
    #         caller-context (this turn's agent) IS KEY 2 so auto-marks
    #
    # KEY 2 honesty: the organism is invoked IN-THREAD by an agent that
    # judges the convergence in real time. The auto-marks carry
    # --proof-skip "organism in-thread KEY 2 — agent invoked + read result"
    # which makes the autonomous-mark distinguishable from a one-shot
    # explicit mark per the plan-fulfillment proof binding (173c8819).
    ORG_PLAN="${1:-}"; shift || true
    ORG_ACTION=""
    ORG_PARENT=""
    declare -a ORG_CHILDREN
    ORG_CHILDREN=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --action) shift; ORG_ACTION="${1:-}"; shift ;;
        --child)  shift
          [ -z "${1:-}" ] && { echo "ERROR: --child needs 'plan|action'" >&2; exit 2; }
          ORG_CHILDREN+=("$1"); shift ;;
        --parent) shift; ORG_PARENT="${1:-}"; shift ;;
        *) echo "ERROR: unknown arg to organism: '$1'" >&2; exit 2 ;;
      esac
    done
    if [ -z "$ORG_PLAN" ]; then
      cat >&2 <<'ORGUSAGE'
usage: contract organism "<plan>" [--action <a>] [--child "plan|action"]... [--parent <pid>]

The default invocation primitive — one verb that converges the whole
funnel+loop+harness organism in-thread. No drill/iterate/_mark ceremony.

Forms:
  organism "<single claim>" --action "<check>"          # cell: declare → iterate → auto-mark
  organism "<umbrella>" --child "p1|a1" --child "p2|a2" # funnel: root + N leaves, all converged
  organism "<judgment>"                                 # agent-judges: declare → in-thread KEY 2
ORGUSAGE
      exit 2
    fi
    # Self-locate the CLI so recursive calls survive cwd / PATH ambiguity.
    ORG_CLI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    # Determine root shape from inputs:
    #   --child given        → funnel
    #   --action given       → cell with that action
    #   neither              → judgment (agent-judges)
    if [ "${#ORG_CHILDREN[@]}" -gt 0 ]; then
      ROOT_ACTION="funnel"
    elif [ -n "$ORG_ACTION" ]; then
      ROOT_ACTION="$ORG_ACTION"
    else
      ROOT_ACTION="agent-judges"
    fi
    # 1. Declare root
    declare -a DECL_ARGS
    DECL_ARGS=(declare "$ORG_PLAN" --action "$ROOT_ACTION" --no-drive)
    [ -n "$ORG_PARENT" ] && DECL_ARGS+=(--parent "$ORG_PARENT")
    ROOT_OUT=$("$ORG_CLI" "${DECL_ARGS[@]}" 2>&1)
    ROOT_ID=$(printf '%s\n' "$ROOT_OUT" | grep -oE 'declared: [a-f0-9]{8}' | awk '{print $2}' | head -1)
    if [ -z "$ROOT_ID" ]; then
      echo "ERROR: organism failed to declare root" >&2
      printf '%s\n' "$ROOT_OUT" >&2
      exit 1
    fi
    # 2. Spawn children (if any)
    declare -a CHILD_IDS
    CHILD_IDS=()
    for _i in "${!ORG_CHILDREN[@]}"; do
      _spec="${ORG_CHILDREN[$_i]}"
      _cplan="${_spec%%|*}"
      _cact="${_spec#*|}"
      [ "$_cact" = "$_spec" ] && _cact="agent-judges"
      _out=$("$ORG_CLI" declare "$_cplan" --action "$_cact" --parent "$ROOT_ID" --no-drive 2>&1)
      _cid=$(printf '%s\n' "$_out" | grep -oE 'declared: [a-f0-9]{8}' | awk '{print $2}' | head -1)
      if [ -z "$_cid" ]; then
        echo "ERROR: organism failed to spawn child '$_cplan'" >&2
        exit 1
      fi
      CHILD_IDS+=("$_cid")
    done
    # 3. Iterate-all + auto-mark + propagate
    echo
    echo "=== ORGANISM ${ROOT_ID} — plan: ${ORG_PLAN:0:100} ==="
    echo "  shape: $ROOT_ACTION; children: ${#CHILD_IDS[@]}"
    LEAVES_PASS=0
    LEAVES_FAIL=0
    declare -a FAIL_DETAILS
    FAIL_DETAILS=()
    if [ "${#CHILD_IDS[@]}" -gt 0 ]; then
      # Funnel form: iterate each leaf, auto-mark on PASS
      for _i in "${!CHILD_IDS[@]}"; do
        _cid="${CHILD_IDS[$_i]}"
        _cplan_short="${ORG_CHILDREN[$_i]%%|*}"
        _iter_out=$("$ORG_CLI" iterate "$_cid" 2>&1)
        if printf '%s\n' "$_iter_out" | grep -qE "result: (PASS|AGENT-JUDGES)"; then
          "$ORG_CLI" _mark "$_cid" satisfied \
            --proof-skip "organism in-thread KEY 2 — leaf $((_i+1))/${#CHILD_IDS[@]} converged via organism $ROOT_ID" > /dev/null 2>&1 || true
          LEAVES_PASS=$((LEAVES_PASS + 1))
          echo "  leaf $((_i+1))/${#CHILD_IDS[@]} ($_cid): PASS — ${_cplan_short:0:60}"
        else
          LEAVES_FAIL=$((LEAVES_FAIL + 1))
          _reason=$(printf '%s\n' "$_iter_out" | grep -E "result: FAIL|ERROR|MISSING|UNAVAILABLE" | head -1)
          FAIL_DETAILS+=("$_cid — ${_cplan_short:0:60} — ${_reason:-no detail}")
          echo "  leaf $((_i+1))/${#CHILD_IDS[@]} ($_cid): FAIL — ${_cplan_short:0:60}"
        fi
      done
    else
      # Single-claim form: iterate root directly
      _iter_out=$("$ORG_CLI" iterate "$ROOT_ID" 2>&1)
      if printf '%s\n' "$_iter_out" | grep -qE "result: (PASS|AGENT-JUDGES)"; then
        LEAVES_PASS=1
      else
        LEAVES_FAIL=1
        _reason=$(printf '%s\n' "$_iter_out" | grep -E "result: FAIL|ERROR|MISSING|UNAVAILABLE" | head -1)
        FAIL_DETAILS+=("$ROOT_ID — root — ${_reason:-no detail}")
      fi
    fi
    # 4. Mark root if all leaves converged
    echo
    if [ "$LEAVES_FAIL" = "0" ]; then
      "$ORG_CLI" _mark "$ROOT_ID" satisfied \
        --proof-skip "organism converged: $LEAVES_PASS leaf(s) passed in-thread, agent KEY 2 fired on read" > /dev/null 2>&1 || true
      echo "=== ORGANISM CONVERGED ==="
      echo "  root:      $ROOT_ID"
      echo "  shape:     $ROOT_ACTION"
      echo "  leaves:    $LEAVES_PASS/$LEAVES_PASS passed"
      echo "  result:    PASS"
      exit 0
    fi
    echo "=== ORGANISM PENDING ==="
    echo "  root:      $ROOT_ID  (stays pending — leaves remain)"
    echo "  leaves:    $LEAVES_PASS passed, $LEAVES_FAIL failed"
    for _f in "${FAIL_DETAILS[@]}"; do
      echo "  - $_f"
    done
    echo
    echo "  Fix: address the failing leaf(s), then re-iterate the leaf id directly"
    echo "  (root organ auto-marks when all leaves satisfy)."
    echo "  result: FAIL (organism root $ROOT_ID pending)"
    exit 1
    ;;
  bind-script)
    # contract bind-script <contract-id> <local-script-path>
    #
    # Plank 10 of DEFERRED-MEGA-VISION 386497eb (generated-code KV cache).
    # Scripts are NOT the source of truth — contracts are; scripts are cached
    # artifacts. This verb pushes a script's body into the ledger as a
    # `script_bound` event (SHA-256 content-hashed, base64-encoded inline body)
    # and the existing unbrowse-mirror hook auto-mirrors that row to the
    # unbrowse KV per Π4. The local file is now hydratable from anywhere the
    # ledger reaches — fresh clone, container, ssh'd account.
    BS_ID="${1:-}"
    BS_PATH="${2:-}"
    if [ -z "$BS_ID" ] || [ -z "$BS_PATH" ]; then
      echo "usage: contract bind-script <contract-id> <local-script-path>" >&2
      echo "  Appends a script_bound event carrying the file's body (b64) + SHA-256." >&2
      echo "  Mirrors via unbrowse-mirror hook to the KV cache for cross-host hydrate." >&2
      exit 2
    fi
    [ -f "$BS_PATH" ] || { echo "ERROR: file not found: $BS_PATH" >&2; exit 2; }
    BS_CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" \
    BS_ID="$BS_ID" BS_PATH="$BS_PATH" python3 <<'BIND_PY'
import sys, os, base64, hashlib, datetime
sys.path.insert(0, os.path.join(os.environ["BS_CLI_DIR"], "lib"))
from contract_core import _append, get
cid = os.environ["BS_ID"]
path = os.environ["BS_PATH"]
c = get(cid)
if not c:
    print(f"ERROR: contract {cid} not found in this scope's ledger", file=sys.stderr)
    sys.exit(1)
body = open(path, "rb").read()
sha = hashlib.sha256(body).hexdigest()[:16]
abs_path = os.path.abspath(path)
ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
row = {
    "event": "script_bound",
    "id": cid,
    "ts": ts,
    "code_path": abs_path,
    "code_hash": sha,
    "code_size": len(body),
    "code_body_b64": base64.b64encode(body).decode("ascii"),
}
_append(row)
print(f"  bound: cid={cid} sha={sha} size={len(body)}B path={abs_path}")
print(f"  hydrate: contract hydrate-script {cid}")
BIND_PY
    ;;
  hydrate-script)
    # contract hydrate-script <contract-id> [--to <override-path>]
    #
    # Reconstructs a script from the latest `script_bound` event for the
    # given contract. Decodes body, verifies SHA matches stored hash, writes
    # to code_path (or --to override). When the local ledger is fresh-clone /
    # container / ssh'd account, the script_bound row reached here via the
    # unbrowse-mirror sync — Π4 transport doing what it was built for.
    HS_ID="${1:-}"; shift || true
    HS_TO=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --to) shift; HS_TO="${1:-}"; shift ;;
        *) echo "ERROR: unknown arg to hydrate-script: '$1'" >&2; exit 2 ;;
      esac
    done
    [ -z "$HS_ID" ] && { echo "usage: contract hydrate-script <contract-id> [--to <override-path>]" >&2; exit 2; }
    HS_CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" \
    HS_ID="$HS_ID" HS_TO="$HS_TO" python3 <<'HYD_PY'
import sys, os, base64, hashlib
sys.path.insert(0, os.path.join(os.environ["HS_CLI_DIR"], "lib"))
from contract_core import _rows, get
cid = os.environ["HS_ID"]
override = os.environ.get("HS_TO", "")
bound_rows = [r for r in _rows() if r.get("id") == cid and r.get("event") == "script_bound"]
if not bound_rows:
    sys.stdout.write("\n  === SCRIPT MISSING ===\n")
    sys.stdout.write(f"  reason:  no script_bound row found for contract {cid} in this ledger\n")
    sys.stdout.write(f"  fix:     contract bind-script {cid} <local-path>\n")
    sys.stdout.write(f"           (or sync the unbrowse mirror via the unbrowse-mirror hook —\n")
    sys.stdout.write(f"            requires UNBROWSE_API_KEY + UNBROWSE_BASE)\n\n")
    print(f"  result: FAIL (no script_bound row for {cid})")
    sys.exit(1)
row = bound_rows[-1]  # latest wins
try:
    body = base64.b64decode(row["code_body_b64"])
except Exception as e:
    print(f"  result: FAIL (script_bound row body unparseable: {e})")
    sys.exit(1)
sha_actual = hashlib.sha256(body).hexdigest()[:16]
sha_stored = row.get("code_hash", "")
if sha_actual != sha_stored:
    print(f"  result: FAIL — sha mismatch: stored={sha_stored} actual={sha_actual}")
    sys.exit(1)
target = override or row.get("code_path")
if not target:
    print(f"  result: FAIL (no code_path on row and no --to override)")
    sys.exit(1)
parent = os.path.dirname(target)
if parent:
    os.makedirs(parent, exist_ok=True)
with open(target, "wb") as f:
    f.write(body)
# Preserve exec bit if it was a script-shaped path (heuristic: extensions or shebang)
head = body[:64]
if target.endswith((".sh", ".py")) or head.startswith(b"#!"):
    try:

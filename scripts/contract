    if l.startswith('declared:'):
        print(l.split(':',1)[1].strip()); break
" <<< "$DECLARE_OUT")
        echo "  + child $((SCAN_COUNT+1)): $CHILD_ID  \"${CHILD_PLAN:0:60}\""
        SCAN_COUNT=$((SCAN_COUNT + 1))
      fi

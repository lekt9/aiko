waiting = []
for cid, jr in latest_judged.items():
    if jr.get('verdict') not in ('HOLD', 'REJECT'):
        continue
    blockers = jr.get('blocked_by') or []
    if not blockers:
        continue
    c = get(cid)
    if not c or c.get('status') == 'satisfied':
        continue
    # Re-resolve every blocker's current status
    blocker_states = [(b, (get(b) or {}).get('status', '?')) for b in blockers]
    all_done = all(st == 'satisfied' for _, st in blocker_states)
    (ready if all_done else waiting).append((cid, c.get('plan', '?'), jr.get('verdict'), blocker_states))

if os.environ.get('MH_JSON'):
    print(json.dumps({'ready': [{'id': cid, 'verdict': v, 'plan': p, 'blockers': bs} for cid, p, v, bs in ready],
                       'waiting': [{'id': cid, 'verdict': v, 'plan': p, 'blockers': bs} for cid, p, v, bs in waiting]},
                      indent=2))
    raise SystemExit(0)

print('=== Ω1 UNBLOCKED (re-judgeable now) ===')
if not ready:
    print('  (no HOLD/REJECT contracts have all their blockers satisfied yet)')
else:
    for cid, plan, verdict, bs in ready:
        print(f'  🔓 {cid}  [{verdict}]  \"{plan[:60]}\"')
        for b, st in bs:
            print(f'      blocker {b}  [{st}]')
        print(f'      -> contract judge {cid}')

      _child_id=$(printf '%s\n' "$_child_out" | grep -oE 'declared: [a-f0-9]{8}' | awk '{print $2}' | head -1)
      if [ -z "$_child_id" ]; then
        echo "ERROR: failed to spawn route child for spec '$_spec'" >&2
        printf '%s\n' "$_child_out" >&2
        exit 1
      fi
      ROUTE_CHILD_IDS+=("$_child_id")
    done
    # 3) Iterate children in declared order until one PASSes.
    echo
    echo "=== CONTRACT ROUTE — organ $ROUTE_ORGAN_ID, ${#ROUTE_TRIES[@]} candidate(s) ==="
    _winner_id=""
    _winner_spec=""
    declare -a _failures
    _failures=()
    for _i in "${!ROUTE_CHILD_IDS[@]}"; do
      _cid="${ROUTE_CHILD_IDS[$_i]}"
      _spec="${ROUTE_TRIES[$_i]}"
      echo "  candidate $((_i+1))/${#ROUTE_CHILD_IDS[@]}: $_spec"
      _iter_out=$("$ROUTE_CLI" iterate "$_cid" 2>&1)
      if printf '%s\n' "$_iter_out" | grep -q "result: PASS"; then
        "$ROUTE_CLI" _mark "$_cid" satisfied \
          --proof "contract route — candidate $((_i+1))/${#ROUTE_CHILD_IDS[@]} PASSed (spec: $_spec)" > /dev/null 2>&1 || true
        _winner_id="$_cid"
        _winner_spec="$_spec"
        echo "  → PASS (winner)"
        break
      else
        _reason=$(printf '%s\n' "$_iter_out" | grep -E "result: FAIL|MISSING|UNAVAILABLE|exit=" | head -2 | tr '\n' ' ' | sed 's/  */ /g')
        _failures+=("$_spec  ::  ${_reason:-no failure detail}")
        echo "  → FAIL"
      fi
    done
    echo
    if [ -n "$_winner_id" ]; then
      "$ROUTE_CLI" _mark "$ROUTE_ORGAN_ID" satisfied \
        --proof "contract route resolved via candidate: $_winner_spec (child $_winner_id)" > /dev/null 2>&1 || true
      echo "  result: PASS (organ=$ROUTE_ORGAN_ID winner_child=$_winner_id backend=$_winner_spec)"
      exit 0
    fi
    echo "  === ROUTE FAILED ==="
    echo "  organ:     $ROUTE_ORGAN_ID"
    echo "  attempted: ${#ROUTE_TRIES[@]} backend(s), none available on this machine"
    for _f in "${_failures[@]}"; do
      echo "  - $_f"
    done
    echo
    echo "  Fix: provide an additional --try spec for a backend that IS available,"
    echo "  OR install / configure one of the attempted backends, then re-iterate $ROUTE_ORGAN_ID"
    echo "  result: FAIL (no backend available — route organ $ROUTE_ORGAN_ID)"
    exit 1
    ;;
  capabilities)
    # contract capabilities [--refresh] [--json]
    #
    # Plank 3+4 of 386497eb (machine-capabilities auto-probe + package-manager detection).
    # Probes the iterate-time machine for binaries, package managers, and L1 backends.
    # Caches at ~/.config/contract/machine-capabilities.json so the route verb can
    # surface candidate specs without re-probing every iterate. The 'install' verb
    # (and future docs/skills delegation) reads this cache to know what's available
    # vs what needs install/fallback.
    CAP_REFRESH=""
    CAP_JSON=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --refresh) CAP_REFRESH=1; shift ;;
        --json) CAP_JSON=1; shift ;;
        *) echo "ERROR: unknown arg: '$1'" >&2; exit 2 ;;
      esac
    done
    CAP_REFRESH="$CAP_REFRESH" CAP_JSON="$CAP_JSON" python3 <<'CAP_PY'
import json, os, platform, shutil, subprocess, sys
from pathlib import Path

CACHE = Path.home() / ".config" / "contract" / "machine-capabilities.json"
CACHE.parent.mkdir(parents=True, exist_ok=True)

# Binaries we care about for L1 backend dispatch + cli composition + install path.
BINARIES = [
    "python3", "node", "bun", "deno",        # runtimes
    "gh", "git",                              # github + vcs
    "brew", "apt", "apt-get", "nix", "pacman",  # package managers
    "nanobrew",                                # justrach/nanobrew (gap-filler)
    "sandbox-exec",                            # macOS native sandbox
    "docker", "podman",                        # container runtimes
    "ssh", "curl", "wget",                    # transport
    "jq", "rg", "fd", "fzf",                  # search/parse helpers
]
PKG_MGRS = ["brew", "apt-get", "apt", "nix", "pacman", "nanobrew"]
# L1 backend tiers (pointer_type → availability check)
BACKENDS = {
    "machine":       lambda: True,                                  # always — falls back to PATH
    "sandbox":       lambda: bool(os.environ.get("TURBOBOX_API_KEY")),
    "runpod":        lambda: bool(os.environ.get("RUNPOD_API_KEY")),
    "bun":           lambda: bool(shutil.which("bun")),
    "macos-sandbox": lambda: platform.system() == "Darwin" and bool(shutil.which("sandbox-exec")),
    "docker":        lambda: bool(shutil.which("docker")),
}

refresh = bool(os.environ.get("CAP_REFRESH"))
emit_json = bool(os.environ.get("CAP_JSON"))

if CACHE.exists() and not refresh:
    cap = json.loads(CACHE.read_text())
else:
    bins = {}
    for b in BINARIES:
        p = shutil.which(b)
        bins[b] = p if p else None
    pkg_mgr = next((m for m in PKG_MGRS if bins.get(m)), None)
    backends = {name: probe() for name, probe in BACKENDS.items()}
    cap = {
        "host":            platform.node(),
        "os":              platform.system(),
        "arch":            platform.machine(),
        "binaries":        bins,
        "package_manager": pkg_mgr,
        "backends":        backends,
        "ts":              __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat().replace("+00:00", "Z"),
    }
    CACHE.write_text(json.dumps(cap, indent=2))

if emit_json:
    print(json.dumps(cap, indent=2))
else:
    print(f"  host:    {cap['host']} ({cap['os']}/{cap['arch']})")
    print(f"  cache:   {CACHE}")
    print(f"  ts:      {cap['ts']}")
    avail_bins = sorted(k for k, v in cap["binaries"].items() if v)
    missing_bins = sorted(k for k, v in cap["binaries"].items() if not v)
    print(f"  binaries (present, {len(avail_bins)}): {', '.join(avail_bins) if avail_bins else '(none)'}")
    print(f"  binaries (missing, {len(missing_bins)}): {', '.join(missing_bins) if missing_bins else '(none)'}")
    print(f"  package_manager: {cap['package_manager'] or '(none detected)'}")
    avail_be = sorted(k for k, v in cap["backends"].items() if v)
    miss_be = sorted(k for k, v in cap["backends"].items() if not v)
    print(f"  backends (available, {len(avail_be)}): {', '.join(avail_be) if avail_be else '(none)'}")
    print(f"  backends (unavailable, {len(miss_be)}): {', '.join(miss_be) if miss_be else '(none)'}")
    print(f"")
    print(f"  result: PASS (capabilities probed, {len(avail_bins)} binaries + {len(avail_be)} backends available)")
CAP_PY
    ;;
  identify)
    # contract identify <handle> [--refresh] [--from-stub <path>]
    #
    # Enrich any internet identifier (email, @handle, did:lens:..., 0x..., ens.eth)
    # via external resolvers, cache the resolved record into the profile JSON.
    # Look-aside cache: local cache HIT (and not --refresh) avoids any network.
    # Stub path injects a fixture JSON for tests instead of probing.
    #
    # Resolvers (best-effort, never raise):
    #   email like name@domain    → gravatar (md5 hash → URL pattern)
    #   @handle                   → github API (rate-limited public path)
    #   *.eth / 0x... / did:*     → marker only (no provider this turn — captured
    #                                as a deferred enrichment plank)
    #
    # Cache: writes resolved={kind, sources, profile_url?, avatar_url?, ts_resolved,
    # ttl_until} alongside the existing profile fields. Appends identity_resolved
    # ledger row on every refresh.
    ID_HANDLE="${1:-}"; shift || true

import os, sys
task = sys.argv[1].lower()
tokens = set(w.strip('.,;:!?()[]') for w in task.split() if len(w) > 3)
skills_dir = os.path.expanduser('~/.claude/skills')
matches = []
try:
    for skill in os.listdir(skills_dir):
        if skill.startswith('_') or '.' in skill:
            continue
        sl = skill.lower().replace('-', ' ')
        parts = sl.split()
        score = sum(1 for t in tokens if t in parts or t in sl)
        if score > 0:
            matches.append((score, skill))
    matches.sort(reverse=True)
    for score, skill in matches[:8]:
        print(f'  ({score}) {skill}')
    if not matches:
        print('  (no skill name matches)')
except Exception as e:
    print(f'  (skill scan error: {e})')
PYSKILL
    echo ""
    echo "--- BINARY PRIMITIVES ---"

import os, json, sys
from datetime import datetime
from collections import defaultdict
from contract_core import _rows, get_corroborations, get

window = int(os.environ['MH_WINDOW'])
thresh = int(os.environ['MH_THRESHOLD'])

# Collect all iterated events with their ts (epoch seconds)
events = []
for r in _rows():
    if r.get('event') == 'iterated' and r.get('id') and r.get('ts'):
        try:
            ts = datetime.fromisoformat(r['ts'].replace('Z','+00:00')).timestamp()
            events.append((ts, r['id']))
        except Exception:
            continue
events.sort()

# Count co-iteration pairs within window. Sliding window over sorted events.
pair_count = defaultdict(int)
n = len(events)
for i, (ts_i, id_i) in enumerate(events):
    for j in range(i+1, n):
        ts_j, id_j = events[j]
        if ts_j - ts_i > window:
            break
        if id_i == id_j:
            continue
        key = tuple(sorted([id_i, id_j]))
        pair_count[key] += 1

# Filter: above threshold AND not already corroborated
candidates = []
for (a, b), n_co in sorted(pair_count.items(), key=lambda kv: -kv[1]):
    if n_co < thresh:
        continue
    existing = set(get_corroborations(a))
    if b in existing:
        continue
    ca = get(a); cb = get(b)
    if not ca or not cb:
        continue
    candidates.append({
        'a': a, 'b': b, 'co_iterations': n_co,
        'plan_a': ca.get('plan',''), 'plan_b': cb.get('plan',''),
        'status_a': ca.get('status'), 'status_b': cb.get('status'),
    })

if os.environ.get('MH_JSON'):
    print(json.dumps({'window_seconds': window, 'threshold': thresh,
                      'count': len(candidates), 'candidates': candidates}, indent=2))
else:
    print('=== CONTRACT SYNAPSE (Hebbian co-iteration scan) ===')
    print('  window: %ds    threshold: %d co-iterations' % (window, thresh))
    if not candidates:
        print('  no co-iteration pairs above threshold (no existing-corroboration overlap).')
        print()
        print('  Hebbian principle: cells that fire together wire together.')
        print('  raise --window or lower --threshold to surface weaker correlations.')
    else:
        print('  %d candidate synapse(s) — pairs co-iterated together but not yet corroborated:' % len(candidates))
        for c in candidates:
            aid = c['a']; bid = c['b']
            a_plan = c['plan_a'][:60]; b_plan = c['plan_b'][:60]
            a_st = c['status_a']; b_st = c['status_b']
            n_co = c['co_iterations']
            print('  [%dx]  %s <-> %s' % (n_co, aid, bid))
            print('         %s: %s   [%s]' % (aid, a_plan, a_st))
            print('         %s: %s   [%s]' % (bid, b_plan, b_st))
            print('         -> contract corroborate %s %s  # if behaviorally related' % (aid, bid))
        print()
        print('  substrate surfaces; agent decides. corroborate is the synapse — never auto-fired.')
"
    ;;

  telegram-poll)

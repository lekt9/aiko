    print('=== Ω1 STILL WAITING ===')
    for cid, plan, verdict, bs in waiting:
        pending = [b for b, st in bs if st != 'satisfied']
        print(f'  ⏳ {cid}  [{verdict}]  blocked by {len(pending)}: {\", \".join(pending[:3])}')
        print(f'      \"{plan[:60]}\"')
"
    ;;

  watch)
    # Ψ4 — async watcher. Programmatic poller that periodically checks an
    # external condition (or the contract's own action) and auto-iterates
    # the contract when it PASSes. Composes with Ω1: when the watcher's
    # iterate flips the contract to satisfied, the wavefront re-surfaces
    # every dependent HOLD'd contract for re-judgement.
    #
    # The substrate enables; it never bakes a verdict. The watcher fires
    # the iterate (mechanical KEY 1); the agent still owns KEY 2 on the
    # _mark satisfied. The tick is one-shot — once the probe flips, the
    # watcher writes its inbox event, iterates the contract, and removes
    # itself. Re-register if you want continued polling.
    #
    # Subcommands: register | list | tick | stop. Origin: contract <Ψ4-id>.
    SUB="${1:-help}"; shift || true
    WATCHERS_DIR="$HOME/.contracts/watchers"
    INBOX_DIR="$HOME/.contracts/inbox/watcher"
    mkdir -p "$WATCHERS_DIR" "$INBOX_DIR" 2>/dev/null

    # Default form `contract watch <id> [args]` — when SUB is not a known
    # subcommand, treat it as the id for register. This lets the common
    # case (the one Lewis's request names) be the shortest invocation.
    case "$SUB" in
      register|list|tick|stop|help|"") : ;;
      *) set -- "$SUB" "$@"; SUB="register" ;;
    esac

    case "$SUB" in
      register|"")
        if [ "$SUB" = "" ] || [ -z "${1:-}" ]; then
          cat >&2 <<'USAGE'
usage:
  contract watch <id> [--probe "<cmd>"] [--interval <s>]   # register a watcher
  contract watch list [--json]                              # list registered watchers
  contract watch tick                                       # one poll cycle (all watchers)
  contract watch stop <id>                                  # remove a watcher
USAGE
          exit 2
        fi
        # Default form: `contract watch <id> [args]` (SUB held the id).
        # Explicit form: `contract watch register <id> [args]`.
        if [ "$SUB" = "register" ]; then
          W_ID="${1:-}"; shift || true
        else
          W_ID="$SUB"
        fi
        [ -z "$W_ID" ] && { echo "usage: contract watch <id> [--probe \"<cmd>\"] [--interval <s>]" >&2; exit 2; }
        W_PROBE=""
        W_INTERVAL="60"
        while [ $# -gt 0 ]; do
          case "$1" in
            --probe)    W_PROBE="${2:-}"; shift 2 ;;
            --interval) W_INTERVAL="${2:-60}"; shift 2 ;;
            *) shift ;;
          esac
        done
        # Verify the contract exists — refuse to register a watcher on a phantom
        EXISTS=$(MH_ID="$W_ID" _py_inline "
import os; from contract_core import get
c = get(os.environ['MH_ID']); print('yes' if c else 'no')
")
        [ "$EXISTS" = "yes" ] || { echo "ERROR: contract $W_ID not found — declare it first" >&2; exit 3; }
        TS=$(date -u +%FT%TZ)
        # Use python3 to write valid JSON (handles probe escaping safely)
        W_ID="$W_ID" W_PROBE="$W_PROBE" W_INT="$W_INTERVAL" W_TS="$TS" W_FILE="$WATCHERS_DIR/$W_ID.json" python3 -c "

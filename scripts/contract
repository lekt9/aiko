import datetime, json, os, sys
sys.path.insert(0, os.path.join(os.environ["MA_CLI_DIR"], "lib"))
try: from contract_core import current_agent, _append, _rows
except ImportError:
    current_agent = lambda: ""; _append = lambda r: None; _rows = lambda: []
mid = os.environ["MA_ID"]
agent = (current_agent() or "anonymous").strip()
ts = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
sent = None; completed = 0; assigned = None; last_step_event = None
for r in _rows():
    if r.get("mail_id") != mid: continue
    if r["event"] == "mail_sent": sent = r
    elif r["event"] == "mail_step_complete":
        completed += 1
        last_step_event = "complete"
        assigned = None  # detach on every complete
    elif r["event"] == "mail_step_assigned":
        assigned = r.get("agent")
        last_step_event = "assigned"
if not sent:
    print(f"  ERROR: no mail with id {mid}", file=sys.stderr); sys.exit(1)
if not assigned or last_step_event != "assigned":
    print(f"  ERROR: no current assignment for mail {mid} — run 'contract mailbox step-next {mid}' first to attach an agent", file=sys.stderr)
    sys.exit(1)
if assigned != agent:
    print(f"  ERROR: mail {mid} is assigned to '{assigned}' but caller is '{agent}' — only the assigned agent can step-complete (prevents rogue advance)", file=sys.stderr)
    sys.exit(1)
step_num = completed + 1
total = sent.get("total_steps", 1)
_append({
    "event": "mail_step_complete", "id": f"mail-{mid}-step-{step_num}",
    "mail_id": mid, "step": step_num, "proof": os.environ["MA_PROOF"],
    "agent": agent, "ts": ts,
})
print(f"  mail_id:      {mid}")
print(f"  step:         {step_num}/{total}  COMPLETE")
print(f"  proof:        {os.environ['MA_PROOF'][:120]}")
print(f"  by_agent:     {agent}")
print(f"  detached:     YES (assigned_agent cleared — next agent attaches via step-next + reads mailbox cold)")
if step_num >= total:
    print(f"  state:        COMPLETED (all {total} steps done)")
else:
    print(f"  next:         contract mailbox step-next {mid}   (assigns step {step_num+1})")
print(f"  result:       PASS")
MA_DONE_PY
        ;;
      step-next)
        MA_ID="${1:-}"

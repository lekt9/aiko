#!/usr/bin/env bash
set -euo pipefail

# aiko-install — install the complete portable Aiko product from the private
# Gitea generic package registry. Component-only installs are intentionally
# unsupported: the bundled install.sh admits Aiko + Neuron + Cell + Contract.

GITEA_URL="${GITEA_URL:-http://100.124.140.92:3000}"
GITEA_TOKEN="${GITEA_TOKEN:-}"
GITEA_ORG="${GITEA_ORG:-Unbrowse}"
AIKO_HOME="${AIKO_HOME:-$HOME/.aiko}"
AIKO_BIN_DIR="${AIKO_BIN_DIR:-$HOME/.local/bin}"
AIKO_LIB_DIR="${AIKO_LIB_DIR:-$AIKO_HOME/lib}"
MANIFEST_URL="${MANIFEST_URL:-$GITEA_URL/$GITEA_ORG/aiko-sdk/raw/branch/main/versions.lock}"

info() { printf 'ℹ  %s\n' "$*"; }
err() { printf '✗  %s\n' "$*" >&2; }
http_get() {
    local url="$1" dest="$2" args=(-sfL)
    [[ -z "$GITEA_TOKEN" ]] || args+=(-H "Authorization: token $GITEA_TOKEN")
    curl "${args[@]}" -o "$dest" "$url"
}
platform() {
    case "$(uname -s):$(uname -m)" in
        Linux:x86_64|Linux:amd64) echo linux-x86_64 ;;
        Linux:aarch64|Linux:arm64) echo linux-aarch64 ;;
        Darwin:x86_64|Darwin:amd64) echo macos-x86_64 ;;
        Darwin:arm64|Darwin:aarch64) echo macos-aarch64 ;;
        *) err "Unsupported platform: $(uname -s) $(uname -m)"; return 1 ;;
    esac
}
sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
    else shasum -a 256 "$1" | awk '{print $1}'; fi
}
validate_archive() {
    python3 - "$1" <<'PY'
import posixpath, sys, tarfile
archive = sys.argv[1]
with tarfile.open(archive, "r:gz") as tf:
    members = tf.getmembers()
    symlinks = set()
    for member in members:
        name = member.name
        clean = posixpath.normpath(name)
        if name.startswith("/") or clean == ".." or clean.startswith("../"):
            raise SystemExit(f"unsafe archive member: {name}")
        if member.ischr() or member.isblk() or member.isfifo():
            raise SystemExit(f"special archive member refused: {name}")
        if member.issym() or member.islnk():
            target = member.linkname
            if target.startswith("/"):
                raise SystemExit(f"absolute archive link refused: {name} -> {target}")
            base = posixpath.dirname(clean) if member.issym() else ""
            resolved = posixpath.normpath(posixpath.join(base, target))
            if resolved == ".." or resolved.startswith("../"):
                raise SystemExit(f"escaping archive link refused: {name} -> {target}")
            if member.issym():
                symlinks.add(clean)
    for member in members:
        clean = posixpath.normpath(member.name)
        parts = clean.split("/")
        for i in range(1, len(parts)):
            if "/".join(parts[:i]) in symlinks:
                raise SystemExit(f"archive member traverses symlink: {member.name}")
PY
}
fetch_version() {
    local manifest="$1"
    http_get "$MANIFEST_URL" "$manifest" || { err "Cannot fetch $MANIFEST_URL"; return 1; }
    sed -n 's/^aiko=//p' "$manifest" | head -1
}
list_versions() {
    local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/aiko-versions.XXXXXX")
    AIKO_INSTALL_WORK="$tmp"
    trap 'rm -rf "${AIKO_INSTALL_WORK:-}"' EXIT
    http_get "$MANIFEST_URL" "$tmp"
    cat "$tmp"
}
install_portable() {
    local requested="${1:-}" work version plat name base expected got root count
    work=$(mktemp -d "${TMPDIR:-/tmp}/aiko-install.XXXXXX")
    AIKO_INSTALL_WORK="$work"
    trap 'rm -rf "${AIKO_INSTALL_WORK:-}"' EXIT
    version="$requested"
    [[ -n "$version" ]] || version=$(fetch_version "$work/versions.lock")
    [[ -n "$version" ]] || { err "versions.lock has no aiko version"; return 1; }
    plat=$(platform)
    name="aiko-${version}-${plat}.tar.gz"
    base="$GITEA_URL/api/packages/$GITEA_ORG/generic/aiko/$version"
    info "Downloading complete Aiko $version ($plat)"
    http_get "$base/$name" "$work/$name" || { err "Failed to download $base/$name"; return 1; }
    http_get "$base/$name.sha256" "$work/$name.sha256" || { err "Missing SHA256 sidecar for $name"; return 1; }
    expected=$(awk 'NF {print $1; exit}' "$work/$name.sha256")
    got=$(sha256_file "$work/$name")
    expected=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
    got=$(printf '%s' "$got" | tr '[:upper:]' '[:lower:]')
    [[ "$expected" =~ ^[0-9a-f]{64}$ && "$expected" == "$got" ]] || {
        err "SHA256 mismatch for $name"; return 1;
    }
    validate_archive "$work/$name"
    mkdir "$work/extract"
    tar -xzf "$work/$name" -C "$work/extract"
    count=$(find "$work/extract" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')
    [[ "$count" == 1 ]] || { err "Portable archive must contain exactly one root"; return 1; }
    root=$(find "$work/extract" -mindepth 1 -maxdepth 1 -print)
    [[ -d "$root" && -f "$root/install.sh" ]] || { err "Portable archive root is missing install.sh"; return 1; }
    chmod 755 "$root/install.sh"
    info "Archive verified; invoking bundled complete-product installer"
    AIKO_HOME="$AIKO_HOME" AIKO_BIN_DIR="$AIKO_BIN_DIR" AIKO_LIB_DIR="$AIKO_LIB_DIR" "$root/install.sh"
}
usage() {
    cat <<'EOF'
Usage: aiko-install [--version VERSION] [--update] [--list]

Installs one verified portable package containing mandatory Aiko, Neuron, Cell,
and Contract. Component-only installs are not supported.
EOF
}
main() {
    local version=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version) [[ $# -ge 2 ]] || { err "--version needs a value"; return 2; }; version="$2"; shift 2 ;;
            --update) shift ;;
            --list) list_versions; return ;;
            -h|--help) usage; return ;;
            *) err "Component targets and unknown arguments are not supported: $1"; usage >&2; return 2 ;;
        esac
    done
    install_portable "$version"
}
main "$@"

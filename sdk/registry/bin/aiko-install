#!/usr/bin/env bash
set -euo pipefail

# aiko-install — Unified installer for the Aiko stack
# Pulls pinned versions of contract (libcontract.dylib), neuron (binary),
# and aiko (binary) from the Gitea package registry over Tailscale.
#
# Usage:
#   aiko-install                    # install everything at pinned versions
#   aiko-install contract           # install only libcontract
#   aiko-install neuron             # install only neuron
#   aiko-install aiko               # install only aiko binary
#   aiko-install --version 0.2.0    # install specific version
#   aiko-install --list             # list available versions
#   aiko-install --update           # update to latest pinned versions

GITEA_URL="${GITEA_URL:-http://100.124.140.92:3000}"
GITEA_TOKEN="${GITEA_TOKEN:-}"
GITEA_ORG="Unbrowse"

# Single source of truth — same as scripts/lib/aiko-env.sh
AIKO_HOME="${AIKO_HOME:-$HOME/.aiko}"
AIKO_BIN_DIR="${AIKO_BIN_DIR:-$HOME/.local/bin}"
AIKO_LIB_DIR="${AIKO_LIB_DIR:-$AIKO_HOME/lib}"

# Version manifest — the single source of truth for pinned versions
# Update this file to bump versions across all machines
MANIFEST_URL="$GITEA_URL/$GITEA_ORG/aiko-sdk/raw/branch/main/versions.lock"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}ℹ${NC}  $*"; }
ok()    { echo -e "${GREEN}✓${NC}  $*"; }
warn()  { echo -e "${YELLOW}⚠${NC}  $*"; }
err()   { echo -e "${RED}✗${NC}  $*" >&2; }

# ─── HTTP helper ───────────────────────────────────────────────────────────

http_get() {
    local url="$1"
    local dest="${2:-}"
    if [[ -n "$GITEA_TOKEN" ]]; then
        if [[ -n "$dest" ]]; then
            curl -sfL -H "Authorization: token $GITEA_TOKEN" -o "$dest" "$url"
        else
            curl -sfL -H "Authorization: token $GITEA_TOKEN" "$url"
        fi
    else
        if [[ -n "$dest" ]]; then
            curl -sfL -o "$dest" "$url"
        else
            curl -sfL "$url"
        fi
    fi
}

http_status() {
    local url="$1"
    if [[ -n "$GITEA_TOKEN" ]]; then
        curl -sI -H "Authorization: token $GITEA_TOKEN" "$url" | head -1
    else
        curl -sI "$url" | head -1
    fi
}

# ─── Version management ────────────────────────────────────────────────────

fetch_manifest() {
    http_get "$MANIFEST_URL" "/tmp/aiko-versions.lock" 2>/dev/null
    if [[ ! -f /tmp/aiko-versions.lock ]] || [[ ! -s /tmp/aiko-versions.lock ]]; then
        err "Cannot fetch version manifest from $MANIFEST_URL"
        err "Check your Tailscale connection and GITEA_TOKEN"
        exit 1
    fi
}

get_version() {
    local package="$1"
    grep "^${package}=" /tmp/aiko-versions.lock 2>/dev/null | cut -d= -f2
}

list_versions() {
    fetch_manifest
    echo "Available pinned versions:"
    while IFS='=' read -r pkg ver; do
        [[ "$pkg" =~ ^# ]] && continue
        [[ -z "$pkg" || -z "$ver" ]] && continue
        printf "  %-15s %s\n" "$pkg" "$ver"
    done < /tmp/aiko-versions.lock
}

# ─── Platform detection ────────────────────────────────────────────────────

detect_platform() {
    local os arch
    os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    arch="$(uname -m)"
    case "$arch" in
        arm64|aarch64) arch="arm64" ;;
        x86_64|amd64)  arch="x86_64" ;;
    esac
    echo "${os}-${arch}"
}

# ─── Package installers ────────────────────────────────────────────────────

install_contract() {
    local version="${1:-$(get_version contract)}"
    local platform
    platform="$(detect_platform)"
    local pkg_name="libcontract-${version}-${platform}.tar.gz"
    local url="$GITEA_URL/api/packages/$GITEA_ORG/generic/contract/${version}/${pkg_name}"

    info "Installing libcontract v${version} (${platform})..."

    mkdir -p "$AIKO_LIB_DIR"
    local tmpfile="/tmp/${pkg_name}"
    if ! http_get "$url" "$tmpfile"; then
        err "Failed to download libcontract v${version}"
        err "URL: $url"
        return 1
    fi

    tar -xzf "$tmpfile" -C "$AIKO_LIB_DIR"
    rm -f "$tmpfile"

    local lib_ext="dylib"
    [[ "$(uname -s)" == "Linux" ]] && lib_ext="so"

    ok "libcontract v${version} installed → $AIKO_LIB_DIR/libcontract.${lib_ext}"
}

install_neuron() {
    local version="${1:-$(get_version neuron)}"
    local platform
    platform="$(detect_platform)"
    local pkg_name="neuron-${version}-${platform}.tar.gz"
    local url="$GITEA_URL/api/packages/$GITEA_ORG/generic/neuron/${version}/${pkg_name}"

    info "Installing neuron v${version} (${platform})..."

    mkdir -p "$AIKO_BIN_DIR"
    local tmpfile="/tmp/${pkg_name}"
    if ! http_get "$url" "$tmpfile"; then
        err "Failed to download neuron v${version}"
        err "URL: $url"
        return 1
    fi

    tar -xzf "$tmpfile" -C "$AIKO_BIN_DIR"
    chmod +x "$AIKO_BIN_DIR/neuron"
    rm -f "$tmpfile"

    ok "neuron v${version} installed → $AIKO_BIN_DIR/neuron"
}

install_aiko() {
    local version="${1:-$(get_version aiko)}"
    local platform
    platform="$(detect_platform)"
    local pkg_name="aiko-${version}-${platform}.tar.gz"
    local url="$GITEA_URL/api/packages/$GITEA_ORG/generic/aiko/${version}/${pkg_name}"

    info "Installing aiko v${version} (${platform})..."

    mkdir -p "$AIKO_BIN_DIR"
    local tmpfile="/tmp/${pkg_name}"
    if ! http_get "$url" "$tmpfile"; then
        err "Failed to download aiko v${version}"
        err "URL: $url"
        return 1
    fi

    tar -xzf "$tmpfile" -C "$AIKO_BIN_DIR"
    chmod +x "$AIKO_BIN_DIR/aiko"
    rm -f "$tmpfile"

    ok "aiko v${version} installed → $AIKO_BIN_DIR/aiko"
}

install_limbs() {
    local version="${1:-$(get_version neuron-limbs)}"
    local url="$GITEA_URL/api/packages/$GITEA_ORG/generic/neuron-limbs/${version}/limbs.tar.gz"

    info "Installing neuron limbs v${version}..."

    mkdir -p "$AIKO_HOME/limbs"
    local tmpfile="/tmp/limbs.tar.gz"
    if ! http_get "$url" "$tmpfile"; then
        warn "Failed to download limbs v${version} (non-fatal)"
        return 0
    fi

    tar -xzf "$tmpfile" -C "$AIKO_HOME/limbs"
    rm -f "$tmpfile"

    ok "neuron limbs v${version} installed → $AIKO_HOME/limbs/"
}

install_all() {
    fetch_manifest

    local contract_ver neuron_ver aiko_ver limbs_ver
    contract_ver=$(get_version contract)
    neuron_ver=$(get_version neuron)
    aiko_ver=$(get_version aiko)
    limbs_ver=$(get_version neuron-limbs)

    echo ""
    info "Installing Aiko stack:"
    info "  contract:     v${contract_ver}"
    info "  neuron:       v${neuron_ver}"
    info "  aiko:         v${aiko_ver}"
    info "  neuron-limbs: v${limbs_ver}"
    info "  platform:     $(detect_platform)"
    echo ""

    # Jesus-graph: after the manifest, packages write different paths — fan out.
    local fails=0
    install_contract "$contract_ver" &
    local p1=$!
    install_neuron "$neuron_ver" &
    local p2=$!
    install_aiko "$aiko_ver" &
    local p3=$!
    install_limbs "$limbs_ver" &
    local p4=$!
    wait "$p1" || fails=$((fails + 1))
    wait "$p2" || fails=$((fails + 1))
    wait "$p3" || fails=$((fails + 1))
    wait "$p4" || fails=$((fails + 1))
    if [[ "$fails" -gt 0 ]]; then
        err "$fails package install(s) failed"
        exit 1
    fi

    echo ""
    ok "Aiko stack installed successfully!"
    echo ""
    info "Add to PATH: export PATH=\"$AIKO_BIN_DIR:\$PATH\""
    info "Verify: aiko --version && neuron --version"
    info "Reinstall / update: aiko-install --update"
}

# ─── Main ──────────────────────────────────────────────────────────────────

main() {
    local specific_version=""
    local target="all"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version) specific_version="$2"; shift 2 ;;
            --list)    list_versions; exit 0 ;;
            --update)  fetch_manifest; install_all; exit 0 ;;
            --help|-h)
                echo "Usage: aiko-install [target] [--version VER] [--list] [--update]"
                echo ""
                echo "Targets:"
                echo "  all       Install everything (default)"
                echo "  contract  Install libcontract only"
                echo "  neuron    Install neuron binary only"
                echo "  aiko      Install aiko binary only"
                echo "  limbs     Install neuron limbs only"
                echo ""
                echo "Options:"
                echo "  --version VER  Install specific version"
                echo "  --list         List available pinned versions"
                echo "  --update       Update to latest pinned versions"
                exit 0
                ;;
            contract|neuron|aiko|limbs|all) target="$1"; shift ;;
            *) err "Unknown argument: $1"; exit 1 ;;
        esac
    done

    case "$target" in
        all)
            if [[ -n "$specific_version" ]]; then
                err "Cannot specify --version with 'all'. Use individual targets."
                exit 1
            fi
            install_all
            ;;
        contract) fetch_manifest; install_contract "$specific_version" ;;
        neuron)   fetch_manifest; install_neuron "$specific_version" ;;
        aiko)     fetch_manifest; install_aiko "$specific_version" ;;
        limbs)    fetch_manifest; install_limbs "$specific_version" ;;
    esac
}

main "$@"

## Local .env for serverless boot. Copy to .env and fill.
## secrets.sh reads these and pushes them into Cloudflare Worker Secrets,
## which the RunPod template (runpod.toml) then sources at cold-start.

# Cloudflare worker name secrets attach to (existing CF Worker or routing shim).
CF_WORKER=

# 8-hex contract id naming this aiko's identity in the canonical ledger.
# Generate by running `aiko "spawn runpod aiko identity" --remote` and
# copying the returned id here. The wallet for this aiko is then
# derivable from AIKO_ROOT_KEY + this id via lineage_lib.deriveKeyPair.
CONTRACT_INSTANCE_ID=

# Optional: pre-funded x402 payment header for outgoing Unbrowse calls.
# Leave empty for 402-on-demand flows.
AIKO_X_PAYMENT=

# Container image registry path the Dockerfile gets pushed to.
RUNPOD_IMAGE=

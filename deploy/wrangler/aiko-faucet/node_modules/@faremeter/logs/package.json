{
  "name": "@faremeter/logs",
  "version": "0.17.1",
  "description": "A configurable logging abstraction for Faremeter",
  "keywords": [
    "faremeter",
    "typescript",
    "sdk",
    "api",
    "x402",
    "ai"
  ],
  "license": "LGPL-3.0-only",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./logtape": {
      "require": "./dist/src/logtape.js",
      "import": "./dist/src/logtape.js",
      "types": "./dist/src/logtape.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@logtape/logtape": "1.0.4",
    "@tapjs/asserts": "4.0.1",
    "@tapjs/tsx": "3.0.1",
    "@types/web": "0.0.246",
    "@typescript/lib-dom": "npm:@types/web@^0.0.246",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "tap": "21.1.0",
    "tsc-esm-fix": "3.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "typescript-language-server": "4.4.0"
  },
  "peerDependencies": {
    "@logtape/logtape": "1.0.4"
  },
  "peerDependenciesMeta": {
    "@logtape/logtape": {
      "optional": true
    }
  },
  "tap": {
    "plugin": [
      "@tapjs/tsx",
      "!@tapjs/typescript"
    ]
  }
}
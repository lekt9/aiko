{
  "name": "@faremeter/middleware",
  "version": "0.21.0",
  "description": "Server middleware for adding payment walls to API endpoints using x402 protocol",
  "keywords": [
    "faremeter",
    "typescript",
    "sdk",
    "api",
    "x402",
    "ai"
  ],
  "license": "LGPL-3.0-only",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./hono": {
      "require": "./dist/src/hono.js",
      "import": "./dist/src/hono.js",
      "types": "./dist/src/hono.d.ts"
    },
    "./express": {
      "require": "./dist/src/express.js",
      "import": "./dist/src/express.js",
      "types": "./dist/src/express.d.ts"
    },
    "./common": {
      "require": "./dist/src/common.js",
      "import": "./dist/src/common.js",
      "types": "./dist/src/common.d.ts"
    },
    "./http-handler": {
      "require": "./dist/src/http-handler.js",
      "import": "./dist/src/http-handler.js",
      "types": "./dist/src/http-handler.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tapjs/tsx": "3.0.1",
    "@types/express": "5.0.3",
    "@types/web": "0.0.246",
    "@typescript/lib-dom": "npm:@types/web@^0.0.246",
    "eslint": "9.34.0",
    "hono": "4.9.0",
    "prettier": "3.6.2",
    "tap": "21.1.0",
    "tsc-esm-fix": "3.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "typescript-language-server": "4.4.0"
  },
  "dependencies": {
    "arktype": "2.2.0",
    "@faremeter/info": "^0.21.0",
    "@faremeter/logs": "^0.21.0",
    "@faremeter/types": "^0.21.0"
  },
  "tap": {
    "plugin": [
      "!@tapjs/typescript",
      "@tapjs/tsx"
    ]
  }
}
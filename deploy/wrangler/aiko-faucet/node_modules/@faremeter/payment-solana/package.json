{
  "name": "@faremeter/payment-solana",
  "version": "0.21.0",
  "description": "Solana payment scheme implementations for x402 protocol (SPL token transfers)",
  "keywords": [
    "faremeter",
    "typescript",
    "sdk",
    "api",
    "x402",
    "ai"
  ],
  "license": "LGPL-3.0-only",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./exact": {
      "require": "./dist/src/exact/index.js",
      "import": "./dist/src/exact/index.js",
      "types": "./dist/src/exact/index.d.ts"
    },
    "./splToken": {
      "require": "./dist/src/splToken.js",
      "import": "./dist/src/splToken.js",
      "types": "./dist/src/splToken.d.ts"
    },
    "./charge": {
      "require": "./dist/src/charge/index.js",
      "import": "./dist/src/charge/index.js",
      "types": "./dist/src/charge/index.d.ts"
    },
    "./flex/client": {
      "require": "./dist/src/flex/client/index.js",
      "import": "./dist/src/flex/client/index.js",
      "types": "./dist/src/flex/client/index.d.ts"
    },
    "./flex/facilitator": {
      "require": "./dist/src/flex/facilitator/index.js",
      "import": "./dist/src/flex/facilitator/index.js",
      "types": "./dist/src/flex/facilitator/index.d.ts"
    },
    "./flex/hono": {
      "require": "./dist/src/flex/hono/index.js",
      "import": "./dist/src/flex/hono/index.js",
      "types": "./dist/src/flex/hono/index.d.ts"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tapjs/asserts": "4.0.1",
    "@types/node": "22.19.17",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "tap": "21.1.0",
    "tsc-esm-fix": "3.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "typescript-language-server": "4.4.0"
  },
  "dependencies": {
    "@faremeter/flex-solana": "0.2.1",
    "@solana-program/compute-budget": "0.15.0",
    "@solana-program/memo": "0.11.0",
    "@solana-program/system": "0.12.0",
    "@solana-program/token": "0.13.0",
    "@solana/addresses": "6.7.0",
    "@solana/kit": "6.7.0",
    "@solana/rpc": "6.7.0",
    "@solana/rpc-api": "6.7.0",
    "@solana/rpc-types": "6.7.0",
    "@solana/transactions": "6.7.0",
    "arktype": "2.2.0",
    "hono": "4.9.0",
    "@faremeter/info": "^0.21.0",
    "@faremeter/logs": "^0.21.0",
    "@faremeter/middleware": "^0.21.0",
    "@faremeter/types": "^0.21.0"
  },
  "tap": {
    "plugin": [
      "@tapjs/tsx",
      "!@tapjs/typescript"
    ]
  }
}
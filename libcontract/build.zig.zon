.{
    .name = .libcontract,
    .version = "0.0.1-stage1",
    .fingerprint = 0xe283c4bbc83094de,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .typed_neuron = .{
            // Sibling-checkout dependency: clone Unbrowse/contract and
            // Unbrowse/neuron into the same parent directory and this builds
            // as-is. It replaces a git+ssh entry that could not build at all
            // (placeholder `1220…00` hash, and a Tailscale address the gitea
            // host no longer answers on).
            //
            // For a standalone clone of contract alone, pin the published
            // package instead — from the neuron checkout, take the commit you
            // want and print its content hash:
            //   zig fetch 'git+ssh://git@100.124.140.92:2222/Unbrowse/neuron.git#<commit>'
            // then swap this line for that .url plus the printed .hash.
            //
            // Note the pin is load-bearing beyond the build: typed-neuron.lock.json
            // records the digest of the six wire files, and Aiko's generated
            // binding (typed_neuron_wire.rs PACKAGE_DIGEST) must name the same
            // one, so a pinned commit has to contain the wire tree this lock
            // was generated from.
            .path = "../../neuron",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}

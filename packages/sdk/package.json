{
  "name": "@unlock/sdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aiko": {
      "types": "./dist/aiko.d.ts",
      "default": "./dist/aiko.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    },
    "./owner": {
      "types": "./dist/owner.d.ts",
      "default": "./dist/owner.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "default": "./dist/sources.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./cdp": {
      "types": "./dist/cdp.d.ts",
      "default": "./dist/cdp.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "default": "./dist/oauth.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "bin": {
    "unlock-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unlock/protocol": "workspace:*",
    "openid-client": "6.8.8"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "description", "triggers", "events", "effects"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2], "default": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string"},
    "triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind"], "properties": {"id":{"type":"string"},"kind":{"type":"string"}}}},
    "effects": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["id", "effect", "variants"], "properties": {"id":{"type":"string"},"effect":{"enum":["read_only","local_reversible","local_write","external_message","purchase","job_application","credential_access","delete","publish","permission_change","account_mutation"]},"variants":{"type":"array","minItems":1,"items":{"type":"string"}},"ephemeral":{"type":"boolean"},"ttl_ms":{"type":"integer","minimum":1},"requires_authority":{"type":"boolean"},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
    "runtime": {"type": "object", "required": ["argv"], "properties": {"argv":{"type":"array","minItems":1,"items":{"type":"string"}},"cwd":{"type":"string"},"restart":{"enum":["never","on-failure","always"]}}},
    "ingress": {
      "type": "object",
      "required": ["modes", "delivery", "signature", "max_body_bytes", "privacy"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["poll", "local_listener", "ephemeral_tunnel", "durable_tunnel", "provider_webhook", "hosted_worker"]}
        },
        "delivery": {"enum": ["at_most_once", "at_least_once", "effectively_once"]},
        "signature": {"enum": ["none", "adapter_declared", "required"]},
        "max_body_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "privacy": {"enum": ["redacted", "public"]}
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "required": ["identity_fields", "change_token_fields", "ttl_ms"],
      "properties": {
        "identity_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "change_token_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "ttl_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
      "then": {"required": ["ingress", "cursor"]}
    }
  ]
}

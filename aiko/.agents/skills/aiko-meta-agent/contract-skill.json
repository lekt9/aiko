{
  "schema_version": 1,
  "id": "aiko-meta-agent",
  "version": "1.0.0",
  "description": "The embedded Contract-native meta-agent connectome.",
  "platforms": [
    "all"
  ],
  "triggers": [],
  "activation": "core",
  "composition": {
    "attach_children_at": "route",
    "join_children_at": "verify"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "nodes": [
    {
      "key": "observe",
      "plan": "Commit a bounded digest of the current stimulus for {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.observe/v1",
      "depends_on": [],
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "stimulus_digest",
        "context_references"
      ],
      "input_bindings": {}
    },
    {
      "key": "recall",
      "plan": "Recall only context explicitly referenced by the observation of {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.recall/v1",
      "depends_on": [
        "observe"
      ],
      "input_bindings": {
        "context_references": "observe.context_references"
      },
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "artifact_digests"
      ]
    },
    {
      "key": "route",
      "plan": "Project the admitted skill route for {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.route/v1",
      "depends_on": [
        "recall"
      ],
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "selected_skill_refs",
        "route_reason"
      ],
      "input_bindings": {
        "artifact_digests": "recall.artifact_digests"
      }
    },
    {
      "key": "act",
      "plan": "Execute the smallest reversible action that advances {{goal}}.",
      "worker": "aiko",
      "depends_on": [
        "route"
      ],
      "can_parallel": false,
      "timeout_ms": 120000,
      "effect": "local_reversible",
      "reversible": true,
      "read_only": false,
      "requires_authority": false,
      "evidence": [
        "action_result"
      ],
      "input_bindings": {
        "selected_skill_refs": "route.selected_skill_refs"
      },
      "writes": [
        "workspace://**"
      ]
    },
    {
      "key": "capture",
      "plan": "Capture the immutable action product and goal identity for independent evaluation of {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.capture/v1",
      "depends_on": [
        "act"
      ],
      "input_bindings": {
        "action_result": "act.action_result"
      },
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "product_snapshot",
        "product_digest",
        "goal_digest"
      ]
    },
    {
      "key": "verify",
      "plan": "Independently witness whether the captured action product satisfies {{goal}}. Return verification as an object with accepted:boolean and bounded nonempty evidence:string.",
      "worker": "aiko",
      "depends_on": [
        "capture"
      ],
      "can_parallel": false,
      "timeout_ms": 120000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "verification"
      ],
      "input_bindings": {
        "product_snapshot": "capture.product_snapshot",
        "product_digest": "capture.product_digest",
        "goal_digest": "capture.goal_digest"
      }
    },
    {
      "key": "judge",
      "plan": "Independently judge the captured action product against {{goal}} without trusting the witness summary. Return verdict as an object with completed:boolean, retryable:boolean, and bounded nonempty evidence:string.",
      "worker": "aiko",
      "depends_on": [
        "capture"
      ],
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "verdict"
      ],
      "input_bindings": {
        "product_snapshot": "capture.product_snapshot",
        "product_digest": "capture.product_digest",
        "goal_digest": "capture.goal_digest"
      }
    },
    {
      "key": "settle",
      "plan": "Deterministically settle only matching independent witness and judge evidence for {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.settle/v1",
      "depends_on": [
        "judge",
        "verify",
        "capture"
      ],
      "input_bindings": {
        "verdict": "judge.verdict",
        "verification": "verify.verification",
        "product_digest": "capture.product_digest",
        "goal_digest": "capture.goal_digest"
      },
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": [
        "settlement"
      ]
    }
  ],
  "examples": [
    {
      "name": "compose-existing-limbs",
      "prompt": "Inspect this project repository and run its tests.",
      "expect": {
        "core": "aiko-meta-agent",
        "attached": [
          "inspect-project",
          "build-and-test-project"
        ],
        "opaque_agent_nodes": 0
      }
    }
  ]
}

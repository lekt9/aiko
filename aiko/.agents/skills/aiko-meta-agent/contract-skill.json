{
  "schema_version": 1,
  "id": "aiko-meta-agent",
  "version": "1.0.0",
  "description": "The embedded Contract-native meta-agent connectome.",
  "platforms": ["all"],
  "triggers": [],
  "activation": "core",
  "composition": {
    "attach_children_at": "route",
    "join_children_at": "verify"
  },
  "input_schema": {"type": "object", "additionalProperties": true},
  "output_schema": {"type": "object", "additionalProperties": true},
  "nodes": [
    {
      "key": "observe",
      "plan": "Commit a bounded digest of the current stimulus for {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.observe/v1",
      "depends_on": [],
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": ["stimulus_digest", "context_references"]
    },
    {
      "key": "recall",
      "plan": "Recall only context explicitly referenced by the observation.",
      "worker": "host",
      "adapter": "aiko.meta.recall/v1",
      "depends_on": ["observe"],
      "input_bindings": {"context_references": "observe.context_references"},
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": ["artifact_digests"]
    },
    {
      "key": "route",
      "plan": "Project the admitted skill route for {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.route/v1",
      "depends_on": ["recall"],
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": ["selected_skill_refs", "route_reason"]
    },
    {
      "key": "act",
      "plan": "Execute the smallest reversible action that advances {{goal}}.",
      "worker": "aiko",
      "depends_on": ["route"],
      "can_parallel": false,
      "timeout_ms": 120000,
      "effect": "local_reversible",
      "reversible": true,
      "read_only": false,
      "requires_authority": false,
      "evidence": ["action_result"]
    },
    {
      "key": "verify",
      "plan": "Verify the routed work against the requested outcome.",
      "worker": "aiko",
      "depends_on": ["act"],
      "can_parallel": false,
      "timeout_ms": 120000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": ["verification"]
    },
    {
      "key": "judge",
      "plan": "Judge whether the verified evidence genuinely satisfies {{goal}}.",
      "worker": "aiko",
      "depends_on": ["verify"],
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": ["verdict"]
    },
    {
      "key": "settle",
      "plan": "Settle the terminal verdict for {{goal}}.",
      "worker": "host",
      "adapter": "aiko.meta.settle/v1",
      "depends_on": ["judge"],
      "input_bindings": {"verdict": "judge.verdict"},
      "can_parallel": false,
      "timeout_ms": 30000,
      "effect": "read_only",
      "reversible": false,
      "read_only": true,
      "requires_authority": false,
      "evidence": ["settlement"]
    }
  ],
  "examples": []
}

{
  "name": "@aiko/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "frontend:dev": "BACKEND_URL=${AIKO_BACKEND_URL:-http://127.0.0.1:8000} npm --prefix ../frontend/frontend run dev",
    "frontend:build": "npm --prefix ../frontend/frontend run build",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:links": "node scripts/link-click-test.mjs",
    "tauri": "tauri",
    "with-env": "node scripts/with-env.mjs",
    "installer:prep": "node scripts/with-env.mjs -- zsh ../../scripts/prep-installer.sh",
    "installer:check": "node scripts/with-env.mjs -- zsh ../../scripts/prep-installer.sh --check",
    "installer:notarize": "node scripts/with-env.mjs -- zsh ../../scripts/prep-installer.sh --notarize",
    "env:check": "node scripts/with-env.mjs -- zsh -c 'echo APPLE_ID=${#APPLE_ID} chars APPLE_TEAM_ID=${#APPLE_TEAM_ID} chars APPLE_PASSWORD=${#APPLE_PASSWORD} chars AIKO_TOKEN=${#AIKO_TOKEN} chars SURPLUS_API_KEY=${#SURPLUS_API_KEY} chars'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1"
  }
}

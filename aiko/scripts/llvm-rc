#!/bin/zsh

# tauri-winres passes llvm-rc's `/no-preprocess` switch. Zig's rc-compatible
# frontend preprocesses the already-generated resource correctly but parses
# that negated switch as the invalid `/o-preprocess`, so omit only that flag.
arguments=()
for argument in "$@"; do
  if [ "$argument" != "/no-preprocess" ]; then
    arguments+=("$argument")
  fi
done
exec /Users/lewis/bin/zig rc "${arguments[@]}"

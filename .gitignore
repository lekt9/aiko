# Monorepo-wide artifact exclusions
node_modules/
dist/
build/
target/
zig-out/
zig-out-*/
zig-cache/
.zig-cache/
# Host-local offload symlinks (no trailing slash — git tracks these as files)
/.zig-cache
/target
/neuron/.zig-cache
__pycache__/
*.pyc
.venv/
venv/

# Build library/object leftovers outside zig-out/target
*.dylib
*.so
*.dll
*.pdb
*.rlib
*.rmeta
*.a
*.o

# Benchmark & run artifacts
**/benchmarks/harbor/
**/benchmarks/agentic-organism/
**/benchmarks/task-benchmark/
**/benchmarks/tools/
**/runs/
**/traces/
**/tmp/

# Local agent / session / index state (never source of truth)
.claude/
.grok/
.graff/
.hallmark/
.aiko/
codedb.snapshot
**/codedb.snapshot
*.local.md
*.local.json
data/

# Unpublished local workspaces (not the product)
career-ops/

# Customer operational material must never be committed
cell/data/hoysan*
cell/hoysan-*

# OS noise
.DS_Store

# --- build outputs (untracked 2026-07-31) --------------------------------
# Prebuilt binaries are host-specific; `zig build` / `cargo build` reproduce
# them. A committed binary is a second source of truth that drifts and shows
# up as a spurious diff on every build.
# cell/ is the fractal harness standard — not a build output (removed 2026-08)
# cell/zig-out/ and cell/.zig-cache already covered by zig-*/

# Contains a pasted credential from a chat transcript — never commit (rotate the token).
aiko/test.md
# smithers local db
smithers.db
smithers.db-*

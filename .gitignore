# Monorepo-wide artifact exclusions
node_modules/
dist/
build/
target/
zig-out/
zig-cache/
.zig-cache/
__pycache__/
*.pyc
.venv/
venv/

# Benchmark & run artifacts
**/benchmarks/harbor/
**/benchmarks/agentic-organism/
**/benchmarks/task-benchmark/
**/benchmarks/tools/
**/runs/
**/traces/
**/tmp/

# Local agent/session state
.grok/
.graff/
.hallmark/
.DS_Store

# --- build outputs (untracked 2026-07-31) --------------------------------
# 246MB of prebuilt macOS .dylib and Windows .dll/.pdb were committed here and
# no Linux artifact was, which is why a fresh Linux clone had nothing to link
# against. Build outputs are reproduced by `zig build` / `cargo build`; a
# committed binary is a second source of truth that drifts from the source
# beside it and shows up as a spurious diff on every build.
zig-out/
zig-out-*/
.zig-cache/
zig-cache/
target/
node_modules/
__pycache__/
*.pyc
*.dylib
*.dll
*.pdb
*.rlib
*.rmeta

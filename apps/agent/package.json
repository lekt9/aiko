{
  "name": "@unlock/agent",
  "private": true,
  "type": "module",
  "imports": {
    "#aiko-memory-host": {
      "workerd": "./src/memory-worker.ts",
      "default": "./src/memory-node.ts"
    }
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun ../../scripts/check-entity-learn.ts && bun test --timeout 30000 test",
    "build": "bun ../../scripts/check-entity-learn.ts && bun build src/main.ts --target=bun --packages=external --outdir=dist"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@cfworker/json-schema": "4.1.1",
    "@composio/core": "0.18.1",

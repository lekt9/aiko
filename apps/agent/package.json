    "@supabase/supabase-js": "^2.115.0",
    "@unbrowse/browser-harness": "link:../../../unbrowse-playground/runtime",
    "@unlock/sdk": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.110",
    "entity-learn": "workspace:*",
    "postgres": "^3.4.9",
    "quickjs-emscripten-core": "0.32.0",
    "tardie": "0.22.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",

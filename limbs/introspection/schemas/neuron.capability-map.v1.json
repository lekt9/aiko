{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuron.capability-map/v1",
  "title": "Capability Map",
  "description": "Complete snapshot of the Neuron system's capabilities, state, and topology. Generated by the inspector neuron from substrate reads.",
  "type": "object",
  "required": ["inspected_at_ms", "neurons", "artifacts", "messages", "packages"],
  "properties": {
    "inspected_at_ms": {
      "type": "integer",
      "description": "Wall clock (from stimulus now_ms) when the inspection ran."
    },
    "neurons": {
      "type": "array",
      "description": "Registered neuron identities and their versions.",
      "items": {
        "type": "object",
        "required": ["identity", "version"],
        "properties": {
          "identity": { "type": "string" },
          "version": { "type": "string" },
          "kind": {
            "type": "string",
            "description": "Neuron implementation kind hint (e.g. 'script', 'spec', 'fixed')."
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Summary of artifact schemas present in the substrate.",
      "items": {
        "type": "object",
        "required": ["schema"],
        "properties": {
          "schema": { "type": "string" },
          "count": { "type": "integer" },
          "ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Artifact IDs matching this schema (capped at 32)."
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "description": "Summary of message schemas observed.",
      "items": {
        "type": "object",
        "required": ["schema"],
        "properties": {
          "schema": { "type": "string" },
          "count": { "type": "integer" },
          "statuses": {
            "type": "object",
            "properties": {
              "queued": { "type": "integer" },
              "acknowledged": { "type": "integer" },
              "dead_letter": { "type": "integer" },
              "reconciliation_required": { "type": "integer" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Firing lifecycle metrics.",
      "properties": {
        "committed": { "type": "integer" },
        "rejected": { "type": "integer" },
        "failed": { "type": "integer" },
        "timed_out": { "type": "integer" },
        "cancelled": { "type": "integer" },
        "total": { "type": "integer" },
        "cache_hit_rate": {
          "type": "number",
          "description": "Ratio of replayed to committed firings (0..1)."
        }
      }
    },
    "packages": {
      "type": "array",
      "description": "Admitted and revoked package records.",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["admitted", "revoked", "detached"]
          },
          "digest": { "type": "string" }
        }
      }
    },
    "topology": {
      "type": "object",
      "description": "Active topology snapshot.",
      "properties": {
        "registered": { "type": "integer", "description": "Count of registered neuron refs." },
        "waits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "neuron_ref": { "type": "string" },
              "predicate": { "type": "string" }
            }
          }
        },
        "joins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "neuron_ref": { "type": "string" },
              "quorum": { "type": "integer" },
              "arrived": { "type": "integer" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

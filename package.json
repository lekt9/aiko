{
  "name": "unlock-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @unlock/web dev",
    "build": "pnpm --filter @unlock/protocol build && pnpm --filter @unlock/sdk build && pnpm --filter @unlock/server build && pnpm --filter @unlock/web build",
    "build:backend": "pnpm --filter @unlock/protocol build && pnpm --filter @unlock/sdk build && pnpm --filter @unlock/server build",
    "typecheck": "pnpm --filter @unlock/protocol build && pnpm --filter @unlock/sdk build && pnpm -r --workspace-concurrency=1 typecheck && pnpm exec tsc -p tsconfig.tests.json",
    "test": "pnpm build:backend && vitest run tests --maxWorkers=2 && pnpm test:aiko && pnpm test:browser-client",
    "test:backend": "node scripts/test-backend.mjs",
    "aiko:init": "pnpm --filter @unlock/agent exec bun src/init.ts",
    "aiko:key": "pnpm --filter @unlock/agent exec bun src/plane-key.ts",
    "aiko:dev": "pnpm --filter @unlock/agent dev",
    "aiko:build": "pnpm --filter @unlock/agent build",
    "aiko:backup": "bun apps/agent/src/backup.ts",
    "test:aiko": "pnpm --filter @unlock/agent test",
    "test:browser-client": "bun run --cwd ../unbrowse-playground/runtime test:client",
    "aiko:browser:init": "bun scripts/init-aiko-browser.ts",
    "server:dev": "pnpm --filter @unlock/server dev",
    "server:start": "pnpm --filter @unlock/server start",
    "server:init": "node scripts/init-backend.mjs",
    "server:rewrap": "pnpm --filter @unlock/server exec node dist/ops.js rewrap",
    "agent": "node packages/sdk/dist/cli.js",
    "test:e2e": "node scripts/browser-qa.mjs --aiko",
    "test:e2e:aiko": "node scripts/browser-qa.mjs --aiko",
    "test:e2e:legacy": "node scripts/browser-qa.mjs",
    "test:csv": "node scripts/browser-qa.mjs --csv",
    "test:http": "node scripts/http-smoke.mjs",
    "preview": "pnpm --filter @unlock/web exec vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "format:check": "prettier --check 'apps/web/src/**/*.{ts,tsx,css}' 'packages/sdk/src/*.ts' 'packages/protocol/src/*.ts' 'apps/server/src/*.ts' 'tests/**/*.ts' tokens.css",
    "harness:learn": "node scripts/harness-learn.mjs",
    "harness:selflearn": "bash scripts/harness-selflearn.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@unlock/protocol": "workspace:*",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.6",
    "tough-cookie": "6.0.2",
    "typescript": "^5.9.3",
    "undici": "7.29.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@unbrowse/browser-harness": "link:../unbrowse-playground/runtime"
  }
}

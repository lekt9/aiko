{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuron.promote-proposal/v1",
  "title": "Promotion Proposal",
  "description": "A proposal to promote a firing pattern into an admitted limb. Generated by the promoter neuron from observed firing records. The harness must independently admit before the limb becomes executable — this is inert proposal data.",
  "type": "object",
  "required": ["neuron_identity", "receptor_pattern", "confidence", "generated_at_ms"],
  "properties": {
    "neuron_identity": {
      "type": "string",
      "description": "The neuron identity that should be promoted (prefix for pattern-based).
    },
    "neuron_version": {
      "type": "string",
      "description": "Current version of the neuron."
    },
    "receptor_pattern": {
      "type": "string",
      "description": "The receptor schema pattern this neuron fires on."
    },
    "evidence": {
      "type": "object",
      "description": "Firing pattern evidence backing the proposal.",
      "properties": {
        "total_firings": { "type": "integer" },
        "committed": { "type": "integer" },
        "rejected": { "type": "integer" },
        "failed": { "type": "integer" },
        "success_rate": { "type": "number" },
        "cache_hits": { "type": "integer" },
        "typical_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "enum": ["write", "send", "spawn"] },
              "schema": { "type": "string" },
              "frequency": { "type": "number" }
            }
          }
        },
        "typical_reads": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Common artifact schemas this neuron reads."
        }
      }
    },
    "requested_caps": {
      "type": "object",
      "description": "Minimal capability grant the limb would need.",
      "properties": {
        "allow_write": { "type": "boolean" },
        "write_prefix": { "type": "string" },
        "allow_send": { "type": "boolean" },
        "send_prefix": { "type": "string" },
        "allow_spawn": { "type": "boolean" },
        "max_effects": { "type": "integer" },
        "max_writes": { "type": "integer" },
        "max_messages": { "type": "integer" },
        "max_spawns": { "type": "integer" },
        "max_bytes": { "type": "integer" },
        "max_depth": { "type": "integer" }
      }
    },
    "generated_limb_spec": {
      "type": "string",
      "description": "A limb/v1 DSL spec generated for this pattern (inert, pending admission)."
    },
    "generated_limb_digest": {
      "type": "string",
      "description": "SHA-256 digest of the generated limb spec."
    },
    "confidence": {
      "type": "number",
      "description": "0..1 confidence that this should be promoted. Based on firing frequency, success rate, and effect consistency."
    },
    "suggest_action": {
      "type": "string",
      "enum": ["promote", "observe_more", "do_not_promote"],
      "description": "Recommended action."
    },
    "generated_at_ms": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}

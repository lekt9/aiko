{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiko.dev/schemas/fech-capability-v1.json",
  "title": "Aiko FECH capability protocol",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9_:-]+(?:\\.[a-z0-9_:-]+)+$"
    },
    "permission": {
      "enum": ["read", "write", "network", "purchase"]
    },
    "effect": {
      "enum": ["read_only", "local_write", "network_read", "network_write", "message_send", "purchase"]
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "capability_version", "provider", "tool", "action", "description", "input_schema", "output_schema", "requires", "permission", "effects", "available"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/identifier" },
        "capability_version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._+-]+$" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(aiko|skill|unbrowse|mcp:[a-z0-9_-]+)$" },
        "tool": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "requires": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "permission": { "$ref": "#/$defs/permission" },
        "effects": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/effect" } },
        "available": { "type": "boolean" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version", "available"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/identifier" },
        "capability_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "available": { "type": "boolean" },
        "reason": { "enum": ["ready", "provider_disconnected", "route_unavailable", "permission_unavailable", "disabled"] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability_id", "capability_version", "success", "duration_ms", "permission_result", "error_class", "result_shape", "observed_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "capability_id": { "$ref": "#/$defs/identifier" },
        "capability_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "success": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "permission_result": { "enum": ["allowed", "denied", "not_required"] },
        "error_class": { "type": ["string", "null"], "enum": [null, "permission_denied", "provider_unavailable", "timeout", "invalid_input", "provider_failure"] },
        "result_shape": { "enum": ["null", "boolean", "number", "string", "array", "object"] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version", "provider", "tool", "action", "permission", "effects", "score", "status", "reason_codes"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/identifier" },
        "capability_version": { "type": "string" },
        "provider": { "type": "string" },
        "tool": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "permission": { "$ref": "#/$defs/permission" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["verified_fresh", "verified_stale", "available_unverified", "unavailable", "inhibited"] },
        "reason_codes": { "type": "array", "uniqueItems": true, "items": { "enum": ["context_match", "proven_success", "recent_failure", "stale_evidence", "unavailable", "permission_mismatch", "effect_mismatch", "fast_history", "prerequisite"] } }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "candidates", "sequence", "parallel", "confidence", "margin", "automatic", "reason_codes"],
      "properties": {
        "version": { "const": 1 },
        "candidates": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/candidate" } },
        "sequence": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/identifier" } },
        "parallel": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/identifier" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "margin": { "type": "number", "minimum": 0, "maximum": 1 },
        "automatic": { "type": "boolean" },
        "reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}

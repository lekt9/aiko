{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "account-handle.v1",
  "type": "object",
  "required": [
    "id",
    "tenant",
    "origin",
    "account_id"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cred:[0-9a-f]{32}$",
      "description": "Opaque deterministic identity handle; never embeds tenant, origin, account id, password, token, cookie, or API key."
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hoysan-draft-result.v1",
  "type": "object",
  "required": [
    "shift_date",
    "shift_code",
    "gangs",
    "standby",
    "unassigned",
    "stats",
    "validation"
  ],
  "properties": {
    "shift_date": {
      "type": "string"
    },
    "shift_code": {
      "type": "string",
      "enum": [
        "D",
        "G"
      ]
    },
    "gangs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "crane_number",
          "wta_required",
          "workers"
        ],
        "properties": {
          "crane_number": {
            "type": "string"
          },
          "vessel": {
            "type": "string"
          },
          "stroking": {},
          "wta_required": {
            "type": "boolean"
          },
          "workers": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "nric",
                "name",
                "pool",
                "role",
                "wah"
              ],
              "properties": {
                "nric": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "pool": {
                  "enum": [
                    "TS",
                    "SIN",
                    "NTS"
                  ]
                },
                "role": {
                  "enum": [
                    "STA",
                    "LW",
                    "CM",
                    "WTA"
                  ]
                },
                "wah": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "standby": {
      "type": "array"
    },
    "unassigned": {
      "type": "array"
    },
    "stats": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "required": [
        "ok",
        "errors"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}

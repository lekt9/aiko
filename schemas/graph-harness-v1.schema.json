{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiko.local/schemas/graph-harness-v1.schema.json",
  "title": "Aiko GraphHarness admission envelope v1",
  "description": "Canonical transport and admission envelope for a bounded graph-engineering harness. This schema declares work; it neither schedules nor settles it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "package",
    "admission",
    "registry"
  ],
  "properties": {
    "api_version": {
      "const": "graph-harness/v1"
    },
    "kind": {
      "const": "GraphHarness"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "admission": {
      "$ref": "#/$defs/admission"
    },
    "registry": {
      "$ref": "#/$defs/registry"
    }
  },
  "$defs": {
    "non_empty": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Portable URI or package-relative path. Resolution is an admission/runtime responsibility."
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "entrypoint": {
          "$ref": "#/$defs/non_empty"
        },
        "media_type": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/implementation"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "ports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/port"
      }
    },
    "membrane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs",
        "authority"
      ],
      "properties": {
        "inputs": {
          "$ref": "#/$defs/ports"
        },
        "outputs": {
          "$ref": "#/$defs/ports"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystem",
            "network",
            "process",
            "secrets"
          ],
          "properties": {
            "filesystem": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty"
              },
              "uniqueItems": true
            },
            "network": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty"
              },
              "uniqueItems": true
            },
            "process": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty"
              },
              "uniqueItems": true
            },
            "secrets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty"
              },
              "uniqueItems": true
            }
          },
          "description": "Declared maximum authority, not proof of executor confinement."
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_codes"
      ],
      "properties": {
        "exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "stdout_schema": {
          "$ref": "#/$defs/implementation"
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation",
        "argv",
        "timeout_ms",
        "expected",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "An argv vector, not an implicitly interpreted shell string."
        },
        "cwd": {
          "$ref": "#/$defs/non_empty"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "ref"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "enum": [
                  "artifact",
                  "durable-state",
                  "structured-output",
                  "boundary-readback"
                ]
              },
              "ref": {
                "$ref": "#/$defs/non_empty"
              },
              "schema": {
                "$ref": "#/$defs/implementation"
              }
            }
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "implementation",
        "consumes",
        "verdict_schema"
      ],
      "properties": {
        "independent": {
          "const": true
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "consumes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "description": "Witness evidence identifiers or durable product references, never the producer's assertion alone."
        },
        "verdict_schema": {
          "$ref": "#/$defs/implementation"
        },
        "policy": {
          "enum": [
            "all",
            "quorum"
          ]
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "quorum"
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "required": [
              "quorum"
            ]
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "witness",
        "judge"
      ],
      "properties": {
        "claim": {
          "$ref": "#/$defs/non_empty"
        },
        "witness": {
          "$ref": "#/$defs/witness"
        },
        "judge": {
          "$ref": "#/$defs/judge"
        }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill_grounding"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/non_empty"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "capability_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "required": [
            "skills"
          ],
          "properties": {
            "skills": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "capability_gaps"
          ],
          "properties": {
            "capability_gaps": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "mode"
      ],
      "properties": {
        "kind": {
          "enum": [
            "filesystem",
            "network",
            "process",
            "secret",
            "device",
            "service",
            "other"
          ]
        },
        "scope": {
          "$ref": "#/$defs/non_empty"
        },
        "mode": {
          "enum": [
            "read",
            "write",
            "execute",
            "admin"
          ]
        },
        "exclusive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scope",
        "external_boundary",
        "readback",
        "on_invalidation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "filesystem",
            "message",
            "payment",
            "deployment",
            "remote-mutation",
            "other"
          ]
        },
        "scope": {
          "$ref": "#/$defs/non_empty"
        },
        "external_boundary": {
          "type": "boolean"
        },
        "readback": {
          "enum": [
            "not-applicable",
            "required"
          ]
        },
        "on_invalidation": {
          "enum": [
            "recompute",
            "compensate-never-replay",
            "manual"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "external_boundary": {
                "const": true
              }
            },
            "required": [
              "external_boundary"
            ]
          },
          "then": {
            "properties": {
              "readback": {
                "const": "required"
              },
              "on_invalidation": {
                "const": "compensate-never-replay"
              }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "depends_on",
        "reads",
        "produces",
        "writes",
        "resources",
        "effects",
        "implementation",
        "grounding",
        "acceptance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "uniqueItems": true
        },
        "produces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "implementation": {
          "$ref": "#/$defs/cell_implementation"
        },
        "determinism": {
          "enum": [
            "required",
            "edge-only",
            "not-applicable"
          ]
        },
        "grounding": {
          "$ref": "#/$defs/grounding"
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        }
      }
    },
    "recursion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "max_children_per_node",
        "max_total_nodes",
        "max_wall_time_ms",
        "max_tool_calls",
        "on_exhaustion"
      ],
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_children_per_node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "max_total_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "on_exhaustion": {
          "const": "refuse"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "source_digests",
        "generator"
      ],
      "properties": {
        "authored_by": {
          "$ref": "#/$defs/non_empty"
        },
        "source_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implementation"
          }
        },
        "generator": {
          "$ref": "#/$defs/implementation"
        },
        "parent_package_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "membrane",
        "north_star",
        "nodes",
        "edges",
        "recursion",
        "provenance"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "description"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "version": {
              "$ref": "#/$defs/semver"
            },
            "description": {
              "$ref": "#/$defs/non_empty"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "membrane": {
          "$ref": "#/$defs/membrane"
        },
        "north_star": {
          "$ref": "#/$defs/acceptance"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "recursion": {
          "$ref": "#/$defs/recursion"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "description": "Explicit port-level data edges. Array order is canonical lexical (from.node, from.port, to.node, to.port).",
          "uniqueItems": true
        }
      }
    },
    "admission": {
      "description": "Build emits prepared; only external Contract-owned attestation may produce admitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/prepared_admission"
        },
        {
          "$ref": "#/$defs/admitted_admission"
        }
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "name",
        "version",
        "description",
        "schema",
        "projections"
      ],
      "properties": {
        "media_type": {
          "const": "application/vnd.aiko.graph-harness+json;version=1"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "$ref": "#/$defs/non_empty"
        },
        "schema": {
          "const": "graph-harness/v1"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "uniqueItems": true
        },
        "projections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aiko_skill_v1": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "description",
                "probe_input",
                "expect_contains"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/identifier"
                },
                "description": {
                  "$ref": "#/$defs/non_empty"
                },
                "probe_input": {
                  "$ref": "#/$defs/non_empty"
                },
                "expect_contains": {
                  "$ref": "#/$defs/non_empty"
                }
              },
              "description": "Compatibility discovery projection only; it does not replace structured acceptance."
            },
            "cell_v0": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "digest"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/non_empty"
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^(?:\\$input|\\$output|[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "skill_grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "declaration"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "declaration": {
          "$ref": "#/$defs/implementation"
        }
      }
    },
    "cell_implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "media_type"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "entrypoint": {
          "$ref": "#/$defs/non_empty"
        },
        "media_type": {
          "const": "application/vnd.aiko.cell+json;version=0"
        }
      }
    },
    "closure_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "schema",
            "cell",
            "skill",
            "source",
            "witness",
            "judge",
            "generator",
            "graph-harness"
          ]
        },
        "ref": {
          "$ref": "#/$defs/non_empty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "transitive_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "graph-harness"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "transitive_digest"
            ]
          }
        }
      ]
    },
    "prepared_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "subject",
        "subject_digest",
        "canonicalization",
        "transitive_digest",
        "dependency_closure"
      ],
      "properties": {
        "state": {
          "const": "prepared"
        },
        "subject": {
          "const": "/package"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "canonicalization": {
          "const": "rfc8785-json"
        },
        "transitive_digest": {
          "$ref": "#/$defs/digest"
        },
        "dependency_closure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closure_entry"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "admitted_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "subject",
        "subject_digest",
        "canonicalization",
        "transitive_digest",
        "dependency_closure",
        "admitted_by",
        "admitted_at",
        "evidence_refs",
        "ledger_ref",
        "attestation_digest",
        "verdicts",
        "authentication"
      ],
      "properties": {
        "state": {
          "const": "admitted"
        },
        "subject": {
          "const": "/package"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "canonicalization": {
          "const": "rfc8785-json"
        },
        "transitive_digest": {
          "$ref": "#/$defs/digest"
        },
        "dependency_closure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/closure_entry"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "admitted_by": {
          "$ref": "#/$defs/implementation"
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty"
          },
          "uniqueItems": true
        },
        "ledger_ref": {
          "$ref": "#/$defs/non_empty",
          "description": "Required Contract-owned durable row reference; the envelope is not itself a ledger."
        },
        "attestation_digest": {
          "$ref": "#/$defs/digest"
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/attestation_verdict"
          }
        },
        "authentication": {
          "$ref": "#/$defs/attestation_authentication"
        }
      }
    },
    "attestation_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "judge",
        "verdict_ref"
      ],
      "properties": {
        "witness_id": {
          "$ref": "#/$defs/identifier"
        },
        "judge": {
          "$ref": "#/$defs/implementation"
        },
        "verdict_ref": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "admission_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "kind",
        "owner",
        "subject_digest",
        "transitive_digest",
        "verdicts",
        "admitted_by",
        "admitted_at",
        "evidence_refs",
        "ledger_ref",
        "authentication"
      ],
      "properties": {
        "api_version": {
          "const": "graph-harness-attestation/v1"
        },
        "kind": {
          "const": "GraphHarnessAdmissionAttestation"
        },
        "owner": {
          "const": "contract"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "transitive_digest": {
          "$ref": "#/$defs/digest"
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/attestation_verdict"
          }
        },
        "admitted_by": {
          "$ref": "#/$defs/implementation"
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "ledger_ref": {
          "$ref": "#/$defs/non_empty"
        },
        "authentication": {
          "$ref": "#/$defs/attestation_authentication"
        }
      }
    },
    "attestation_authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  }
}

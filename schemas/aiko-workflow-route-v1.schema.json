{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiko.local/schemas/aiko-workflow-route-v1.schema.json",
  "title": "Aiko workflow route decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "facts",
    "preview",
    "decision"
  ],
  "properties": {
    "api_version": {
      "const": "aiko-workflow-route/v1"
    },
    "facts": {
      "$ref": "#/$defs/facts"
    },
    "preview": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/preview"
        }
      ]
    },
    "decision": {
      "$ref": "#/$defs/decision"
    }
  },
  "$defs": {
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explicit_workflow": {
          "type": "boolean",
          "default": false
        },
        "reuse_or_publish": {
          "type": "boolean",
          "default": false
        },
        "scheduled_or_durable": {
          "type": "boolean",
          "default": false
        },
        "reactive": {
          "type": "boolean",
          "default": false
        },
        "recursive": {
          "type": "boolean",
          "default": false
        },
        "workflow_compatibility_flag": {
          "type": "boolean",
          "default": false
        },
        "opaque_composition": {
          "type": "boolean",
          "default": false
        },
        "requests_process": {
          "type": "boolean",
          "default": false
        },
        "requests_network": {
          "type": "boolean",
          "default": false
        },
        "requests_write": {
          "type": "boolean",
          "default": false
        },
        "help_schema_or_version": {
          "type": "boolean",
          "default": false
        },
        "atomic_public_verb": {
          "type": "boolean",
          "default": false
        },
        "deterministic_local_transform": {
          "type": "boolean",
          "default": false
        },
        "read_only_observation": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "plan_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "plan",
        "action",
        "timeout_ms",
        "skill_id",
        "skill_version",
        "worker"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "research": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "input_bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "requires_authorization": {
          "type": "boolean",
          "default": false
        },
        "read_only": {
          "type": "boolean",
          "default": false
        },
        "reversible": {
          "type": "boolean",
          "default": false
        },
        "generated": {
          "type": "boolean",
          "default": false
        },
        "effect_scope": {
          "type": "string",
          "default": ""
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_version": {
          "type": "string",
          "minLength": 1
        },
        "worker": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "script": {
          "type": [
            "string",
            "null"
          ]
        },
        "script_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "witness": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_admitted",
        "children"
      ],
      "properties": {
        "core_admitted": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan_node"
          }
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "reasons"
          ],
          "properties": {
            "route": {
              "const": "graph_harness_required"
            },
            "reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "explicit_workflow",
                  "reuse_or_publish",
                  "more_than_one_logical_node",
                  "dependency",
                  "join_or_independent_judge",
                  "generated",
                  "scheduled_or_durable",
                  "reactive",
                  "external_effect",
                  "recursive",
                  "workflow_compatibility_flag"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "reason"
          ],
          "properties": {
            "route": {
              "const": "direct_allowed"
            },
            "reason": {
              "enum": [
                "help_schema_version",
                "read_only_observation",
                "deterministic_local_transform",
                "atomic_public_verb",
                "single_bounded_model_turn"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "policy_id",
            "audit_ref"
          ],
          "properties": {
            "route": {
              "const": "compatibility_escape"
            },
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "audit_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "code"
          ],
          "properties": {
            "route": {
              "const": "refused"
            },
            "code": {
              "enum": [
                "opaque_workflow",
                "uninspectable_composition"
              ]
            }
          }
        }
      ]
    }
  }
}

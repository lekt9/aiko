{
  "north_star": "Neuron, Contract, Cell, and the Smithers control surface are versioned compatible packages that install and update without reversing the one-way dependency.",
  "grade_min": 8,
  "nodes": [
    {
      "id": "stack-lock",
      "plan": "Pin stack versions and ABIs in one lock file",
      "depends_on": [],
      "status": "settled",
      "reads": ["VERSION", "sdk/registry/versions.lock"],
      "writes": ["sdk/registry/stack.lock.json"],
      "invoke_skills": ["harness-engineering"],
      "inspire_from": ["src:sdk/registry/versions.lock"],
      "capability_gaps": [],
      "witness": "test -s sdk/registry/stack.lock.json && grep -q '\"cell/v0\"' sdk/registry/stack.lock.json"
    },
    {
      "id": "layer-manifests",
      "plan": "Give each layer an aiko-package.json with requires that encode the one-way direction",
      "depends_on": ["stack-lock"],
      "status": "settled",
      "reads": ["sdk/registry/stack.lock.json"],
      "writes": [
        "cell/aiko-package.json",
        "neuron/aiko-package.json",
        "contract/aiko-package.json",
        "aiko-flow/aiko-package.json"
      ],
      "invoke_skills": ["harness-engineering"],
      "inspire_from": ["src:docs/SOURCE-OF-TRUTH.md"],
      "capability_gaps": [],
      "witness": "test -s neuron/aiko-package.json && test -s cell/aiko-package.json && test -s contract/aiko-package.json"
    },
    {
      "id": "package-cli",
      "plan": "check/list/install/update that refuse an incompatible mix",
      "depends_on": ["layer-manifests"],
      "status": "settled",
      "reads": ["scripts/lib/aiko-env.sh"],
      "writes": ["scripts/aiko-packages.py", "scripts/aiko-packages.sh"],
      "invoke_skills": ["harness-engineering"],
      "inspire_from": ["src:scripts/install-aiko-package.sh"],
      "capability_gaps": [],
      "witness": "python3 scripts/aiko-packages.py check"
    },
    {
      "id": "install-wire",
      "plan": "Portable install writes package currents; Smithers findCellRunner sees the installed Cell",
      "depends_on": ["package-cli"],
      "status": "settled",
      "reads": ["scripts/install-aiko-package.sh"],
      "writes": [
        "scripts/install-aiko-package.sh",
        "scripts/lib/aiko-env.sh",
        "aiko-flow/packages/components/src/components/runCell.js"
      ],
      "invoke_skills": ["cell"],
      "inspire_from": ["src:scripts/lib/assemble-portable.sh"],
      "capability_gaps": [],
      "witness": "bash tests/aiko-packages-gate.sh"
    }
  ]
}
